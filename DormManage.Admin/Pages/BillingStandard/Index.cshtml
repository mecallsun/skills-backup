@page
@model DormManage.Admin.Pages.BillingStandard.IndexModel
@{
    ViewData["Title"] = "费用标准管理";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .filter-btn {
            min-width: 90px !important;
            max-width: 90px !important;
            width: 90px !important;
            height: 38px !important;
            min-height: 38px !important;
            max-height: 38px !important;
            line-height: 38px !important;
            padding: 0 12px !important;
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 4px !important;
            font-size: 14px !important;
            font-weight: 400 !important;
            vertical-align: middle !important;
            white-space: nowrap !important;
            text-decoration: none !important;
            border-radius: 6px !important;
            border: 1px solid transparent !important;
            cursor: pointer !important;
        }
        .filter-btn i { font-size: 14px !important; line-height: 1 !important; margin: 0 !important; }
        .btn-primary.filter-btn {
            background: #1976d2 !important;
            border-color: #1976d2 !important;
            color: #fff !important;
        }
        .btn-primary.filter-btn:hover { background: #1565c0 !important; border-color: #1565c0 !important; }
        .btn-outline-secondary.filter-btn {
            color: #6c757d !important;
            border-color: #dee2e6 !important;
        }
        .btn-outline-secondary.filter-btn:hover {
            background: #f8f9fa !important;
            color: #495057 !important;
            border-color: #ced4da !important;
        }
    </style>
}

<div class="container-fluid">
    <!-- 页头（v2.13.15 使用 PageHeader 组件） -->
    @await Component.InvokeAsync("PageHeader", new {
        icon = "bi-cash-stack",
        title = "费用标准管理",
        count = Model.Total,
        countLabel = "条",
        primaryAction = new PageAction { Label = "新增标准", Url = "/BillingStandard/Create", Icon = "bi-plus-lg", Style = "success" }
    })

    <!-- 当前有效标准 -->
    @if (Model.ActiveStandard != null)
    {
        <div class="alert alert-success mb-3">
            <strong><i class="bi bi-check-circle"></i> 当前生效：</strong>
            @Model.ActiveStandard.StandardName
            （@Model.ActiveStandard.EffectiveFrom.Value:yyyy-MM-dd ~ @(Model.ActiveStandard.EffectiveTo?.ToString("yyyy-MM-dd") ?? "长期")）
            水 @Model.ActiveStandard.ColdWaterUnitPrice 元/m³ | 热 @Model.ActiveStandard.HotWaterUnitPrice 元/m³ | 电 @Model.ActiveStandard.ElectricUnitPrice 元/kWh
        </div>
    }

    <!-- 筛选区（v2.13.12 新增，v2.13.16 统一样式） -->
    <div class="card filter-card mb-3">
        <div class="card-body py-2">
            <form method="get" class="filter-row flex-nowrap">
                <div class="col-auto filter-item">
                    <input type="text" class="form-control form-control-sm" name="keyword" value="@ViewData["Keyword"]" placeholder="标准名称" />
                </div>
                <div class="col-auto filter-item">
                    <select class="form-select form-select-sm" name="isActive">
                        <option value="">全部状态</option>
                        <option value="true" selected="@(ViewData["IsActive"]?.ToString() == "True")">启用</option>
                        <option value="false" selected="@(ViewData["IsActive"]?.ToString() == "False")">停用</option>
                    </select>
                </div>
                <div class="col-auto filter-item filter-item-btn">
                    <button type="submit" class="btn btn-primary filter-btn"><i class="bi bi-search"></i> 查询</button>
                </div>
                <div class="col-auto filter-item filter-item-btn">
                    <a href="/BillingStandard" class="btn btn-outline-secondary filter-btn"><i class="bi bi-arrow-clockwise"></i> 重置</a>
                </div>
            </form>
        </div>
    </div>

    <!-- 列表 -->
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:50px">序号</th>
                        <th>标准名称</th>
                        <th>生效日期</th>
                        <th>截止日期</th>
                        <th>冷水(元/m³)</th>
                        <th>热水(元/m³)</th>
                        <th>电(元/kWh)</th>
                        <th>适用类型</th>
                        <th style="width:100px">状态</th>
                        <th style="width:120px">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Result != null)
                    {
                        @for (var i = 0; i < Model.Result.Items.Count; i++)
                        {
                            var item = Model.Result.Items[i];
                            <tr>
                                <td>@((Model.Result.PageIndex - 1) * Model.Result.PageSize + i + 1)</td>
                                <td>@item.StandardName</td>
                                <td>@item.EffectiveFrom?.ToString("yyyy-MM-dd")</td>
                                <td>@(item.EffectiveTo?.ToString("yyyy-MM-dd") ?? "—")</td>
                                <td>@item.ColdWaterUnitPrice</td>
                                <td>@item.HotWaterUnitPrice</td>
                                <td>@item.ElectricUnitPrice</td>
                                <td>@(item.ApplicableType ?? "全部")</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">启用</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">停用</span>
                                    }
                                </td>
                                <td>
                                    <a href="/BillingStandard/Edit?id=@item.Id" class="btn btn-sm btn-outline-primary">编辑</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 分页（v2.13.12 统一页尾样式） -->
    @if (Model.Result != null)
    {
        <div class="card-footer d-flex justify-content-between align-items-center pagination-footer mt-3">
            <div class="text-muted">
                共 <strong>@Model.Result.TotalCount</strong> 条记录，第 <strong>@Model.Result.PageIndex</strong> / <strong>@Model.Result.TotalPages</strong> 页
            </div>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Result.PageIndex <= 1 ? "disabled" : "")">
                        <a class="page-link" href="?page=1">&laquo;</a>
                    </li>
                    <li class="page-item @(Model.Result.PageIndex <= 1 ? "disabled" : "")">
                        <a class="page-link" href="?page=@(Model.Result.PageIndex - 1)">&lsaquo;</a>
                    </li>
                    @{
                        var start = Math.Max(1, Model.Result.PageIndex - 2);
                        var end = Math.Min(Model.Result.TotalPages, Model.Result.PageIndex + 2);
                        for (var p = start; p <= end; p++)
                        {
                            <li class="page-item @(p == Model.Result.PageIndex ? "active" : "")">
                                <a class="page-link" href="?page=@p">@p</a>
                            </li>
                        }
                    }
                    <li class="page-item @(Model.Result.PageIndex >= Model.Result.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="?page=@(Model.Result.PageIndex + 1)">&rsaquo;</a>
                    </li>
                    <li class="page-item @(Model.Result.PageIndex >= Model.Result.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="?page=@Model.Result.TotalPages">&raquo;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
