@page
@model DormManage.Admin.Pages.BillingStandard.IndexModel
@{
    ViewData["Title"] = "费用标准管理";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- 页头（v2.13.15 使用 PageHeader 组件） -->
    @await Component.InvokeAsync("PageHeader", new {
        icon = "bi-cash-stack",
        title = "费用标准管理",
        count = Model.Total,
        countLabel = "条",
        primaryAction = new PageAction { Label = "新增标准", Url = "/BillingStandard/Create", Icon = "bi-plus-lg", Style = "success", PermissionCode = "billing:edit" }
    })

    <!-- 当前有效标准 -->
    @if (Model.ActiveStandard != null)
    {
        <div class="alert alert-success mb-3">
            <strong><i class="bi bi-check-circle"></i> 当前生效：</strong>
            @Model.ActiveStandard.StandardName
            （@Model.ActiveStandard.EffectiveFrom:yyyy-MM-dd ~ @(Model.ActiveStandard.EffectiveTo?.ToString("yyyy-MM-dd") ?? "永久")）
            水 @Model.ActiveStandard.ColdWaterUnitPrice 元/m³ | 热 @Model.ActiveStandard.HotWaterUnitPrice 元/m³ | 电 @Model.ActiveStandard.ElectricUnitPrice 元/kWh
        </div>
    }

    <!-- 筛选区（v2.13.20 统一结构与样式） -->
    <form method="get" class="card mb-3 filter-card" data-filter-form="billingStandard">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end flex-nowrap filter-row">
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">标准名称</label>
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="标准名称">
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">适用类型</label>
                    <select name="applicableType" class="form-select">
                        <option value="">全部</option>
                        @foreach (var item in Model.ApplicableTypes)
                        {
                            <option value="@item" selected="@(Model.ApplicableType == item)">@item</option>
                        }
                    </select>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">状态</label>
                    <select name="isActive" class="form-select">
                        <option value="">全部</option>
                        <option value="true" selected="@(Model.IsActive == "true")">启用</option>
                        <option value="false" selected="@(Model.IsActive == "false")">停用</option>
                    </select>
                </div>
                <div class="col-auto filter-item filter-item-btn">
                    <button type="submit" class="btn btn-primary filter-btn">
                        <i class="bi bi-search"></i> 查询
                    </button>
                </div>
                <div class="col-auto filter-item filter-item-btn">
                    <button type="button" class="btn btn-outline-secondary filter-btn" onclick="FilterPersistence.resetFilters('billingStandard')">
                        <i class="bi bi-arrow-clockwise"></i> 重置
                    </button>
                </div>
            </div>
        </div>
    </form>

    <!-- 列表 -->
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th style="width:50px">序号</th>
                        <th>标准名称</th>
                        <th>生效日期</th>
                        <th>截止日期</th>
                        <th>冷水(元/m³)</th>
                        <th>热水(元/m³)</th>
                        <th>电(元/kWh)</th>
                        <th>适用类型</th>
                        <th style="width:100px">状态</th>
                        <th style="width:120px">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Result != null && Model.Result.Items.Count > 0)
                    {
                        @for (var i = 0; i < Model.Result.Items.Count; i++)
                        {
                            var item = Model.Result.Items[i];
                            var today = DateOnly.FromDateTime(DateTime.Today);
                            var isCurrentlyEffective = item.IsActive
                                && item.EffectiveFrom <= today
                                && (!item.EffectiveTo.HasValue || item.EffectiveTo.Value >= today);
                            var isExpired = item.EffectiveTo.HasValue && item.EffectiveTo.Value < today;
                            <tr class="@(isCurrentlyEffective ? "table-success" : "")">
                                <td>@((Model.Result.PageIndex - 1) * Model.Result.PageSize + i + 1)</td>
                                <td><strong>@item.StandardName</strong></td>
                                <td>@item.EffectiveFrom.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (item.EffectiveTo.HasValue)
                                    {
                                        @item.EffectiveTo.Value.ToString("yyyy-MM-dd")
                                    }
                                    else
                    {
                                        <span class="badge bg-success">当前生效</span>
                                    }
                                </td>
                                <td>¥ @item.ColdWaterUnitPrice.ToString("F2")</td>
                                <td>¥ @item.HotWaterUnitPrice.ToString("F2")</td>
                                <td>¥ @item.ElectricUnitPrice.ToString("F4")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.ApplicableType))
                                    {
                                        <span class="badge bg-info text-dark">@item.ApplicableType</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">全部</span>
                                    }
                                </td>
                                <td>
                                    @if (isExpired)
                                    {
                                        <span class="badge bg-secondary">已过期</span>
                                    }
                                    else if (isCurrentlyEffective)
                                    {
                                        <span class="badge bg-success">当前生效</span>
                                    }
                                    else if (item.IsActive)
                                    {
                                        <span class="badge bg-warning text-dark">未生效</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">停用</span>
                                    }
                                </td>
                                <td>
                                    @* v2.13.88 RBAC 细化：编辑 → billing:edit（v2.13.61 起新增独立权限，不再借用 booking:checkin） *@
                                    @if (await Html.HasPermissionAsync("billing:edit"))
                                    {
                                        <a href="/BillingStandard/Edit?id=@item.Id" class="btn btn-sm btn-outline-primary" data-return-list>编辑</a>
                                    }
                                    else
                                    {
                                        <small class="text-muted"><i class="bi bi-lock"></i> 无操作权限</small>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        @* v2.13.42 新增：空状态提示（原型有「暂无费用标准」） *@
                        <tr>
                            <td colspan="10" class="text-center text-muted py-4">
                                <i class="bi bi-inbox" style="font-size: 2rem; opacity: 0.4;"></i>
                                <div class="mt-2">暂无费用标准</div>
                                <a href="/BillingStandard/Create" class="btn btn-sm btn-primary mt-2">
                                    <i class="bi bi-plus-lg"></i> 新增费用标准
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- 页尾分页（v2.13.71 100% 原型对齐） -->
    @if (Model.Result != null && Model.Result.TotalCount > 0)
    {
        @await Html.PartialAsync("_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel
        {
            PageIndex = Model.PageIndex,
            PageSize = Model.PageSize,
            TotalCount = Model.Result.TotalCount
        })
    }
</div>
