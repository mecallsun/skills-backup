@page
@model DormManage.Admin.Pages.BillingStandard.EditModel
@{
    ViewData["Title"] = "编辑费用标准";
}

<div class="container-fluid px-4 py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0"><i class="bi bi-pencil-square"></i> 编辑费用标准</h2>
        <a href="/BillingStandard" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> 返回列表</a>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post">
                @* v2.13.42 BUG 修复：必须把 Input.Id 一起 POST，否则 SaveStandardAsync 收到 Id=0 走新增分支 *@
                <input type="hidden" asp-for="Input.Id" />
                <input type="hidden" asp-for="Input.CreatedAt" />
                @* v2.13.61 修复：保留旧 ApplicableType Name 用于回显（冗余字段） *@
                <input type="hidden" asp-for="Input.ApplicableType" />
                <div asp-validation-summary="All" class="text-danger mb-2"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">标准名称 <span class="text-danger">*</span></label>
                        <input asp-for="Input.StandardName" class="form-control" required maxlength="100" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">生效日期 <span class="text-danger">*</span></label>
                        <input asp-for="Input.EffectiveFrom" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">截止日期</label>
                        <input asp-for="Input.EffectiveTo" type="date" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">冷水单价(元/m³) <span class="text-danger">*</span></label>
                        <input asp-for="Input.ColdWaterUnitPrice" type="number" step="0.01" min="0" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">热水单价(元/m³) <span class="text-danger">*</span></label>
                        <input asp-for="Input.HotWaterUnitPrice" type="number" step="0.01" min="0" class="form-control" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">电价(元/kWh) <span class="text-danger">*</span></label>
                        <input asp-for="Input.ElectricUnitPrice" type="number" step="0.0001" min="0" class="form-control" required />
                    </div>
                    @* v2.13.61 修复：适用员工类型改为 select 下拉，选项来自 EmployeeType 表（基础资料真源），FK 关联保存为 ApplicableTypeId *@
                    <div class="col-md-3">
                        <label class="form-label">适用员工类型 <span class="text-danger">*</span></label>
                        <select asp-for="Input.ApplicableTypeId" class="form-select" required>
                            <option value="">请选择员工类型</option>
                            @foreach (var t in Model.EmployeeTypes)
                            {
                                <option value="@t.Id">@t.Name (@t.Code)</option>
                            }
                        </select>
                        <small class="form-text text-muted">来自「基础资料 → 员工类型」字典（FK 关联）</small>
                    </div>
                    @* v2.13.61 BUG 修复：启用勾选 - 修复 Razor 渲染逻辑（之前 `asp-for` hidden field 会覆盖 checkbox 状态） *@
                    <div class="col-md-3 form-field d-flex align-items-end">
                        <div class="form-check pb-2">
                            <input name="Input.IsActive" type="hidden" value="false" />
                            <input asp-for="Input.IsActive" type="checkbox" class="form-check-input" />
                            <label class="form-check-label" asp-for="Input.IsActive">启用此标准</label>
                        </div>
                    </div>
                </div>
                <div class="mt-4 d-flex gap-2 justify-content-end">
                    <a href="/BillingStandard" class="btn btn-outline-secondary">取消</a>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> 保存修改</button>
                </div>
            </form>
        </div>
    </div>
</div>
