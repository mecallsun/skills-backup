@page
@model DormManage.Admin.Pages.Settings.UserModel
@{
    ViewData["Title"] = "用户管理";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- v2.13.65：页面级 antiforgery token（form 内已无 asp-page-handler 自动注入，需要手动放一个供 JS 读取） -->
    @inject Microsoft.AspNetCore.Antiforgery.IAntiforgery PageAntiforgery
    @{
        var pageTokens = PageAntiforgery.GetAndStoreTokens(HttpContext);
    }
    <input type="hidden" id="pageAntiforgeryToken" name="__RequestVerificationToken" value="@pageTokens.RequestToken" />

    <!-- v2.13.65 改用 Bootstrap 5 原生 modal 触发（data-bs-toggle + data-bs-target），不再依赖内联 onclick -->
    @await Component.InvokeAsync("PageHeader", new {
        icon = "bi-person-badge",
        title = "用户管理",
        count = Model.TotalCount,
        countLabel = "人",
        primaryAction = new PageAction { Label = "新增用户", Url = "#createUserModal", Icon = "bi-plus-lg", Style = "primary" }
    })

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success py-2"><i class="bi bi-check-circle"></i> @Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage</div>
    }

    <!-- 筛选区 -->
    <div class="filter-card">
        <form method="get" class="filter-row">
            <div class="filter-item">
                <label class="form-label">搜索</label>
                <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="用户名 / 姓名" />
            </div>
            <div class="filter-item">
                <label class="form-label">角色</label>
                <select name="RoleId" class="form-select">
                    <option value="">全部</option>
                    @foreach (var role in Model.AvailableRoles)
                    {
                        if (Model.RoleId == role.Id)
                        {
                            <option value="@role.Id" selected="selected">@role.RoleName</option>
                        }
                        else
                        {
                            <option value="@role.Id">@role.RoleName</option>
                        }
                    }
                </select>
            </div>
            <div class="filter-item">
                <label class="form-label">状态</label>
                <select name="Status" class="form-select">
                    @if (string.IsNullOrEmpty(Model.Status))
                    {
                        <option value="" selected="selected">全部</option>
                    }
                    else
                    {
                        <option value="">全部</option>
                    }
                    @if (Model.Status == "active")
                    {
                        <option value="active" selected="selected">启用</option>
                    }
                    else
                    {
                        <option value="active">启用</option>
                    }
                    @if (Model.Status == "disabled")
                    {
                        <option value="disabled" selected="selected">禁用</option>
                    }
                    else
                    {
                        <option value="disabled">禁用</option>
                    }
                    @if (Model.Status == "locked")
                    {
                        <option value="locked" selected="selected">已锁定</option>
                    }
                    else
                    {
                        <option value="locked">已锁定</option>
                    }
                </select>
            </div>
            <div class="filter-item filter-item-btn">
                <button type="submit" class="btn btn-primary filter-btn"><i class="bi bi-search"></i> 查询</button>
            </div>
            <div class="filter-item filter-item-btn">
                <a href="/Settings/User" class="btn btn-outline-secondary filter-btn"><i class="bi bi-arrow-counterclockwise"></i> 重置</a>
            </div>
        </form>
    </div>

    <div class="card content-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th width="60">序号</th>
                        <th>用户名</th>
                        <th>姓名</th>
                        <th>角色</th>
                        <th>联系方式</th>
                        <th>最后登录</th>
                        <th width="120" class="text-center">状态</th>
                        <th width="280">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var startIdx = (Model.PageIndex - 1) * Model.PageSize + 1;
                        var idx = 0;
                    }
                    @foreach (var u in Model.Users)
                    {
                        idx++;
                        <tr>
                            <td class="text-muted">@(startIdx + idx - 1)</td>
                            <td><strong>@u.UserName</strong></td>
                            <td>@u.DisplayName</td>
                            <td>
                                @foreach (var roleName in u.RoleNames.Split(", ", StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-info me-1">@roleName</span>
                                }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(u.Email))
                                {
                                    <div><i class="bi bi-envelope"></i> @u.Email</div>
                                }
                                @if (!string.IsNullOrEmpty(u.Phone))
                                {
                                    <div><i class="bi bi-phone"></i> @u.Phone</div>
                                }
                            </td>
                            <td class="small text-muted">
                                @(u.LastLoginTime?.ToString("yyyy-MM-dd HH:mm") ?? "从未登录")
                                @if (!string.IsNullOrEmpty(u.LastLoginIp))
                                {
                                    <div><code>@u.LastLoginIp</code></div>
                                }
                            </td>
                            <td class="text-center">
                                @if (u.IsActive && !u.IsLocked)
                                {
                                    <span class="badge bg-success">正常</span>
                                }
                                else if (u.IsLocked)
                                {
                                    <span class="badge bg-danger">已锁定</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">禁用</span>
                                }
                            </td>
                            <td>
                                <!-- v2.13.65 改用 data-bs-toggle="modal" + 自定义 JS 填充字段，不再依赖内联 onclick -->
                                <button class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editUserModal"
                                        data-user-id="@u.Id"
                                        data-user-name="@u.UserName"
                                        data-display-name="@u.DisplayName"
                                        data-email="@u.Email"
                                        data-phone="@u.Phone"
                                        data-is-active="@u.IsActive.ToString().ToLower()"
                                        data-role-ids="@u.RoleIds">
                                    <i class="bi bi-pencil"></i> 编辑
                                </button>
                                @if (u.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline-warning" onclick="toggleUserStatus(@u.Id, false)" title="停用账号">
                                        <i class="bi bi-pause-circle"></i> 停用
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success" onclick="toggleUserStatus(@u.Id, true)" title="启用账号">
                                        <i class="bi bi-play-circle"></i> 启用
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-warning"
                                        data-bs-toggle="modal"
                                        data-bs-target="#resetPwdModal"
                                        data-user-id="@u.Id"
                                        data-user-name="@u.UserName">
                                    <i class="bi bi-key"></i> 重置密码
                                </button>
                                @if (u.UserName != "admin")
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteConfirmModal"
                                            data-user-id="@u.Id"
                                            data-user-name="@u.UserName">
                                        <i class="bi bi-trash"></i> 删除
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Users.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center py-4 text-muted">暂无数据</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalCount > 0)
        {
            <div class="pagination-footer">
                <span class="page-info">
                    共 <strong>@Model.TotalCount</strong> 人 ·
                    第 <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong> 页
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@BuildPageUrl(1, Model)">« 首页</a>
                        </li>
                        <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@BuildPageUrl(Model.PageIndex - 1, Model)">‹ 上一页</a>
                        </li>
                        <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@BuildPageUrl(Model.PageIndex + 1, Model)">下一页 ›</a>
                        </li>
                        <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@BuildPageUrl(Model.TotalPages, Model)">末页 »</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@functions {
    string BuildPageUrl(int pageIndex, UserModel model)
    {
        var query = new List<string>();
        if (!string.IsNullOrEmpty(model.Search)) query.Add($"Search={Uri.EscapeDataString(model.Search)}");
        if (model.RoleId.HasValue) query.Add($"RoleId={model.RoleId}");
        if (!string.IsNullOrEmpty(model.Status)) query.Add($"Status={Uri.EscapeDataString(model.Status)}");
        query.Add($"PageIndex={pageIndex}");
        query.Add($"PageSize={model.PageSize}");
        return "/Settings/User?" + string.Join("&", query);
    }
}

<!-- 新增用户 Modal — v2.13.65 改用 data-bs-toggle="modal" + AJAX fetch 提交，失败显示 feedback；不再依赖 onclick 字符串 -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="createUserForm">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus"></i> 新增用户</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="createUserFeedback" class="alert d-none mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label">用户名 <span class="text-danger">*</span></label>
                        <input type="text" name="UserName" class="form-control" required maxlength="50" pattern="[A-Za-z0-9_-]+" placeholder="英文字母/数字/下划线" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">姓名 <span class="text-danger">*</span></label>
                        <input type="text" name="DisplayName" class="form-control" required maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">初始密码 <span class="text-danger">*</span></label>
                        <input type="password" name="Password" class="form-control" required minlength="6" />
                        <div class="form-text">至少 6 位，建议首次登录后修改</div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">邮箱</label>
                            <input type="email" name="Email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">电话</label>
                            <input type="text" name="Phone" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">角色</label>
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="SelectedRoleIds" value="@role.Id" id="newRole_@role.Id">
                                <label class="form-check-label" for="newRole_@role.Id">
                                    @role.RoleName <small class="text-muted">(@role.RoleCode)</small>
                                </label>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary" id="createUserSubmit"><i class="bi bi-check-lg"></i> 创建</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 编辑用户 Modal — v2.13.65 改用 AJAX fetch 提交 -->
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="editUserForm">
                <input type="hidden" name="Id" id="editId">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil"></i> 编辑用户</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="editUserFeedback" class="alert d-none mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label">用户名</label>
                        <input type="text" id="editUserName" class="form-control" disabled>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">姓名 <span class="text-danger">*</span></label>
                        <input type="text" name="DisplayName" id="editDisplayName" class="form-control" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">邮箱</label>
                            <input type="email" name="Email" id="editEmail" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">电话</label>
                            <input type="text" name="Phone" id="editPhone" class="form-control">
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check pb-2">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editIsActive">
                            <label class="form-check-label" for="editIsActive">启用账号</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">角色</label>
                        <div id="editRolesContainer">
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="SelectedRoleIds" value="@role.Id" id="editRole_@role.Id">
                                    <label class="form-check-label" for="editRole_@role.Id">
                                        @role.RoleName <small class="text-muted">(@role.RoleCode)</small>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary" id="editUserSubmit"><i class="bi bi-check-lg"></i> 保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 重置密码 Modal — v2.13.65 改用 AJAX fetch 提交 -->
<div class="modal fade" id="resetPwdModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <form id="resetPwdForm">
                <input type="hidden" name="Id" id="pwdId">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-key"></i> 重置密码</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="resetPwdFeedback" class="alert d-none mb-3"></div>
                    <p>为用户 <strong id="pwdUserName"></strong> 设置新密码：</p>
                    <input type="password" name="NewPassword" id="pwdNewPassword" class="form-control" required minlength="6">
                    <div class="form-text">至少 6 位</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-warning" id="resetPwdSubmit"><i class="bi bi-key"></i> 重置</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 删除确认 Modal — v2.13.65 改用确认弹窗替代原生 confirm() -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <form id="deleteForm">
                <input type="hidden" name="Id" id="deleteId">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger"></i> 删除确认</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="deleteFeedback" class="alert d-none mb-3"></div>
                    <p>确定要删除用户 <strong id="deleteUserNameDisplay"></strong> 吗？</p>
                    <p class="text-muted small mb-0">此操作不可撤销。</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-danger" id="deleteSubmit"><i class="bi bi-trash"></i> 确认删除</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <!-- v2.13.65 完整 JS 重写：用 addEventListener 而非内联 onclick，Bootstrap data-bs-* 原生 modal 触发，AJAX fetch 异步提交并显示反馈 -->
    <script>
        // 获取 antiforgery token（页面级别的 form 之外的 meta）
        const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        // ====== 公共 feedback 显示 ======
        function showFeedback(elId, type, message) {
            const el = document.getElementById(elId);
            if (!el) return;
            el.className = 'alert mb-3 alert-' + type;
            el.textContent = message;
            el.classList.remove('d-none');
        }
        function hideFeedback(elId) {
            const el = document.getElementById(elId);
            if (!el) return;
            el.classList.add('d-none');
        }

        // ====== 通用 AJAX POST helper（form 提交，绕过 Razor Pages handler） ======
        // v2.13.65：使用 API 端点而非 Razor Pages handler，避免 modal 关闭与重定向耦合
        async function postUserAction(url, data, feedbackElId) {
            try {
                const formData = new URLSearchParams();
                for (const [key, value] of data.entries()) {
                    if (Array.isArray(value)) {
                        for (const v of value) formData.append(key, v);
                    } else if (value !== null && value !== undefined) {
                        formData.append(key, value);
                    }
                }
                const resp = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiforgeryToken
                    },
                    body: formData.toString()
                });
                let j = null;
                try { j = await resp.json(); } catch (e) {}
                if (resp.ok && (j === null || j.success !== false)) {
                    return { ok: true, data: j };
                } else {
                    const msg = j?.message || ('HTTP ' + resp.status);
                    if (feedbackElId) showFeedback(feedbackElId, 'danger', '操作失败：' + msg);
                    return { ok: false, message: msg };
                }
            } catch (e) {
                if (feedbackElId) showFeedback(feedbackElId, 'danger', '请求失败：' + e.message);
                return { ok: false, message: e.message };
            }
        }

        // ====== 启停用户（保持 API 风格 fetch） ======
        window.toggleUserStatus = async function(id, enable) {
            if (!confirm(enable ? '确定启用该用户？' : '确定停用该用户？')) return;
            const url = '/api/v1/auth/users/' + id + '/' + (enable ? 'enable' : 'disable');
            const resp = await fetch(url, { method: 'POST' });
            const j = await resp.json().catch(() => null);
            if (resp.ok && j?.success) {
                alert(enable ? '已启用' : '已停用');
                location.reload();
            } else {
                alert('操作失败：' + (j?.message || '未知错误'));
            }
        };

        // ====== Create Modal：监听 submit 事件 + Bootstrap modal 事件填充 form ======
        document.getElementById('createUserModal').addEventListener('show.bs.modal', function() {
            hideFeedback('createUserFeedback');
            document.getElementById('createUserForm').reset();
        });

        document.getElementById('createUserForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            hideFeedback('createUserFeedback');
            const data = new FormData(this);
            const submitBtn = document.getElementById('createUserSubmit');
            const origHtml = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>保存中...';
            const result = await postUserAction(
                '/Settings/User?handler=Create',
                data,
                'createUserFeedback'
            );
            submitBtn.disabled = false;
            submitBtn.innerHTML = origHtml;
            if (result.ok) {
                showFeedback('createUserFeedback', 'success', '✓ 创建成功！即将刷新...');
                setTimeout(() => location.reload(), 800);
            }
            // 失败时 postUserAction 内部已显示 feedback
        });

        // ====== Edit Modal：用 data-* 属性填充字段（Bootstrap 5.2+ 原生能力） ======
        document.getElementById('editUserModal').addEventListener('show.bs.modal', function(event) {
            hideFeedback('editUserFeedback');
            const btn = event.relatedTarget; // 触发 modal 的按钮
            if (!btn) return;
            const id = btn.getAttribute('data-user-id');
            const userName = btn.getAttribute('data-user-name');
            const displayName = btn.getAttribute('data-display-name') || '';
            const email = btn.getAttribute('data-email') || '';
            const phone = btn.getAttribute('data-phone') || '';
            const isActive = btn.getAttribute('data-is-active') === 'true';
            const roleIds = (btn.getAttribute('data-role-ids') || '').split(',').filter(s => s);

            document.getElementById('editId').value = id;
            document.getElementById('editUserName').value = userName;
            document.getElementById('editDisplayName').value = displayName;
            document.getElementById('editEmail').value = email;
            document.getElementById('editPhone').value = phone;
            document.getElementById('editIsActive').checked = isActive;

            // 按 RoleIds Id 严格勾选
            document.querySelectorAll('#editRolesContainer input[type=checkbox]').forEach(cb => {
                cb.checked = roleIds.includes(cb.value);
            });
        });

        document.getElementById('editUserForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            hideFeedback('editUserFeedback');
            const data = new FormData(this);
            // IsActive checkbox: unchecked 时字段不会提交，需要手动加 'false'
            if (!document.getElementById('editIsActive').checked) {
                data.set('IsActive', 'false');
            } else {
                data.set('IsActive', 'true');
            }
            const submitBtn = document.getElementById('editUserSubmit');
            const origHtml = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>保存中...';
            const result = await postUserAction(
                '/Settings/User?handler=Update',
                data,
                'editUserFeedback'
            );
            submitBtn.disabled = false;
            submitBtn.innerHTML = origHtml;
            if (result.ok) {
                showFeedback('editUserFeedback', 'success', '✓ 更新成功！即将刷新...');
                setTimeout(() => location.reload(), 800);
            }
        });

        // ====== Reset Password Modal ======
        document.getElementById('resetPwdModal').addEventListener('show.bs.modal', function(event) {
            hideFeedback('resetPwdFeedback');
            const btn = event.relatedTarget;
            if (!btn) return;
            document.getElementById('pwdId').value = btn.getAttribute('data-user-id');
            document.getElementById('pwdUserName').textContent = btn.getAttribute('data-user-name');
            document.getElementById('pwdNewPassword').value = '';
        });

        document.getElementById('resetPwdForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            hideFeedback('resetPwdFeedback');
            const data = new FormData(this);
            const submitBtn = document.getElementById('resetPwdSubmit');
            const origHtml = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>重置中...';
            const result = await postUserAction(
                '/Settings/User?handler=ResetPassword',
                data,
                'resetPwdFeedback'
            );
            submitBtn.disabled = false;
            submitBtn.innerHTML = origHtml;
            if (result.ok) {
                showFeedback('resetPwdFeedback', 'success', '✓ 密码已重置！即将关闭...');
                setTimeout(() => {
                    const modal = bootstrap.Modal.getInstance(document.getElementById('resetPwdModal'));
                    modal?.hide();
                }, 600);
            }
        });

        // ====== Delete Confirm Modal ======
        document.getElementById('deleteConfirmModal').addEventListener('show.bs.modal', function(event) {
            hideFeedback('deleteFeedback');
            const btn = event.relatedTarget;
            if (!btn) return;
            document.getElementById('deleteId').value = btn.getAttribute('data-user-id');
            document.getElementById('deleteUserNameDisplay').textContent = btn.getAttribute('data-user-name');
        });

        document.getElementById('deleteForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            hideFeedback('deleteFeedback');
            const data = new FormData(this);
            const submitBtn = document.getElementById('deleteSubmit');
            const origHtml = submitBtn.innerHTML;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>删除中...';
            const result = await postUserAction(
                '/Settings/User?handler=Delete',
                data,
                'deleteFeedback'
            );
            submitBtn.disabled = false;
            submitBtn.innerHTML = origHtml;
            if (result.ok) {
                showFeedback('deleteFeedback', 'success', '✓ 删除成功！即将刷新...');
                setTimeout(() => location.reload(), 800);
            }
        });
    </script>
}