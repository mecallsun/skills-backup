@page
@model DormManage.Admin.Pages.Settings.UserModel
@{
    ViewData["Title"] = "用户管理";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- 页头（v2.13.17 使用 PageHeader 组件） -->
    @await Component.InvokeAsync("PageHeader", new {
        icon = "bi-person-badge",
        title = "用户管理",
        count = Model.TotalCount,
        countLabel = "人",
        primaryAction = new PageAction { Label = "新增用户", OnClick = "var m = new bootstrap.Modal(document.getElementById('createUserModal')); m.show();", Icon = "bi-plus-lg", Style = "primary" }
    })

    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success py-2"><i class="bi bi-check-circle"></i> @Model.SuccessMessage</div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle"></i> @Model.ErrorMessage</div>
    }

    <!-- 筛选区（v2.13.64 新增 — 与原型 settings/index.html 用户 Tab 一致：搜索 + 角色筛选 + 状态筛选） -->
    <div class="filter-card">
        <form method="get" class="filter-row">
            <div class="filter-item">
                <label class="form-label">搜索</label>
                <input type="text" name="Search" value="@Model.Search" class="form-control" placeholder="用户名 / 姓名" />
            </div>
            <div class="filter-item">
                <label class="form-label">角色</label>
                <select name="RoleId" class="form-select">
                    <option value="">全部</option>
                    @foreach (var role in Model.AvailableRoles)
                    {
                        if (Model.RoleId == role.Id)
                        {
                            <option value="@role.Id" selected="selected">@role.RoleName</option>
                        }
                        else
                        {
                            <option value="@role.Id">@role.RoleName</option>
                        }
                    }
                </select>
            </div>
            <div class="filter-item">
                <label class="form-label">状态</label>
                <select name="Status" class="form-select">
                    @if (string.IsNullOrEmpty(Model.Status))
                    {
                        <option value="" selected="selected">全部</option>
                    }
                    else
                    {
                        <option value="">全部</option>
                    }
                    @if (Model.Status == "active")
                    {
                        <option value="active" selected="selected">启用</option>
                    }
                    else
                    {
                        <option value="active">启用</option>
                    }
                    @if (Model.Status == "disabled")
                    {
                        <option value="disabled" selected="selected">禁用</option>
                    }
                    else
                    {
                        <option value="disabled">禁用</option>
                    }
                    @if (Model.Status == "locked")
                    {
                        <option value="locked" selected="selected">已锁定</option>
                    }
                    else
                    {
                        <option value="locked">已锁定</option>
                    }
                </select>
            </div>
            <div class="filter-item filter-item-btn">
                <button type="submit" class="btn btn-primary filter-btn"><i class="bi bi-search"></i> 查询</button>
            </div>
            <div class="filter-item filter-item-btn">
                <a href="/Settings/User" class="btn btn-outline-secondary filter-btn"><i class="bi bi-arrow-counterclockwise"></i> 重置</a>
            </div>
        </form>
    </div>

    <div class="card content-card">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th width="60">序号</th>
                        <th>用户名</th>
                        <th>姓名</th>
                        <th>角色</th>
                        <th>联系方式</th>
                        <th>最后登录</th>
                        <th width="120" class="text-center">状态</th>
                        <th width="280">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var startIdx = (Model.PageIndex - 1) * Model.PageSize + 1;
                        var idx = 0;
                    }
                    @foreach (var u in Model.Users)
                    {
                        idx++;
                        <tr>
                            <td class="text-muted">@(startIdx + idx - 1)</td>
                            <td><strong>@u.UserName</strong></td>
                            <td>@u.DisplayName</td>
                            <td>
                                @foreach (var roleName in u.RoleNames.Split(", ", StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-info me-1">@roleName</span>
                                }
                            </td>
                            <td class="small">
                                @if (!string.IsNullOrEmpty(u.Email))
                                {
                                    <div><i class="bi bi-envelope"></i> @u.Email</div>
                                }
                                @if (!string.IsNullOrEmpty(u.Phone))
                                {
                                    <div><i class="bi bi-phone"></i> @u.Phone</div>
                                }
                            </td>
                            <td class="small text-muted">
                                @(u.LastLoginTime?.ToString("yyyy-MM-dd HH:mm") ?? "从未登录")
                                @if (!string.IsNullOrEmpty(u.LastLoginIp))
                                {
                                    <div><code>@u.LastLoginIp</code></div>
                                }
                            </td>
                            <td class="text-center">
                                @if (u.IsActive && !u.IsLocked)
                                {
                                    <span class="badge bg-success">正常</span>
                                }
                                else if (u.IsLocked)
                                {
                                    <span class="badge bg-danger">已锁定</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">禁用</span>
                                }
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary"
                                        onclick="openEditModal(@u.Id, '@u.DisplayName', '@u.Email', '@u.Phone', @u.IsActive.ToString().ToLower(), '@u.RoleIds', '@u.UserName')">
                                    <i class="bi bi-pencil"></i> 编辑
                                </button>
                                @if (u.IsActive)
                                {
                                    <button class="btn btn-sm btn-outline-warning" onclick="toggleUserStatus(@u.Id, false)" title="停用账号">
                                        <i class="bi bi-pause-circle"></i> 停用
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-sm btn-outline-success" onclick="toggleUserStatus(@u.Id, true)" title="启用账号">
                                        <i class="bi bi-play-circle"></i> 启用
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-warning"
                                        onclick="openPwdModal(@u.Id, '@u.UserName')">
                                    <i class="bi bi-key"></i> 重置密码
                                </button>
                                @if (u.UserName != "admin")
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            onclick="confirmDelete(@u.Id, '@u.UserName')">
                                        <i class="bi bi-trash"></i> 删除
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Users.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center py-4 text-muted">暂无数据</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @* 分页页尾（v2.13.64 统一风格） *@
        @if (Model.TotalCount > 0)
        {
            <div class="pagination-footer">
                <span class="page-info">
                    共 <strong>@Model.TotalCount</strong> 人 ·
                    第 <strong>@Model.PageIndex</strong> / <strong>@Model.TotalPages</strong> 页
                </span>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@BuildPageUrl(1, Model)">« 首页</a>
                        </li>
                        <li class="page-item @(Model.PageIndex <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@BuildPageUrl(Model.PageIndex - 1, Model)">‹ 上一页</a>
                        </li>
                        <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@BuildPageUrl(Model.PageIndex + 1, Model)">下一页 ›</a>
                        </li>
                        <li class="page-item @(Model.PageIndex >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@BuildPageUrl(Model.TotalPages, Model)">末页 »</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@functions {
    string BuildPageUrl(int pageIndex, UserModel model)
    {
        var query = new List<string>();
        if (!string.IsNullOrEmpty(model.Search)) query.Add($"Search={Uri.EscapeDataString(model.Search)}");
        if (model.RoleId.HasValue) query.Add($"RoleId={model.RoleId}");
        if (!string.IsNullOrEmpty(model.Status)) query.Add($"Status={Uri.EscapeDataString(model.Status)}");
        query.Add($"PageIndex={pageIndex}");
        query.Add($"PageSize={model.PageSize}");
        return "/Settings/User?" + string.Join("&", query);
    }
}

<!-- 新增用户 Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus"></i> 新增用户</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label class="form-label">用户名 <span class="text-danger">*</span></label>
                        <input type="text" name="UserName" class="form-control" required maxlength="50" pattern="[A-Za-z0-9_-]+" placeholder="英文字母/数字/下划线" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">姓名 <span class="text-danger">*</span></label>
                        <input type="text" name="DisplayName" class="form-control" required maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">初始密码 <span class="text-danger">*</span></label>
                        <input type="password" name="Password" class="form-control" required minlength="6" />
                        <div class="form-text">至少 6 位，建议首次登录后修改</div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">邮箱</label>
                            <input type="email" name="Email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">电话</label>
                            <input type="text" name="Phone" class="form-control" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">角色</label>
                        @foreach (var role in Model.AvailableRoles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="SelectedRoleIds" value="@role.Id" id="newRole_@role.Id">
                                <label class="form-check-label" for="newRole_@role.Id">
                                    @role.RoleName <small class="text-muted">(@role.RoleCode)</small>
                                </label>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> 创建</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 编辑用户 Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Update">
                <input type="hidden" name="Id" id="editId">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil"></i> 编辑用户</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div asp-validation-summary="All" class="text-danger mb-2"></div>
                    <div class="mb-3">
                        <label class="form-label">用户名</label>
                        <input type="text" id="editUserName" class="form-control" disabled>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">姓名 <span class="text-danger">*</span></label>
                        <input type="text" name="DisplayName" id="editDisplayName" class="form-control" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">邮箱</label>
                            <input type="email" name="Email" id="editEmail" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">电话</label>
                            <input type="text" name="Phone" id="editPhone" class="form-control">
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check pb-2">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editIsActive">
                            <label class="form-check-label" for="editIsActive">启用账号</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">角色</label>
                        <div id="editRolesContainer">
                            @foreach (var role in Model.AvailableRoles)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="SelectedRoleIds" value="@role.Id" id="editRole_@role.Id">
                                    <label class="form-check-label" for="editRole_@role.Id">
                                        @role.RoleName <small class="text-muted">(@role.RoleCode)</small>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> 保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 重置密码 Modal -->
<div class="modal fade" id="resetPwdModal" tabindex="-1">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <form method="post" asp-page-handler="ResetPassword">
                <input type="hidden" name="Id" id="pwdId">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-key"></i> 重置密码</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>为用户 <strong id="pwdUserName"></strong> 设置新密码：</p>
                    <input type="password" name="NewPassword" class="form-control" required minlength="6">
                    <div class="form-text">至少 6 位</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-warning"><i class="bi bi-key"></i> 重置</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 删除确认表单（隐藏） -->
<form id="deleteForm" method="post" asp-page-handler="Delete" style="display:none;">
    <input type="hidden" name="Id" id="deleteId">
</form>

@section Scripts {
    <script>
        function openEditModal(id, displayName, email, phone, isActive, roleIdsStr, userName) {
            document.getElementById('editId').value = id;
            document.getElementById('editUserName').value = userName;
            document.getElementById('editDisplayName').value = displayName;
            document.getElementById('editEmail').value = email || '';
            document.getElementById('editPhone').value = phone || '';
            document.getElementById('editIsActive').checked = isActive === 'true';

            // v2.13.64 重构：按 RoleIds（逗号分隔的 Id 字符串）勾选匹配角色，替代原"按名称前缀匹配"易误判
            const roleIds = (roleIdsStr || '').split(',').map(s => s.trim()).filter(s => s);
            document.querySelectorAll('#editRolesContainer input[type=checkbox]').forEach(cb => {
                cb.checked = roleIds.includes(cb.value);
            });
            new bootstrap.Modal(document.getElementById('editUserModal')).show();
        }

        // v2.13.64 BUG 修复：调用正确的端点 /enable 或 /disable（之前调用 /enable 或 /disable 已正确）
        function toggleUserStatus(id, enable) {
            if (!confirm(enable ? '确定启用该用户？' : '确定停用该用户？')) return;
            fetch('/api/v1/auth/users/' + id + '/' + (enable ? 'enable' : 'disable'), { method: 'POST' })
                .then(r => r.json())
                .then(j => {
                    if (j.success) {
                        alert(enable ? '已启用' : '已停用');
                        location.reload();
                    } else {
                        alert('操作失败：' + (j.message || '未知错误'));
                    }
                })
                .catch(err => alert('请求失败：' + err.message));
        }

        function openPwdModal(id, userName) {
            document.getElementById('pwdId').value = id;
            document.getElementById('pwdUserName').textContent = userName;
            new bootstrap.Modal(document.getElementById('resetPwdModal')).show();
        }

        function confirmDelete(id, userName) {
            if (confirm(`确定要删除用户 ${userName} 吗？此操作不可撤销。`)) {
                document.getElementById('deleteId').value = id;
                document.getElementById('deleteForm').submit();
            }
        }
    </script>
}