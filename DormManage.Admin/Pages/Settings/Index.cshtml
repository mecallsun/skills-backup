@page
@model DormManage.Admin.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "系统设置";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .settings-nav .nav-link {
            color: #37474f;
            border-radius: 8px;
            padding: 0.55rem 0.9rem;
        }
        .settings-nav .nav-link.active { background: #1976d2; color: #fff; }
        .settings-nav .nav-link:not(.active):hover { background: #e9f1fb; }
        .form-label.small { color: #607d8b; }
        .status-dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 5px; }
        .dot-run { background: #28a745; }
        .dot-stop { background: #dc3545; }
        .step-line { display: flex; align-items: center; gap: 8px; padding: 4px 0; }
        .db-test-step { opacity: 0; transition: opacity 0.3s; }
        .db-test-step.visible { opacity: 1; }
    </style>
}

<div class="container-fluid">
    <!-- 页头 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-gear"></i> 系统设置
            <span class="badge bg-warning text-dark ms-2">v2.13.19</span>
        </h2>
    </div>

    <div class="alert alert-info py-2 mb-3">
        <i class="bi bi-info-circle"></i>
        后台系统配置中心，与托盘管理程序（TrayApp）为<strong>同一份配置的双 UI 入口</strong>，涵盖服务端口、数据库、PDA 版本、用户权限、备份恢复。
    </div>

    <div style="display: flex; align-items: flex-start; gap: 12px;">
        <!-- 左侧导航 -->
        <div style="flex-shrink: 0; width: 200px;">
            <div class="card">
                <div class="card-body p-2">
                    <div class="nav flex-column nav-pills settings-nav" role="tablist">
                        <button class="nav-link @(Model.ActiveTab == "service" ? "active" : "") text-start"
                                data-bs-toggle="pill" data-bs-target="#tab-service"
                                onclick="setActiveTab('service')">
                            <i class="bi bi-hdd-network"></i> 服务与端口
                        </button>
                        <button class="nav-link @(Model.ActiveTab == "db" ? "active" : "") text-start"
                                data-bs-toggle="pill" data-bs-target="#tab-db"
                                onclick="setActiveTab('db')">
                            <i class="bi bi-database"></i> 数据库连接
                        </button>
                        <button class="nav-link @(Model.ActiveTab == "app" ? "active" : "") text-start"
                                data-bs-toggle="pill" data-bs-target="#tab-app"
                                onclick="setActiveTab('app')">
                            <i class="bi bi-phone"></i> PDA App 版本
                        </button>
                        <button class="nav-link @(Model.ActiveTab == "users" ? "active" : "") text-start"
                                data-bs-toggle="pill" data-bs-target="#tab-users"
                                onclick="setActiveTab('users')">
                            <i class="bi bi-person-badge"></i> 用户管理
                        </button>
                        <button class="nav-link @(Model.ActiveTab == "roles" ? "active" : "") text-start"
                                data-bs-toggle="pill" data-bs-target="#tab-roles"
                                onclick="setActiveTab('roles')">
                            <i class="bi bi-shield-lock"></i> 角色与权限
                        </button>
                        <button class="nav-link @(Model.ActiveTab == "backup" ? "active" : "") text-start"
                                data-bs-toggle="pill" data-bs-target="#tab-backup"
                                onclick="setActiveTab('backup')">
                            <i class="bi bi-hdd-stack"></i> 备份与恢复
                        </button>
                        <button class="nav-link @(Model.ActiveTab == "integration" ? "active" : "") text-start"
                                data-bs-toggle="pill" data-bs-target="#tab-integration"
                                onclick="setActiveTab('integration')">
                            <i class="bi bi-plug"></i> 系统集成
                        </button>
                        <button class="nav-link @(Model.ActiveTab == "about" ? "active" : "") text-start"
                                data-bs-toggle="pill" data-bs-target="#tab-about"
                                onclick="setActiveTab('about')">
                            <i class="bi bi-info-circle"></i> 关于系统
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右侧内容 -->
        <div style="flex: 1 1 0%;">
            <div class="tab-content">

                <!-- 服务与端口 -->
                <div class="tab-pane fade @(Model.ActiveTab == "service" ? "show active" : "")" id="tab-service">
                    <div class="card">
                        <div class="card-header bg-light">
                            <strong><i class="bi bi-hdd-network"></i> 服务与端口</strong>
                        </div>
                        <div class="card-body">
                            @if (TempData["SuccessMessage"] is string okMsg)
                            {
                                <div class="alert alert-success py-2"><i class="bi bi-check-circle"></i> @okMsg</div>
                            }
                            @if (TempData["ErrorMessage"] is string errMsg)
                            {
                                <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle"></i> @errMsg</div>
                            }

                            <!-- 托盘状态 -->
                            <div class="alert @(Model.TrayReachable ? "alert-success" : "alert-warning") py-2 mb-3">
                                <i class="bi bi-@(Model.TrayReachable ? "check-circle" : "exclamation-triangle")"></i>
                                <strong>托盘状态：</strong>
                                @if (Model.TrayReachable)
                                {
                                    <text>已连接（127.0.0.1:5099）</text>
                                }
                                else
                                {
                                    <text>未连接（请先启动托盘程序 DormManage.TrayApp.exe）</text>
                                }
                                <form method="post" asp-page-handler="PingTray" class="d-inline ms-2">
                                    <button type="submit" class="btn btn-sm btn-outline-info">
                                        <i class="bi bi-arrow-repeat"></i> 测试连接
                                    </button>
                                </form>
                            </div>

                            <form method="post" asp-page-handler="SaveService">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label small">PDA 服务端口</label>
                                        <input type="number" name="PdaPort" value="@Model.PdaPort" class="form-control" min="1" max="65535">
                                    </div>
                                    <div class="col-md-4 d-flex align-items-end gap-2">
                                        <span class="me-2">
                                            @switch (Model.ApiState)
                                            {
                                                case "Running":
                                                    <text><span class="status-dot dot-run"></span>运行中</text>
                                                    break;
                                                case "Starting":
                                                    <text><span class="status-dot dot-run" style="background:#fbc02d;"></span>启动中</text>
                                                    break;
                                                case "Stopped":
                                                    <text><span class="status-dot dot-stop"></span>已停止</text>
                                                    break;
                                                case "Crashed":
                                                    <text><span class="status-dot dot-stop" style="background:#dc3545;"></span>异常</text>
                                                    break;
                                                default:
                                                    <text><span class="status-dot dot-stop"></span>@Model.ApiState</text>
                                                    break;
                                            }
                                        </span>
                                        <form method="post" asp-page-handler="ControlService" class="d-inline">
                                            <input type="hidden" name="service" value="api">
                                            <input type="hidden" name="action" value="start">
                                            <button type="submit" class="btn btn-sm btn-outline-success" @(Model.TrayReachable ? "" : "disabled")>启动</button>
                                        </form>
                                        <form method="post" asp-page-handler="ControlService" class="d-inline">
                                            <input type="hidden" name="service" value="api">
                                            <input type="hidden" name="action" value="stop">
                                            <button type="submit" class="btn btn-sm btn-outline-warning" @(Model.TrayReachable ? "" : "disabled")>停止</button>
                                        </form>
                                        <form method="post" asp-page-handler="ControlService" class="d-inline">
                                            <input type="hidden" name="service" value="api">
                                            <input type="hidden" name="action" value="restart">
                                            <button type="submit" class="btn btn-sm btn-outline-primary" @(Model.TrayReachable ? "" : "disabled")>重启</button>
                                        </form>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small">Web 服务端口</label>
                                        <input type="number" name="WebPort" value="@Model.WebPort" class="form-control" min="1" max="65535">
                                    </div>
                                    <div class="col-md-4 d-flex align-items-end gap-2">
                                        <span class="me-2">
                                            @switch (Model.AdminState)
                                            {
                                                case "Running":
                                                    <text><span class="status-dot dot-run"></span>运行中</text>
                                                    break;
                                                case "Starting":
                                                    <text><span class="status-dot dot-run" style="background:#fbc02d;"></span>启动中</text>
                                                    break;
                                                case "Stopped":
                                                    <text><span class="status-dot dot-stop"></span>已停止</text>
                                                    break;
                                                case "Crashed":
                                                    <text><span class="status-dot dot-stop" style="background:#dc3545;"></span>异常</text>
                                                    break;
                                                default:
                                                    <text><span class="status-dot dot-stop"></span>@Model.AdminState</text>
                                                    break;
                                            }
                                        </span>
                                        <form method="post" asp-page-handler="ControlService" class="d-inline">
                                            <input type="hidden" name="service" value="admin">
                                            <input type="hidden" name="action" value="start">
                                            <button type="submit" class="btn btn-sm btn-outline-success" @(Model.TrayReachable ? "" : "disabled")>启动</button>
                                        </form>
                                        <form method="post" asp-page-handler="ControlService" class="d-inline">
                                            <input type="hidden" name="service" value="admin">
                                            <input type="hidden" name="action" value="stop">
                                            <button type="submit" class="btn btn-sm btn-outline-success" style="display:none">_</button>
                                            <button type="submit" class="btn btn-sm btn-outline-warning" @(Model.TrayReachable ? "" : "disabled")>停止</button>
                                        </form>
                                        <form method="post" asp-page-handler="ControlService" class="d-inline">
                                            <input type="hidden" name="service" value="admin">
                                            <input type="hidden" name="action" value="restart">
                                            <button type="submit" class="btn btn-sm btn-outline-primary" @(Model.TrayReachable ? "" : "disabled")>重启</button>
                                        </form>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small">服务器域名 / IP（PDA 访问用）</label>
                                        <input type="text" name="ServerDomain" value="@Model.ServerDomain" class="form-control">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small">图片保存路径</label>
                                        <input type="text" name="ImagePath" value="@Model.ImagePath" class="form-control">
                                        <div class="form-text">必须为绝对路径且目录可写，如 D:\MeterImages</div>
                                    </div>
                                </div>
                                <hr>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-save"></i> 保存并提示重启
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 数据库连接（v2.13.19 双 UI 双向同步） -->
                <div class="tab-pane fade @(Model.ActiveTab == "db" ? "show active" : "")" id="tab-db">
                    <div class="card">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong><i class="bi bi-database"></i> 数据库连接</strong>
                            <span class="badge bg-info text-dark">v2.13.19 双 UI 双向同步</span>
                        </div>
                        <div class="card-body">
                            <div id="dbConfigResult" class="mb-2"></div>

                            <div class="row g-3">
                                <div class="col-md-3">
                                    <label class="form-label small">数据库提供程序</label>
                                    <select id="dbProvider" class="form-select">
                                        <option value="SqlServer">SQL Server</option>
                                        <option value="Sqlite">SQLite</option>
                                    </select>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small">数据库服务器</label>
                                    <input type="text" id="dbServer" class="form-control" placeholder="192.168.1.237">
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small">端口号</label>
                                    <input type="number" id="dbPort" class="form-control" value="1433" min="1" max="65535">
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small">数据库名称</label>
                                    <input type="text" id="dbName" class="form-control" placeholder="WaterMeterDB">
                                </div>
                                <div class="col-md-6 sqlserver-only">
                                    <label class="form-label small">账号 <i class="bi bi-person-circle"></i></label>
                                    <input type="text" id="dbUser" class="form-control" placeholder="wateruser">
                                </div>
                                <div class="col-md-6 sqlserver-only">
                                    <label class="form-label small">密码（留空保持不变）<i class="bi bi-lock"></i></label>
                                    <input type="password" id="dbPassword" class="form-control" placeholder="******">
                                </div>
                                <div class="col-md-12 sqlite-only" style="display:none;">
                                    <label class="form-label small">SQLite 数据库文件路径 <i class="bi bi-file-earmark-binary"></i></label>
                                    <input type="text" id="dbSqlitePath" class="form-control" placeholder="D:\Data\dorm.db">
                                </div>
                            </div>

                            <div class="mt-3 d-flex gap-2 align-items-center">
                                <button type="button" class="btn btn-outline-info" id="btnDbTest">
                                    <i class="bi bi-plug"></i> 测试连接
                                </button>
                                <button type="button" class="btn btn-primary" id="btnDbSave">
                                    <i class="bi bi-save"></i> 保存
                                </button>
                                <span class="text-muted ms-2 small" id="dbConfigHint">保存后会自动写入 db_setting.json 并写入 SQL Server SysParameter 表</span>
                            </div>
                            <div id="dbTestResult" class="mt-3"></div>
                        </div>
                    </div>
                </div>

                <!-- PDA App 版本管理 -->
                <div class="tab-pane fade @(Model.ActiveTab == "app" ? "show active" : "")" id="tab-app">
                    <div class="card">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong><i class="bi bi-phone"></i> PDA App 版本管理</strong>
                            <button class="btn btn-sm btn-success" onclick="alert('原型演示：上传 APK 并发布新版本')">
                                <i class="bi bi-cloud-upload"></i> 发布新版本
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>版本号</th>
                                        <th>大小</th>
                                        <th>发布日期</th>
                                        <th>更新说明</th>
                                        <th>状态</th>
                                        <th width="160">操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var version in Model.AppVersions)
                                    {
                                        <tr>
                                            <td>
                                                <strong>@version.Version</strong>
                                                @if (version.IsLatest)
                                                {
                                                    <span class="badge bg-success ms-1">最新</span>
                                                }
                                            </td>
                                            <td>@version.Size</td>
                                            <td>@version.ReleaseDate</td>
                                            <td><small class="text-muted">@version.ReleaseNotes</small></td>
                                            <td>
                                                @if (version.IsEnabled)
                                                {
                                                    <span class="badge bg-success">启用</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">禁用</span>
                                                }
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary">编辑</button>
                                                <button class="btn btn-sm btn-outline-danger">删除</button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer text-muted small">
                            <i class="bi bi-link-45deg"></i> PDA 下载地址：
                            <code>http://@Model.ServerDomain:@Model.WebPort/app/download</code>
                            · 抄表员用 PDA 浏览器访问即可安装最新版
                        </div>
                    </div>
                </div>

                <!-- 用户与角色 -->
                <!-- 用户管理 -->
                <div class="tab-pane fade @(Model.ActiveTab == "users" ? "show active" : "")" id="tab-users">
                    <div class="card">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong><i class="bi bi-person-badge"></i> 用户管理</strong>
                            <button class="btn btn-sm btn-success" onclick="alert('原型演示：新增用户')">
                                <i class="bi bi-plus-lg"></i> 新增用户
                            </button>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>用户名</th>
                                            <th>姓名</th>
                                            <th>角色</th>
                                            <th>最近登录</th>
                                            <th>状态</th>
                                            <th>备注</th>
                                            <th width="200">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var user in Model.Users)
                                        {
                                            <tr>
                                                <td>@user.UserName</td>
                                                <td>@user.DisplayName</td>
                                                <td><span class="badge bg-info">@user.Role</span></td>
                                                <td>@user.LastLogin</td>
                                                <td>
                                                    @if (user.IsEnabled)
                                                    {
                                                        <span class="badge bg-success">启用</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary">禁用</span>
                                                    }
                                                </td>
                                                <td class="text-muted small">@user.Remark</td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary">编辑</button>
                                                    <button class="btn btn-sm btn-outline-danger">删除</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 角色与权限 -->
                <div class="tab-pane fade @(Model.ActiveTab == "roles" ? "show active" : "")" id="tab-roles">
                    <div class="card">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong><i class="bi bi-shield-lock"></i> 角色权限矩阵</strong>
                            <button class="btn btn-sm btn-success" onclick="alert('原型演示：新增角色')">
                                <i class="bi bi-plus-lg"></i> 新增角色
                            </button>
                        </div>
                        <div class="card-body">
                            <div class="table-responsive">
                                <table class="table table-bordered mb-0 align-middle text-center">
                                    <thead class="table-light">
                                        <tr>
                                            <th>角色</th>
                                            @foreach (var perm in Model.PermissionMatrix.Take(1))
                                            {
                                                <th>管理员</th>
                                                <th>财务</th>
                                                <th>PDA 操作员</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var perm in Model.PermissionMatrix)
                                        {
                                            <tr>
                                                <td class="text-start">@perm.Module</td>
                                                <td>
                                                    @if (perm.AdminAccess) { <text>✅</text> } else { <text>❌</text> }
                                                </td>
                                                <td>
                                                    @if (perm.FinanceAccess) { <text>✅</text> } else { <text>❌</text> }
                                                </td>
                                                <td>
                                                    @if (perm.PdaAccess) { <text>✅</text> } else { <text>❌</text> }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 备份与恢复 -->
                <div class="tab-pane fade @(Model.ActiveTab == "backup" ? "show active" : "")" id="tab-backup">
                    <div class="card">
                        <div class="card-header bg-light d-flex justify-content-between align-items-center">
                            <strong><i class="bi bi-hdd-stack"></i> 备份与恢复</strong>
                            <button class="btn btn-sm btn-success" onclick="alert('原型演示：立即执行数据库备份')">
                                <i class="bi bi-download"></i> 立即备份
                            </button>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-secondary py-2 mb-3">
                                <i class="bi bi-clock"></i> 自动备份策略：每日 <strong>02:00</strong> 全量备份，保留最近 <strong>30</strong> 天；图片目录随文件系统单独备份。
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>备份文件</th>
                                            <th>大小</th>
                                            <th>时间</th>
                                            <th>类型</th>
                                            <th width="160">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var backup in Model.Backups)
                                        {
                                            <tr>
                                                <td><i class="bi bi-file-earmark-zip"></i> @backup.FileName</td>
                                                <td>@backup.FileSize</td>
                                                <td>@backup.CreatedAt</td>
                                                <td>
                                                    @if (backup.IsAuto)
                                                    {
                                                        <span class="badge bg-info">自动</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-success">手动</span>
                                                    }
                                                </td>
                                                <td>
                                                    <button class="btn btn-sm btn-outline-primary">恢复</button>
                                                    <button class="btn btn-sm btn-outline-danger">删除</button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 系统集成 -->
                <div class="tab-pane fade @(Model.ActiveTab == "integration" ? "show active" : "")" id="tab-integration">
                    <div class="card">
                        <div class="card-header bg-light">
                            <strong><i class="bi bi-plug"></i> 系统集成配置</strong>
                        </div>
                        <div class="card-body">
                            <div class="alert alert-info py-2 mb-3">
                                <i class="bi bi-info-circle"></i> 配置与外部系统（HR / K3ERP）的连接参数。配置后系统可自动同步员工花名册、在职状态等数据。
                            </div>
                            <form method="post" asp-page-handler="SaveIntegration">
                                <div class="table-responsive">
                                    <table class="table table-hover mb-3 align-middle">
                                        <thead class="table-light">
                                            <tr>
                                                <th width="100">系统编码</th>
                                                <th width="160">系统名称</th>
                                                <th>服务器地址</th>
                                                <th width="140">账号</th>
                                                <th width="140">密码</th>
                                                <th width="100" class="text-center">启用</th>
                                                <th width="180">操作</th>
                                                <th width="140" class="text-center">连接状态</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var integration in Model.Integrations)
                                            {
                                                <tr>
                                                    <td><strong>@integration.SystemCode</strong></td>
                                                    <td>@integration.SystemName</td>
                                                    <td><input type="text" name="Integration_@integration.Id)_ServerAddress" value="@integration.ServerAddress" class="form-control form-control-sm"></td>
                                                    <td><input type="text" name="Integration_@integration.Id)_Account" value="@integration.Account" class="form-control form-control-sm"></td>
                                                    <td><input type="password" name="Integration_@integration.Id)_Password" value="@integration.Password" class="form-control form-control-sm"></td>
                                                    <td class="text-center">
                                                        <div class="form-check form-switch d-inline-block">
                                                            <input type="checkbox" name="Integration_@integration.Id)_Enabled" value="true" class="form-check-input" @(integration.IsEnabled ? "checked" : "")>
                                                            <input type="hidden" name="Integration_@integration.Id)_Enabled" value="false">
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <button type="button" class="btn btn-sm btn-outline-info" onclick="testConnection(@integration.Id)">
                                                            <i class="bi bi-plug"></i> 测试
                                                        </button>
                                                    </td>
                                                    <td class="text-center">
                                                        @if (integration.LastTestResult == true)
                                                        {
                                                            <span class="badge bg-success">正常</span>
                                                        }
                                                        else if (integration.LastTestResult == false)
                                                        {
                                                            <span class="badge bg-danger">失败</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary">未测试</span>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                                <hr>
                                <div class="text-end">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-save"></i> 保存参数
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 关于系统 -->
                <div class="tab-pane fade @(Model.ActiveTab == "about" ? "show active" : "")" id="tab-about">
                    <div class="card">
                        <div class="card-header bg-light">
                            <strong><i class="bi bi-info-circle"></i> 关于系统</strong>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm table-borderless mb-0">
                                <tr>
                                    <th width="120" class="text-muted">系统名称</th>
                                    <td>金戈宿舍管理系统</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">当前版本</th>
                                    <td>v2.13.19</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">技术栈</th>
                                    <td>.NET 8 + Razor Pages + Bootstrap 5 + EF Core</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">部署方式</th>
                                    <td>EXE 自托管 + 托盘守护进程</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">数据库</th>
                                    <td>SQLite（开发）/ SQL Server（生产）</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">设计规模</th>
                                    <td>800 人 / 200+ 宿舍 / 500+ 入住</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // v2.13.19: 数据库连接双 UI 双向同步 JS
        const DB_API = '/api/v1/system/dbconfig';

        function setActiveTab(tab) {
            const url = new URL(window.location);
            url.searchParams.set('tab', tab);
            window.history.replaceState({}, '', url);
        }

        // v2.13.19：封装对 Tray 的 IPC 通知，实际通过后端 API 转发到底层 TCP 端口 5099
        async function fetchTrayIpc(command, payload) {
            try {
                const res = await fetch('/api/v1/system/ipc/tray', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ command, payload })
                });
                return await res.json();
            } catch (e) {
                console.warn('fetchTrayIpc 失败:', e);
                return { success: false, message: e.message };
            }
        }

        // 加载当前数据库配置
        function loadDbConfig() {
            fetch(DB_API).then(r => r.json()).then(res => {
                if (!res.success) return;
                const c = res.data;
                document.getElementById('dbProvider').value = c.provider || 'SqlServer';
                document.getElementById('dbServer').value = c.dbServer || '';
                document.getElementById('dbPort').value = c.dbPort || 1433;
                document.getElementById('dbName').value = c.dbName || '';
                document.getElementById('dbUser').value = c.dbUser || '';
                document.getElementById('dbSqlitePath').value = c.sqlitePath || '';
                document.getElementById('dbPassword').value = '';
                toggleProviderUI();
            });
        }

        // 切换 SqlServer / Sqlite 字段可见性
        function toggleProviderUI() {
            const p = document.getElementById('dbProvider').value;
            const sqlserverOnly = document.querySelectorAll('.sqlserver-only');
            const sqliteOnly = document.querySelectorAll('.sqlite-only');
            sqlserverOnly.forEach(el => el.style.display = p === 'SqlServer' ? '' : 'none');
            sqliteOnly.forEach(el => el.style.display = p === 'Sqlite' ? '' : 'none');
        }

        // 测试连接（真实 HTTP 调用）
        async function runDbTest() {
            const box = document.getElementById('dbTestResult');
            box.innerHTML = '<div class="text-muted small"><span class="spinner-border spinner-border-sm"></span> 正在测试连接...</div>';

            const payload = {
                provider: document.getElementById('dbProvider').value,
                dbServer: document.getElementById('dbServer').value,
                dbPort: parseInt(document.getElementById('dbPort').value) || 1433,
                dbName: document.getElementById('dbName').value,
                dbUser: document.getElementById('dbUser').value,
                dbPassword: document.getElementById('dbPassword').value || 'unchanged',
                sqlitePath: document.getElementById('dbSqlitePath').value
            };

            try {
                const res = await fetch(DB_API + '/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const json = await res.json();
                if (json.success) {
                    box.innerHTML = `<div class="alert alert-success mb-0"><strong><i class="bi bi-check2-all"></i> ${json.message}</strong></div>`;
                } else {
                    box.innerHTML = `<div class="alert alert-danger mb-0"><i class="bi bi-x-octagon"></i> ${json.message}</div>`;
                }
            } catch (e) {
                box.innerHTML = `<div class="alert alert-danger mb-0"><i class="bi bi-x-octagon"></i> 测试失败: ${e.message}</div>`;
            }
        }

        // 保存配置（真实 HTTP 调用 → 触发双 UI 广播）
        async function saveDbConfig() {
            const box = document.getElementById('dbConfigResult');
            box.innerHTML = '<div class="text-muted small"><span class="spinner-border spinner-border-sm"></span> 正在保存...</div>';

            const payload = {
                provider: document.getElementById('dbProvider').value,
                dbServer: document.getElementById('dbServer').value,
                dbPort: parseInt(document.getElementById('dbPort').value) || 1433,
                dbName: document.getElementById('dbName').value,
                dbUser: document.getElementById('dbUser').value,
                dbPassword: document.getElementById('dbPassword').value || 'unchanged',
                sqlitePath: document.getElementById('dbSqlitePath').value
            };

            try {
                const res = await fetch(DB_API + '/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const json = await res.json();
                if (json.success) {
                    box.innerHTML = `<div class="alert alert-success mb-0"><i class="bi bi-check-circle"></i> ${json.message}</div>`;
                    // 触发 TrayApp IPC 同步广播
                    fetchTrayIpc('dbconfig.updated', payload);
                } else {
                    box.innerHTML = `<div class="alert alert-danger mb-0"><i class="bi bi-x-octagon"></i> ${json.message}</div>`;
                }
            } catch (e) {
                box.innerHTML = `<div class="alert alert-danger mb-0"><i class="bi bi-x-octagon"></i> 保存失败: ${e.message}</div>`;
            }
        }

        // DOM Ready 初始化：数据库配置区域始终可用（v2.13.28 修复：不再依赖 URL ?tab=db 参数）
        document.addEventListener('DOMContentLoaded', function () {
            loadDbConfig();
            var providerEl = document.getElementById('dbProvider');
            if (providerEl) providerEl.addEventListener('change', toggleProviderUI);
            var testEl = document.getElementById('btnDbTest');
            if (testEl) testEl.addEventListener('click', runDbTest);
            var saveEl = document.getElementById('btnDbSave');
            if (saveEl) saveEl.addEventListener('click', saveDbConfig);
        });

        function toggleService(which) {
            alert(`原型演示：${which === 'pda' ? 'PDA' : 'Web'} 服务状态切换`);
        }

        function testConnection(id) {
            alert(`测试与系统 ID=${id} 的连接...\n（实际将发送 HTTP 请求并返回结果）`);
        }
    </script>
}
