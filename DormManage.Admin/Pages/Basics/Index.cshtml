@page
@model DormManage.Admin.Pages.Basics.IndexModel
@{
    ViewData["Title"] = "基础资料";
    Layout = "_Layout";
    // v2.13.120 设备档案按钮权限（写入 JS 全局变量，避免 Razor @await 在 JS 模板里失效）
    var deviceCanEdit = (await Html.HasPermissionAsync("device:edit")).ToString().ToLower();
    var deviceCanDelete = (await Html.HasPermissionAsync("device:delete")).ToString().ToLower();
}

<div class="container-fluid">
    <!-- 页头（v2.13.45 P2-1：与全站 page-header 规范一致） -->
    <div class="page-header">
        <h2>
            <i class="bi bi-database header-icon"></i> 基础资料
            <span class="header-count">10 类数据字典</span>
        </h2>
    </div>

    <!-- 左侧纵向 pills 导航 + 右侧 tab 面板（v2.13.13 重构：与系统设置风格一致） -->
    <div style="display: flex; align-items: flex-start; gap: 12px;">
        <!-- 左侧导航（200px） -->
        <div style="flex-shrink: 0; width: 200px;">
            <div class="card">
                <div class="card-body p-2">
                    <div class="nav flex-column nav-pills basics-nav" role="tablist">
                        <button class="nav-link text-start @(Model.ActiveTab == "dept" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-dept"
                                onclick="setActiveTab('dept')">
                            <i class="bi bi-building"></i> 部门管理
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "building" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-building"
                                onclick="setActiveTab('building')">
                            <i class="bi bi-geo-alt"></i> 楼栋管理
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "floor" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-floor"
                                onclick="setActiveTab('floor')">
                            <i class="bi bi-layers"></i> 楼层管理
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "address" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-address"
                                onclick="setActiveTab('address')">
                            <i class="bi bi-pin-map"></i> 地址管理
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "emptype" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-emptype"
                                onclick="setActiveTab('emptype')">
                            <i class="bi bi-person-badge"></i> 员工类型
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "attendance" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-attendance"
                                onclick="setActiveTab('attendance')">
                            <i class="bi bi-clock-history"></i> 班次
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "team" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-team"
                                onclick="setActiveTab('team')">
                            <i class="bi bi-people-fill"></i> 员工班组
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "unit" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-unit"
                                onclick="setActiveTab('unit')">
                            <i class="bi bi-speedometer2"></i> 计量单位
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "residence" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-residence"
                                onclick="setActiveTab('residence')">
                            <i class="bi bi-house-door"></i> 住宿状态
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "employment" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-employment"
                                onclick="setActiveTab('employment')">
                            <i class="bi bi-person-check"></i> 在职状态
                        </button>
                        @* v2.13.120 新增：设备档案 *@
                        <button class="nav-link text-start @(Model.ActiveTab == "device" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-device"
                                onclick="setActiveTab('device')">
                            <i class="bi bi-cpu"></i> 设备档案
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右侧内容 -->
        <div style="flex: 1 1 0%;">
            <div class="tab-content" id="basicsTabContent">

                <!-- 部门管理 -->
                <div class="tab-pane fade @(Model.ActiveTab == "dept" ? "show active" : "")" id="pane-dept" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-building"></i> 部门列表</h5>
                                <button class="btn btn-success" onclick="showAddModal('dept')">
                                    <i class="bi bi-plus-lg"></i> 新增部门
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="60">序号</th>
                                            <th>部门编码</th>
                                            <th>部门名称</th>
                                            <th>备注</th>
                                            <th width="100">状态</th>
                                            <th width="120">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody id="deptTable"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 楼栋管理 -->
                <div class="tab-pane fade @(Model.ActiveTab == "building" ? "show active" : "")" id="pane-building" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-geo-alt"></i> 楼栋列表</h5>
                                <button class="btn btn-success" onclick="showAddModal('building')">
                                    <i class="bi bi-plus-lg"></i> 新增楼栋
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="60">序号</th>
                                            <th>楼栋名称</th>
                                            <th>备注</th>
                                            <th width="100">状态</th>
                                            <th width="120">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody id="buildingTable"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 楼层管理 -->
                <div class="tab-pane fade @(Model.ActiveTab == "floor" ? "show active" : "")" id="pane-floor" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-layers"></i> 楼层列表</h5>
                                <button class="btn btn-success" onclick="showAddModal('floor')">
                                    <i class="bi bi-plus-lg"></i> 新增楼层
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="60">序号</th>
                                            <th>楼层</th>
                                            <th>备注</th>
                                            <th width="100">状态</th>
                                            <th width="120">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody id="floorTable"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 地址管理 -->
                <div class="tab-pane fade @(Model.ActiveTab == "address" ? "show active" : "")" id="pane-address" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-pin-map"></i> 地址列表</h5>
                                <button class="btn btn-success" onclick="showAddModal('address')">
                                    <i class="bi bi-plus-lg"></i> 新增地址
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="60">序号</th>
                                            <th>地址</th>
                                            <th>备注</th>
                                            <th width="100">状态</th>
                                            <th width="120">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody id="addressTable"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 员工类型 -->
                <div class="tab-pane fade @(Model.ActiveTab == "emptype" ? "show active" : "")" id="pane-emptype" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-person-badge"></i> 员工类型列表</h5>
                                <button class="btn btn-success" onclick="showAddModal('emptype')">
                                    <i class="bi bi-plus-lg"></i> 新增类型
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="60">序号</th>
                                            <th>类型编码</th>
                                            <th>类型名称</th>
                                            <th>备注</th>
                                            <th width="100">状态</th>
                                            <th width="120">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody id="emptypeTable"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 班次 -->
                <div class="tab-pane fade @(Model.ActiveTab == "attendance" ? "show active" : "")" id="pane-attendance" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-clock-history"></i> 班次列表</h5>
                                <button class="btn btn-success" onclick="showAddModal('attendance')">
                                    <i class="bi bi-plus-lg"></i> 新增班次
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="60">序号</th>
                                            <th>类型编码</th>
                                            <th>类型名称</th>
                                            <th>工作时段</th>
                                            <th>备注</th>
                                            <th width="100">状态</th>
                                            <th width="120">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody id="attendanceTable"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 员工班组（新增 v2.13.13） -->
                <div class="tab-pane fade @(Model.ActiveTab == "team" ? "show active" : "")" id="pane-team" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-people-fill"></i> 员工班组列表</h5>
                                <button class="btn btn-success" onclick="showAddModal('team')">
                                    <i class="bi bi-plus-lg"></i> 新增班组
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="60">序号</th>
                                            <th>班组编码</th>
                                            <th>班组名称</th>
                                            <th>排序号</th>
                                            <th>备注</th>
                                            <th width="100">状态</th>
                                            <th width="120">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody id="teamTable"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 计量单位 -->
                <div class="tab-pane fade @(Model.ActiveTab == "unit" ? "show active" : "")" id="pane-unit" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-speedometer2"></i> 计量单位列表</h5>
                                <button class="btn btn-success" onclick="showAddModal('unit')">
                                    <i class="bi bi-plus-lg"></i> 新增单位
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="60">序号</th>
                                            <th>单位编码</th>
                                            <th>单位名称</th>
                                            <th>显示单位</th>
                                            <th>备注</th>
                                            <th width="100">状态</th>
                                            <th width="120">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody id="unitTable"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 住宿状态 -->
                <div class="tab-pane fade @(Model.ActiveTab == "residence" ? "show active" : "")" id="pane-residence" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-house-door"></i> 住宿状态列表</h5>
                                <button class="btn btn-success" onclick="showAddModal('residence')">
                                    <i class="bi bi-plus-lg"></i> 新增状态
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="60">序号</th>
                                            <th>状态编码</th>
                                            <th>状态名称</th>
                                            <th>备注</th>
                                            <th width="100">状态</th>
                                            <th width="120">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody id="residenceTable"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 在职状态 -->
                <div class="tab-pane fade @(Model.ActiveTab == "employment" ? "show active" : "")" id="pane-employment" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-person-check"></i> 在职状态列表</h5>
                                <button class="btn btn-success" onclick="showAddModal('employment')">
                                    <i class="bi bi-plus-lg"></i> 新增状态
                                </button>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="60">序号</th>
                                            <th>状态编码</th>
                                            <th>状态名称</th>
                                            <th>备注</th>
                                            <th width="100">状态</th>
                                            <th width="120">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody id="employmentTable"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                @* v2.13.120 设备档案（与 Dorm 1:1）*@
                <div class="tab-pane fade @(Model.ActiveTab == "device" ? "show active" : "")" id="pane-device" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-cpu"></i> 设备档案列表</h5>
                                @if (await Html.HasPermissionAsync("device:create"))
                                {
                                    <button class="btn btn-success" onclick="showDeviceAddModal()">
                                        <i class="bi bi-plus-lg"></i> 新增设备档案
                                    </button>
                                }
                            </div>

                            @* 筛选区 *@
                            <div class="row g-2 mb-3 align-items-end">
                                <div class="col-auto">
                                    <label class="form-label small text-muted mb-1">关键词</label>
                                    <input type="text" id="deviceKeyword" class="form-control form-control-sm" placeholder="房号/电表ID/冷/热水表ID" style="min-width:260px;" />
                                </div>
                                <div class="col-auto">
                                    <button class="btn btn-primary btn-sm" onclick="loadDeviceMeters()"><i class="bi bi-search"></i> 查询</button>
                                    <button class="btn btn-outline-secondary btn-sm" onclick="resetDeviceFilter()"><i class="bi bi-arrow-clockwise"></i> 重置</button>
                                </div>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th width="60">序号</th>
                                            <th>房号</th>
                                            <th>楼栋</th>
                                            <th>楼层</th>
                                            <th>电表ID</th>
                                            <th>冷水ID</th>
                                            <th>热水ID</th>
                                            <th>备注</th>
                                            <th width="80">更新时间</th>
                                            <th width="150">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody id="deviceTable"></tbody>
                                </table>
                            </div>

                            @* 分页（v2.13.105 默认 10 / 20 / 50 / 100）*@
                            @await Html.PartialAsync("_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel
                            {
                                PageIndex = 1,
                                PageSize = 10,
                                TotalCount = 0
                            })
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- 新增/编辑 Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalTitle">新增</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editId" />
                <div class="mb-3" id="codeField" style="display:none;">
                    <label class="form-label">编码</label>
                    <input type="text" class="form-control" id="editCode" placeholder="如 CONTRACT" />
                </div>
                <div class="mb-3">
                    <label class="form-label" id="nameLabel">名称</label>
                    <input type="text" class="form-control" id="editName" placeholder="请输入名称" />
                </div>
                <div class="mb-3" id="sortField" style="display:none;">
                    <label class="form-label">排序号</label>
                    <input type="number" class="form-control" id="editSort" value="0" />
                </div>
                <div class="mb-3" id="hoursField" style="display:none;">
                    <label class="form-label">工作时段</label>
                    <input type="text" class="form-control" id="editHours" placeholder="如 09:00-18:00" />
                </div>
                <div class="mb-3" id="unitField" style="display:none;">
                    <label class="form-label">显示单位</label>
                    <input type="text" class="form-control" id="editUnit" placeholder="如 m³" />
                </div>
                <div class="mb-3">
                    <label class="form-label">备注</label>
                    <textarea class="form-control" id="editRemark" rows="2" placeholder="可选"></textarea>
                </div>
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="editActive" checked />
                        <label class="form-check-label" for="editActive">启用</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="saveData()">保存</button>
            </div>
        </div>
    </div>
</div>

<!-- v2.13.120 设备档案 新增/编辑 Modal -->
<div class="modal fade" id="deviceModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="deviceModalTitle"><i class="bi bi-cpu text-success"></i> 新增设备档案</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deviceId" value="0" />
                <div class="mb-3">
                    <label class="form-label">房号 <span class="text-danger">*</span></label>
                    <select id="deviceDormId" class="form-select">
                        <option value="">— 请选择房号 —</option>
                    </select>
                    <small class="text-muted">每间宿舍只能配置 1 条设备档案（1:1 约束）</small>
                </div>
                <div class="row g-2">
                    <div class="col-md-4">
                        <label class="form-label">电表 ID</label>
                        <input type="text" id="deviceElectric" class="form-control" placeholder="现场电表编号" maxlength="64" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">冷水表 ID</label>
                        <input type="text" id="deviceCold" class="form-control" placeholder="现场冷水表编号" maxlength="64" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">热水表 ID</label>
                        <input type="text" id="deviceHot" class="form-control" placeholder="现场热水表编号" maxlength="64" />
                    </div>
                </div>
                <div class="mt-2">
                    <label class="form-label">备注</label>
                    <textarea id="deviceRemark" class="form-control" rows="2" maxlength="500" placeholder="可选"></textarea>
                </div>
            </div>
            <div class="modal-footer py-2">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="saveDeviceMeter()"><i class="bi bi-check-lg"></i> 保存</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    .basics-nav .nav-link {
        color: #37474f;
        border-radius: 8px;
        padding: 0.55rem 0.9rem;
    }
    .basics-nav .nav-link.active { background: #1976d2; color: #fff; }
    .basics-nav .nav-link:not(.active):hover { background: #e9f1fb; }
</style>
}

@section Scripts {
<script>
    // API 配置
    const API_BASE = '/api/basics';

    // 当前编辑类型和ID
    let currentType = 'dept';
    let currentId = null;

    // 标签映射
    const labelMap = {
        departments: '部门名称',
        buildings: '楼栋名称',
        floors: '楼层',
        addresses: '地址',
        employeeTypes: '类型名称',
        attendanceTypes: '类型名称',
        teams: '班组名称',
        meterUnits: '单位名称',
        residenceStatuses: '状态名称',
        employmentStatuses: '状态名称'
    };

    // 类型到API的映射
    const typeToApi = {
        dept: 'departments',
        building: 'buildings',
        floor: 'floors',
        address: 'addresses',
        emptype: 'employee-types',
        attendance: 'attendance-types',
        team: 'teams',
        unit: 'meter-units',
        residence: 'residence-statuses',
        employment: 'employment-statuses'
    };

    // 页面加载时根据 URL 参数或默认加载对应 tab
    document.addEventListener('DOMContentLoaded', function () {
        const urlParams = new URLSearchParams(window.location.search);
        const tabParam = urlParams.get('tab');
        const typeMap = {
            'dept': 'dept', 'building': 'building', 'floor': 'floor',
            'address': 'address', 'emptype': 'emptype', 'attendance': 'attendance',
            'team': 'team', 'unit': 'unit', 'residence': 'residence', 'employment': 'employment'
        };
        const type = tabParam && typeMap[tabParam] ? typeMap[tabParam] : 'dept';
        setActiveTab(type);
        loadData(type);
    });

    // 设置当前 tab 高亮（URL 参数持久化）
    function setActiveTab(type) {
        // 更新 URL 参数
        const url = new URL(window.location);
        url.searchParams.set('tab', type);
        window.history.replaceState({}, '', url);

        // 移除所有 active
        document.querySelectorAll('.basics-nav .nav-link').forEach(el => el.classList.remove('active'));
        // 激活当前
        const btn = document.querySelector(`.basics-nav .nav-link[onclick="setActiveTab('${type}')"]`);
        if (btn) btn.classList.add('active');

        // 切换 tab pane
        document.querySelectorAll('#basicsTabContent .tab-pane').forEach(el => {
            el.classList.remove('show', 'active');
        });
        const target = document.getElementById('pane-' + type);
        if (target) target.classList.add('show', 'active');

        // 加载数据
        loadData(type);
    }

    // 加载数据
    async function loadData(type) {
        currentType = type;
        const apiType = typeToApi[type];
        try {
            const resp = await fetch(`${API_BASE}/${apiType}`);
            const result = await resp.json();
            if (result.success) {
                renderTable(type, result.data.items);
            }
        } catch (err) {
            console.error('加载数据失败:', err);
        }
    }

    // 渲染表格
    function renderTable(type, items) {
        const tableId = getTableId(type);
        let html = '';

        items.forEach((item, idx) => {
            const statusBadge = item.isActive
                ? '<span class="badge bg-success">启用</span>'
                : '<span class="badge bg-secondary">停用</span>';

            if (type === 'dept') {
                html += `<tr>
                    <td>${idx + 1}</td>
                    <td><code>${item.code}</code></td>
                    <td>${item.name}</td>
                    <td>${item.remark || '-'}</td>
                    <td>${statusBadge}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" onclick="editItem('${type}', ${item.id})">编辑</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteItem('${type}', ${item.id})">删除</button>
                    </td>
                </tr>`;
            } else if (type === 'building' || type === 'address') {
                html += `<tr>
                    <td>${idx + 1}</td>
                    <td>${item.name || item.addressText}</td>
                    <td>${item.remark || '-'}</td>
                    <td>${statusBadge}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" onclick="editItem('${type}', ${item.id})">编辑</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteItem('${type}', ${item.id})">删除</button>
                    </td>
                </tr>`;
            } else if (type === 'floor') {
                html += `<tr>
                    <td>${idx + 1}</td>
                    <td>${item.floorNo} 楼</td>
                    <td>${item.remark || '-'}</td>
                    <td>${statusBadge}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" onclick="editItem('${type}', ${item.id})">编辑</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteItem('${type}', ${item.id})">删除</button>
                    </td>
                </tr>`;
            } else if (type === 'emptype' || type === 'residence' || type === 'employment') {
                html += `<tr>
                    <td>${idx + 1}</td>
                    <td><code>${item.code}</code></td>
                    <td>${item.name}</td>
                    <td>${item.remark || '-'}</td>
                    <td>${statusBadge}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" onclick="editItem('${type}', ${item.id})">编辑</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteItem('${type}', ${item.id})">删除</button>
                    </td>
                </tr>`;
            } else if (type === 'attendance') {
                html += `<tr>
                    <td>${idx + 1}</td>
                    <td><code>${item.code}</code></td>
                    <td>${item.name}</td>
                    <td>${item.workHours || '-'}</td>
                    <td>${item.remark || '-'}</td>
                    <td>${statusBadge}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" onclick="editItem('${type}', ${item.id})">编辑</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteItem('${type}', ${item.id})">删除</button>
                    </td>
                </tr>`;
            } else if (type === 'team') {
                html += `<tr>
                    <td>${idx + 1}</td>
                    <td><code>${item.code || '-'}</code></td>
                    <td>${item.name}</td>
                    <td>${item.sortOrder ?? 0}</td>
                    <td>${item.remark || '-'}</td>
                    <td>${statusBadge}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" onclick="editItem('${type}', ${item.id})">编辑</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteItem('${type}', ${item.id})">删除</button>
                    </td>
                </tr>`;
            } else if (type === 'unit') {
                html += `<tr>
                    <td>${idx + 1}</td>
                    <td><code>${item.code}</code></td>
                    <td>${item.name}</td>
                    <td>${item.unit || '-'}</td>
                    <td>${item.remark || '-'}</td>
                    <td>${statusBadge}</td>
                    <td>
                        <button class="btn btn-sm btn-outline-primary" onclick="editItem('${type}', ${item.id})">编辑</button>
                        <button class="btn btn-sm btn-outline-danger" onclick="deleteItem('${type}', ${item.id})">删除</button>
                    </td>
                </tr>`;
            }
        });

        document.getElementById(tableId).innerHTML = html || '<tr><td colspan="7" class="text-center text-muted py-4">暂无数据</td></tr>';
    }

    function getTableId(type) {
        const map = {
            dept: 'deptTable',
            building: 'buildingTable',
            floor: 'floorTable',
            address: 'addressTable',
            emptype: 'emptypeTable',
            attendance: 'attendanceTable',
            team: 'teamTable',
            unit: 'unitTable',
            residence: 'residenceTable',
            employment: 'employmentTable'
        };
        return map[type] || '';
    }

    // 显示新增 Modal
    function showAddModal(type) {
        currentType = type;
        currentId = null;
        document.getElementById('editModalTitle').textContent = '新增';
        document.getElementById('editId').value = '';
        document.getElementById('editCode').value = '';
        document.getElementById('editName').value = '';
        document.getElementById('editHours').value = '';
        document.getElementById('editRemark').value = '';
        document.getElementById('editSort').value = '0';
        document.getElementById('editUnit').value = '';
        document.getElementById('editActive').checked = true;

        const showCode = ['dept', 'emptype', 'attendance', 'unit', 'residence', 'employment', 'team'].includes(type);
        const showHours = type === 'attendance';
        const showUnit = type === 'unit';
        const showSort = type === 'team';

        document.getElementById('codeField').style.display = showCode ? 'block' : 'none';
        document.getElementById('hoursField').style.display = showHours ? 'block' : 'none';
        document.getElementById('unitField').style.display = showUnit ? 'block' : 'none';
        document.getElementById('sortField').style.display = showSort ? 'block' : 'none';

        const apiType = typeToApi[type];
        document.getElementById('nameLabel').textContent = labelMap[apiType] || '名称';

        new bootstrap.Modal(document.getElementById('editModal')).show();
    }

    // 编辑
    async function editItem(type, id) {
        currentType = type;
        currentId = id;
        const apiType = typeToApi[type];

        try {
            const resp = await fetch(`${API_BASE}/${apiType}/${id}`);
            const result = await resp.json();
            if (result.success) {
                const data = result.data;
                document.getElementById('editModalTitle').textContent = '编辑';
                document.getElementById('editId').value = id;
                document.getElementById('editCode').value = data.code || '';
                document.getElementById('editName').value = data.name || data.floorNo || data.addressText || '';
                document.getElementById('editHours').value = data.workHours || '';
                document.getElementById('editRemark').value = data.remark || '';
                document.getElementById('editSort').value = data.sortOrder ?? 0;
                document.getElementById('editUnit').value = data.unit || '';
                document.getElementById('editActive').checked = data.isActive;

                const showCode = ['dept', 'emptype', 'attendance', 'unit', 'residence', 'employment', 'team'].includes(type);
                const showHours = type === 'attendance';
                const showUnit = type === 'unit';
                const showSort = type === 'team';

                document.getElementById('codeField').style.display = showCode ? 'block' : 'none';
                document.getElementById('hoursField').style.display = showHours ? 'block' : 'none';
                document.getElementById('unitField').style.display = showUnit ? 'block' : 'none';
                document.getElementById('sortField').style.display = showSort ? 'block' : 'none';

                const apiType2 = typeToApi[type];
                document.getElementById('nameLabel').textContent = labelMap[apiType2] || '名称';

                new bootstrap.Modal(document.getElementById('editModal')).show();
            }
        } catch (err) {
            console.error('获取数据失败:', err);
        }
    }

    // 删除
    async function deleteItem(type, id) {
        if (!confirm('确定删除该记录吗？')) return;

        const apiType = typeToApi[type];
        try {
            const resp = await fetch(`${API_BASE}/${apiType}/${id}`, { method: 'DELETE' });
            const result = await resp.json();
            if (result.success) {
                alert('删除成功');
                loadData(type);
            } else {
                alert(result.message || '删除失败');
            }
        } catch (err) {
            console.error('删除失败:', err);
        }
    }

    // 保存
    async function saveData() {
        const name = document.getElementById('editName').value.trim();
        if (!name) { alert('请输入名称'); return; }

        const apiType = typeToApi[currentType];
        const id = document.getElementById('editId').value;

        let payload = { name: name };
        if (['dept', 'emptype', 'attendance', 'unit', 'residence', 'employment', 'team'].includes(currentType)) {
            payload.code = document.getElementById('editCode').value.trim();
        }
        if (currentType === 'floor') {
            payload.floorNo = parseInt(name);
        } else if (currentType === 'address') {
            payload.addressText = name;
        }
        payload.remark = document.getElementById('editRemark').value.trim();
        payload.isActive = document.getElementById('editActive').checked;
        if (currentType === 'attendance') {
            payload.workHours = document.getElementById('editHours').value.trim();
        }
        if (currentType === 'team') {
            payload.sortOrder = parseInt(document.getElementById('editSort').value) || 0;
        }
        if (currentType === 'unit') {
            payload.unit = document.getElementById('editUnit').value.trim();
        }

        try {
            let resp;
            if (id) {
                resp = await fetch(`${API_BASE}/${apiType}/${id}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            } else {
                resp = await fetch(`${API_BASE}/${apiType}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
            }

            const result = await resp.json();
            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
                alert('保存成功');
                loadData(currentType);
            } else {
                alert(result.message || '保存失败');
            }
        } catch (err) {
            console.error('保存失败:', err);
        }
    }

    // ========== v2.13.120 设备档案 ==========
    let deviceDormOptions = [];

    async function loadDeviceMeters(page = 1, pageSize = 10) {
        const kw = document.getElementById('deviceKeyword')?.value?.trim() || '';
        try {
            const url = new URL('/api/basics/device-meters', window.location.origin);
            url.searchParams.set('keyword', kw);
            url.searchParams.set('page', page);
            url.searchParams.set('pageSize', pageSize);
            const resp = await fetch(url, { credentials: 'same-origin' });
            const result = await resp.json();
            if (!result.success) { alert(result.message || '加载失败'); return; }
            renderDeviceTable(result.data.items, page, pageSize);
            renderDevicePagination(result.data, page, pageSize);
        } catch (err) {
            console.error('加载设备档案失败:', err);
        }
    }

    function renderDeviceTable(items, page, pageSize) {
        const tbody = document.getElementById('deviceTable');
        if (!items || items.length === 0) {
            tbody.innerHTML = '<tr><td colspan="10" class="text-center text-muted py-4">暂无设备档案</td></tr>';
            return;
        }
        const canEdit = window.__deviceCanEdit === true;
        const canDelete = window.__deviceCanDelete === true;
        tbody.innerHTML = items.map((it, idx) => {
            const no = (page - 1) * pageSize + idx + 1;
            return `
                <tr>
                    <td class="text-center text-muted">${no}</td>
                    <td><strong>${escapeHtml(it.dormCode)}</strong></td>
                    <td>${escapeHtml(it.buildingName || '-')}</td>
                    <td>${it.floorNo} 楼</td>
                    <td>${escapeHtml(it.electricMeterId || '-')}</td>
                    <td>${escapeHtml(it.coldWaterMeterId || '-')}</td>
                    <td>${escapeHtml(it.hotWaterMeterId || '-')}</td>
                    <td><small>${escapeHtml(it.remark || '')}</small></td>
                    <td><small class="text-muted">${formatDate(it.updatedAt)}</small></td>
                    <td class="text-center">
                        ${canEdit ? `<button class="btn btn-sm btn-outline-primary me-1" onclick="showDeviceEditModal(${it.id})">修改</button>` : ''}
                        ${canDelete ? `<button class="btn btn-sm btn-outline-danger" onclick="deleteDeviceMeter(${it.id}, '${escapeHtml(it.dormCode)}')">删除</button>` : ''}
                        ${!canEdit && !canDelete ? '<small class="text-muted">无操作权限</small>' : ''}
                    </td>
                </tr>
            `;
        }).join('');
    }

    function renderDevicePagination(data, page, pageSize) {
        // 复用 _PaginationPartial 但更新统计 + 分页器
        const total = data.totalCount;
        const start = total === 0 ? 0 : (page - 1) * pageSize + 1;
        const end = Math.min(page * pageSize, total);
        const totalPages = Math.max(1, Math.ceil(total / pageSize));
        const footer = document.querySelector('#pane-device .pagination-footer');
        if (footer) {
            footer.innerHTML = `
                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-muted small">
                        共 ${total} 条 · 第 ${start}-${end} 条 · 共 ${totalPages} 页
                        <select class="form-select form-select-sm d-inline-block ms-2" style="width:90px;" onchange="loadDeviceMeters(1, this.value)">
                            <option value="10" ${pageSize===10?'selected':''}>10 条/页</option>
                            <option value="20" ${pageSize===20?'selected':''}>20 条/页</option>
                            <option value="50" ${pageSize===50?'selected':''}>50 条/页</option>
                            <option value="100" ${pageSize===100?'selected':''}>100 条/页</option>
                        </select>
                    </div>
                    <nav><ul class="pagination pagination-sm mb-0"></ul></nav>
                </div>
            `;
            const ul = footer.querySelector('.pagination');
            ul.innerHTML = buildDevicePager(page, totalPages);
        }
    }

    function buildDevicePager(page, totalPages) {
        let html = `<li class="page-item ${page===1?'disabled':''}"><a class="page-link" href="javascript:;" onclick="loadDeviceMeters(${page-1}, 10)">«</a></li>`;
        const win = 2;
        let start = Math.max(1, page - win);
        let end = Math.min(totalPages, page + win);
        if (start > 1) { html += `<li class="page-item"><a class="page-link" href="javascript:;" onclick="loadDeviceMeters(1, 10)">1</a></li>`; if (start > 2) html += `<li class="page-item disabled"><span class="page-link">…</span></li>`; }
        for (let i = start; i <= end; i++) html += `<li class="page-item ${i===page?'active':''}"><a class="page-link" href="javascript:;" onclick="loadDeviceMeters(${i}, 10)">${i}</a></li>`;
        if (end < totalPages) { if (end < totalPages - 1) html += `<li class="page-item disabled"><span class="page-link">…</span></li>`; html += `<li class="page-item"><a class="page-link" href="javascript:;" onclick="loadDeviceMeters(${totalPages}, 10)">${totalPages}</a></li>`; }
        html += `<li class="page-item ${page===totalPages?'disabled':''}"><a class="page-link" href="javascript:;" onclick="loadDeviceMeters(${page+1}, 10)">»</a></li>`;
        return html;
    }

    function resetDeviceFilter() {
        document.getElementById('deviceKeyword').value = '';
        loadDeviceMeters(1, 10);
    }

    async function loadDormOptionsForDevice(excludeDeviceId) {
        try {
            const resp = await fetch('/api/basics/dorms-for-device', { credentials: 'same-origin' });
            const result = await resp.json();
            if (!result.success) return;
            deviceDormOptions = result.data || [];
            const sel = document.getElementById('deviceDormId');
            const cur = sel.value;
            sel.innerHTML = '<option value="">— 请选择房号 —</option>' +
                deviceDormOptions.map(d => {
                    const tag = d.hasDevice ? '（已配置）' : '';
                    return `<option value="${d.dormId}">${escapeHtml(d.buildingName)} / ${d.floorNo}楼 / ${escapeHtml(d.dormCode)} ${tag}</option>`;
                }).join('');
            if (cur) sel.value = cur;
        } catch (err) { console.error('加载房号选项失败:', err); }
    }

    async function showDeviceAddModal() {
        document.getElementById('deviceId').value = '0';
        document.getElementById('deviceDormId').value = '';
        document.getElementById('deviceElectric').value = '';
        document.getElementById('deviceCold').value = '';
        document.getElementById('deviceHot').value = '';
        document.getElementById('deviceRemark').value = '';
        document.getElementById('deviceModalTitle').innerHTML = '<i class="bi bi-cpu text-success"></i> 新增设备档案';
        await loadDormOptionsForDevice();
        new bootstrap.Modal(document.getElementById('deviceModal')).show();
    }

    async function showDeviceEditModal(id) {
        try {
            const resp = await fetch(`/api/basics/device-meters/${id}`, { credentials: 'same-origin' });
            const result = await resp.json();
            if (!result.success) { alert(result.message || '加载失败'); return; }
            const it = result.data;
            document.getElementById('deviceId').value = it.id;
            await loadDormOptionsForDevice(id);
            document.getElementById('deviceDormId').value = it.dormId;
            document.getElementById('deviceElectric').value = it.electricMeterId || '';
            document.getElementById('deviceCold').value = it.coldWaterMeterId || '';
            document.getElementById('deviceHot').value = it.hotWaterMeterId || '';
            document.getElementById('deviceRemark').value = it.remark || '';
            document.getElementById('deviceModalTitle').innerHTML = '<i class="bi bi-pencil-square text-primary"></i> 编辑设备档案 #' + it.id;
            new bootstrap.Modal(document.getElementById('deviceModal')).show();
        } catch (err) { console.error('加载失败:', err); }
    }

    async function saveDeviceMeter() {
        const id = parseInt(document.getElementById('deviceId').value || '0');
        const dormId = parseInt(document.getElementById('deviceDormId').value || '0');
        if (!dormId) { alert('请选择房号'); return; }
        const payload = {
            id: id,
            dormId: dormId,
            electricMeterId: document.getElementById('deviceElectric').value.trim(),
            coldWaterMeterId: document.getElementById('deviceCold').value.trim(),
            hotWaterMeterId: document.getElementById('deviceHot').value.trim(),
            remark: document.getElementById('deviceRemark').value.trim()
        };
        try {
            const url = id > 0 ? `/api/basics/device-meters/${id}` : '/api/basics/device-meters';
            const method = id > 0 ? 'PUT' : 'POST';
            const resp = await fetch(url, {
                method: method,
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify(payload)
            });
            const result = await resp.json();
            if (result.success) {
                bootstrap.Modal.getInstance(document.getElementById('deviceModal')).hide();
                loadDeviceMeters();
            } else {
                alert(result.message || '保存失败');
            }
        } catch (err) { console.error('保存失败:', err); alert('保存失败：' + err.message); }
    }

    async function deleteDeviceMeter(id, code) {
        if (!confirm(`确定删除设备档案「${code}」吗？此操作不可恢复。`)) return;
        try {
            const resp = await fetch(`/api/basics/device-meters/${id}`, { method: 'DELETE', credentials: 'same-origin' });
            const result = await resp.json();
            if (result.success) loadDeviceMeters();
            else alert(result.message || '删除失败');
        } catch (err) { console.error('删除失败:', err); alert('删除失败：' + err.message); }
    }

    function escapeHtml(s) { return s == null ? '' : String(s).replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c])); }
    function formatDate(d) { if (!d) return '-'; const x = new Date(d); return x.toLocaleString('zh-CN', { hour12: false }); }

    // 设备档案自动加载（如果 tab=device）
    document.addEventListener('DOMContentLoaded', function () {
        if ('@Model.ActiveTab' === 'device') loadDeviceMeters();
    });
</script>

<script>
    // v2.13.120 注入设备档案按钮权限到全局（避免 Razor at-符 在 JS 注释中误解析）
    window.__deviceCanEdit = @deviceCanEdit;
    window.__deviceCanDelete = @deviceCanDelete;
</script>
}
