<!-- 新增/编辑 Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalTitle">新增</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editId" />
                <div class="mb-3" id="codeField" style="display:none;">
                    <label class="form-label">编码</label>
                    <input type="text" class="form-control" id="editCode" placeholder="如 CONTRACT" />
                </div>
                <div class="mb-3">
                    <label class="form-label" id="nameLabel">名称</label>
                    <input type="text" class="form-control" id="editName" placeholder="请输入名称" />
                </div>
                <div class="mb-3" id="sortField" style="display:none;">
                    <label class="form-label">排序号</label>
                    <input type="number" class="form-control" id="editSort" value="0" />
                </div>
                <div class="mb-3" id="hoursField" style="display:none;">
                    <label class="form-label">工作时段</label>
                    <input type="text" class="form-control" id="editHours" placeholder="如 09:00-18:00" />
                </div>
                <div class="mb-3" id="unitField" style="display:none;">
                    <label class="form-label">显示单位</label>
                    <input type="text" class="form-control" id="editUnit" placeholder="如 m³" />
                </div>
                <div class="mb-3">
                    <label class="form-label">备注</label>
                    <textarea class="form-control" id="editRemark" rows="2" placeholder="可选"></textarea>
                </div>
                <div class="mb-3">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="editActive" checked />
                        <label class="form-check-label" for="editActive">启用</label>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="saveData()">保存</button>
            </div>
        </div>
    </div>
</div>

@section Styles {
