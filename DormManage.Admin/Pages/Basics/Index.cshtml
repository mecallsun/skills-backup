</div>

@* ============ 设备记录批量删除 Modal ============ *@
<div class="modal fade" id="batchDeleteEquipmentReadingModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog"><div class="modal-content">
        <div class="modal-header py-2 bg-warning text-dark"><h5 class="modal-title"><i class="bi bi-exclamation-triangle-fill"></i> 批量删除设备记录</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <div class="alert alert-warning py-2 mb-3"><i class="bi bi-exclamation-triangle-fill"></i> <strong>危险操作！</strong>将永久删除指定时间段内的<strong>所有</strong>设备记录，请谨慎使用。</div>
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label">起始时间 <span class="text-danger">*</span></label><input type="datetime-local" id="batchDelStartTime" class="form-control" /></div>
                <div class="col-md-6"><label class="form-label">结束时间 <span class="text-danger">*</span></label><input type="datetime-local" id="batchDelEndTime" class="form-control" /></div>
            </div>
            <div class="form-check mt-3"><input class="form-check-input" type="checkbox" id="batchDelConfirm" /><label class="form-check-label" for="batchDelConfirm">我已确认要删除该时间段的所有设备记录（此操作不可撤销）</label></div>
        </div>
        <div class="modal-footer py-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
            <button type="button" id="batchDeleteConfirmBtn" class="btn btn-danger" onclick="confirmBatchDeleteEquipmentReadings()" disabled><i class="bi bi-trash3"></i> 确认删除</button>
        </div>
    </div></div>
</div>

@section Styles {
<style>
    .basics-nav .nav-link { color: #37474f; border-radius: 8px; padding: 0.55rem 0.9rem; }
    .basics-nav .nav-link.active { background: #1976d2; color: #fff; }
    .basics-nav .nav-link:not(.active):hover { background: #e9f1fb; }
</style>
}

@section Scripts {
<script>
    const API_BASE = '/api/basics';
    let currentType = '@Model.ActiveTab';
    let currentId = null;
    const labelMap = { departments:'部门名称', buildings:'楼栋名称', floors:'楼层', addresses:'地址',
        employeeTypes:'类型名称', attendanceTypes:'类型名称', teams:'班组名称', meterUnits:'单位名称',
        residenceStatuses:'状态名称', employmentStatuses:'状态名称' };
    const typeToApi = { dept:'departments', building:'buildings', floor:'floors', address:'addresses',
        emptype:'employee-types', attendance:'attendance-types', team:'teams', unit:'meter-units',
        residence:'residence-statuses', employment:'employment-statuses' };

    function escapeHtml(s) { return s == null ? '' : String(s).replace(/[&<>"']/g, c => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[c])); }
    function formatDate(d) { if (!d) return '-'; return new Date(d).toLocaleString('zh-CN', { hour12: false }); }

    function showAddModal(type) {
        currentType = type; currentId = null;
        document.getElementById('editModalTitle').textContent = '新增';
        document.getElementById('editId').value = '';
        document.getElementById('editCode').value = '';
        document.getElementById('editName').value = '';
        document.getElementById('editHours').value = '';
        document.getElementById('editSort').value = '0';   // v2.13.161 默认 0
        document.getElementById('editRemark').value = '';
        document.getElementById('editActive').checked = true;
        const showCode = ['dept','emptype','attendance','unit','residence','employment','team'].includes(type);
        document.getElementById('codeField').style.display = showCode ? 'block' : 'none';
        document.getElementById('hoursField').style.display = type === 'attendance' ? 'block' : 'none';
        // v2.13.161：员工班组编辑/新增显示排序号输入框
        document.getElementById('sortField').style.display = type === 'team' ? 'block' : 'none';
        document.getElementById('nameLabel').textContent = labelMap[typeToApi[type]] || '名称';
        new bootstrap.Modal(document.getElementById('editModal')).show();
    }

    async function editItem(type, id) {
        currentType = type; currentId = id;
        const apiType = typeToApi[type];
        try {
            const resp = await fetch(`${API_BASE}/${apiType}/${id}`);
            const result = await resp.json();
            if (result.success) {
                const data = result.data;
                document.getElementById('editModalTitle').textContent = '编辑';
                document.getElementById('editId').value = id;
                document.getElementById('editCode').value = data.code || '';
                document.getElementById('editName').value = data.name || data.floorNo || data.addressText || '';
                document.getElementById('editHours').value = data.workHours || '';
                // v2.13.161：编辑班组时回显排序号
                document.getElementById('editSort').value = data.sortOrder ?? 0;
                document.getElementById('editRemark').value = data.remark || '';
                document.getElementById('editActive').checked = data.isActive;
                document.getElementById('codeField').style.display = ['dept','emptype','attendance','unit','residence','employment','team'].includes(type) ? 'block' : 'none';
                document.getElementById('hoursField').style.display = type === 'attendance' ? 'block' : 'none';
                document.getElementById('sortField').style.display = type === 'team' ? 'block' : 'none';
                document.getElementById('nameLabel').textContent = labelMap[typeToApi[type]] || '名称';
                new bootstrap.Modal(document.getElementById('editModal')).show();
            }
        } catch (err) { console.error('获取数据失败:', err); }
    }

    async function deleteItem(type, id) {
        if (!confirm('确定删除该记录吗？')) return;
        try {
            const resp = await fetch(`${API_BASE}/${typeToApi[type]}/${id}`, { method: 'DELETE' });
            const result = await resp.json();
            if (result.success) { alert('删除成功'); location.reload(); } else alert(result.message || '删除失败');
        } catch (err) { console.error('删除失败:', err); }
    }

    async function saveData() {
        const name = document.getElementById('editName').value.trim();
        if (!name) { alert('请输入名称'); return; }
        const apiType = typeToApi[currentType];
        const id = document.getElementById('editId').value;
        let payload = { name: name };
        if (['dept','emptype','attendance','unit','residence','employment','team'].includes(currentType)) payload.code = document.getElementById('editCode').value.trim();
        if (currentType === 'floor') payload.floorNo = parseInt(name);
        if (currentType === 'address') payload.addressText = name;
        payload.remark = document.getElementById('editRemark').value.trim();
        payload.isActive = document.getElementById('editActive').checked;
        if (currentType === 'attendance') payload.workHours = document.getElementById('editHours').value.trim();
        // v2.13.161：员工班组保存时携带 sortOrder
        if (currentType === 'team') {
            const sortVal = parseInt(document.getElementById('editSort').value);
            payload.sortOrder = isNaN(sortVal) ? 0 : sortVal;
        }
        try {
            const resp = id
                ? await fetch(`${API_BASE}/${apiType}/${id}`, { method: 'PUT', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
                : await fetch(`${API_BASE}/${apiType}`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            const result = await resp.json();
            if (result.success) { bootstrap.Modal.getInstance(document.getElementById('editModal')).hide(); alert('保存成功'); location.reload(); } else alert(result.message || '保存失败');
        } catch (err) { console.error('保存失败:', err); }
    }

    // 设备档案
    async function showDeviceAddModal() {
        document.getElementById('deviceId').value = '0';
        document.getElementById('deviceDormId').value = '';
        document.getElementById('deviceElectric').value = '';
        document.getElementById('deviceCold').value = '';
        document.getElementById('deviceHot').value = '';
        document.getElementById('deviceRemark').value = '';
        document.getElementById('deviceModalTitle').innerHTML = '<i class="bi bi-cpu text-success"></i> 新增设备档案';
        new bootstrap.Modal(document.getElementById('deviceModal')).show();
    }
    async function showDeviceEditModal(id) {
        try {
            const resp = await fetch(`/api/basics/device-meters/${id}`);
            const result = await resp.json();
            if (!result.success) { alert(result.message || '加载失败'); return; }
            const it = result.data;
            document.getElementById('deviceId').value = it.id;
            document.getElementById('deviceDormId').value = it.dormId;
            document.getElementById('deviceElectric').value = it.electricMeterId || '';
            document.getElementById('deviceCold').value = it.coldWaterMeterId || '';
            document.getElementById('deviceHot').value = it.hotWaterMeterId || '';
            document.getElementById('deviceRemark').value = it.remark || '';
            document.getElementById('deviceModalTitle').innerHTML = '<i class="bi bi-pencil-square text-primary"></i> 编辑设备档案 #' + it.id;
            new bootstrap.Modal(document.getElementById('deviceModal')).show();
        } catch (err) { console.error('加载失败:', err); }
    }
    async function saveDeviceMeter() {
        const id = parseInt(document.getElementById('deviceId').value || '0');
        const dormId = parseInt(document.getElementById('deviceDormId').value || '0');
        if (!dormId) { alert('请选择房号'); return; }
        const payload = { id, dormId,
            electricMeterId: document.getElementById('deviceElectric').value.trim(),
            coldWaterMeterId: document.getElementById('deviceCold').value.trim(),
            hotWaterMeterId: document.getElementById('deviceHot').value.trim(),
            remark: document.getElementById('deviceRemark').value.trim() };
        try {
            const url = id > 0 ? `/api/basics/device-meters/${id}` : '/api/basics/device-meters';
            const method = id > 0 ? 'PUT' : 'POST';
            const resp = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            const result = await resp.json();
            if (result.success) { bootstrap.Modal.getInstance(document.getElementById('deviceModal')).hide(); location.reload(); } else alert(result.message || '保存失败');
        } catch (err) { alert('保存失败：' + err.message); }
    }
    async function deleteDeviceMeter(id, code) {
        if (!confirm(`确定删除设备档案「${code}」吗？此操作不可恢复。`)) return;
        try {
            const resp = await fetch(`/api/basics/device-meters/${id}`, { method: 'DELETE' });
            const result = await resp.json();
            if (result.success) location.reload(); else alert(result.message || '删除失败');
        } catch (err) { alert('删除失败：' + err.message); }
    }

    // 设备记录
    function showAddEquipmentReadingModal() {
        document.getElementById('equipmentReadingModalTitle').innerHTML = '<i class="bi bi-journal-text text-success"></i> 新增设备记录';
        document.getElementById('eqReadingId').value = '0';
        document.getElementById('eqReadingEquipmentId').value = '';
        document.getElementById('eqReadingEquipmentType').value = '1';
        document.getElementById('eqReadingReading').value = '';
        const now = new Date();
        const localISO = new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
        document.getElementById('eqReadingReadTime').value = localISO;
        document.getElementById('eqReadingRemark').value = '';
        new bootstrap.Modal(document.getElementById('equipmentReadingModal')).show();
    }
    async function showEditEquipmentReadingModal(id) {
        try {
            const resp = await fetch(`/api/basics/equipment-readings/${id}`);
            const result = await resp.json();
            if (!result.success) { alert(result.message || '加载失败'); return; }
            const r = result.data;
            document.getElementById('equipmentReadingModalTitle').innerHTML = '<i class="bi bi-pencil-square text-primary"></i> 编辑设备记录';
            document.getElementById('eqReadingId').value = r.id;
            document.getElementById('eqReadingEquipmentId').value = r.equipmentId || '';
            document.getElementById('eqReadingEquipmentType').value = r.equipmentType;
            document.getElementById('eqReadingReading').value = r.reading;
            const rt = new Date(r.readTime);
            document.getElementById('eqReadingReadTime').value = new Date(rt.getTime() - rt.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
            document.getElementById('eqReadingRemark').value = r.remark || '';
            new bootstrap.Modal(document.getElementById('equipmentReadingModal')).show();
        } catch (err) { alert('加载失败：' + err.message); }
    }
    async function saveEquipmentReading() {
        const id = parseInt(document.getElementById('eqReadingId').value || '0');
        const equipmentId = document.getElementById('eqReadingEquipmentId').value.trim();
        const equipmentType = parseInt(document.getElementById('eqReadingEquipmentType').value);
        const reading = parseFloat(document.getElementById('eqReadingReading').value);
        const readTimeStr = document.getElementById('eqReadingReadTime').value;
        const remark = document.getElementById('eqReadingRemark').value.trim();
        if (!equipmentId) { alert('设备ID不能为空'); return; }
        if (!equipmentType) { alert('请选择设备类型'); return; }
        if (isNaN(reading) || reading < 0) { alert('请输入有效的读数（≥ 0）'); return; }
        if (!readTimeStr) { alert('请选择读取时间'); return; }
        const payload = { id, equipmentId, equipmentType, reading, readTime: new Date(readTimeStr).toISOString(), remark };
        const method = id > 0 ? 'PUT' : 'POST';
        const url = id > 0 ? `/api/basics/equipment-readings/${id}` : '/api/basics/equipment-readings';
        try {
            const resp = await fetch(url, { method, headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
            const result = await resp.json();
            if (result.success) { bootstrap.Modal.getInstance(document.getElementById('equipmentReadingModal')).hide(); location.reload(); } else alert(result.message || '保存失败');
        } catch (err) { alert('保存失败：' + err.message); }
    }
    async function deleteEquipmentReading(id) {
        if (!confirm('确认删除该设备记录？此操作不可撤销。')) return;
        try {
            const resp = await fetch(`/api/basics/equipment-readings/${id}`, { method: 'DELETE' });
            const result = await resp.json();
            if (result.success) location.reload(); else alert(result.message || '删除失败');
        } catch (err) { alert('删除失败：' + err.message); }
    }
    function showBatchDeleteEquipmentReadingModal() {
        document.getElementById('batchDelStartTime').value = '';
        document.getElementById('batchDelEndTime').value = '';
        document.getElementById('batchDelConfirm').checked = false;
        document.getElementById('batchDeleteConfirmBtn').disabled = true;
        new bootstrap.Modal(document.getElementById('batchDeleteEquipmentReadingModal')).show();
    }
    document.addEventListener('change', e => {
        if (['batchDelConfirm','batchDelStartTime','batchDelEndTime'].includes(e.target.id)) {
            const start = document.getElementById('batchDelStartTime').value;
            const end = document.getElementById('batchDelEndTime').value;
            const confirmed = document.getElementById('batchDelConfirm').checked;
            document.getElementById('batchDeleteConfirmBtn').disabled = !(start && end && confirmed);
        }
    });
    async function confirmBatchDeleteEquipmentReadings() {
        const start = document.getElementById('batchDelStartTime').value;
        const end = document.getElementById('batchDelEndTime').value;
        if (!start || !end) { alert('请填写完整的起始时间和结束时间'); return; }
        if (new Date(start) > new Date(end)) { alert('起始时间必须早于或等于结束时间'); return; }
        try {
            const resp = await fetch('/api/basics/equipment-readings/batch-delete', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ startTime: new Date(start).toISOString(), endTime: new Date(end).toISOString() })
            });
            const result = await resp.json();
            if (result.success) { bootstrap.Modal.getInstance(document.getElementById('batchDeleteEquipmentReadingModal')).hide(); alert(result.message || `批量删除成功，共删除 ${result.data || 0} 条记录`); location.reload(); } else alert(result.message || '批量删除失败');
        } catch (err) { alert('批量删除失败：' + err.message); }
    }
</script>
}
