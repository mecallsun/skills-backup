@page
@model DormManage.Admin.Pages.Basics.IndexModel
@{
    ViewData["Title"] = "基础资料";
    Layout = "_Layout";
    // v2.13.158 设备档案按钮权限
    var deviceCanEdit = (await Html.HasPermissionAsync("device:edit")).ToString().ToLower();
    var deviceCanDelete = (await Html.HasPermissionAsync("device:delete")).ToString().ToLower();
    // v2.13.158 设备记录按钮权限
    var erCanEdit = (await Html.HasPermissionAsync("equipment-reading:edit")).ToString().ToLower();
    var erCanDelete = (await Html.HasPermissionAsync("equipment-reading:delete")).ToString().ToLower();
}

<div class="container-fluid">
    <!-- 页头（v2.13.158 与 Personnel 页头规范一致） -->
    <div class="page-header">
        <h2>
            <i class="bi bi-database header-icon"></i> 基础资料
            <span class="header-count">@Model.CurrentTabTotalCount 条记录</span>
        </h2>
    </div>

    <div style="display: flex; align-items: flex-start; gap: 12px;">
        <!-- 左侧导航（200px） -->
        <div style="flex-shrink: 0; width: 200px;">
            <div class="card">
                <div class="card-body p-2">
                    <div class="nav flex-column nav-pills basics-nav" role="tablist">
                        @{
                            string[] tabs = { "dept", "building", "floor", "address", "emptype",
                                "attendance", "team", "unit", "residence", "employment",
                                "device", "equipmentreading" };
                            var labels = new Dictionary<string, string> {
                                {"dept","部门管理"},{"building","楼栋管理"},{"floor","楼层管理"},
                                {"address","地址管理"},{"emptype","员工类型"},{"attendance","班次"},
                                {"team","员工班组"},{"unit","计量单位"},{"residence","住宿状态"},
                                {"employment","在职状态"},{"device","设备档案"},{"equipmentreading","设备记录"}
                            };
                            var icons = new Dictionary<string, string> {
                                {"dept","bi-building"},{"building","bi-geo-alt"},{"floor","bi-layers"},
                                {"address","bi-pin-map"},{"emptype","bi-person-badge"},{"attendance","bi-clock-history"},
                                {"team","bi-people-fill"},{"unit","bi-speedometer2"},{"residence","bi-house-door"},
                                {"employment","bi-person-check"},{"device","bi-cpu"},{"equipmentreading","bi-journal-text"}
                            };
                            string UrlWithTab(string t) => Url.Page("/Basics/Index", new {
                                tab = t, page = 1, pageSize = Model.PageSize, kw = Model.Keyword,
                                type = Model.EquipmentType, start = Model.StartTime, end = Model.EndTime
                            });
                        }
                        @foreach (var t in tabs)
                        {
                            <a class="nav-link text-start @(Model.ActiveTab == t ? "active" : "")"
                               href="@UrlWithTab(t)">
                                <i class="bi @icons[t]"></i> @labels[t]
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- 右侧内容 -->
        <div style="flex: 1 1 0%;">
            <!-- 部门管理（默认 tab） -->
            @if (Model.ActiveTab == "dept")
            {
                <div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-building"></i> 部门列表</h5>
                        <button class="btn btn-success" onclick="showAddModal('dept')">
                            <i class="bi bi-plus-lg"></i> 新增部门
                        </button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr><th width="60">序号</th><th>部门编码</th><th>部门名称</th><th>备注</th><th width="100">状态</th><th width="120">操作</th></tr>
                            </thead>
                            <tbody>
                            @for (int i = 0; i < Model.Departments.Count; i++)
                            {
                                var it = Model.Departments[i];
                                var status = it.IsActive ? "<span class='badge bg-success'>启用</span>" : "<span class='badge bg-secondary'>停用</span>";
                                <tr>
                                    <td>@((Model.PageIndex - 1) * Model.PageSize + i + 1)</td>
                                    <td><code>@it.Code</code></td>
                                    <td>@it.Name</td>
                                    <td>@(it.Remark ?? "-")</td>
                                    <td>@Html.Raw(status)</td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" onclick="editItem('dept', @it.Id)">编辑</button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="deleteItem('dept', @it.Id)">删除</button>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    @await Html.PartialAsync("../Shared/_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel {
                        PageIndex = Model.PageIndex, PageSize = Model.PageSize, TotalCount = Model.DepartmentsCount
                    })
                </div></div>
            }
            @* 其它 11 个 tab 结构与部门管理完全一致，仅数据源不同；详见下方 Razor 块 *@
            @if (Model.ActiveTab == "building")
            {
                <div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-geo-alt"></i> 楼栋列表</h5>
                        <button class="btn btn-success" onclick="showAddModal('building')"><i class="bi bi-plus-lg"></i> 新增楼栋</button>
                    </div>
                    <div class="table-responsive"><table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th width="60">序号</th><th>楼栋名称</th><th>备注</th><th width="100">状态</th><th width="120">操作</th></tr></thead>
                        <tbody>
                        @for (int i = 0; i < Model.Buildings.Count; i++) { var it = Model.Buildings[i]; var st = it.IsActive ? "<span class='badge bg-success'>启用</span>" : "<span class='badge bg-secondary'>停用</span>";
                            <tr><td>@((Model.PageIndex - 1) * Model.PageSize + i + 1)</td><td>@it.Name</td><td>@(it.Remark ?? "-")</td><td>@Html.Raw(st)</td>
                            <td><button class="btn btn-sm btn-outline-primary" onclick="editItem('building', @it.Id)">编辑</button><button class="btn btn-sm btn-outline-danger" onclick="deleteItem('building', @it.Id)">删除</button></td></tr>}
                        </tbody></table></div>
                    @await Html.PartialAsync("../Shared/_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel {
                        PageIndex = Model.PageIndex, PageSize = Model.PageSize, TotalCount = Model.BuildingsCount
                    })
                </div></div>
            }

            @if (Model.ActiveTab == "floor")
            {
                <div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-layers"></i> 楼层列表</h5>
                        <button class="btn btn-success" onclick="showAddModal('floor')"><i class="bi bi-plus-lg"></i> 新增楼层</button>
                    </div>
                    <div class="table-responsive"><table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th width="60">序号</th><th>楼层</th><th>备注</th><th width="100">状态</th><th width="120">操作</th></tr></thead>
                        <tbody>
                        @for (int i = 0; i < Model.Floors.Count; i++) { var it = Model.Floors[i]; var st = it.IsActive ? "<span class='badge bg-success'>启用</span>" : "<span class='badge bg-secondary'>停用</span>";
                            <tr><td>@((Model.PageIndex - 1) * Model.PageSize + i + 1)</td><td>@it.FloorNo 楼</td><td>@(it.Remark ?? "-")</td><td>@Html.Raw(st)</td>
                            <td><button class="btn btn-sm btn-outline-primary" onclick="editItem('floor', @it.Id)">编辑</button><button class="btn btn-sm btn-outline-danger" onclick="deleteItem('floor', @it.Id)">删除</button></td></tr>}
                        </tbody></table></div>
                    @await Html.PartialAsync("../Shared/_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel {
                        PageIndex = Model.PageIndex, PageSize = Model.PageSize, TotalCount = Model.FloorsCount
                    })
                </div></div>
            }

            @if (Model.ActiveTab == "address")
            {
                <div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-pin-map"></i> 地址列表</h5>
                        <button class="btn btn-success" onclick="showAddModal('address')"><i class="bi bi-plus-lg"></i> 新增地址</button>
                    </div>
                    <div class="table-responsive"><table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th width="60">序号</th><th>地址</th><th>备注</th><th width="100">状态</th><th width="120">操作</th></tr></thead>
                        <tbody>
                        @for (int i = 0; i < Model.Addresses.Count; i++) { var it = Model.Addresses[i]; var st = it.IsActive ? "<span class='badge bg-success'>启用</span>" : "<span class='badge bg-secondary'>停用</span>";
                            <tr><td>@((Model.PageIndex - 1) * Model.PageSize + i + 1)</td><td>@it.AddressText</td><td>@(it.Remark ?? "-")</td><td>@Html.Raw(st)</td>
                            <td><button class="btn btn-sm btn-outline-primary" onclick="editItem('address', @it.Id)">编辑</button><button class="btn btn-sm btn-outline-danger" onclick="deleteItem('address', @it.Id)">删除</button></td></tr>}
                        </tbody></table></div>
                    @await Html.PartialAsync("../Shared/_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel {
                        PageIndex = Model.PageIndex, PageSize = Model.PageSize, TotalCount = Model.AddressesCount
                    })
                </div></div>
            }

            @if (Model.ActiveTab == "emptype")
            {
                <div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-person-badge"></i> 员工类型列表</h5>
                        <button class="btn btn-success" onclick="showAddModal('emptype')"><i class="bi bi-plus-lg"></i> 新增类型</button>
                    </div>
                    <div class="table-responsive"><table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th width="60">序号</th><th>类型编码</th><th>类型名称</th><th>备注</th><th width="100">状态</th><th width="120">操作</th></tr></thead>
                        <tbody>
                        @for (int i = 0; i < Model.EmployeeTypes.Count; i++) { var it = Model.EmployeeTypes[i]; var st = it.IsActive ? "<span class='badge bg-success'>启用</span>" : "<span class='badge bg-secondary'>停用</span>";
                            <tr><td>@((Model.PageIndex - 1) * Model.PageSize + i + 1)</td><td><code>@it.Code</code></td><td>@it.Name</td><td>@(it.Remark ?? "-")</td><td>@Html.Raw(st)</td>
                            <td><button class="btn btn-sm btn-outline-primary" onclick="editItem('emptype', @it.Id)">编辑</button><button class="btn btn-sm btn-outline-danger" onclick="deleteItem('emptype', @it.Id)">删除</button></td></tr>}
                        </tbody></table></div>
                    @await Html.PartialAsync("../Shared/_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel {
                        PageIndex = Model.PageIndex, PageSize = Model.PageSize, TotalCount = Model.EmployeeTypesCount
                    })
                </div></div>
            }

            @if (Model.ActiveTab == "attendance")
            {
                <div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-clock-history"></i> 班次列表</h5>
                        <button class="btn btn-success" onclick="showAddModal('attendance')"><i class="bi bi-plus-lg"></i> 新增班次</button>
                    </div>
                    <div class="table-responsive"><table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th width="60">序号</th><th>类型编码</th><th>类型名称</th><th>工作时段</th><th>备注</th><th width="100">状态</th><th width="120">操作</th></tr></thead>
                        <tbody>
                        @for (int i = 0; i < Model.AttendanceTypes.Count; i++) { var it = Model.AttendanceTypes[i]; var st = it.IsActive ? "<span class='badge bg-success'>启用</span>" : "<span class='badge bg-secondary'>停用</span>";
                            <tr><td>@((Model.PageIndex - 1) * Model.PageSize + i + 1)</td><td><code>@it.Code</code></td><td>@it.Name</td><td>@(it.WorkHours ?? "-")</td><td>@(it.Remark ?? "-")</td><td>@Html.Raw(st)</td>
                            <td><button class="btn btn-sm btn-outline-primary" onclick="editItem('attendance', @it.Id)">编辑</button><button class="btn btn-sm btn-outline-danger" onclick="deleteItem('attendance', @it.Id)">删除</button></td></tr>}
                        </tbody></table></div>
                    @await Html.PartialAsync("../Shared/_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel {
                        PageIndex = Model.PageIndex, PageSize = Model.PageSize, TotalCount = Model.AttendanceTypesCount
                    })
                </div></div>
            }

            @if (Model.ActiveTab == "team")
            {
                <div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-people-fill"></i> 员工班组列表</h5>
                        <button class="btn btn-success" onclick="showAddModal('team')"><i class="bi bi-plus-lg"></i> 新增班组</button>
                    </div>
                    <div class="table-responsive"><table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th width="60">序号</th><th>班组编码</th><th>班组名称</th><th>排序号</th><th>备注</th><th width="100">状态</th><th width="120">操作</th></tr></thead>
                        <tbody>
                        @for (int i = 0; i < Model.Teams.Count; i++) { var it = Model.Teams[i]; var st = it.IsActive ? "<span class='badge bg-success'>启用</span>" : "<span class='badge bg-secondary'>停用</span>";
                            <tr><td>@((Model.PageIndex - 1) * Model.PageSize + i + 1)</td><td><code>@(it.Code ?? "-")</code></td><td>@it.Name</td><td>@it.SortOrder</td><td>—</td><td>@Html.Raw(st)</td>
                            <td><button class="btn btn-sm btn-outline-primary" onclick="editItem('team', @it.Id)">编辑</button><button class="btn btn-sm btn-outline-danger" onclick="deleteItem('team', @it.Id)">删除</button></td></tr>}
                        </tbody></table></div>
                    @await Html.PartialAsync("../Shared/_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel {
                        PageIndex = Model.PageIndex, PageSize = Model.PageSize, TotalCount = Model.TeamsCount
                    })
                </div></div>
            }

            @if (Model.ActiveTab == "unit")
            {
                <div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-speedometer2"></i> 计量单位列表</h5>
                        <button class="btn btn-success" onclick="showAddModal('unit')"><i class="bi bi-plus-lg"></i> 新增单位</button>
                    </div>
                    <div class="table-responsive"><table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th width="60">序号</th><th>单位编码</th><th>单位名称</th><th>显示单位</th><th>备注</th><th width="100">状态</th><th width="120">操作</th></tr></thead>
                        <tbody>
                        @for (int i = 0; i < Model.MeterUnits.Count; i++) { var it = Model.MeterUnits[i]; var st = it.IsActive ? "<span class='badge bg-success'>启用</span>" : "<span class='badge bg-secondary'>停用</span>";
                            <tr><td>@((Model.PageIndex - 1) * Model.PageSize + i + 1)</td><td><code>@it.Code</code></td><td>@it.Name</td><td>@(it.Unit ?? "-")</td><td>@(it.Remark ?? "-")</td><td>@Html.Raw(st)</td>
                            <td><button class="btn btn-sm btn-outline-primary" onclick="editItem('unit', @it.Id)">编辑</button><button class="btn btn-sm btn-outline-danger" onclick="deleteItem('unit', @it.Id)">删除</button></td></tr>}
                        </tbody></table></div>
                    @await Html.PartialAsync("../Shared/_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel {
                        PageIndex = Model.PageIndex, PageSize = Model.PageSize, TotalCount = Model.MeterUnitsCount
                    })
                </div></div>
            }

            @if (Model.ActiveTab == "residence")
            {
                <div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-house-door"></i> 住宿状态列表</h5>
                        <button class="btn btn-success" onclick="showAddModal('residence')"><i class="bi bi-plus-lg"></i> 新增状态</button>
                    </div>
                    <div class="table-responsive"><table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th width="60">序号</th><th>状态编码</th><th>状态名称</th><th>备注</th><th width="100">状态</th><th width="120">操作</th></tr></thead>
                        <tbody>
                        @for (int i = 0; i < Model.ResidenceStatuses.Count; i++) { var it = Model.ResidenceStatuses[i]; var st = it.IsActive ? "<span class='badge bg-success'>启用</span>" : "<span class='badge bg-secondary'>停用</span>";
                            <tr><td>@((Model.PageIndex - 1) * Model.PageSize + i + 1)</td><td><code>@it.Code</code></td><td>@it.Name</td><td>@(it.Remark ?? "-")</td><td>@Html.Raw(st)</td>
                            <td><button class="btn btn-sm btn-outline-primary" onclick="editItem('residence', @it.Id)">编辑</button><button class="btn btn-sm btn-outline-danger" onclick="deleteItem('residence', @it.Id)">删除</button></td></tr>}
                        </tbody></table></div>
                    @await Html.PartialAsync("../Shared/_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel {
                        PageIndex = Model.PageIndex, PageSize = Model.PageSize, TotalCount = Model.ResidenceStatusesCount
                    })
                </div></div>
            }

            @if (Model.ActiveTab == "employment")
            {
                <div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-person-check"></i> 在职状态列表</h5>
                        <button class="btn btn-success" onclick="showAddModal('employment')"><i class="bi bi-plus-lg"></i> 新增状态</button>
                    </div>
                    <div class="table-responsive"><table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th width="60">序号</th><th>状态编码</th><th>状态名称</th><th>备注</th><th width="100">状态</th><th width="120">操作</th></tr></thead>
                        <tbody>
                        @for (int i = 0; i < Model.EmploymentStatuses.Count; i++) { var it = Model.EmploymentStatuses[i]; var st = it.IsActive ? "<span class='badge bg-success'>启用</span>" : "<span class='badge bg-secondary'>停用</span>";
                            <tr><td>@((Model.PageIndex - 1) * Model.PageSize + i + 1)</td><td><code>@it.Code</code></td><td>@it.Name</td><td>@(it.Remark ?? "-")</td><td>@Html.Raw(st)</td>
                            <td><button class="btn btn-sm btn-outline-primary" onclick="editItem('employment', @it.Id)">编辑</button><button class="btn btn-sm btn-outline-danger" onclick="deleteItem('employment', @it.Id)">删除</button></td></tr>}
                        </tbody></table></div>
                    @await Html.PartialAsync("../Shared/_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel {
                        PageIndex = Model.PageIndex, PageSize = Model.PageSize, TotalCount = Model.EmploymentStatusesCount
                    })
                </div></div>
            }

            <!-- ========== 设备档案（v2.13.120 起，第 11 个 tab）============= -->
            @if (Model.ActiveTab == "device")
            {
                <div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-cpu"></i> 设备档案列表</h5>
                        @if (await Html.HasPermissionAsync("device:create"))
                        {
                            <button class="btn btn-success" onclick="showDeviceAddModal()"><i class="bi bi-plus-lg"></i> 新增设备档案</button>
                        }
                    </div>
                    <div class="table-responsive"><table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th width="60">序号</th><th>房号</th><th>楼栋</th><th>楼层</th><th>电表ID</th><th>冷水ID</th><th>热水ID</th><th>备注</th><th>更新时间</th><th width="150">操作</th></tr></thead>
                        <tbody>
                        @for (int i = 0; i < Model.DeviceMeters.Count; i++) { var it = Model.DeviceMeters[i];
                            <tr><td class="text-muted">@((Model.PageIndex - 1) * Model.PageSize + i + 1)</td>
                            <td><strong>@it.DormCode</strong></td><td>@(it.BuildingName ?? "-")</td><td>@it.FloorNo 楼</td>
                            <td>@(it.ElectricMeterId ?? "-")</td><td>@(it.ColdWaterMeterId ?? "-")</td><td>@(it.HotWaterMeterId ?? "-")</td>
                            <td><small>@(it.Remark ?? "")</small></td>
                            <td><small class="text-muted">@it.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</small></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" onclick="showDeviceEditModal(@it.Id)">修改</button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteDeviceMeter(@it.Id, '@it.DormCode')">删除</button>
                            </td></tr>}
                        </tbody></table></div>
                    @await Html.PartialAsync("../Shared/_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel {
                        PageIndex = Model.PageIndex, PageSize = Model.PageSize, TotalCount = Model.DeviceMetersCount
                    })
                </div></div>
            }

            <!-- ========== 设备记录（v2.13.130 起，第 12 个 tab）============ -->
            @if (Model.ActiveTab == "equipmentreading")
            {
                <div class="card"><div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-journal-text"></i> 设备记录列表</h5>
                        <div class="d-flex gap-2">
                            @if (await Html.HasPermissionAsync("equipment-reading:batch-delete")) { <button class="btn btn-warning" onclick="showBatchDeleteEquipmentReadingModal()"><i class="bi bi-trash3"></i> 批量删除</button> }
                            @if (await Html.HasPermissionAsync("equipment-reading:create")) { <button class="btn btn-success" onclick="showAddEquipmentReadingModal()"><i class="bi bi-plus-lg"></i> 新增设备记录</button> }
                        </div>
                    </div>
                    <div class="table-responsive"><table class="table table-hover mb-0">
                        <thead class="table-light"><tr><th width="60">序号</th><th>设备ID</th><th>设备类型</th><th>读数</th><th>读取时间</th><th>备注</th><th>创建人</th><th width="150">操作</th></tr></thead>
                        <tbody>
                        @for (int i = 0; i < Model.EquipmentReadings.Count; i++) { var r = Model.EquipmentReadings[i];
                            var typeBadge = r.EquipmentType switch { 1 => "⚡ 电表", 2 => "💧 冷水", 3 => "♨️ 热水", _ => "未知" };
                            <tr><td class="text-muted">@((Model.PageIndex - 1) * Model.PageSize + i + 1)</td>
                            <td><strong>@r.EquipmentId</strong></td>
                            <td>@typeBadge</td>
                            <td>@(r.Reading.ToString("0.00"))</td>
                            <td><small>@(r.ReadTime.ToString("yyyy-MM-dd HH:mm"))</small></td>
                            <td><small>@(r.Remark ?? "—")</small></td>
                            <td><small>@(r.CreatedBy ?? "—")</small></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary" onclick="showEditEquipmentReadingModal(@r.Id)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" onclick="deleteEquipmentReading(@r.Id)"><i class="bi bi-trash"></i></button>
                            </td></tr>}
                        </tbody></table></div>
                    @await Html.PartialAsync("../Shared/_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel {
                        PageIndex = Model.PageIndex, PageSize = Model.PageSize, TotalCount = Model.EquipmentReadingsCount
                    })
                </div></div>
            }
        </div>
    </div>
</div>

@* =================== 新增/编辑 Modal（保留 AJAX 行为） ================ *@
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="editModalTitle">新增</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editId" />
                <div class="mb-3" id="codeField" style="display:none;"><label class="form-label">编码</label><input type="text" class="form-control" id="editCode" /></div>
                <div class="mb-3"><label class="form-label" id="nameLabel">名称</label><input type="text" class="form-control" id="editName" /></div>
                <div class="mb-3" id="hoursField" style="display:none;"><label class="form-label">工作时段</label><input type="text" class="form-control" id="editHours" placeholder="如 09:00-18:00" /></div>
                <div class="mb-3" id="sortField" style="display:none;"><label class="form-label">排序号</label><input type="number" class="form-control" id="editSort" value="0" min="0" step="1" /><small class="form-text text-muted">数字越小越靠前（默认 0 = 末尾）</small></div>
                <div class="mb-3"><label class="form-label">备注</label><textarea class="form-control" id="editRemark" rows="2"></textarea></div>
                <div class="mb-3"><div class="form-check"><input class="form-check-input" type="checkbox" id="editActive" checked /><label class="form-check-label" for="editActive">启用</label></div></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="saveData()">保存</button>
            </div>
        </div>
    </div>
</div>

@* ============ 设备档案 Modal ============ *@
<div class="modal fade" id="deviceModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header py-2"><h5 class="modal-title" id="deviceModalTitle"><i class="bi bi-cpu text-success"></i> 新增设备档案</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <input type="hidden" id="deviceId" value="0" />
            <div class="mb-3"><label class="form-label">房号 <span class="text-danger">*</span></label>
                <select id="deviceDormId" class="form-select"><option value="">— 请选择房号 —</option>
                @foreach (var d in Model.DormOptions) { var tag = d.HasDevice ? "（已配置）" : ""; <option value="@d.DormId">@d.BuildingName / @(d.FloorNo)楼 / @d.DormCode @tag</option> }
                </select></div>
            <div class="row g-2">
                <div class="col-md-4"><label class="form-label">电表 ID</label><input type="text" id="deviceElectric" class="form-control" maxlength="64" /></div>
                <div class="col-md-4"><label class="form-label">冷水表 ID</label><input type="text" id="deviceCold" class="form-control" maxlength="64" /></div>
                <div class="col-md-4"><label class="form-label">热水表 ID</label><input type="text" id="deviceHot" class="form-control" maxlength="64" /></div>
            </div>
            <div class="mt-2"><label class="form-label">备注</label><textarea id="deviceRemark" class="form-control" rows="2" maxlength="500"></textarea></div>
        </div>
        <div class="modal-footer py-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
            <button type="button" class="btn btn-primary" onclick="saveDeviceMeter()"><i class="bi bi-check-lg"></i> 保存</button>
        </div>
    </div></div>
</div>

@* ============ 设备记录 Modal ============ *@
<div class="modal fade" id="equipmentReadingModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg"><div class="modal-content">
        <div class="modal-header py-2"><h5 class="modal-title" id="equipmentReadingModalTitle"><i class="bi bi-journal-text text-success"></i> 新增设备记录</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <input type="hidden" id="eqReadingId" value="0" />
            <div class="row g-2">
                <div class="col-md-6"><label class="form-label">设备ID <span class="text-danger">*</span></label><input type="text" id="eqReadingEquipmentId" class="form-control" maxlength="64" placeholder="如 EL-001" /></div>
                <div class="col-md-6"><label class="form-label">设备类型 <span class="text-danger">*</span></label><select id="eqReadingEquipmentType" class="form-select"><option value="1">⚡ 电表</option><option value="2">💧 冷水</option><option value="3">♨️ 热水</option></select></div>
            </div>
            <div class="row g-2 mt-1">
