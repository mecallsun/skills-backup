@using DormManage.Admin.Extensions
@using Microsoft.AspNetCore.Http.Extensions
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@{
    var httpContext = HttpContextAccessor.HttpContext;
    var userId = httpContext?.GetCurrentUserId() ?? 0;
    var userName = httpContext?.User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "用户";
    var displayName = httpContext?.User.FindFirst("DisplayName")?.Value ?? userName;
    var roles = httpContext?.GetRoles() ?? new List<string>();
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context);
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 金戈宿舍管理系统</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    @await RenderSectionAsync("Styles", required: false)
    <style>
        body { font-family: "Microsoft YaHei UI", sans-serif; background: #f5f7fa; }
        .navbar-brand { font-weight: bold; color: #1976d2 !important; }
        .sidebar { background: #fff; min-height: calc(100vh - 56px); border-right: 1px solid #e0e0e0; }
        .nav-link { color: #333; border-radius: 6px; margin: 2px 8px; }
        .nav-link:hover { background: #e3f2fd; color: #1976d2; }
        .nav-link.active { background: #1976d2; color: #fff !important; }
        .nav-item i { width: 20px; text-align: center; margin-right: 6px; }
        .cat-blue { color: #1976d2; }
        .cat-green { color: #388e3c; }
        .cat-orange { color: #f57c00; }
        .cat-settings { color: #6c757d; }
        .main-content { padding: 20px; }
        .user-menu { cursor: pointer; }
        @@media (max-width: 768px) {
            .sidebar { min-height: auto; }
        }
    </style>
</head>
<body>
    <!-- 顶部导航栏 -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="background: #1976d2;">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="bi bi-house-door"></i> 金戈宿舍管理系统
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <!-- 动态菜单：按权限渲染 -->
                @await Component.InvokeAsync("Menu")
                <!-- 右侧用户菜单 -->
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link user-menu dropdown-toggle" href="#" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle"></i> @displayName
                            @if (roles.Any())
                            {
                                <span class="badge bg-light text-dark ms-1">@roles.First()</span>
                            }
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text text-muted small">
                                <i class="bi bi-shield-lock me-1"></i> 角色: @(string.Join(", ", roles))
                            </span></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="/Settings"><i class="bi bi-gear me-2"></i>系统设置</a></li>
                            <li><a class="dropdown-item" href="/Account/Logout"><i class="bi bi-box-arrow-right me-2"></i>退出登录</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- 页面内容 -->
    <div class="main-content">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <!-- v2.13.11 全局筛选条件持久化（localStorage） -->
    <script src="~/js/filter-persistence.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
