@model DormManage.Admin.ViewComponents.MenuViewModel
@using DormManage.Admin.Services
@{
    var topMenus = Model.TopMenus ?? new List<AuthHelperExtensions.MenuNode>();
    var currentPath = (Model.CurrentPath ?? "").TrimEnd('/');

    // v2.13.76 RBAC：仅当用户拥有该菜单权限时才渲染 tab。
    // IAuthService.GetUserMenusAsync 已自动补齐父级（子菜单有权限 → 父级可见）。
    string IconClass(string icon) =>
        !string.IsNullOrWhiteSpace(icon) ? icon : "bi-circle";
    bool IsActive(string? route)
    {
        if (string.IsNullOrWhiteSpace(route)) return false;
        var r = route.TrimEnd('/');
        if (string.Equals(r, "/", StringComparison.OrdinalIgnoreCase))
            return currentPath == "/" || currentPath == "";
        return currentPath == r || currentPath.StartsWith(r + "/", StringComparison.OrdinalIgnoreCase);
    }
}

@if (topMenus.Any())
{
    @foreach (var menu in topMenus.OrderBy(m => m.SortOrder).ThenBy(m => m.Id))
    {
        var isActive = IsActive(menu.Route);
        <a class="tab-item @(isActive ? "active" : "")"
           data-tab-id="tab-@menu.PermissionCode.Replace(":", "-")"
           data-module="@menu.PermissionCode"
           data-url="@menu.Route"
           href="@menu.Route"
           data-permission="@menu.PermissionCode"
           title="@menu.PermissionName">
            <i class="bi @IconClass(menu.Icon) tab-icon"></i> @menu.PermissionName
        </a>
    }
}
else
{
    @* v2.13.76：用户没有任何菜单权限时给提示 *@
    <span class="tab-item text-warning" style="cursor:default;opacity:0.7;">
        <i class="bi bi-exclamation-triangle tab-icon"></i> 无可见菜单（请联系管理员分配权限）
    </span>
}