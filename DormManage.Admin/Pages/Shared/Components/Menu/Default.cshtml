@using DormManage.Admin.Services
@model (List<AuthHelperExtensions.MenuNode> TopMenus, List<AuthHelperExtensions.MenuNode> AllMenus)
@{
    var topMenus = Model.TopMenus ?? new List<AuthHelperExtensions.MenuNode>();
    var allMenus = Model.AllMenus ?? new List<AuthHelperExtensions.MenuNode>();
    var currentPath = Context.Request.Path.Value?.TrimEnd('/') ?? "/";
}

<ul class="navbar-nav me-auto">
    @if (topMenus.Any())
    {
        @foreach (var menu in topMenus)
        {
            var children = allMenus.Where(m => m.ParentId == menu.Id).ToList();
            if (children.Any())
            {
                // 含子菜单：渲染为下拉
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                        @if (!string.IsNullOrWhiteSpace(menu.Icon))
                        {
                            <i class="bi @menu.Icon"></i>
                        }
                        @menu.PermissionName
                    </a>
                    <ul class="dropdown-menu">
                        @foreach (var child in children)
                        {
                            <li>
                                <a class="dropdown-item" href="@child.Route">
                                    @if (!string.IsNullOrWhiteSpace(child.Icon))
                                    {
                                        <i class="bi @child.Icon me-2"></i>
                                    }
                                    @child.PermissionName
                                </a>
                            </li>
                        }
                    </ul>
                </li>
            }
            else
            {
                // 顶级菜单：直接渲染为导航项
                var isActive = string.Equals(currentPath, menu.Route?.TrimEnd('/'), StringComparison.OrdinalIgnoreCase);
                <li class="nav-item">
                    <a class="nav-link @(isActive ? "active" : "")" href="@menu.Route">
                        @if (!string.IsNullOrWhiteSpace(menu.Icon))
                        {
                            <i class="bi @menu.Icon"></i>
                        }
                        @menu.PermissionName
                    </a>
                </li>
            }
        }
    }
    else
    {
        <!-- 无权限时显示提示 -->
        <li class="nav-item">
            <span class="nav-link text-warning">
                <i class="bi bi-exclamation-triangle"></i> 无可见菜单（请联系管理员分配权限）
            </span>
        </li>
    }
</ul>