@page
@model DormManage.Admin.Pages.Dorms.DetailsModel
@{
    ViewData["Title"] = "宿舍详情";
    Layout = "_Layout";
}

@section Styles {
    <style>
        /* v2.11.4 (s) 时间线样式 */
        .timeline { border-left: 2px solid #1976d2; padding-left: 20px; margin-left: 10px; min-height: 100px; }
        .timeline-item { position: relative; padding: 10px 0; border-bottom: 1px dashed #dee2e6; }
        .timeline-item:last-child { border-bottom: none; }
        .timeline-item::before {
            content: '';
            position: absolute;
            left: -28px;
            top: 18px;
            width: 12px;
            height: 12px;
            border-radius: 50%;
            background: #1976d2;
        }
        .timeline-item.left::before { background: #6c757d; }

        /* v2.12.24 布局固定：左右两栏严格并排，禁止换行 */
        .details-row {
            display: flex;
            flex-wrap: nowrap;
            align-items: flex-start;
            gap: 12px;
        }
        .details-left {
            width: 300px;
            flex-shrink: 0;
        }
        .details-right {
            flex: 1 1 0;
            min-width: 0;
        }
    </style>
}

<div class="container-fluid">
    <!-- 页头 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-building"></i> 宿舍详情
        </h2>
        <div>
            <a href="/Dorms" class="btn btn-outline-secondary" data-back-to-list="/Dorms" onclick="ReturnUrl.handleBack(event)">
                <i class="bi bi-arrow-left"></i> 返回列表
            </a>
            <a href="/Dorms/Edit?id=@(Model.Dorm?.Id)" class="btn btn-primary">
                <i class="bi bi-pencil"></i> 编辑
            </a>
        </div>
    </div>

    @if (Model.Dorm != null)
    {
        <!-- v2.12.24 布局：左右两栏严格并排，左栏300px固定宽度，右栏自适应剩余空间 -->
        <div class="details-row">
            <!-- 左栏：基本信息 + 操作（各300px固定宽度，上下堆叠，左边框对齐） -->
            <div class="details-left">
                <!-- 基本信息卡片（v2.13.60 1:1 对齐原型 dorms/details.html 用 table table-sm table-borderless） -->
                <div class="card mb-3">
                    <div class="card-header bg-light">
                        <h5 class="mb-0"><i class="bi bi-info-circle"></i> 基本信息</h5>
                    </div>
                    <div class="card-body">
                        <table class="table table-sm table-borderless mb-0">
                            <tr>
                                <th width="60" class="text-muted">房号</th>
                                <td><strong>@Model.Dorm.DormCode</strong></td>
                            </tr>
                            <tr>
                                <th width="60" class="text-muted">楼栋</th>
                                <td>@(Model.Dorm.BuildingName ?? "-")</td>
                            </tr>
                            <tr>
                                <th width="60" class="text-muted">楼层</th>
                                <td>@Model.Dorm.FloorId 楼</td>
                            </tr>
                            <tr>
                                <th width="60" class="text-muted">地址</th>
                                <td>@(Model.Dorm.AddressText ?? "-")</td>
                            </tr>
                            <tr>
                                <th width="60" class="text-muted">房间数</th>
                                <td>@Model.Dorm.RoomCount 间</td>
                            </tr>
                            <tr>
                                <th width="60" class="text-muted">容量</th>
                                <td>@Model.Dorm.Capacity 人</td>
                            </tr>
                            <tr>
                                <th width="60" class="text-muted">性别</th>
                                <td>
                                    @* v2.13.85 派生性别：基于当前在宿人员实时计算（不读 Dorm.Gender 静态字段） *@
                                    @if (Model.Dorm.EffectiveGender == 1)
                                    {
                                        <span class="badge bg-info text-dark" title="男 @Model.Dorm.MaleCount 人">男</span>
                                    }
                                    else if (Model.Dorm.EffectiveGender == 2)
                                    {
                                        <span class="badge bg-danger" title="女 @Model.Dorm.FemaleCount 人">女</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary" title="空房间或无在宿人员">无</span>
                                    }
                                </td>
                            </tr>
                            <tr>
                                <th width="60" class="text-muted">状态</th>
                                <td>
                                    @if (Model.Dorm.IsActive)
                                    {
                                        <span class="badge bg-success">启用</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">停用</span>
                                    }
                                </td>
                            </tr>
                            @if (!string.IsNullOrEmpty(Model.Dorm.Remark))
                            {
                                <tr>
                                    <th width="60" class="text-muted">备注</th>
                                    <td>@Model.Dorm.Remark</td>
                                </tr>
                            }
                        </table>
                    </div>
                </div>

                <!-- 操作卡片 -->
                <div class="card">
                    <div class="card-header">
                        <h5 class="mb-0"><i class="bi bi-tools"></i> 操作</h5>
                    </div>
                    <div class="card-body">
                        <button id="btnToggleHistory" class="btn btn-outline-secondary w-100 mb-2" onclick="toggleHistory()">
                            <i class="bi bi-clock-history"></i> 查看住宿历史
                        </button>
                        <a href="/Dorms" class="btn btn-link w-100"><i class="bi bi-arrow-left"></i> 返回宿舍列表</a>
                    </div>
                </div>
            </div>

            <!-- 右栏：当前入住人员 + 住宿历史（与左侧栏顶部对齐，上下堆叠） -->
            <div class="details-right">
                <!-- 当前入住人员（与左侧栏顶部对齐） -->
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-people"></i> 当前入住人员
                            <span class="badge bg-primary ms-2">@Model.CurrentResidents.Count</span>
                        </h5>
                        <span class="text-muted small">容量上限：@Model.Dorm?.Capacity 人</span>
                    </div>
                    <div class="card-body">
                        @if (Model.CurrentResidents.Count > 0)
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-light">
                                        @* v2.13.60 1:1 对齐原型 dorms/details.html：9 列（工号|姓名|部门|员工类型|考勤班次|床号|入住日期|已入住|操作），删除原 Razor 额外的「序号」+「手机」列 *@
                                        @* v2.13.91 新增：在「部门」与「员工类型」之间插入「班组」列（FK 关联 SysEmployee.TeamId → Team.Name），与人员清单表头顺序一致 *@
                                        <tr>
                                            <th>工号</th>
                                            <th>姓名</th>
                                            <th>部门</th>
                                            <th>班组</th>
                                            <th>员工类型</th>
                                            <th>考勤班次</th>
                                            <th>床号</th>
                                            <th>入住日期</th>
                                            <th>已入住</th>
                                            <th width="200">操作</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var resident in Model.CurrentResidents)
                                        {
                                            // v2.12.40 考勤班次从 SysEmployee.AttendanceTypeId → AttendanceType.Name 关联引用
                                            var attendance = Model.EmployeeAttendanceMap.ContainsKey(resident.EmployeeId)
                                                ? Model.EmployeeAttendanceMap[resident.EmployeeId]
                                                : null;
                                            // v2.13.91 班组从 SysEmployee.TeamId → Team.Name 关联引用
                                            var teamBadge = Model.EmployeeTeamMap.ContainsKey(resident.EmployeeId)
                                                ? Model.EmployeeTeamMap[resident.EmployeeId]
                                                : null;
                                            // v2.13.39 员工类型从 SysEmployee.EmployeeTypeId → EmployeeType.Name 关联引用
                                            EmployeeTypeBadgeDto? empType = null;
                                            if (resident.EmployeeTypeId.HasValue
                                                && Model.EmployeeTypeMap.ContainsKey(resident.EmployeeTypeId.Value))
                                            {
                                                empType = Model.EmployeeTypeMap[resident.EmployeeTypeId.Value];
                                            }
                                            // v2.13.39 已入住天数（CheckInDate → today）
                                            var stayDays = resident.CheckInDate.HasValue
                                                ? (DateOnly.FromDateTime(DateTime.Now).DayNumber - resident.CheckInDate.Value.DayNumber)
                                                : 0;
                                            <tr>
                                                <td><strong>@resident.EmployeeCode</strong></td>
                                                <td>@resident.EmployeeName</td>
                                                <td>@(resident.Department ?? "-")</td>
                                                @* v2.13.91 新增：班组 Badge（FK 关联引用 SysEmployee.TeamId → Team.Name） *@
                                                <td>
                                                    @if (teamBadge != null)
                                                    {
                                                        <span class="badge @teamBadge.BadgeClass" title="来源：SysEmployee.TeamId → Team.Name">@teamBadge.Name</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (empType != null)
                                                    {
                                                        <span class="badge @empType.BadgeClass" title="来源：SysEmployee.EmployeeTypeId → EmployeeType.Name">@empType.Name</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    @if (attendance != null)
                                                    {
                                                        <span class="badge @attendance.BadgeClass">@attendance.Name</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    @* v2.12.40 床号列 - FK 关联引用 SysEmployee.BedNo（与人员清单床号列同步）*@
                                                    @if (resident.BedNo.HasValue)
                                                    {
                                                        <span class="badge bg-info text-dark">床位 @resident.BedNo</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>@resident.CheckInDate?.ToString("yyyy-MM-dd")</td>
                                                <td>
                                                    @if (stayDays >= 0)
                                                    {
                                                        <span class="badge bg-info">@stayDays 天</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td>
                                                    <a href="/Booking/Edit?id=@resident.Id" class="btn btn-sm btn-outline-warning">
                                                        <i class="bi bi-arrow-left-right"></i> 调宿
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="checkoutResident(@resident.Id, '@resident.EmployeeName')">
                                                        <i class="bi bi-box-arrow-right"></i> 退宿
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center py-4 mb-0">暂无入住人员</p>
                        }
                    </div>
                </div>

                <!-- 住宿历史记录（默认隐藏，timeline 时间线样式） -->
                <div id="historySection" class="card" style="display: none;">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-clock-history"></i> 住宿历史记录
                            <span class="badge bg-secondary ms-2" id="historyCount">0</span>
                        </h5>
                        <button class="btn btn-sm btn-link" onclick="toggleHistory()">收起 ▲</button>
                    </div>
                    <div class="card-body">
                        <div class="timeline" id="historyTimeline"></div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // v2.11.4 (s) 查看住宿历史开关效果
        let historyVisible = false;

        // v2.13.39 新增：退宿操作（POST /api/v1/bookings/{id}/check-out）
        function checkoutResident(bookingId, name) {
            if (!confirm('确定办理 ' + name + ' 的退宿吗？')) return;
            var token = document.querySelector('input[name="__RequestVerificationToken"]');
            var headers = { 'Content-Type': 'application/json' };
            if (token) headers['RequestVerificationToken'] = token.value;

            fetch('/api/v1/bookings/' + bookingId + '/check-out', {
                method: 'POST',
                headers: headers,
                credentials: 'same-origin'
            })
            .then(function(r) { return r.json().then(function(j) { return { ok: r.ok, body: j }; }); })
            .then(function(res) {
                if (res.ok && res.body.success !== false) {
                    alert('✓ ' + name + ' 已退宿');
                    location.reload();
                } else {
                    alert('✗ 退宿失败：' + (res.body.message || res.body.error || '未知错误'));
                }
            })
            .catch(function(err) { alert('✗ 退宿请求失败：' + err.message); });
        }

        function toggleHistory() {
            historyVisible = !historyVisible;
            const section = document.getElementById('historySection');
            const btn = document.getElementById('btnToggleHistory');

            if (historyVisible) {
                section.style.display = 'block';
                btn.innerHTML = '<i class="bi bi-x-circle"></i> 关闭历史';
                btn.classList.remove('btn-outline-secondary');
                btn.classList.add('btn-secondary');
                renderHistory();
            } else {
                section.style.display = 'none';
                btn.innerHTML = '<i class="bi bi-clock-history"></i> 查看住宿历史';
                btn.classList.remove('btn-secondary');
                btn.classList.add('btn-outline-secondary');
            }
        }

        function formatDate(d) {
            if (!d) return '-';
            return d instanceof Date ? d.toISOString().slice(0, 10) : String(d);
        }

        function renderHistory() {
            // 从后端传入的历史数据渲染时间线
            const history = @(Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.HistoryRecords.Where(r => r.Type != 1 || r.Status != 2).OrderByDescending(r => r.BookingDate).Take(50), new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase })));
            document.getElementById('historyCount').textContent = history.length;
            const timeline = document.getElementById('historyTimeline');

            if (history.length === 0) {
                timeline.innerHTML = '<div class="text-muted text-center py-4">暂无历史记录</div>';
                return;
            }

            timeline.innerHTML = history.map(r => {
                const isCheckedOut = r.type === 2 && r.status === 3;
                const checkInDate = r.checkInDate ? new Date(r.checkInDate) : new Date();
                const leaveDate = r.checkOutDate ? new Date(r.checkOutDate) : null;
                const stayDays = leaveDate
                    ? Math.floor((leaveDate - checkInDate) / (1000 * 60 * 60 * 24))
                    : Math.floor((new Date() - checkInDate) / (1000 * 60 * 60 * 24));

                return `
                <div class="timeline-item ${isCheckedOut ? 'left' : ''}">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <strong>${r.employeeName || '-'}</strong>
                            <small class="text-muted ms-2">${r.employeeCode || '-'} | ${r.department || '-'}</small>
                            ${isCheckedOut ? '<span class="badge bg-secondary ms-2">已退宿</span>' : '<span class="badge bg-success ms-2">在宿</span>'}
                        </div>
                        <small class="text-muted">${r.registrar || ''}</small>
                    </div>
                    <div class="mt-1 text-muted small">
                        <i class="bi bi-box-arrow-in-right"></i> 入住：${formatDate(r.checkInDate)}
                        ${r.checkOutDate ? `<i class="bi bi-box-arrow-right ms-3"></i> 退宿：${formatDate(r.checkOutDate)}` : '<i class="bi bi-hourglass-split ms-3"></i> 至今'}
                        <i class="bi bi-clock ms-3"></i> 共 ${stayDays} 天
                    </div>
                </div>`;
            }).join('');
        }
    </script>
}