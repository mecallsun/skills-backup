@page
@model DormManage.Admin.Pages.Dorms.IndexModel
@{
    ViewData["Title"] = "宿舍管理";
    Layout = "_Layout";

    var currentPage = Model.PageIndex;
    var pageSize = Model.PageSize;
    var totalCount = Model.Result?.TotalCount ?? 0;
    var totalPages = totalCount > 0 ? (int)Math.Ceiling(totalCount / (double)pageSize) : 0;
    var startIndex = (currentPage - 1) * pageSize + 1;
}

<div class="container-fluid">
    <!-- 页头（v2.13.15 使用 PageHeader 组件） -->
    @await Component.InvokeAsync("PageHeader", new {
        icon = "bi-building",
        title = "宿舍档案",
        count = Model.Total,
        countLabel = "间",
        primaryAction = new PageAction { Label = "新增宿舍", OnClick = "openDormModal(0)", Icon = "bi-plus-lg", Style = "success" },
        actions = new List<PageAction> { new() { Label = "新窗口新增", Icon = "bi-box-arrow-up-right", Url = "/Dorms/Create", Style = "secondary" } }
    })

    <!-- 筛选条件区域（v2.13.10 按原型 dorms/list.html 排序：楼栋/楼层/状态/关键词） -->
    <form method="get" class="card mb-3 filter-card" data-filter-form="dorms">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end flex-nowrap filter-row">
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">楼栋</label>
                    <select name="BuildingId" class="form-select">
                        <option value="">全部</option>
                        @foreach (var item in Model.Buildings)
                        {
                            <option value="@item.Id" selected="@(Model.BuildingId == item.Id)">@item.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">楼层</label>
                    <input type="number" name="FloorNo" value="@Model.FloorNo" class="form-control" placeholder="如：3" min="1" max="99">
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">状态</label>
                    <select name="IsActive" class="form-select">
                        <option value="">全部</option>
                        <option value="true" selected="@(Model.IsActive == true)">启用</option>
                        <option value="false" selected="@(Model.IsActive == false)">停用</option>
                    </select>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">关键词</label>
                    <input type="text" name="Keyword" value="@Model.Keyword" class="form-control" placeholder="房号/地址">
                </div>
                <div class="col-auto filter-item filter-item-btn">
                    <button type="submit" class="btn btn-primary filter-btn">
                        <i class="bi bi-search"></i> 查询
                    </button>
                </div>
                <div class="col-auto filter-item filter-item-btn">
                    <button type="button" class="btn btn-outline-secondary filter-btn" onclick="FilterPersistence.resetFilters('dorms')">
                        <i class="bi bi-arrow-clockwise"></i> 重置
                    </button>
                </div>
            </div>
        </div>
    </form>

    <!-- 列表 -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th width="60" class="text-center">序号</th>
                            <th>房号</th>
                            <th>楼栋</th>
                            <th>楼层</th>
                            <th>地址</th>
                            <th class="text-center">性别</th>
                            <th class="text-center">房间数</th>
                            <th class="text-center">容量</th>
                            <th class="text-center">在住人数</th>
                            <th class="text-center" style="min-width:120px">使用率</th>
                            <th class="text-center">状态</th>
                            <th width="220" class="text-center">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Result?.Items.Count > 0)
                        {
                            var index = startIndex;
                            foreach (var item in Model.Result.Items)
                            {
                                <tr>
                                    <td class="text-center text-muted">@index</td>
                                    <td><strong>@item.DormCode</strong></td>
                                    <td>@item.BuildingName</td>
                                    <td>@item.FloorNo 楼</td>
                                    <td>@item.AddressText</td>
                                    <td class="text-center">
                                        @if (item.Gender == 1)
                                        {
                                            <span class="badge bg-info text-dark">男</span>
                                        }
                                        else if (item.Gender == 2)
                                        {
                                            <span class="badge bg-danger">女</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">不限</span>
                                        }
                                    </td>
                                    <td class="text-center">@item.RoomCount</td>
                                    <td class="text-center">@item.Capacity 人</td>
                                    <td class="text-center">
                                        <span class="badge @(item.CurrentCount > 0 ? "bg-primary" : "bg-secondary")">@item.CurrentCount</span>
                                        / @item.Capacity
                                    </td>
                                    <td class="text-center">
                                        @{
                                            var usage = item.Capacity > 0 ? (int)Math.Round(item.CurrentCount * 100.0 / item.Capacity) : 0;
                                            var usageColor = usage >= 100 ? "bg-danger" : usage >= 75 ? "bg-warning text-dark" : "bg-success";
                                        }
                                        <div class="progress" style="height: 18px; min-width: 80px;">
                                            <div class="progress-bar @usageColor" style="width: @usage%">@usage%</div>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge bg-success">启用</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">停用</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <a href="/Dorms/Details?id=@item.Id" class="btn btn-sm btn-outline-info">详情</a>
                                        <a href="/Dorms/Edit?id=@item.Id" class="btn btn-sm btn-outline-primary">修改</a>
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#dormModal" onclick="openDormModal(@item.Id)" title="在弹窗中编辑">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @* v2.12.41 删除按钮：仅当无在宿人员 且 无办理登记历史时才显示（否则隐藏）*@
                                        @if (item.CanDelete)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="deleteDorm(@item.Id, '@item.DormCode')">删除</button>
                                        }
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="text-center text-muted py-4">暂无宿舍数据</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- 页尾分页 -->
            @if (totalPages > 0)
            {
                <div class="card-footer d-flex justify-content-between align-items-center pagination-footer">
                    <div class="text-muted">
                        共 <strong>@totalCount</strong> 条记录，第 <strong>@currentPage</strong> / <strong>@totalPages</strong> 页
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?BuildingId=@Model.BuildingId&FloorNo=@Model.FloorNo&IsActive=@Model.IsActive&Keyword=@Model.Keyword&PageIndex=@(currentPage - 1)" aria-label="上一页">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                            }
                            @for (var p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                            {
                                <li class="page-item @(p == currentPage ? "active" : "")">
                                    <a class="page-link" href="?BuildingId=@Model.BuildingId&FloorNo=@Model.FloorNo&IsActive=@Model.IsActive&Keyword=@Model.Keyword&PageIndex=@p">@p</a>
                                </li>
                            }
                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?BuildingId=@Model.BuildingId&FloorNo=@Model.FloorNo&IsActive=@Model.IsActive&Keyword=@Model.Keyword&PageIndex=@(currentPage + 1)" aria-label="下一页">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    function deleteDorm(id, code) {
        if (!confirm('确定删除宿舍 "' + code + '" 吗？此操作不可恢复。')) return;
        const f = document.createElement('form');
        f.method = 'post';
        f.action = '/Dorms?handler=Delete&id=' + id;
        const t = document.querySelector('input[name="__RequestVerificationToken"]');
        if (t) f.appendChild(t.cloneNode());
        document.body.appendChild(f);
        f.submit();
    }
    // v2.13.11 Modal 弹窗（与原型 dorms/list.html modalDormCreate/modalDormEdit 一致）：
    //   通过 iframe 复用现有 Create/Edit 页面，提交后自动关闭弹窗 + 刷新列表
    function openDormModal(id) {
        var url = id > 0 ? '/Dorms/Edit?id=' + id + '&inModal=1' : '/Dorms/Create?inModal=1';
        var frame = document.getElementById('dormModalFrame');
        frame.src = url;
        var title = document.getElementById('dormModalTitle');
        title.innerHTML = id > 0
            ? '<i class="bi bi-pencil-square text-primary"></i> 编辑宿舍'
            : '<i class="bi bi-plus-circle text-success"></i> 新增宿舍';
    }
    // 监听 iframe 提交完成事件（Create/Edit 页面保存后跳转到 /Dorms，弹窗需关闭）
    var modalEl = document.getElementById('dormModal');
    modalEl.addEventListener('hidden.bs.modal', function () {
        // 关闭后刷新当前页（保留筛选状态）
        var f = document.querySelector('[data-filter-form="dorms"]');
        if (f) f.submit();
    });
</script>
}

<!-- v2.13.11 宿舍新增/编辑 Modal 弹窗（iframe 复用独立页面，避免表单代码重复） -->
<div class="modal fade" id="dormModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" style="max-width: 800px;">
        <div class="modal-content">
            <div class="modal-header py-2">
                <h5 class="modal-title" id="dormModalTitle"><i class="bi bi-plus-circle text-success"></i> 新增宿舍</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="dormModalFrame" src="" style="width: 100%; height: 70vh; border: none;"></iframe>
            </div>
        </div>
    </div>
</div>

<style>
    /* 表格样式优化 */
    .table th {
        white-space: nowrap;
        font-weight: 500;
    }

    .table td {
        vertical-align: middle;
    }

    /* 分页样式 */
    .pagination-footer {
        background: transparent;
        border: none;
        padding: 0.75rem 0 0 0;
    }

    .pagination .page-link {
        min-width: 32px;
        text-align: center;
    }
</style>
