@page
@model DormManage.Admin.Pages.Dorms.EditModel
@{
    ViewData["Title"] = "编辑宿舍";
    Layout = "_Layout";
}

@section Styles {
    <style>
        /* v2.12.38 紧凑一屏布局：去掉规范信息，减小行间距 */
        .form-section { margin-bottom: 0.6rem; }
        .form-section-title { font-size: 0.85rem; font-weight: 600; color: #1976d2; border-left: 3px solid #1976d2; padding-left: 0.5rem; margin-bottom: 0.4rem; }
        .form-field { margin-bottom: 0.5rem; }
        .form-label { font-size: 0.85rem; font-weight: 500; color: #495057; margin-bottom: 0.2rem; }
        .form-label .required { color: #dc3545; margin-left: 2px; }
        .form-control, .form-select { border-radius: 6px; padding: 0.375rem 0.75rem; font-size: 0.9rem; }
        .form-readonly { background: #f5f7fa; cursor: not-allowed; }
    </style>
}

<div class="container-fluid">
    <!-- v2.12.38 紧凑页头 -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">
            <i class="bi bi-building text-primary"></i> 编辑宿舍
            @* v2.13.88 RBAC 只读模式：顶角显示「只读」徽章 *@
            @if (Model.IsReadOnly)
            {
                <span class="badge bg-warning text-dark ms-2"><i class="bi bi-lock-fill"></i> 只读模式</span>
            }
        </h2>
        <a href="/Dorms" class="btn btn-outline-secondary" data-back-to-list="/Dorms" onclick="ReturnUrl.handleBack(event)">
            <i class="bi bi-arrow-left"></i> 返回列表
        </a>
    </div>

    @* v2.13.88 RBAC 只读模式提示 alert *@
    @if (Model.IsReadOnly)
    {
        <div class="alert alert-warning py-2 mb-2">
            <i class="bi bi-shield-lock"></i> 您没有 <strong>编辑宿舍</strong> 权限，当前页面以<strong>只读</strong>模式展示。如需修改，请联系系统管理员分配「dorm:edit」权限。
        </div>
    }

    <!-- v2.12.38 编辑表单（紧凑一屏布局） -->
    @* v2.13.88 只读模式时禁用所有表单输入控件 *@
    <form method="post" id="dormEditForm">
        <input type="hidden" asp-for="Dorm.Id" />

        <!-- 区块 1：基本信息（房号锁定 readonly，禁止修改） -->
        <div class="card mb-2">
            <div class="card-body py-2">
                <div class="form-section-title">基本信息</div>
                <div class="row g-2">
                    <div class="col-md-6 form-field">
                        <label class="form-label">宿舍号<span class="required">*</span></label>
                        <input type="text" class="form-control form-readonly" asp-for="Dorm.DormCode" required maxlength="20" readonly>
                        <small class="text-muted" style="font-size:0.75rem;">宿舍编号不可修改，禁止创建重复房号</small>
                        <span class="text-danger small d-block" asp-validation-for="Dorm.DormCode"></span>
                    </div>
                    <div class="col-md-6 form-field">
                        <label class="form-label">楼栋<span class="required">*</span></label>
                        <select class="form-select" asp-for="Dorm.BuildingId" required>
                            <option value="">请选择楼栋</option>
                            @foreach (var item in Model.Buildings)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>
                        <span class="text-danger small" asp-validation-for="Dorm.BuildingId"></span>
                    </div>
                    <div class="col-md-6 form-field">
                        <label class="form-label">楼层<span class="required">*</span></label>
                        <select class="form-select" asp-for="Dorm.FloorId" required>
                            <option value="">请选择楼层</option>
                            @foreach (var item in Model.Floors)
                            {
                                <option value="@item.Id">@item.FloorNo 楼</option>
                            }
                        </select>
                        <span class="text-danger small" asp-validation-for="Dorm.FloorId"></span>
                    </div>
                    <div class="col-md-6 form-field">
                        <label class="form-label">地址<span class="required">*</span></label>
                        <select class="form-select" asp-for="Dorm.AddressId" required>
                            <option value="">请选择地址</option>
                            @foreach (var item in Model.Addresses)
                            {
                                <option value="@item.Id">@item.AddressText</option>
                            }
                        </select>
                        <span class="text-danger small" asp-validation-for="Dorm.AddressId"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 区块 2：容量配置（床位数锁定 readonly，随容量同步） -->
        <div class="card mb-2">
            <div class="card-body py-2">
                <div class="form-section-title">容量配置</div>
                <div class="row g-2">
                    <div class="col-md-4 form-field">
                        <label class="form-label">房间数<span class="required">*</span></label>
                        <input type="number" class="form-control" asp-for="Dorm.RoomCount" required min="1" max="10">
                        <span class="text-danger small" asp-validation-for="Dorm.RoomCount"></span>
                    </div>
                    <div class="col-md-4 form-field">
                        <label class="form-label">容量（人）<span class="required">*</span></label>
                        <input type="number" id="inputCapacity" class="form-control" asp-for="Dorm.Capacity" required min="1" max="40" oninput="syncBedCount()">
                        <span class="text-danger small" asp-validation-for="Dorm.Capacity"></span>
                    </div>
                    <div class="col-md-4 form-field">
                        <label class="form-label">床位数<span class="required">*</span></label>
                        <input type="number" id="inputBedCount" class="form-control form-readonly" value="@Model.Dorm.Capacity" readonly>
                        <small class="text-muted" style="font-size:0.75rem;">床位号由容量自动生成（1..容量）</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 区块 3：其他 -->
        <div class="card mb-2">
            <div class="card-body py-2">
                <div class="form-section-title">其他</div>
                <div class="row g-2">
                    <div class="col-md-6 form-field">
                        @* v2.13.85 派生性别：基于当前在宿人员实时计算，不可手工编辑 *@
                        <label class="form-label">性别 <small class="text-muted">（派生自当前在宿人员）</small></label>
                        @if (Model.EffectiveGender == 1)
                        {
                            <div><span class="badge bg-info text-dark" title="男 @Model.MaleCount 人">男</span> <small class="text-muted">@Model.MaleCount 人在宿</small></div>
                        }
                        else if (Model.EffectiveGender == 2)
                        {
                            <div><span class="badge bg-danger" title="女 @Model.FemaleCount 人">女</span> <small class="text-muted">@Model.FemaleCount 人在宿</small></div>
                        }
                        else
                        {
                            <div><span class="badge bg-secondary">无</span> <small class="text-muted">空房间或无在宿人员</small></div>
                        }
                        <input type="hidden" asp-for="Dorm.Gender" value="@Model.Dorm.Gender" />
                    </div>
                    <div class="col-md-6 form-field d-flex align-items-end">
                        <div class="form-check pb-2">
                            <input type="checkbox" class="form-check-input"
                                   asp-for="Dorm.IsActive"
                                   disabled="@Model.IsActiveLocked"
                                   aria-describedby="dormLockedHelp">
                            <label class="form-check-label" for="Dorm_IsActive">
                                启用该宿舍
                                @if (Model.IsActiveLocked)
                                {
                                    <i class="bi bi-lock-fill text-warning ms-1" title="有在宿人员时不可停用"></i>
                                }
                            </label>
                        </div>
                    </div>
                    <div class="col-md-12 form-field">
                        <label class="form-label">备注</label>
                        <textarea class="form-control" asp-for="Dorm.Remark" rows="2" maxlength="500" placeholder="可选"></textarea>
                        <span class="text-danger small" asp-validation-for="Dorm.Remark"></span>
                    </div>
                </div>
                @* v2.13.82 业务约束：在宿人数 > 0 时锁定「启用宿舍」勾选状态 *@
                @if (Model.IsActiveLocked)
                {
                    <div class="alert alert-warning py-2 mb-0 mt-2" id="dormLockedHelp" role="alert">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>该宿舍当前在宿 <span class="badge bg-danger">@Model.CurrentCount</span> 人</strong>，
                        <strong>禁止停用</strong>。请先办理所有人员的退宿手续后，方可取消「启用该宿舍」勾选。
                        <div class="mt-1 small text-muted">业务约束（v2.13.82）：CurrentCount &gt; 0 时锁定 IsActive，避免在宿员工失去宿舍关联。</div>
                    </div>
                }
                <span class="text-danger small d-block mt-1" asp-validation-for="Dorm.IsActive"></span>
            </div>
        </div>

        <!-- 操作按钮 -->
        <div class="d-flex justify-content-end gap-2">
            <a href="/Dorms" class="btn btn-outline-secondary" data-back-to-list="/Dorms" onclick="ReturnUrl.handleBack(event)">取消</a>
            @* v2.13.88 RBAC 只读模式：无编辑权限时隐藏「保存」按钮 *@
            @if (!Model.IsReadOnly)
            {
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg"></i> 保存
                </button>
            }
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // v2.12.38 床位数锁定同步（容量变化时自动更新床位数）
        function syncBedCount() {
            var cap = parseInt(document.getElementById('inputCapacity').value) || 0;
            document.getElementById('inputBedCount').value = cap;
        }
        // v2.13.88 RBAC 只读模式：拦截 form 提交防止意外保存
        @if (Model.IsReadOnly)
        {
            <text>
            document.addEventListener('DOMContentLoaded', function() {
                var form = document.getElementById('dormEditForm');
                if (form) {
                    form.addEventListener('submit', function(e) {
                        e.preventDefault();
                        alert('您没有编辑宿舍权限，无法保存修改');
                        return false;
                    });
                }
            });
            </text>
        }
        // 页面加载时初始化
        document.addEventListener('DOMContentLoaded', function() {
            syncBedCount();
        });
    </script>
}
