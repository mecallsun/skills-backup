@page
@model DormManage.Admin.Pages.Dorms.CreateModel
@{
    ViewData["Title"] = "新增宿舍";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- 页头 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-building"></i> 新增宿舍
        </h2>
        <div>
            <a href="/Dorms" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> 返回列表
            </a>
        </div>
    </div>

    <!-- 新增表单 -->
    <div class="card">
        <div class="card-body">
            <form method="post">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">宿舍号 <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" asp-for="Dorm.DormCode" required maxlength="20" placeholder="如 D-001">
                        <span class="text-danger small" asp-validation-for="Dorm.DormCode"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">楼栋 <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="Dorm.BuildingId" required>
                            <option value="">请选择楼栋</option>
                            @foreach (var item in Model.Buildings)
                            {
                                <option value="@item.Id">@item.Name</option>
                            }
                        </select>
                        <span class="text-danger small" asp-validation-for="Dorm.BuildingId"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">楼层 <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="Dorm.FloorId" required>
                            <option value="">请选择楼层</option>
                            @foreach (var item in Model.Floors)
                            {
                                <option value="@item.Id">@item.FloorNo 楼</option>
                            }
                        </select>
                        <span class="text-danger small" asp-validation-for="Dorm.FloorId"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">地址 <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="Dorm.AddressId" required>
                            <option value="">请选择地址</option>
                            @foreach (var item in Model.Addresses)
                            {
                                <option value="@item.Id">@item.AddressText</option>
                            }
                        </select>
                        <span class="text-danger small" asp-validation-for="Dorm.AddressId"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">容量（人） <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" asp-for="Dorm.Capacity" required min="1" max="20" value="4">
                        <span class="text-danger small" asp-validation-for="Dorm.Capacity"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">性别 <span class="text-danger">*</span></label>
                        <select class="form-select" asp-for="Dorm.Gender" required>
                            <option value="1">男</option>
                            <option value="2">女</option>
                        </select>
                        <span class="text-danger small" asp-validation-for="Dorm.Gender"></span>
                    </div>
                    <div class="col-md-12">
                        <label class="form-label">备注</label>
                        <textarea class="form-control" asp-for="Dorm.Remark" rows="3" maxlength="500" placeholder="可选"></textarea>
                    </div>
                    <div class="col-md-12">
                        <div class="form-check">
                            <input type="checkbox" class="form-check-input" asp-for="Dorm.IsActive" checked>
                            <label class="form-check-label" for="Dorm_IsActive">启用该宿舍</label>
                        </div>
                    </div>
                </div>

                <hr class="my-4">

                <div class="d-flex justify-content-end gap-2">
                    <a href="/Dorms" class="btn btn-outline-secondary">取消</a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-lg"></i> 保存
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
