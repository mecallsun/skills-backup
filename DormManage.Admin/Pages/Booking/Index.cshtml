// v2.13.24 新增：删除办理登记（仅预约/已取消状态）
async function deleteBooking(id) {
    if (!confirm('确认删除该办理登记记录？\n注意：仅预约或已取消状态可删除。\n删除后不可恢复，请谨慎操作。')) return;
    try {
        const resp = await fetch(`${API_BASE}/${id}`, { method: 'DELETE' });
        if (!resp.ok) {
            const msg = await resp.text();
            alert('删除失败：' + (msg || resp.statusText));
            return;
        }
        alert('✓ 已删除');
        renderList(); // 重新渲染列表
    } catch (err) {
        console.error(err);
        alert('删除失败');
    }
}

