function statusName(s) {
    return s === 1 ? '预约' : s === 2 ? '在宿' : s === 3 ? '已退房' : s === 4 ? '已取消' : '-';
}

// ===== v2.13.32-hotfix BUG #2：一键修复工号姓名关联 =====
async function repairEmployeeNames() {
    if (!confirm('将以「人员清单」档案中的最新姓名为准，修正办理登记列表中所有工号对应的姓名。\n\n仅修正 DormBooking.EmployeeName 与 SysEmployee.RealName 不一致的记录，已一致的会跳过。\n\n继续执行？')) return;
    try {
        const resp = await fetch('/api/v1/bookings/repair-employee-names', { method: 'POST' });
        const result = await resp.json();
        if (result.success) {
            const { updated, skipped, notFound } = result.data;
            alert(`✅ 修复完成\n\n修正：${updated} 条\n跳过（已一致）：${skipped} 条\n未找到档案：${notFound} 条\n\n3 秒后自动刷新页面...`);
            setTimeout(() => location.reload(), 3000);
        } else {
            alert('修复失败：' + (result.message || '未知错误'));
        }
    } catch (err) {
        console.error(err);
        alert('修复请求失败：' + err.message);
    }
}

// ===== 退房弹窗：员工搜索 =====
function onCoEmpSearch() {
    const kw = document.getElementById('coEmpKeyword').value.trim();
    if (!kw) { document.getElementById('coEmpSuggestions').style.display = 'none'; coSearchResults = []; return; }
    fetch(`/api/v1/bookings/employee-search?keyword=${encodeURIComponent(kw)}`)
        .then(r => r.json())
        .then(res => {
            if (res.success && res.data.length > 0) {
                // v2.13.32-hotfix: 保存退房搜索结果
                coSearchResults = res.data;
                const sug = document.getElementById('coEmpSuggestions');
                sug.innerHTML = res.data.slice(0, 10).map(e =>
                    `<div class="suggestion-item" onclick="selectCoEmp(${e.id})">
                        <strong>${e.realName}</strong>
                        <small class="text-muted ms-2">${e.employeeCode} | ${e.department || ''} | ${e.phone || ''}</small>
                    </div>`
                ).join('');
                sug.style.display = 'block';
            } else {
                coSearchResults = [];
                document.getElementById('coEmpSuggestions').style.display = 'none';
            }
        }).catch(() => { coSearchResults = []; document.getElementById('coEmpSuggestions').style.display = 'none'; });
}

function showCoSuggestions() { document.getElementById('coEmpSuggestions').style.display = 'block'; }

async function selectCoEmp(empId) {
    document.getElementById('coEmpSuggestions').style.display = 'none';
    // v2.13.32-hotfix: 从最近一次退房搜索结果查员工 + 填充员工信息展示区
    const emp = coSearchResults.find(x => x.id === empId);
    if (!emp) {
        alert('员工信息已失效，请重新搜索');
        return;
    }
    const kw = document.getElementById('coEmpKeyword');
    kw.dataset.empId = emp.id;
    kw.dataset.empCode = emp.employeeCode || '';
    kw.dataset.empName = emp.realName || '';

    document.getElementById('coEmpCode').textContent = emp.employeeCode || '-';
    document.getElementById('coEmpName').textContent = emp.realName || '-';
    document.getElementById('coEmpPhone').textContent = emp.phone || '-';
    document.getElementById('coEmpDept').textContent = emp.department || '-';
    document.getElementById('coEmpInfo').style.display = 'block';

    document.getElementById('coValidationPanel').innerHTML =
        `<p class="mb-1"><i class="bi bi-check2 text-success"></i> 已选择：<strong>${emp.realName}</strong>（${emp.employeeCode}）</p>
         <p class="mb-1 small text-muted">部门：${emp.department || '-'}</p>
         <p class="mb-0 small text-muted">手机：${emp.phone || '-'}</p>`;

    // 加载员工在宿记录
    try {
        const resp = await fetch(`${API_BASE}/staying-records/${empId}`);
        const res = await resp.json();
        if (res.success && res.data.length > 0) {
            document.getElementById('coStepRecord').style.display = 'block';
            document.getElementById('coStepDate').style.display = 'block';
            const sel = document.getElementById('coRecordSelect');
            sel.innerHTML = '<option value="">请选择</option>' +
                res.data.map(r => `<option value="${r.id}">${r.dormCode}（${r.bookingDate} 入住）</option>`).join('');
        } else {
            alert('该员工当前没有在宿记录');
        }
    } catch(e) {}
}

function onCoDateChange() { /* 校验逻辑 */ }

async function submitCheckOut() {
    const recordId = document.getElementById('coRecordSelect').value;
    const date = document.getElementById('coCheckoutDate').value;
    const reason = document.getElementById('coReason').value;

    if (!recordId) { alert('请选择退房记录'); return; }
    if (!date) { alert('请选择退房日期'); return; }

    try {
        const resp = await fetch(`${API_BASE}/${recordId}/check-out`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ checkOutDate: date })
        });
        const result = await resp.json();
        if (result.success) {
            alert('退房办理成功');
            bootstrap.Modal.getInstance(document.getElementById('checkOutModal')).hide();
            location.reload();
        } else {
            alert(result.message || '退房办理失败');
        }
    } catch (err) { console.error(err); alert('退房办理失败'); }
}
