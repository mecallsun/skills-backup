@page
@model DormManage.Admin.Pages.Booking.IndexModel
@{
    ViewData["Title"] = "办理登记";
    Layout = "_Layout";

    var currentPage = Model.PageIndex;
    var pageSize = Model.PageSize;
    var totalCount = Model.Result?.TotalCount ?? 0;
    var totalPages = (int)Math.Ceiling(totalCount / (double)pageSize);
    var startIndex = (currentPage - 1) * pageSize + 1;
}

<div class="container-fluid">
    <!-- 页头 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-clipboard-check"></i> 办理登记
            <small class="text-muted fs-6">（共 <span id="totalCount">@totalCount</span> 条）</small>
        </h2>
        <div class="btn-group" role="group">
            <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#checkInModal">
                <i class="bi bi-box-arrow-in-right"></i> 办理入住
            </button>
            <button type="button" class="btn btn-info text-white" data-bs-toggle="modal" data-bs-target="#checkOutModal">
                <i class="bi bi-box-arrow-right"></i> 办理退房
            </button>
            <button class="btn btn-outline-secondary" onclick="exportExcel()">
                <i class="bi bi-download"></i> 导出
            </button>
        </div>
    </div>

    <!-- 筛选表单 -->
    <form method="get" class="card mb-3 filter-card" data-filter-form="booking">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end flex-nowrap filter-row">
                <div class="col-auto filter-item filter-item-name">
                    <label class="form-label mb-1">员工（姓名/工号/手机）</label>
                    <input type="text" name="keyword" value="@Model.Keyword" class="form-control" placeholder="模糊查询">
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">部门</label>
                    <input type="text" name="department" value="@Model.Department" class="form-control" placeholder="模糊查询">
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">房号</label>
                    <input type="text" name="dormCode" value="@Model.DormCode" class="form-control" placeholder="模糊查询">
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">类型</label>
                    <select name="type" class="form-select">
                        <option value="">全部</option>
                        <option value="1" selected="@(Model.Type == 1)">入住</option>
                        <option value="2" selected="@(Model.Type == 2)">退房</option>
                    </select>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">状态</label>
                    <select name="status" class="form-select">
                        <option value="">全部</option>
                        <option value="1" selected="@(Model.Status == 1)">预约</option>
                        <option value="2" selected="@(Model.Status == 2)">在宿</option>
                        <option value="3" selected="@(Model.Status == 3)">已退房</option>
                        <option value="4" selected="@(Model.Status == 4)">已取消</option>
                    </select>
                </div>
                <div class="col-auto filter-item filter-item-date">
                    <label class="form-label mb-1">入退日期从</label>
                    <input type="date" name="dateFrom" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="form-control">
                </div>
                <div class="col-auto filter-item filter-item-date">
                    <label class="form-label mb-1">到</label>
                    <input type="date" name="dateTo" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="form-control">
                </div>
                <div class="col-auto filter-item filter-item-btn">
                    <button type="submit" class="btn btn-primary filter-btn">
                        <i class="bi bi-search"></i> 查询
                    </button>
                </div>
                <div class="col-auto filter-item filter-item-btn">
                    <a href="/Booking" class="btn btn-outline-secondary filter-btn">
                        <i class="bi bi-arrow-clockwise"></i> 重置
                    </a>
                </div>
                <div class="col-auto filter-item filter-item-btn">
                    <button type="button" class="btn btn-outline-danger filter-btn" onclick="FilterPersistence.reset('booking')" title="清除 localStorage 中该模块的筛选缓存">
                        <i class="bi bi-trash"></i> 清除
                    </button>
                </div>
            </div>
        </div>
    </form>

    <!-- 列表 -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th width="60" class="text-center">序号</th>
                            <th>工号</th>
                            <th>姓名</th>
                            <th>部门</th>
                            <th>宿舍</th>
                            <th class="text-center">类型</th>
                            <th class="text-center">入退日期</th>
                            <th class="text-center">状态</th>
                            <th class="text-center">登记人</th>
                            <th class="text-center">登记时间</th>
                            <th width="220" class="text-center">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Result?.Items.Count > 0)
                        {
                            var index = startIndex;
                            foreach (var item in Model.Result.Items)
                            {
                                <tr>
                                    <td class="text-center text-muted">@index</td>
                                    <td><strong>@item.EmployeeCode</strong></td>
                                    <td>@item.EmployeeName</td>
                                    <td>@(item.Department ?? "-")</td>
                                    <td>@item.DormCode</td>
                                    <td class="text-center">
                                        @if (item.Type == 1)
                                        {
                                            <span class="badge bg-success">入住</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">退房</span>
                                        }
                                    </td>
                                    <td class="text-center">@item.BookingDate.ToString("yyyy-MM-dd")</td>
                                    <td class="text-center">
                                        @switch (item.Status)
                                        {
                                            case 1: <span class="badge bg-warning text-dark">预约</span>; break;
                                            case 2: <span class="badge bg-success">在宿</span>; break;
                                            case 3: <span class="badge bg-secondary">已退房</span>; break;
                                            case 4: <span class="badge bg-danger">已取消</span>; break;
                                        }
                                    </td>
                                    <td class="text-center"><small class="text-muted">@item.Registrar</small></td>
                                    <td class="text-center"><small class="text-muted">@item.RegistrationDate.ToString("yyyy-MM-dd HH:mm")</small></td>
                                    <td class="text-center">
                                        @* v2.11.12 操作列顺序：修改 → 撤销退房(v2.11.10) → 入住 → 退房 → 撤销预约(v2.11.11，最右侧) *@
                                        @if (item.Status == 1)
                                        {
                                            <a href="/Booking/Edit?id=@item.Id" class="btn btn-sm btn-outline-primary">修改</a>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" disabled title="仅预约状态可修改">修改</button>
                                        }
                                        @* v2.11.10 新增：撤销退房按钮（仅 BookingDate=今天 && Status=3 已退房 时显示，位于修改按钮右侧） *@
                                        @if (item.BookingDate == DateOnly.FromDateTime(DateTime.Today) && item.Status == 3)
                                        {
                                            <button class="btn btn-sm btn-outline-info" onclick="undoCheckout(@item.Id)">撤销</button>
                                        }
                                        @* v2.11.8 新增：入住快速确认按钮（仅 Type=1 入住 && Status=1 预约时显示） *@
                                        @if (item.Type == 1 && item.Status == 1)
                                        {
                                            <button class="btn btn-sm btn-outline-success" onclick="confirmCheckin(@item.Id)">入住</button>
                                        }
                                        @* v2.11.12 退房按钮扩展：Status=2 在宿（既有）或 Type=2 退房 && Status=1 预约（新增） *@
                                        @if (item.Status == 2)
                                        {
                                            <button class="btn btn-sm btn-outline-warning" onclick="checkOut(@item.Id)">退房</button>
                                        }
                                        else if (item.Type == 2 && item.Status == 1)
                                        {
                                            <button class="btn btn-sm btn-outline-warning" onclick="confirmCheckout(@item.Id)">退房</button>
                                        }
                                        @* v2.11.17 新增：撤销在宿按钮（仅 Type=1 入住 && Status=2 在宿 && BookingDate=今天 时显示） *@
                                        @if (item.Type == 1 && item.Status == 2 && item.BookingDate == DateOnly.FromDateTime(DateTime.Today))
                                        {
                                            <button class="btn btn-sm btn-outline-danger" onclick="cancelToday(@item.Id)">撤销在宿</button>
                                        }
                                        @* v2.11.11 新增：撤销预约按钮（仅 Status=1 预约时显示，位置在操作列最右侧） *@
                                        @if (item.Status == 1)
                                        {
                                            <button class="btn btn-sm btn-outline-danger" onclick="cancelReservation(@item.Id)">撤销</button>
                                        }
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="11" class="text-center text-muted py-4">暂无办理记录</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (totalPages > 0)
            {
                <div class="card-footer d-flex justify-content-between align-items-center pagination-footer">
                    <div class="text-muted">
                        共 <strong>@totalCount</strong> 条记录，第 <strong>@currentPage</strong> / <strong>@totalPages</strong> 页
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            @if (currentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?keyword=@Model.Keyword&department=@Model.Department&dormCode=@Model.DormCode&type=@Model.Type&status=@Model.Status&dateFrom=@Model.DateFrom?.ToString("yyyy-MM-dd")&dateTo=@Model.DateTo?.ToString("yyyy-MM-dd")&pageIndex=@(currentPage - 1)" aria-label="上一页">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                            }
                            @for (var p = Math.Max(1, currentPage - 2); p <= Math.Min(totalPages, currentPage + 2); p++)
                            {
                                <li class="page-item @(p == currentPage ? "active" : "")">
                                    <a class="page-link" href="?keyword=@Model.Keyword&department=@Model.Department&dormCode=@Model.DormCode&type=@Model.Type&status=@Model.Status&dateFrom=@Model.DateFrom?.ToString("yyyy-MM-dd")&dateTo=@Model.DateTo?.ToString("yyyy-MM-dd")&pageIndex=@p">@p</a>
                                </li>
                            }
                            @if (currentPage < totalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="?keyword=@Model.Keyword&department=@Model.Department&dormCode=@Model.DormCode&type=@Model.Type&status=@Model.Status&dateFrom=@Model.DateFrom?.ToString("yyyy-MM-dd")&dateTo=@Model.DateTo?.ToString("yyyy-MM-dd")&pageIndex=@(currentPage + 1)" aria-label="下一页">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>
</div>

<!-- ==================== 办理入住弹窗 ==================== -->
<div class="modal fade" id="checkInModal" tabindex="-1" aria-labelledby="checkInModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;border:none;box-shadow:0 8px 32px rgba(0,0,0,0.15);">
            <div class="modal-header" style="background:#1976d2;color:#fff;border-radius:12px 12px 0 0;">
                <h5 class="modal-title"><i class="bi bi-box-arrow-in-right"></i> 办理入住</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="关闭"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <!-- 左侧：员工选择 + 表单 -->
                    <div class="col-lg-8">
                        <!-- 步骤1：选择员工 -->
                        <div class="card border-0 bg-light mb-3" style="border-left:4px solid #1976d2;border-radius:8px!important;">
                            <div class="card-body">
                                <h6 class="text-primary mb-3"><span class="badge bg-primary me-2">1</span>选择员工</h6>
                                <div class="position-relative">
                                    <input type="text" id="ciEmpKeyword" class="form-control" placeholder="输入姓名/工号/手机号搜索..." oninput="onCiEmpSearch()" onfocus="showCiSuggestions()">
                                    <div id="ciEmpSuggestions" class="suggestion-list" style="display:none;"></div>
                                </div>
                                <div class="row g-2 mt-2" id="ciEmpInfo" style="display:none;">
                                    <div class="col-md-4"><label class="form-label small text-muted">工号</label><div id="ciEmpCode" class="fw-bold"></div></div>
                                    <div class="col-md-4"><label class="form-label small text-muted">姓名</label><div id="ciEmpName" class="fw-bold"></div></div>
                                    <div class="col-md-4"><label class="form-label small text-muted">手机号</label><div id="ciEmpPhone"></div></div>
                                    <div class="col-md-4"><label class="form-label small text-muted">部门</label><div id="ciEmpDept"></div></div>
                                    <div class="col-md-4"><label class="form-label small text-muted">员工类型</label><div id="ciEmpType"></div></div>
                                    <div class="col-md-4"><label class="form-label small text-muted">考勤班次</label><div id="ciEmpAtt"></div></div>
                                </div>
                                <div id="ciEmpWarn" class="mt-2" style="display:none;"></div>
                            </div>
                        </div>

                        <!-- 步骤2：入退日期 + 原因 -->
                        <div class="card border-0 bg-light mb-3" style="border-left:4px solid #1976d2;border-radius:8px!important;">
                            <div class="card-body">
                                <h6 class="text-primary mb-3"><span class="badge bg-primary me-2">2</span>入住信息</h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label small">入住日期 <span class="text-danger">*</span></label>
                                        <input type="date" id="ciBookingDate" class="form-control" onchange="onCiDateChange()">
                                        <small class="text-muted">默认 = 今天</small>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small">原因</label>
                                        <select id="ciReason" class="form-select">
                                            <option value="入职">入职</option>
                                            <option value="调岗">调岗</option>
                                            <option value="换房">换房</option>
                                            <option value="预约">预约</option>
                                            <option value="其他">其他</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small">登记人</label>
                                        <input type="text" id="ciRegistrar" class="form-control" readonly disabled>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 步骤3：选择房间 -->
                        <div class="card border-0 bg-light mb-3" style="border-left:4px solid #1976d2;border-radius:8px!important;">
                            <div class="card-body">
                                <h6 class="text-primary mb-3"><span class="badge bg-primary me-2">3</span>选择房间</h6>
                                <select id="ciDormSelect" class="form-select" onchange="onCiDormSelect()">
                                    <option value="">请先选择员工和入住日期</option>
                                </select>
                                <div id="ciDormHint" class="form-text mt-1"></div>
                            </div>
                        </div>
                    </div>

                    <!-- 右侧：校验提示 + 历史记录 -->
                    <div class="col-lg-4">
                        <div class="card border-0 mb-3" style="border-left:4px solid #2e7d32;border-radius:8px!important;">
                            <div class="card-body">
                                <h6 class="text-success mb-3"><i class="bi bi-shield-check"></i> 校验提示</h6>
                                <div id="ciValidationPanel">
                                    <p class="text-muted small">请先选择员工</p>
                                </div>
                            </div>
                        </div>
                        <div class="card border-0" style="border-left:4px solid #00838f;border-radius:8px!important;">
                            <div class="card-body">
                                <h6 class="mb-3" style="color:#00838f;"><i class="bi bi-clock-history"></i> 员工历史办理</h6>
                                <div id="ciEmpHistory">
                                    <p class="text-muted small">请先选择员工</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #e8eaed;padding:1rem 2rem;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> 取消
                </button>
                <button type="button" class="btn btn-success" onclick="submitCheckIn()">
                    <i class="bi bi-check-lg"></i> 确认入住
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== 办理退房弹窗 ==================== -->
<div class="modal fade" id="checkOutModal" tabindex="-1" aria-labelledby="checkOutModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;border:none;box-shadow:0 8px 32px rgba(0,0,0,0.15);">
            <div class="modal-header" style="background:#00838f;color:#fff;border-radius:12px 12px 0 0;">
                <h5 class="modal-title"><i class="bi bi-box-arrow-right"></i> 办理退房</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="关闭"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-4">
                    <!-- 左侧：员工选择 + 表单 -->
                    <div class="col-lg-8">
                        <!-- 步骤1：选择员工（仅当前在宿） -->
                        <div class="card border-0 bg-light mb-3" style="border-left:4px solid #00838f;border-radius:8px!important;">
                            <div class="card-body">
                                <h6 class="text-primary mb-3"><span class="badge bg-primary me-2">1</span>选择员工（仅显示当前在宿员工）</h6>
                                <div class="position-relative">
                                    <input type="text" id="coEmpKeyword" class="form-control" placeholder="输入姓名/工号/手机号搜索..." oninput="onCoEmpSearch()" onfocus="showCoSuggestions()">
                                    <div id="coEmpSuggestions" class="suggestion-list" style="display:none;"></div>
                                </div>
                                <div class="row g-2 mt-2" id="coEmpInfo" style="display:none;">
                                    <div class="col-md-4"><label class="form-label small text-muted">工号</label><div id="coEmpCode" class="fw-bold"></div></div>
                                    <div class="col-md-4"><label class="form-label small text-muted">姓名</label><div id="coEmpName" class="fw-bold"></div></div>
                                    <div class="col-md-4"><label class="form-label small text-muted">手机号</label><div id="coEmpPhone"></div></div>
                                    <div class="col-md-4"><label class="form-label small text-muted">部门</label><div id="coEmpDept"></div></div>
                                    <div class="col-md-4"><label class="form-label small text-muted">员工类型</label><div id="coEmpType"></div></div>
                                    <div class="col-md-4"><label class="form-label small text-muted">考勤班次</label><div id="coEmpAtt"></div></div>
                                </div>
                            </div>
                        </div>

                        <!-- 步骤2：选择在宿记录 -->
                        <div class="card border-0 bg-light mb-3" id="coStepRecord" style="display:none;border-left:4px solid #00838f;border-radius:8px!important;">
                            <div class="card-body">
                                <h6 class="text-primary mb-3"><span class="badge bg-primary me-2">2</span>选择退房记录（在宿记录）</h6>
                                <select id="coRecordSelect" class="form-select">
                                    <option value="">请选择</option>
                                </select>
                            </div>
                        </div>

                        <!-- 步骤3：退房日期 + 原因 -->
                        <div class="card border-0 bg-light mb-3" id="coStepDate" style="display:none;border-left:4px solid #00838f;border-radius:8px!important;">
                            <div class="card-body">
                                <h6 class="text-primary mb-3"><span class="badge bg-primary me-2">3</span>退房信息</h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label small">退房日期 <span class="text-danger">*</span></label>
                                        <input type="date" id="coCheckoutDate" class="form-control" onchange="onCoDateChange()">
                                        <small class="text-muted">默认 = 今天</small>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small">原因</label>
                                        <select id="coReason" class="form-select">
                                            <option value="离职">离职</option>
                                            <option value="调岗">调岗</option>
                                            <option value="换房">换房</option>
                                            <option value="其他">其他</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small">登记人</label>
                                        <input type="text" id="coRegistrar" class="form-control" readonly disabled>
                                    </div>
                                </div>
                                <div id="coDateHint" class="mt-2" style="display:none;"></div>
                            </div>
                        </div>
                    </div>

                    <!-- 右侧：校验提示 -->
                    <div class="col-lg-4">
                        <div class="card border-0" style="border-left:4px solid #2e7d32;border-radius:8px!important;">
                            <div class="card-body">
                                <h6 class="mb-3" style="color:#2e7d32;"><i class="bi bi-info-circle"></i> 一进一出校验</h6>
                                <div id="coValidationPanel">
                                    <p class="text-muted small">请先选择员工</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid #e8eaed;padding:1rem 2rem;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> 取消
                </button>
                <button type="button" class="btn btn-info text-white" onclick="submitCheckOut()">
                    <i class="bi bi-check-lg"></i> 提交退房
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ==================== CSS & JS ==================== -->
<style>
    /* 弹窗建议列表 */
    .suggestion-list {
        position: absolute;
        z-index: 1055;
        background: white;
        border: 1px solid #dee2e6;
        border-radius: 6px;
        max-height: 240px;
        overflow-y: auto;
        width: 100%;
