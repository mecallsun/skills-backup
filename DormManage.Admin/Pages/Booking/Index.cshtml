<script>
const API_BASE = '/api/v1/bookings';

async function checkOut(id) {
    if (!confirm('确定要为该员工办理退房吗？')) return;

    const date = prompt('请输入退房日期（格式：YYYY-MM-DD）', new Date().toISOString().split('T')[0]);
    if (!date) return;

    try {
        const resp = await fetch(`${API_BASE}/${id}/check-out`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ checkOutDate: date })
        });
        const result = await resp.json();
        if (result.success) {
            alert('退房成功');
            location.reload();
        } else {
            alert(result.message || '退房失败');
        }
    } catch (err) {
        console.error(err);
        alert('退房失败');
    }
}

// v2.11.8 新增：入住快速确认
// 调用 POST /api/v1/bookings/{id}/confirm-checkin
// 服务端将 Status 即时变更为 2 在宿，同步 Registrar=当前账号、RegistrationDate=now()
async function confirmCheckin(id) {
    if (!confirm('确认该员工已入住？\n（状态：预约 → 在宿，登记人/登记时间将更新为当前信息）')) return;

    try {
        const resp = await fetch(`${API_BASE}/${id}/confirm-checkin`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const result = await resp.json();
        if (result.success) {
            alert('入住已确认（状态 → 在宿）');
            location.reload();
        } else {
            alert(result.message || '入住确认失败');
        }
    } catch (err) {
        console.error(err);
        alert('入住确认失败');
    }
}

// v2.11.10 新增：撤销退房
// 调用 POST /api/v1/bookings/{id}/undo-checkout
// 仅当 BookingDate == today && Status == 3 已退房 时显示
// 服务端先校验宿舍房号余量：
//   - 有余量 → Status 即时变更为 2 在宿，同步 Registrar=当前账号、RegistrationDate=now()，联动恢复 SysEmployee.DormCode
//   - 无余量 → 返回 400 NO_CAPACITY，前端弹窗提示"床位已满，撤销退房失败！"，不修改任何字段
async function undoCheckout(id) {
    if (!confirm('确认撤销该记录的退房？\n（后台将先校验宿舍房号余量，有余量则恢复状态：在宿；无余量则提示床位已满，撤销失败）')) return;

    try {
        const resp = await fetch(`${API_BASE}/${id}/undo-checkout`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const result = await resp.json();
        if (result.success) {
            alert('退房已撤销（状态 → 在宿）');
            location.reload();
        } else {
            alert(result.message || '撤销退房失败');
        }
    } catch (err) {
        console.error(err);
        alert('撤销退房失败');
    }
}

// v2.11.11 新增：撤销预约
// 调用 POST /api/v1/bookings/{id}/cancel-reservation
// 仅当 Status == 1 预约 时显示（位置在操作列最右侧）
// 服务端将 Status 即时变更为 4 已取消，同步 Registrar=当前账号、RegistrationDate=now()、UpdatedAt=now()
// 注意：无需校验房间余量（该记录从未入住）
async function cancelReservation(id) {
    if (!confirm('确认撤销该预约记录？\n（状态：预约 → 已取消，登记人/登记时间将更新为当前信息）')) return;

    try {
        const resp = await fetch(`${API_BASE}/${id}/cancel-reservation`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const result = await resp.json();
        if (result.success) {
            alert('预约已撤销（状态 → 已取消）');
            location.reload();
        } else {
            alert(result.message || '撤销预约失败');
        }
    } catch (err) {
        console.error(err);
        alert('撤销预约失败');
    }
}

// v2.11.12 新增：确认退房（针对预约退房 Type=2 && Status=1 的记录）
// 调用 POST /api/v1/bookings/{id}/confirm-checkout
// 仅当 Type == 2 退房 && Status == 1 预约 时显示（位置在"修改"与"撤销预约"之间）
// 服务端将 Status 即时变更为 3 已退房，同步 Registrar=当前账号、RegistrationDate=now()、UpdatedAt=now()
// 联动 SysEmployee.DormCode=NULL（员工变为未分配宿舍）
async function confirmCheckout(id) {
    if (!confirm('确认该员工已退房？\n（状态：预约 → 已退房，登记人/登记时间将更新为当前信息）')) return;

    try {
        const resp = await fetch(`${API_BASE}/${id}/confirm-checkout`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const result = await resp.json();
        if (result.success) {
            alert('退房已确认（状态 → 已退房）');
            location.reload();
        } else {
            alert(result.message || '确认退房失败');
        }
    } catch (err) {
        console.error(err);
        alert('确认退房失败');
    }
}

// v2.11.17 新增：撤销在宿
// 调用 POST /api/v1/bookings/{id}/cancel-today
// 仅当 Type == 1 入住 && Status == 2 在宿 && BookingDate == today 时显示
// 服务端将 Status 即时变更为 4 已取消，联动清空 SysEmployee.DormCode
async function cancelToday(id) {
    if (!confirm('确认撤销该员工的在宿记录？\n（状态：在宿 → 已取消，并清空该员工的宿舍分配）')) return;

    try {
        const resp = await fetch(`${API_BASE}/${id}/cancel-today`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const result = await resp.json();
        if (result.success) {
            alert('在宿已撤销（状态 → 已取消）');
            location.reload();
        } else {
            alert(result.message || '撤销在宿失败');
        }
    } catch (err) {
        console.error(err);
        alert('撤销在宿失败');
    }
}

// ==================== 办理入住弹窗逻辑 ====================
let ciSelectedEmp = null;

// 初始化入住弹窗
document.addEventListener('DOMContentLoaded', function() {
    const ciModal = document.getElementById('checkInModal');
    if (ciModal) {
        ciModal.addEventListener('show.bs.modal', function() {
            document.getElementById('ciBookingDate').valueAsDate = new Date();
            document.getElementById('ciRegistrar').value = 'admin'; // TODO: 从当前用户上下文获取
            document.getElementById('ciEmpKeyword').value = '';
            document.getElementById('ciEmpInfo').style.display = 'none';
            document.getElementById('ciEmpWarn').style.display = 'none';
            document.getElementById('ciDormSelect').innerHTML = '<option value="">请先选择员工和入住日期</option>';
            document.getElementById('ciDormHint').textContent = '';
            document.getElementById('ciValidationPanel').innerHTML = '<p class="text-muted small">请先选择员工</p>';
            document.getElementById('ciEmpHistory').innerHTML = '<p class="text-muted small">请先选择员工</p>';
        });
    }

    // 初始化退房弹窗
    const coModal = document.getElementById('checkOutModal');
    if (coModal) {
        coModal.addEventListener('show.bs.modal', function() {
            document.getElementById('coCheckoutDate').valueAsDate = new Date();
            document.getElementById('coRegistrar').value = 'admin';
            document.getElementById('coEmpKeyword').value = '';
            document.getElementById('coEmpInfo').style.display = 'none';
            document.getElementById('coStepRecord').style.display = 'none';
            document.getElementById('coStepDate').style.display = 'none';
            document.getElementById('coValidationPanel').innerHTML = '<p class="text-muted small">请先选择员工</p>';
        });
    }
});

// ===== 入住弹窗：员工搜索 =====
function onCiEmpSearch() {
    const kw = document.getElementById('ciEmpKeyword').value.trim();
    if (!kw) { document.getElementById('ciEmpSuggestions').style.display = 'none'; return; }
    // 调用 API 搜索员工
    fetch(`/api/v1/bookings/employee-search?keyword=${encodeURIComponent(kw)}`)
        .then(r => r.json())
        .then(res => {
            if (res.success && res.data.length > 0) {
                const sug = document.getElementById('ciEmpSuggestions');
                sug.innerHTML = res.data.slice(0, 10).map(e =>
                    `<div class="suggestion-item" onclick="selectCiEmp(${e.id})">
                        <strong>${e.realName}</strong>
                        <small class="text-muted ms-2">${e.employeeCode} | ${e.department || ''} | ${e.phone || ''}</small>
                    </div>`
                ).join('');
                sug.style.display = 'block';
            } else {
                document.getElementById('ciEmpSuggestions').style.display = 'none';
            }
        }).catch(() => { document.getElementById('ciEmpSuggestions').style.display = 'none'; });
}

function showCiSuggestions() { document.getElementById('ciEmpSuggestions').style.display = 'block'; }

document.addEventListener('click', function(e) {
    if (!e.target.closest('#ciEmpKeyword') && !e.target.closest('#ciEmpSuggestions')) {
        document.getElementById('ciEmpSuggestions').style.display = 'none';
    }
    if (!e.target.closest('#coEmpKeyword') && !e.target.closest('#coEmpSuggestions')) {
        document.getElementById('coEmpSuggestions').style.display = 'none';
    }
});

async function selectCiEmp(empId) {
    document.getElementById('ciEmpSuggestions').style.display = 'none';
    try {
        const resp = await fetch(`/api/v1/bookings/employee-search?keyword=`);
        // 从搜索结果中找到匹配的员工（简化：通过 API 获取员工详情）
        // 这里先用搜索回调填充
        onCiEmpSearch();
    } catch(e) {}
}

function onCiDateChange() { refreshCiDorms(); }
function onCiDormSelect() { /* TODO: 显示宿舍详情 */ }

async function submitCheckIn() {
    const employeeId = document.getElementById('ciEmpKeyword').dataset.empId;
    const dormCode = document.getElementById('ciDormSelect').value;
    const bookingDate = document.getElementById('ciBookingDate').value;
    const reason = document.getElementById('ciReason').value;
    const remark = document.getElementById('ciRemark')?.value || '';

    if (!employeeId) { alert('请选择员工'); return; }
    if (!dormCode) { alert('请选择房间'); return; }
    if (!bookingDate) { alert('请选择入住日期'); return; }

    try {
        const resp = await fetch(`${API_BASE}/check-in`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ employeeId: parseInt(employeeId), dormCode, bookingDate, reason, remark })
        });
        const result = await resp.json();
        if (result.success) {
            alert('入住办理成功');
            bootstrap.Modal.getInstance(document.getElementById('checkInModal')).hide();
            location.reload();
        } else {
            alert(result.message || '入住办理失败');
        }
    } catch (err) { console.error(err); alert('入住办理失败'); }
}

function refreshCiDorms() {
    const empId = document.getElementById('ciEmpKeyword').dataset.empId;
    const date = document.getElementById('ciBookingDate').value;
    if (!empId || !date) return;
    fetch(`${API_BASE}/available-dorms?employeeId=${empId}&bookingDate=${date}`)
        .then(r => r.json())
        .then(res => {
            if (res.success) {
                const sel = document.getElementById('ciDormSelect');
                sel.innerHTML = '<option value="">请选择房间</option>' +
                    res.data.map(d => `<option value="${d.dormCode}">${d.dormCode} | ${d.buildingName}（余量 ${d.availableCount}/${d.capacity} 人）</option>`).join('');
                document.getElementById('ciDormHint').innerHTML = `💡 共 <strong>${res.data.length}</strong> 间可用房间`;
            }
        }).catch(() => {});
}

// ===== 退房弹窗：员工搜索 =====
function onCoEmpSearch() {
    const kw = document.getElementById('coEmpKeyword').value.trim();
    if (!kw) { document.getElementById('coEmpSuggestions').style.display = 'none'; return; }
    fetch(`/api/v1/bookings/employee-search?keyword=${encodeURIComponent(kw)}`)
        .then(r => r.json())
        .then(res => {
            if (res.success && res.data.length > 0) {
                const sug = document.getElementById('coEmpSuggestions');
                sug.innerHTML = res.data.slice(0, 10).map(e =>
                    `<div class="suggestion-item" onclick="selectCoEmp(${e.id})">
                        <strong>${e.realName}</strong>
                        <small class="text-muted ms-2">${e.employeeCode} | ${e.department || ''} | ${e.phone || ''}</small>
                    </div>`
                ).join('');
                sug.style.display = 'block';
            } else {
                document.getElementById('coEmpSuggestions').style.display = 'none';
            }
        }).catch(() => { document.getElementById('coEmpSuggestions').style.display = 'none'; });
}

function showCoSuggestions() { document.getElementById('coEmpSuggestions').style.display = 'block'; }

async function selectCoEmp(empId) {
    document.getElementById('coEmpSuggestions').style.display = 'none';
    // 加载员工在宿记录
    try {
        const resp = await fetch(`${API_BASE}/staying-records/${empId}`);
        const res = await resp.json();
        if (res.success && res.data.length > 0) {
            document.getElementById('coStepRecord').style.display = 'block';
            document.getElementById('coStepDate').style.display = 'block';
            const sel = document.getElementById('coRecordSelect');
            sel.innerHTML = '<option value="">请选择</option>' +
                res.data.map(r => `<option value="${r.id}">${r.dormCode}（${r.bookingDate} 入住）</option>`).join('');
        } else {
            alert('该员工当前没有在宿记录');
        }
    } catch(e) {}
}

function onCoDateChange() { /* 校验逻辑 */ }

async function submitCheckOut() {
    const recordId = document.getElementById('coRecordSelect').value;
    const date = document.getElementById('coCheckoutDate').value;
    const reason = document.getElementById('coReason').value;

    if (!recordId) { alert('请选择退房记录'); return; }
    if (!date) { alert('请选择退房日期'); return; }

    try {
        const resp = await fetch(`${API_BASE}/${recordId}/check-out`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ checkOutDate: date })
        });
        const result = await resp.json();
        if (result.success) {
            alert('退房办理成功');
            bootstrap.Modal.getInstance(document.getElementById('checkOutModal')).hide();
            location.reload();
        } else {
            alert(result.message || '退房办理失败');
        }
    } catch (err) { console.error(err); alert('退房办理失败'); }
}
</script>
}
