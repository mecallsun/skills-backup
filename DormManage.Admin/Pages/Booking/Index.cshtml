// v2.11.10 新增：撤销退房
// 调用 POST /api/v1/bookings/{id}/undo-checkout
// 仅当 BookingDate == today && Status == 3 已退房 时显示
// 服务端先校验宿舍房号余量：
//   - 有余量 → Status 即时变更为 2 在宿，同步 Registrar=当前账号、RegistrationDate=now()，联动恢复 SysEmployee.DormCode
//   - 无余量 → 返回 400 NO_CAPACITY，前端弹窗提示"床位已满，撤销退房失败！"，不修改任何字段
async function undoCheckout(id) {
    if (!confirm('确认撤销该记录的退房？\n（后台将先校验宿舍房号余量，有余量则恢复状态：在宿；无余量则提示床位已满，撤销失败）')) return;

    try {
        const resp = await fetch(`${API_BASE}/${id}/undo-checkout`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const result = await resp.json();
        if (result.success) {
            alert('退房已撤销（状态 → 在宿）');
            location.reload();
        } else {
            alert(result.message || '撤销退房失败');
        }
    } catch (err) {
        console.error(err);
        alert('撤销退房失败');
    }
}

