@page
@model DormManage.Admin.Pages.Meter.ImportModel
@{
    ViewData["Title"] = "批量导入抄表";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .step-card { border-left: 4px solid #1976d2; }
        .step-card.completed { border-left-color: #2e7d32; }
        .step-number {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: #1976d2;
            color: #fff;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
        }
        .step-card.completed .step-number { background: #2e7d32; }
        .reading { font-variant-numeric: tabular-nums; }
    </style>
}

<div class="container-fluid">
    <!-- 页头 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-file-earmark-arrow-up"></i> 批量导入抄表
            <small class="text-muted fs-6">（Excel 文件批量导入）</small>
        </h2>
        <a href="/Meter" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> 返回抄表记录
        </a>
    </div>

    <div class="alert alert-info py-2 mb-3">
        <i class="bi bi-info-circle"></i>
        <strong>v2.11.4 更新：</strong>所有数据操作均为覆盖模式。
        <strong>status=0(未抄表)/4(未完成) 记录将被覆盖</strong>；status=1(正常)/2(已修正) 记录拦截，提示走修正流程。
        文件内同月同房号重复仅首行有效。
    </div>

    <!-- 步骤指示器 -->
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card step-card @(Model.Step >= 1 ? "completed" : "")">
                <div class="card-body d-flex align-items-center">
                    <span class="step-number me-3">1</span>
                    <div>
                        <h6 class="mb-0">下载模板</h6>
                        <small class="text-muted">获取标准 Excel 模板</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card step-card @(Model.Step >= 2 ? "completed" : "")">
                <div class="card-body d-flex align-items-center">
                    <span class="step-number me-3">2</span>
                    <div>
                        <h6 class="mb-0">上传文件</h6>
                        <small class="text-muted">选择 Excel 文件上传</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card step-card @(Model.Step >= 3 ? "completed" : "")">
                <div class="card-body d-flex align-items-center">
                    <span class="step-number me-3">3</span>
                    <div>
                        <h6 class="mb-0">导入结果</h6>
                        <small class="text-muted">查看导入统计与错误</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 步骤 1：下载模板 -->
    <div class="card mb-3 step-card @(Model.Step >= 1 ? "completed" : "")">
        <div class="card-body">
            <h5>步骤 1：下载模板</h5>
            <p class="text-muted small mb-2">模板列：房号、抄表月份(YYYY-MM)、冷水读数、热水读数、电表读数、抄表员、备注</p>
            <form method="post" asp-page-handler="DownloadTemplate">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-download"></i> 下载 抄表导入模板.xlsx
                </button>
            </form>
        </div>
    </div>

    <!-- 步骤 2：上传文件 -->
    <div class="card mb-3">
        <div class="card-body">
            <h5>步骤 2：上传文件并校验</h5>
            <form method="post" enctype="multipart/form-data" asp-page-handler="Upload" class="row g-2 align-items-end">
                <div class="col-auto">
                    <input type="file" id="file" name="file" accept=".xlsx" class="form-control">
                </div>
                <div class="col-auto">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-search"></i> 校验并预览
                    </button>
                </div>
            </form>
            <small class="text-muted d-block mt-2">
                支持 .xlsx 格式，文件大小不超过 10MB
            </small>
        </div>
    </div>

    @if (Model.ImportResult != null)
    {
        <!-- 步骤 3：导入结果 -->
        <div class="card mb-3">
            <div class="card-body">
                <h5>步骤 3：校验结果</h5>

                <div class="row mb-3">
                    <div class="col-md-3">
                        <div class="card bg-light text-center">
                            <div class="card-body">
                                <h6 class="text-muted">总数据行</h6>
                                <h3 class="mb-0">@Model.ImportResult.TotalRows</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-success bg-opacity-10 text-center">
                            <div class="card-body">
                                <h6 class="text-muted">通过校验</h6>
                                <h3 class="mb-0 text-success">@Model.ImportResult.ValidRows</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-danger bg-opacity-10 text-center">
                            <div class="card-body">
                                <h6 class="text-muted">校验失败</h6>
                                <h3 class="mb-0 text-danger">@Model.ImportResult.InvalidRows</h3>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="card bg-warning bg-opacity-10 text-center">
                            <div class="card-body">
                                <h6 class="text-muted">需修正</h6>
                                <h3 class="mb-0 text-warning">@Model.ImportResult.NeedCorrectionRows</h3>
                            </div>
                        </div>
                    </div>
                </div>

                @if (Model.ImportResult.Errors != null && Model.ImportResult.Errors.Count > 0)
                {
                    <h6 class="mt-3">错误详情</h6>
                    <div class="table-responsive">
                        <table class="table table-sm table-bordered align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width:80px">行号</th>
                                    <th style="width:100px">房号</th>
                                    <th style="width:120px">月份</th>
                                    <th style="width:100px">冷水</th>
                                    <th style="width:100px">热水</th>
                                    <th style="width:100px">电</th>
                                    <th>错误信息</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var error in Model.ImportResult.Errors)
                                {
                                    <tr>
                                        <td>@error.RowNumber</td>
                                        <td>@error.DormCode</td>
                                        <td>@error.Month</td>
                                        <td class="reading">@error.ColdMeter</td>
                                        <td class="reading">@error.HotMeter</td>
                                        <td class="reading">@error.ElectricMeter</td>
                                        <td>@error.ErrorMessage</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <hr>
                <form method="post" asp-page-handler="Import">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-upload"></i> 确认导入
                    </button>
                    <a href="/Meter" class="btn btn-secondary">取消</a>
                </form>
            </div>
        </div>
    }
</div>
