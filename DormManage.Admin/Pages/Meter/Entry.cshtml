@page
@model DormManage.Admin.Pages.Meter.EntryModel
@{
    ViewData["Title"] = "手动补录抄表";
    Layout = "_Layout";
}

@section Styles {
    <style>
        .meter-card { border-left: 4px solid #1976d2; }
        .upload-ph {
            height: 90px;
            border: 2px dashed #cfd8dc;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #90a4ae;
            cursor: pointer;
            transition: all 0.2s;
        }
        .upload-ph:hover { border-color: #1976d2; color: #1976d2; }
        .usage-preview { background: #f8f9fa; border-radius: 8px; padding: 12px; }
    </style>
}

<div class="container-fluid">
    <!-- 页头 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-pencil-square"></i> 手动补录抄表
            <small class="text-muted fs-6">（后台人工录入）</small>
        </h2>
        <a href="/Meter" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> 返回抄表记录
        </a>
    </div>

    <div class="alert alert-info py-2 mb-3">
        <i class="bi bi-info-circle"></i>
        <strong>v2.11.4 更新：</strong>所有数据操作均为覆盖模式，不新增。若同月同房号已存在记录，将覆盖旧数据并保留历史快照。
    </div>

    <form method="post">
        <div class="row">
            <!-- 左侧：表单 -->
            <div class="col-md-8">
                <!-- 基本信息 -->
                <div class="card meter-card mb-3">
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label">宿舍 <span class="text-danger">*</span></label>
                                <select asp-for="DormId" class="form-select" onchange="onDormMonthChange()" required>
                                    <option value="">请选择宿舍</option>
                                    @foreach (var dorm in Model.Dorms)
                                    {
                                        <option value="@dorm.Id" selected="@(Model.DormId == dorm.Id)">
                                            @dorm.DormCode | @dorm.AddressText
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">抄表月份 <span class="text-danger">*</span></label>
                                <input type="month" asp-for="ReadMonth" class="form-control" onchange="onDormMonthChange()" required>
                                <span asp-validation-for="ReadMonth" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">抄表员</label>
                                <input type="text" class="form-control" value="admin（后台补录）" disabled>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ExistWarning))
                        {
                            <div class="alert alert-danger mt-3 mb-0">
                                <i class="bi bi-exclamation-triangle"></i> @Model.ExistWarning
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.LastReadingRef))
                        {
                            <div class="alert alert-secondary mt-3 mb-0">
                                <i class="bi bi-clock-history"></i>
                                上月读数参考：
                                @if (Model.LastReadingRef.Contains("冷水"))
                                {
                                    <text>冷水 @Model.LastReadingRef.Replace("上月读数参考：", "").Replace("冷水", "<strong>冷水</strong>").Replace("热水", "<strong>热水</strong>").Replace("电", "<strong>电</strong>")</text>
                                }
                                else
                                {
                                    <text>@Model.LastReadingRef</text>
                                }
                            </div>
                        }
                    </div>
                </div>

                <!-- 三表读数输入 -->
                <div class="row g-3" id="meterInputs">
                    <div class="col-md-4">
                        <div class="card meter-card h-100">
                            <div class="card-body">
                                <h6 class="text-primary"><i class="bi bi-droplet"></i> 冷水</h6>
                                <label class="form-label small">读数（m³） <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0" asp-for="ColdMeter" class="form-control" oninput="onReadingInput()">
                                <span asp-validation-for="ColdMeter" class="text-danger"></span>
                                <div class="form-text" id="hint-cold">用量：—</div>
                                <div class="upload-ph mt-2" onclick="alert('原型演示：实际弹出拍照/选图上传（自动加水印）')">
                                    <i class="bi bi-camera"></i>&nbsp;上传冷水照片
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card meter-card h-100">
                            <div class="card-body">
                                <h6 class="text-info"><i class="bi bi-steam"></i> 热水</h6>
                                <label class="form-label small">读数（m³） <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0" asp-for="HotMeter" class="form-control" oninput="onReadingInput()">
                                <span asp-validation-for="HotMeter" class="text-danger"></span>
                                <div class="form-text" id="hint-hot">用量：—</div>
                                <div class="upload-ph mt-2" onclick="alert('原型演示：实际弹出拍照/选图上传（自动加水印）')">
                                    <i class="bi bi-camera"></i>&nbsp;上传热水照片
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card meter-card h-100">
                            <div class="card-body">
                                <h6 class="text-warning"><i class="bi bi-lightning"></i> 电</h6>
                                <label class="form-label small">读数（度） <span class="text-danger">*</span></label>
                                <input type="number" step="0.01" min="0" asp-for="ElectricMeter" class="form-control" oninput="onReadingInput()">
                                <span asp-validation-for="ElectricMeter" class="text-danger"></span>
                                <div class="form-text" id="hint-electric">用量：—</div>
                                <div class="upload-ph mt-2" onclick="alert('原型演示：实际弹出拍照/选图上传（自动加水印）')">
                                    <i class="bi bi-camera"></i>&nbsp;上传电表照片
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 备注 -->
                <div class="card meter-card mt-3">
                    <div class="card-body">
                        <label class="form-label">备注</label>
                        <textarea asp-for="Remark" class="form-control" rows="2" placeholder="异常说明（如：PDA 未上传、读数修正原因等）"></textarea>
                        <span asp-validation-for="Remark" class="text-danger"></span>
                    </div>
                </div>

                <!-- 操作按钮 -->
                <div class="d-flex gap-2 mt-3">
                    <a href="/Meter" class="btn btn-secondary">取消</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check"></i> 提交
                    </button>
                </div>
            </div>

            <!-- 右侧：用量预览 -->
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header bg-light">
                        <strong><i class="bi bi-calculator"></i> 本月用量预览</strong>
                    </div>
                    <div class="card-body">
                        <div id="usagePreview" class="usage-preview">
                            <p class="text-muted small mb-0">请选择宿舍与月份，并录入读数</p>
                        </div>
                    </div>
                </div>

                @if (Model.LastRecord != null)
                {
                    <div class="card mt-3">
                        <div class="card-header bg-light">
                            <strong><i class="bi bi-clock-history"></i> 上月读数参考</strong>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm table-borderless mb-0">
                                <tr>
                                    <th width="80" class="text-muted">冷水</th>
                                    <td>@Model.LastRecord.ColdMeter.ToString("F2") m³</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">热水</th>
                                    <td>@Model.LastRecord.HotMeter.ToString("F2") m³</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">电</th>
                                    <td>@Model.LastRecord.ElectricMeter.ToString("F2") 度</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">月份</th>
                                    <td>@Model.LastRecord.ReadMonth</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function onDormMonthChange() {
            // TODO: 实际项目中应通过 AJAX 加载上月读数
            console.log('Dorm/Month changed');
        }

        function onReadingInput() {
            var cold = parseFloat(document.querySelector('input[name="ColdMeter"]').value) || 0;
            var hot = parseFloat(document.querySelector('input[name="HotMeter"]').value) || 0;
            var electric = parseFloat(document.querySelector('input[name="ElectricMeter"]').value) || 0;

            document.getElementById('hint-cold').textContent = '用量：' + cold.toFixed(2) + ' m³';
            document.getElementById('hint-hot').textContent = '用量：' + hot.toFixed(2) + ' m³';
            document.getElementById('hint-electric').textContent = '用量：' + electric.toFixed(2) + ' 度';

            var total = cold + hot + electric;
            var preview = document.getElementById('usagePreview');
            if (total > 0) {
                preview.innerHTML =
                    '<div class="d-flex justify-content-between mb-1">' +
                    '<span>冷水</span><span class="fw-bold">' + cold.toFixed(2) + ' m³</span>' +
                    '</div>' +
                    '<div class="d-flex justify-content-between mb-1">' +
                    '<span>热水</span><span class="fw-bold">' + hot.toFixed(2) + ' m³</span>' +
                    '</div>' +
                    '<div class="d-flex justify-content-between mb-1">' +
                    '<span>电</span><span class="fw-bold">' + electric.toFixed(2) + ' 度</span>' +
                    '</div>' +
                    '<hr>' +
                    '<div class="d-flex justify-content-between">' +
                    '<span class="fw-bold">合计</span><span class="fw-bold text-primary">' + total.toFixed(2) + '</span>' +
                    '</div>';
            } else {
                preview.innerHTML = '<p class="text-muted small mb-0">请输入读数</p>';
            }
        }
    </script>
}
