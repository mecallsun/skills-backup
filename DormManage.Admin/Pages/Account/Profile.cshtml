@page
@model DormManage.Admin.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "个人中心";
    Layout = "_Layout";
}

<div class="container-fluid">
    @Html.AntiForgeryToken()

    <!-- v2.13.49 P0：与 Basics 风格完全一致的 page-header -->
    <div class="page-header">
        <h2>
            <i class="bi bi-person-circle header-icon"></i> 个人中心
            <span class="header-count">@Model.SubMenuCount 类账号设置</span>
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/">首页</a></li>
                <li class="breadcrumb-item active" aria-current="page">个人中心</li>
            </ol>
        </nav>
    </div>

    <!-- v2.13.49 P0：左侧 200px 纵向 pills 导航 + 右侧 tab 面板（与 Basics 1:1 对齐） -->
    <div style="display: flex; align-items: flex-start; gap: 12px;">
        <!-- 左侧导航（200px） -->
        <div style="flex-shrink: 0; width: 200px;">
            <div class="card">
                <div class="card-body p-2">
                    <div class="nav flex-column nav-pills profile-nav" role="tablist">
                        <button class="nav-link text-start @(Model.ActiveTab == "overview" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-overview"
                                onclick="setProfileTab('overview')">
                            <i class="bi bi-person-vcard"></i> 账号总览
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "profile" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-profile"
                                onclick="setProfileTab('profile')">
                            <i class="bi bi-person"></i> 基本资料
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "password" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-password"
                                onclick="setProfileTab('password')">
                            <i class="bi bi-key"></i> 修改密码
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "security" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-security"
                                onclick="setProfileTab('security')">
                            <i class="bi bi-shield-question"></i> 安全问题
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "wechat" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-wechat"
                                onclick="setProfileTab('wechat')">
                            <i class="bi bi-wechat"></i> 微信绑定
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "prefs" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-prefs"
                                onclick="setProfileTab('prefs')">
                            <i class="bi bi-sliders"></i> 偏好设置
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "filter" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-filter"
                                onclick="setProfileTab('filter')">
                            <i class="bi bi-hdd"></i> 筛选缓存
                        </button>
                        <button class="nav-link text-start @(Model.ActiveTab == "logs" ? "active" : "")"
                                data-bs-toggle="pill" data-bs-target="#pane-logs"
                                onclick="setProfileTab('logs')">
                            <i class="bi bi-clock-history"></i> 操作日志
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- 右侧内容 -->
        <div style="flex: 1 1 0%;">
            <div class="tab-content" id="profileTabContent">

                <!-- 子菜单 1: 账号总览 -->
                <div class="tab-pane fade @(Model.ActiveTab == "overview" ? "show active" : "")" id="pane-overview" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <h5 class="mb-3"><i class="bi bi-person-vcard"></i> 账号信息</h5>
                            <dl class="row mb-3">
                                <dt class="col-sm-3 text-muted">用户名</dt>
                                <dd class="col-sm-9"><strong>@Model.UserName</strong></dd>

                                <dt class="col-sm-3 text-muted">显示名</dt>
                                <dd class="col-sm-9">@Model.DisplayName</dd>

                                <dt class="col-sm-3 text-muted">角色</dt>
                                <dd class="col-sm-9">
                                    @foreach (var role in Model.Roles)
                                    {
                                        <span class="badge bg-primary me-1">@role</span>
                                    }
                                </dd>

                                <dt class="col-sm-3 text-muted">手机号</dt>
                                <dd class="col-sm-9">@(Model.Mobile ?? "-")</dd>

                                <dt class="col-sm-3 text-muted">邮箱</dt>
                                <dd class="col-sm-9">@(Model.Email ?? "-")</dd>

                                <dt class="col-sm-3 text-muted">最近登录</dt>
                                <dd class="col-sm-9">
                                    <small class="text-muted">@(Model.LastLoginAt?.ToString("yyyy-MM-dd HH:mm") ?? "-")</small>
                                    @if (!string.IsNullOrEmpty(Model.LastLoginIp))
                                    {
                                        <small class="text-muted ms-2">@Model.LastLoginIp</small>
                                    }
                                </dd>

                                <dt class="col-sm-3 text-muted">微信绑定</dt>
                                <dd class="col-sm-9">
                                    @if (Model.IsWeChatBound)
                                    {
                                        <span class="badge bg-success"><i class="bi bi-check-circle"></i> 已绑定</span>
                                        <small class="text-muted d-block mt-1">@Model.WeChatBindAt?.ToString("yyyy-MM-dd HH:mm")</small>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">未绑定</span>
                                    }
                                </dd>
                            </dl>
                            <div class="d-flex gap-2">
                                <a href="/Account/Logout" class="btn btn-outline-danger">
                                    <i class="bi bi-box-arrow-right"></i> 退出登录
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 子菜单 2: 基本资料 -->
                <div class="tab-pane fade @(Model.ActiveTab == "profile" ? "show active" : "")" id="pane-profile" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-person"></i> 基本资料</h5>
                            </div>
                            <form id="profileForm" onsubmit="return submitProfile(event)">
                                <div class="mb-3">
                                    <label class="form-label">用户名</label>
                                    <input type="text" class="form-control" value="@Model.UserName" disabled readonly>
                                    <small class="text-muted">用户名不可修改</small>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">显示名 <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="profileDisplayName" maxlength="64" value="@Model.DisplayName" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">手机号</label>
                                    <input type="tel" class="form-control" id="profilePhone" maxlength="16" value="@Model.Mobile" pattern="^1[3-9]\d{9}$">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">邮箱</label>
                                    <input type="email" class="form-control" id="profileEmail" maxlength="64" value="@Model.Email">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">当前密码 <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" id="profileCurrentPassword" required>
                                    <small class="text-muted">敏感操作需验证当前密码</small>
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-save"></i> 保存资料
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 子菜单 3: 修改密码（v2.13.49 从原账号安全 Tab 拆出） -->
                <div class="tab-pane fade @(Model.ActiveTab == "password" ? "show active" : "")" id="pane-password" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-key"></i> 修改密码</h5>
                            </div>
                            <form id="passwordForm" onsubmit="return submitPassword(event)">
                                <div class="mb-3">
                                    <label class="form-label">原密码 <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" id="pwdOld" required>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">新密码 <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" id="pwdNew" minlength="8" required>
                                    <small class="text-muted">≥8 位，含字母与数字</small>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">确认新密码 <span class="text-danger">*</span></label>
                                    <input type="password" class="form-control" id="pwdConfirm" minlength="8" required>
                                </div>
                                <button type="submit" class="btn btn-warning">
                                    <i class="bi bi-key"></i> 修改密码
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- 子菜单 4: 安全问题（v2.13.49 从原账号安全 Tab 拆出） -->
                <div class="tab-pane fade @(Model.ActiveTab == "security" ? "show active" : "")" id="pane-security" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-shield-question"></i> 安全问题</h5>
                            </div>
                            <p class="text-muted small">请设置 2 个安全问题，答案保存为密文。忘记密码时需要回答这 2 个问题。</p>
                            <div id="sqListArea">
                                <p class="text-muted small"><i class="bi bi-info-circle"></i> 加载中...</p>
                            </div>
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="openSqModal()">
                                <i class="bi bi-pencil"></i> 修改安全问题
                            </button>
                        </div>
                    </div>
                </div>

                <!-- 子菜单 5: 微信绑定（v2.13.49 从原账号安全 Tab 拆出） -->
                <div class="tab-pane fade @(Model.ActiveTab == "wechat" ? "show active" : "")" id="pane-wechat" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-wechat"></i> 微信绑定</h5>
                            </div>
                            <div id="wechatStatus">
                                @if (Model.IsWeChatBound)
                                {
                                    <div class="alert alert-success py-2">
                                        <i class="bi bi-check-circle"></i> 已绑定微信 OpenID: <code>@Model.MaskedWeChatOpenId</code>
                                        <small class="d-block mt-1">绑定时间: @Model.WeChatBindAt?.ToString("yyyy-MM-dd HH:mm")</small>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="openUnbindWeChatModal()">
                                        <i class="bi bi-x-circle"></i> 解绑微信
                                    </button>
                                }
                                else
                                {
                                    <div class="alert alert-warning py-2">
                                        <i class="bi bi-exclamation-triangle"></i> 未绑定微信。可在扫码登录后填入 OpenID 完成绑定。
                                    </div>
                                    <button type="button" class="btn btn-outline-success btn-sm" onclick="openBindWeChatModal()">
                                        <i class="bi bi-wechat"></i> 绑定微信
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 子菜单 6: 偏好设置 -->
                <div class="tab-pane fade @(Model.ActiveTab == "prefs" ? "show active" : "")" id="pane-prefs" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-sliders"></i> 偏好设置</h5>
                            </div>
                            <div class="form-section mb-3">
                                <div class="form-section-title">界面偏好</div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="darkModePref">
                                    <label class="form-check-label" for="darkModePref">
                                        深色模式
                                    </label>
                                </div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="compactModePref">
                                    <label class="form-check-label" for="compactModePref">
                                        紧凑布局
                                    </label>
                                </div>
                                <p class="text-muted small"><i class="bi bi-info-circle"></i> 深色/紧凑模式将在 v2.14 实施（预留接口）</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 子菜单 7: 筛选缓存 -->
                <div class="tab-pane fade @(Model.ActiveTab == "filter" ? "show active" : "")" id="pane-filter" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-hdd"></i> 筛选条件缓存</h5>
                            </div>
                            <div class="form-section mb-3">
                                <div class="form-section-title">筛选条件持久化</div>
                                <div class="form-check form-switch mb-3">
                                    <input class="form-check-input" type="checkbox" id="storeFilterPreference" @(Model.StoreFilterPreference ? "checked" : "")>
                                    <label class="form-check-label" for="storeFilterPreference">
                                        <strong>存储筛选条件到云端</strong>
                                    </label>
                                </div>
                                <p class="text-muted small mb-3">
                                    <i class="bi bi-info-circle"></i>
                                    勾选后，您在各列表模块（人员/宿舍/办理/抄表/账单）的筛选条件将保存到云端数据库。
                                </p>
                                <div id="cacheListArea">
                                    @if (Model.CachedModules != null && Model.CachedModules.Any())
                                    {
                                        <div class="list-group">
                                            @foreach (var item in Model.CachedModules)
                                            {
                                                <div class="list-group-item d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <i class="bi bi-check-circle-fill text-success me-2"></i>
                                                        <strong>@GetModuleDisplayName(item.ModuleName)</strong>
                                                        <small class="text-muted ms-2">@item.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                                                    </div>
                                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="resetFilterCache('@item.ModuleName')">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted small mb-3"><i class="bi bi-info-circle"></i> 暂无已缓存的筛选模块</p>
                                    }
                                </div>
                                <div class="d-flex gap-2 mt-3">
                                    <button type="button" class="btn btn-outline-warning btn-sm" onclick="resetAllFilterCache()">
                                        <i class="bi bi-trash"></i> 清除全部云端筛选缓存
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="clearLocalStorageCache()">
                                        <i class="bi bi-hdd"></i> 清除本地缓存
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 子菜单 8: 操作日志（v2.14 实施 - 当前为预留 Tab） -->
                <div class="tab-pane fade @(Model.ActiveTab == "logs" ? "show active" : "")" id="pane-logs" role="tabpanel">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h5 class="mb-0"><i class="bi bi-clock-history"></i> 我的操作日志</h5>
                                <small class="text-muted">v2.14 实施</small>
                            </div>
                            <div class="alert alert-info py-2">
                                <i class="bi bi-info-circle"></i>
                                本人最近 20 条操作记录将在 v2.14 版本上线（数据源 <code>SysOpLog WHERE UserId = [当前登录用户]</code>）。
                                <br />v2.13.49 起已在 <code>SysUserSelfService</code> 6 个敏感方法（资料更新/密码修改/安全问题/密码重置/微信绑定解绑）写入 SysOpLog。
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- 安全问题编辑 Modal -->
<div class="modal fade" id="sqModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-shield-question"></i> 设置安全问题</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">建议选择 <strong>不容易被他人查到</strong> 且 <strong>自己不容易忘记</strong> 的答案。</p>
                <form id="sqForm">
                    <div class="mb-3">
                        <label class="form-label">问题 1</label>
                        <select class="form-select" id="sqQuestion1">
                            <option>您出生的城市是？</option>
                            <option>您母亲的名字是？</option>
                            <option>您第一所小学的名称是？</option>
                            <option>您的工号/学号末四位是？</option>
                            <option>您最喜爱的书籍是？</option>
                            <option>您的宠物名字是？</option>
                        </select>
                        <input type="text" class="form-control mt-2" id="sqAnswer1" placeholder="答案" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">问题 2</label>
                        <select class="form-select" id="sqQuestion2">
                            <option>您出生的城市是？</option>
                            <option>您母亲的名字是？</option>
                            <option>您第一所小学的名称是？</option>
                            <option>您的工号/学号末四位是？</option>
                            <option>您最喜爱的书籍是？</option>
                            <option>您的宠物名字是？</option>
                        </select>
                        <input type="text" class="form-control mt-2" id="sqAnswer2" placeholder="答案" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">当前密码 <span class="text-danger">*</span></label>
                        <input type="password" class="form-control" id="sqCurrentPassword" required>
                        <small class="text-muted">敏感操作需要验证当前密码</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" onclick="submitSq()">保存</button>
            </div>
        </div>
    </div>
</div>

<!-- 微信绑定 Modal -->
<div class="modal fade" id="wechatBindModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-wechat"></i> 绑定微信 OpenID</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">请使用企业微信扫描登录获取 OpenID 后填入下方输入框。</p>
                <div class="mb-3">
                    <label class="form-label">OpenID <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="wechatOpenId" placeholder="o6_bm1JZq..." pattern="^[A-Za-z0-9_-]{16,64}$" required>
                    <small class="text-muted">格式: 16-64 位字母/数字/下划线/连字符</small>
                </div>
                <div class="mb-3">
                    <label class="form-label">当前密码 <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" id="wechatBindPwd" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-success" onclick="submitBindWeChat()">绑定</button>
            </div>
        </div>
    </div>
</div>

<!-- 微信解绑 Modal -->
<div class="modal fade" id="wechatUnbindModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-wechat"></i> 解绑微信</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning py-2">
                    <i class="bi bi-exclamation-triangle"></i> 解绑后将无法使用微信扫码登录。确认要解绑吗？
                </div>
                <div class="mb-3">
                    <label class="form-label">当前密码 <span class="text-danger">*</span></label>
                    <input type="password" class="form-control" id="wechatUnbindPwd" required>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-danger" onclick="submitUnbindWeChat()">确认解绑</button>
            </div>
        </div>
    </div>
</div>

@functions {
    public string GetModuleDisplayName(string module)
    {
        return module switch
        {
            "personnel" => "人员清单",
            "dorms" => "宿舍档案",
            "booking" => "办理登记",
            "meter" => "抄表记录",
            "billingStandard" => "费用标准",
            "dormBilling" => "宿舍账单",
            "employeeBilling" => "员工账单",
            _ => module
        };
    }
}

@section Styles {
<style>
    /* v2.13.49：与 Basics 完全一致的 pills 样式 */
    .profile-nav .nav-link {
        border-radius: 6px;
        padding: 0.6rem 0.85rem;
        margin-bottom: 2px;
        font-size: 0.88rem;
        color: #495057;
        background: transparent;
    }
    .profile-nav .nav-link i { margin-right: 0.5rem; font-size: 1rem; }
    .profile-nav .nav-link:hover { background: #f0f4f8; }
    .profile-nav .nav-link.active {
