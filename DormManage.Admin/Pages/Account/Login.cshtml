@page
@model DormManage.Admin.Pages.Account.LoginModel
@{
    ViewData["Title"] = "登录 - 金戈宿舍管理系统";
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: "Microsoft YaHei UI", sans-serif;
            background: linear-gradient(135deg, #1976d2 0%, #0d47a1 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            max-width: 420px;
            width: 100%;
            overflow: hidden;
        }
        .login-header {
            background: linear-gradient(135deg, #1976d2, #1565c0);
            color: #fff;
            padding: 2.5rem 2rem 2rem;
            text-align: center;
        }
        .login-header i {
            font-size: 3rem;
            margin-bottom: 0.75rem;
            display: block;
        }
        .login-header h3 {
            font-weight: bold;
            margin-bottom: 0.25rem;
        }
        .login-header small {
            opacity: 0.85;
            font-size: 0.85rem;
        }
        .login-body {
            padding: 2rem;
        }
        .login-body .form-floating > label {
            color: #90a4ae;
        }
        .login-body .btn-primary {
            background: #1976d2;
            border-color: #1976d2;
            padding: 0.75rem;
            font-size: 1rem;
            font-weight: 600;
        }
        .login-body .btn-primary:hover {
            background: #1565c0;
            border-color: #1565c0;
        }
        .error-message {
            background: #ffebee;
            color: #c62828;
            border: 1px solid #ef9a9a;
            border-radius: 8px;
            padding: 0.75rem 1rem;
            margin-bottom: 1rem;
            font-size: 0.9rem;
        }
        .version-badge {
            position: absolute;
            bottom: 1rem;
            right: 1rem;
            background: rgba(255,255,255,0.15);
            color: #fff;
            padding: 0.25rem 0.75rem;
            border-radius: 20px;
            font-size: 0.75rem;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <i class="bi bi-house-door"></i>
            <h3>金戈宿舍管理系统</h3>
            <small>请登录以继续使用</small>
        </div>
        <div class="login-body">
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="error-message">
                    <i class="bi bi-exclamation-triangle me-1"></i> @Model.ErrorMessage
                </div>
            }

            <form method="post">
                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="UserName" type="text" class="form-control" id="userNameInput" placeholder="请输入用户名" autocomplete="username" autofocus />
                        <label for="userNameInput"><i class="bi bi-person me-1"></i>用户名</label>
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <div class="form-floating">
                        <input asp-for="Password" type="password" class="form-control" id="passwordInput" placeholder="请输入密码" autocomplete="current-password" />
                        <label for="passwordInput"><i class="bi bi-lock me-1"></i>密码</label>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3 form-check">
                    <input asp-for="RememberMe" class="form-check-input" id="rememberCheck" />
                    <label class="form-check-label text-muted" for="rememberCheck">
                        记住登录状态
                    </label>
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-box-arrow-in-right me-1"></i> 登录
                </button>
            </form>

            <div class="text-center mt-3">
                <a href="/Account/ForgotPassword" class="text-muted small">
                    <i class="bi bi-question-circle"></i> 忘记密码？
                </a>
            </div>
        </div>
    </div>

    <div class="version-badge">v2.13.31</div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.20.1/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
