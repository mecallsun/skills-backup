@page
@model DormManage.Admin.Pages.Personnel.IndexModel
@{
    ViewData["Title"] = "人员清单";
    Layout = "_Layout";

    var currentPage = Model.PageIndex;
    var pageSize = Model.PageSize;
    var totalCount = Model.Result?.TotalCount ?? 0;
    var totalPages = totalCount > 0 ? (int)Math.Ceiling(totalCount / (double)pageSize) : 0;
    var startIndex = (currentPage - 1) * pageSize + 1;
}

<div class="container-fluid">
    @Html.AntiForgeryToken()
    <!-- 页头（v2.13.15 使用 PageHeader 组件） -->
    @await Component.InvokeAsync("PageHeader", new {
        icon = "bi-people-fill",
        title = "人员清单",
        count = Model.Total,
        countLabel = "人",
        primaryAction = new PageAction { Label = "新增", Url = "/Personnel/Create", Icon = "bi-plus-lg", Style = "success", PermissionCode = "personnel:import" },
        actions = new List<PageAction> {
            new() { Label = "导入", Url = "/Personnel/Import", Icon = "bi-upload", Style = "info", PermissionCode = "personnel:import" },
            // v2.13.88 第四轮：导出按钮加 personnel:export 权限管控
            new() { Label = "导出", OnClick = "location.href='/api/v1/personnel/export'", Icon = "bi-file-earmark-excel", Style = "success", PermissionCode = "personnel:export" }
        }
    })

    <!-- 筛选条件区域（v2.13.20 统一 flex-nowrap 一行排列，响应式） -->
    <form method="get" class="card mb-3 filter-card" data-filter-form="personnel">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end flex-nowrap filter-row">
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">关键词</label>
                    <input type="text" name="Keyword" value="@Model.Keyword" class="form-control" placeholder="姓名/工号/手机号">
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">部门</label>
                    <select name="DepartmentId" class="form-select">
                        <option value="">全部</option>
                        @foreach (var dept in Model.Departments)
                        {
                            <option value="@dept.Id" selected="@(Model.DepartmentId == dept.Id)">
                                @dept.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">员工类型</label>
                    <select name="EmployeeTypeId" class="form-select">
                        <option value="">全部</option>
                        @foreach (var et in Model.EmployeeTypes)
                        {
                            <option value="@et.Id" selected="@(Model.EmployeeTypeId == et.Id)">
                                @et.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">班组</label>
                    <select name="TeamId" class="form-select">
                        <option value="">全部</option>
                        @foreach (var team in Model.Teams)
                        {
                            <option value="@team.Id" selected="@(Model.TeamId == team.Id)">
                                @team.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">考勤班次</label>
                    <select name="AttendanceTypeId" class="form-select">
                        <option value="">全部</option>
                        @foreach (var at in Model.AttendanceTypes)
                        {
                            <option value="@at.Id" selected="@(Model.AttendanceTypeId == at.Id)">
                                @at.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">在职状态</label>
                    <select name="EmploymentStatusId" class="form-select">
                        <option value="">全部</option>
                        @foreach (var es in Model.EmploymentStatuses)
                        {
                            <option value="@es.Id" selected="@(Model.EmploymentStatusId == es.Id)">
                                @es.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">宿舍（房号）</label>
                    <input type="text" name="DormCode" value="@Model.DormCode" class="form-control" placeholder="如 D-001（模糊匹配）" list="dormList">
                    <datalist id="dormList">
                        @if (Model.DormCodes != null)
                        {
                            @foreach (var code in Model.DormCodes)
                            {
                                <option value="@code"></option>
                            }
                        }
                    </datalist>
                </div>
                <div class="col-auto filter-item filter-item-btn">
                    <button type="submit" class="btn btn-primary filter-btn">
                        <i class="bi bi-search"></i> 查询
                    </button>
                </div>
                <div class="col-auto filter-item filter-item-btn">
                    <button type="button" class="btn btn-outline-secondary filter-btn" onclick="FilterPersistence.resetFilters('personnel')">
                        <i class="bi bi-arrow-clockwise"></i> 重置
                    </button>
                </div>
            </div>
        </div>
    </form>

    <!-- 列表 -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th width="60" class="text-center">序号</th>
                            <th>工号</th>
                            @* v2.13.92 字段权限：姓名列条件渲染 *@
                            <th class="@(await Html.IsFieldHiddenAsync("employee.realname") ? "d-none" : "")">姓名</th>
                            @* v2.13.87 性别列居中，与原型 list.html <th class="text-center"> 一致 *@
                            <th class="text-center">性别</th>
                            @* v2.13.92 字段权限：手机号列条件渲染 *@
                            <th class="@(await Html.IsFieldHiddenAsync("employee.phone") ? "d-none" : "")">手机号</th>
                            <th>部门</th>
                            <th>员工类型</th>
                            <th>班组</th>
                            <th>考勤班次</th>
                            <th>入职日期</th>
                            <th>在职状态</th>
                            <th>离职日期</th>
                            <th>宿舍（房号）</th>
                            <th>床号</th>
                            <th width="200" class="text-center">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Result?.Items.Count > 0)
                        {
                            var index = startIndex;
                            foreach (var item in Model.Result.Items)
                            {
    // v2.11.7.CORRECT 员工类型 Badge 颜色映射（仅 5 种，与基础资料-员工类型列表一致）
                                string empTypeClass = item.EmployeeTypeCode switch
                                {
                                    "CONTRACT" => "bg-secondary",
                                    "TEMPORARY" => "bg-warning text-dark",
                                    "OUTSOURCE" => "bg-info text-dark",
                                    "INTERN" => "bg-success",
                                    "ONSITE" => "bg-dark",
                                    _ => "bg-light text-dark border"
                                };

                                // 考勤班次 Badge 颜色映射
                                string attClass = item.AttendanceTypeCode switch
                                {
                                    "DEFAULT" => "bg-secondary",
                                    "MORNING" => "bg-primary",
                                    "MIDDLE" => "bg-info",
                                    "EVENING" => "bg-warning text-dark",
                                    "NIGHT" => "bg-dark",
                                    "OTHER" => "bg-light text-dark border",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td class="text-center text-muted">@index</td>
                                    <td><strong>@item.EmployeeCode</strong></td>
                                    @* v2.13.92 字段权限：姓名单元格条件渲染 *@
                                    @if (!await Html.IsFieldHiddenAsync("employee.realname"))
                                    {
                                        <td>@item.RealName</td>
                                    }
                                    else
                                    {
                                        <td class="d-none"></td>
                                    }
                                    <td class="text-center">
                                        @* v2.13.87 性别 Badge：男=primary蓝 / 女=danger粉 / 未知=secondary *@
                                        @if (item.Gender == 1)
                                        {
                                            <span class="badge bg-primary"><i class="bi bi-gender-male"></i> 男</span>
                                        }
                                        else if (item.Gender == 2)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-gender-female"></i> 女</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary text-dark">未知</span>
                                        }
                                    </td>
                                    <td class="@(await Html.IsFieldHiddenAsync("employee.phone") ? "d-none" : "")">@(await Html.IsFieldHiddenAsync("employee.phone") ? "***" : item.Phone)</td>
                                    <td>@item.Department</td>
                                    <td>
                                        <span class="badge @empTypeClass" title="FK: EmployeeType.Id = @item.EmployeeTypeId">
                                            @item.EmployeeTypeName
                                        </span>
                                    </td>
                                    <td>@item.TeamName</td>
                                    <td>
                                        <span class="badge @attClass">@item.AttendanceTypeName</span>
                                    </td>
                                    <td>@item.HireDate</td>
                                    <td>
                                        @if (item.Status == 1)
                                        {
                                            <span class="badge bg-success">在职</span>
                                        }
                                        else if (item.Status == 2)
                                        {
                                            <span class="badge bg-warning text-dark">待入职</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">已离职</span>
                                        }
                                    </td>
                                    <td>@item.LeaveDate</td>
                                    <td>@item.DormCode</td>
                                    <td>@(item.BedNo > 0 ? item.BedNo.ToString() : "-")</td>
                                    <td class="text-center">
                                        @* v2.13.88 RBAC 细化：编辑 → personnel:edit / 离职 → personnel:markleft / 删除 → personnel:delete *@
                                        @if (await Html.HasPermissionAsync("personnel:edit"))
                                        {
                                            <a href="/Personnel/Edit?id=@item.Id" class="btn btn-sm btn-outline-primary" data-return-list>编辑</a>
                                        }
                                        @if (await Html.HasPermissionAsync("personnel:markleft"))
                                        {
                                            @if (item.Status == 1)
                                            {
                                                <button class="btn btn-sm btn-outline-warning" onclick="markLeft(@item.Id, '@item.RealName')">离职</button>
                                            }
                                        }
                                        @if (await Html.HasPermissionAsync("personnel:delete"))
                                        {
                                            <button class="btn btn-sm btn-outline-danger" onclick="del(@item.Id, '@item.RealName')">删除</button>
                                        }
                                        @* 完全无权限时显示提示 *@
                                        @if (!await Html.HasPermissionAsync("personnel:edit") && !await Html.HasPermissionAsync("personnel:markleft") && !await Html.HasPermissionAsync("personnel:delete"))
                                        {
                                            <small class="text-muted"><i class="bi bi-lock"></i> 无操作权限</small>
                                        }
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="15" class="text-center text-muted py-4">暂无人员数据</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- 页尾分页（v2.13.71 100% 原型对齐） -->
            @await Html.PartialAsync("_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel
            {
                PageIndex = currentPage,
                PageSize = pageSize,
                TotalCount = totalCount
            })
        </div>
    </div>
</div>

@section Styles {
<style>
    /* 表格样式优化 */
    .table th {
        white-space: nowrap;
        font-weight: 500;
    }

    .table td {
        vertical-align: middle;
    }

    /* 分页样式 */
    .pagination-footer {
        background: transparent;
        border: none;
        padding: 0.75rem 0 0 0;
    }

    .pagination .page-link {
        min-width: 32px;
        text-align: center;
    }
</style>
}

@section Scripts {
<script>
    function markLeft(id, name) {
        if (!confirm('确定将人员 ' + name + ' 标记为离职吗？')) return;
        const f = document.createElement('form');
        f.method = 'post';
        f.action = '/Personnel?handler=MarkLeft&id=' + id;
        const t = document.querySelector('input[name="__RequestVerificationToken"]');
        if (t) f.appendChild(t.cloneNode());
        document.body.appendChild(f);
        f.submit();
    }

    function del(id, name) {
        if (!confirm('确定删除人员 ' + name + ' 吗？此操作不可恢复。')) return;
        const f = document.createElement('form');
        f.method = 'post';
        f.action = '/Personnel?handler=Delete&id=' + id;
        const t = document.querySelector('input[name="__RequestVerificationToken"]');
        if (t) f.appendChild(t.cloneNode());
        document.body.appendChild(f);
        f.submit();
    }
</script>
}
