@page
@model DormManage.Admin.Pages.Personnel.EditModel
@{
    ViewData["Title"] = "编辑人员";
    Layout = "_Layout";
}

<div class="container-fluid px-4 py-3">
@Html.AntiForgeryToken()
    <!-- 页头（v2.12.27 与原型 edit.html 一致） -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-person-gear"></i> 编辑人员
            <small class="text-muted ms-2 fs-6">@Model.EmployeeCode · @Model.RealName</small>
            @* v2.13.88 RBAC 只读模式：顶角显示「只读」徽章 *@
            @if (Model.IsReadOnly)
            {
                <span class="badge bg-warning text-dark ms-2"><i class="bi bi-lock-fill"></i> 只读模式</span>
            }
        </h2>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/Personnel">人员清单</a></li>
                <li class="breadcrumb-item active" aria-current="page">编辑员工</li>
            </ol>
        </nav>
    </div>

    @* v2.13.88 RBAC 只读模式提示 alert *@
    @if (Model.IsReadOnly)
    {
        <div class="alert alert-warning py-2 mb-3">
            <i class="bi bi-shield-lock"></i> 您没有 <strong>编辑员工</strong> 权限，当前页面以<strong>只读</strong>模式展示。如需修改，请联系系统管理员分配「personnel:edit」权限。
        </div>
    }

    <!-- 表单卡片（v2.12.27 与新增人员布局一致） -->
    <div class="form-card">
        <div class="form-card-header">
            <i class="bi bi-person-vcard text-primary"></i>
            <h3>人员信息编辑</h3>
        </div>

        <form method="post">
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="All" class="text-danger m-3"></div>
            <div class="form-card-body">

                <!-- 区块 1：基本信息（4 字段，工号只读） -->
                <div class="form-section">
                    <div class="form-section-title">基本信息</div>
                    <div class="row g-2">
                        <div class="col-md-3 form-field">
                            <label class="form-label">工号<span class="required">*</span></label>
                            <input class="form-control form-readonly" value="@Model.EmployeeCode" readonly />
                        </div>
                        <div class="col-md-3 form-field">
                            <label class="form-label">姓名<span class="required">*</span></label>
                            <input asp-for="Input.RealName" class="form-control" required maxlength="50" />
                        </div>
                        <div class="col-md-3 form-field">
                            <label class="form-label">手机号</label>
                            <input asp-for="Input.Phone" class="form-control" maxlength="20" placeholder="11位手机号" />
                        </div>
                        @* v2.13.83 新增：性别 select（必填；与 v2.13.83 行政资料回填 + 姓名推断配套） *@
                        <div class="col-md-3 form-field">
                            <label class="form-label">性别<span class="required">*</span></label>
                            <select asp-for="Input.Gender" class="form-select" required>
                                <option value="1">男</option>
                                <option value="2">女</option>
                            </select>
                            <span class="text-danger small" asp-validation-for="Input.Gender"></span>
                        </div>
                        <div class="col-md-3 form-field">
                            <label class="form-label">入职日期<span class="required">*</span></label>
                            <input asp-for="Input.HireDate" type="date" class="form-control" required />
                        </div>
                    </div>
                </div>

                <!-- 区块 2：组织与岗位（5 字段） -->
                <div class="form-section">
                    <div class="form-section-title">组织与岗位</div>
                    <div class="row g-2">
                        <div class="col-md-3 form-field">
                            <label class="form-label">部门<span class="required">*</span></label>
                            <select asp-for="Input.DepartmentId" asp-items="Model.Departments" class="form-select" required>
                                <option value="">请选择部门</option>
                            </select>
                        </div>
                        <div class="col-md-3 form-field">
                            <label class="form-label">员工类型<span class="required">*</span></label>
                            <select asp-for="Input.EmployeeTypeId" asp-items="Model.EmployeeTypes" class="form-select" required>
                                <option value="">请选择员工类型</option>
                            </select>
                        </div>
                        <div class="col-md-3 form-field">
                            <label class="form-label">考勤班次<span class="required">*</span></label>
                            <select asp-for="Input.AttendanceTypeId" asp-items="Model.AttendanceTypes" class="form-select" required>
                                <option value="">请选择考勤班次</option>
                            </select>
                        </div>
                        <div class="col-md-3 form-field">
                            <label class="form-label">班组</label>
                            <select asp-for="Input.TeamId" asp-items="Model.Teams" class="form-select">
                                <option value="">请选择班组</option>
                            </select>
                        </div>
                        <div class="col-md-3 form-field">
                            <label class="form-label">在职状态<span class="required">*</span></label>
                            <select asp-for="Input.EmploymentStatusId" asp-items="Model.EmploymentStatuses" class="form-select" required>
                                <option value="">请选择在职状态</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- 区块 3：住宿信息（房号/床号只读，通过办理登记分配） -->
                <div class="form-section">
                    <div class="form-section-title">住宿信息</div>
                    <div class="row g-2">
                        <div class="col-md-3 form-field">
                            <label class="form-label">房号</label>
                            <input asp-for="Input.DormCode" class="form-control form-readonly" readonly placeholder="通过办理登记分配" />
                        </div>
                        <div class="col-md-3 form-field">
                            <label class="form-label">床号</label>
                            <input asp-for="Input.BedNo" type="number" min="0" class="form-control form-readonly" readonly placeholder="通过办理登记分配" />
                        </div>
                    </div>
                </div>

                <!-- 区块 4：其他信息 -->
                <div class="form-section" style="margin-bottom: 0;">
                    <div class="form-section-title">其他信息</div>
                    <div class="form-field" style="margin-bottom: 0;">
                        <label class="form-label">备注</label>
                        <textarea asp-for="Input.Remark" class="form-control" rows="2" maxlength="500" placeholder="选填"></textarea>
                    </div>
                </div>

            </div>

            <!-- 操作按钮区 -->
            <div class="form-actions">
                <a href="/Personnel" class="btn btn-outline-secondary" data-back-to-list="/Personnel" onclick="ReturnUrl.handleBack(event)"><i class="bi bi-x"></i> 取消</a>
                @if (!Model.IsReadOnly)
                {
                    @if (Model.EmploymentStatusId != 3)
                    {
                        <button type="button" class="btn btn-outline-warning" onclick="markLeft()"><i class="bi bi-person-dash"></i> 标记离职</button>
                    }
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> 保存修改</button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    function markLeft() {
        if (!confirm('确定要将该员工标记为离职吗？')) return;
        const f = document.createElement('form');
        f.method = 'post';
        f.action = '?handler=MarkLeft&id=@Model.Id';
        // v2.13.40 BUG 修复：必须把 Id 一起 POST，否则 OnPostMarkLeft 会收到 Id=0，跳转 Edit?id=0 失败
        const idInput = document.createElement('input');
        idInput.type = 'hidden';
        idInput.name = 'Id';
        idInput.value = '@Model.Id';
        f.appendChild(idInput);
        const t = document.querySelector('input[name="__RequestVerificationToken"]');
        if (t) f.appendChild(t.cloneNode());
        document.body.appendChild(f);
        f.submit();
    }
</script>
}

@section Styles {
<style>
    .form-card { background: #fff; border-radius: 12px; box-shadow: 0 1px 4px rgba(0,0,0,.06); border: 1px solid #eee; overflow: hidden; }
    .form-card-header { padding: .75rem 1.25rem; border-bottom: 1px solid #eee; background: #fafbfc; display: flex; align-items: center; gap: .5rem; }
    .form-card-header h3 { margin: 0; font-size: 1rem; font-weight: 600; color: #1976d2; }
    .form-card-body { padding: 1rem 1.25rem; }
    .form-section { margin-bottom: .75rem; }
    .form-section-title { font-size: .85rem; font-weight: 600; color: #1976d2; border-left: 3px solid #1976d2; padding-left: .5rem; margin-bottom: .5rem; }
    .form-field { margin-bottom: .6rem; }
    .form-label { font-size: .85rem; font-weight: 500; color: #495057; margin-bottom: .2rem; }
    .form-label .required { color: #dc3545; margin-left: 2px; }
    .form-control, .form-select { border-radius: 6px; padding: .375rem .75rem; font-size: .9rem; }
    .form-actions { background: #fafbfc; border-top: 1px solid #eee; padding: .75rem 1.25rem; display: flex; justify-content: flex-end; gap: .75rem; align-items: center; }
    .form-actions .btn { min-width: 100px; }
    .form-readonly { background: #f5f7fa; cursor: not-allowed; }
</style>
}