@page
@model IndexModel
@{
    ViewData["Title"] = "首页";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- 页头 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-speedometer2"></i> 数据看板
        </h2>
        <div class="d-flex align-items-center gap-2">
            <form method="get" class="d-flex align-items-center gap-2">
                <label class="text-muted small mb-0">参考月份：</label>
                <select name="month" class="form-select form-select-sm" style="width:auto;" onchange="this.form.submit()">
                    @foreach (var m in Model.AvailableMonths)
                    {
                        if (m == Model.CurrentMonth)
                        {
                            <option value="@m" selected>@m</option>
                        }
                        else
                        {
                            <option value="@m">@m</option>
                        }
                    }
                </select>
                <noscript><button type="submit" class="btn btn-sm btn-primary">切换</button></noscript>
            </form>
            <small class="text-muted">
                <i class="bi bi-calendar3"></i> @DateTime.Now.ToString("yyyy年MM月dd日")
            </small>
        </div>
    </div>

    <!-- 第一行：4 个 KPI 卡片 -->
    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #1976d2;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;background:#e3f2fd;">
                            <i class="bi bi-building text-primary fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <div class="text-muted mb-1">宿舍总量</div>
                        <div class="fs-3 fw-bold text-dark">@Model.Dashboard.Kpi.TotalDorms</div>
                        <small class="text-muted">共 <span class="text-dark fw-semibold">@Model.Dashboard.Kpi.TotalBeds</span> 个床位</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #388e3c;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;background:#e8f5e9;">
                            <i class="bi bi-graph-up text-success fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <div class="text-muted mb-1">入住率</div>
                        <div class="fs-3 fw-bold text-dark">@Model.Dashboard.Kpi.OccupancyRate%</div>
                        <small class="text-muted"><span class="text-success fw-semibold">@Model.Dashboard.Kpi.CurrentOccupancy</span> 人已入住</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #f57c00;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;background:#fff3e0;">
                            <i class="bi bi-people text-warning fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <div class="text-muted mb-1">员工总数</div>
                        <div class="fs-3 fw-bold text-dark">@Model.Dashboard.Kpi.TotalEmployees</div>
                        <small class="text-muted">在职员工</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #7b1fa2;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;background:#f3e5f5;">
                            <i class="bi bi-clipboard-check fs-4" style="color:#7b1fa2;"></i>
                        </div>
                    </div>
                    <div>
                        <div class="text-muted mb-1">今日办理</div>
                        <div class="fs-3 fw-bold text-dark">@Model.Dashboard.Kpi.TodayCheckIns + @Model.Dashboard.Kpi.TodayCheckOuts</div>
                        <small class="text-muted">入住 <span class="text-success fw-semibold">@Model.Dashboard.Kpi.TodayCheckIns</span> 退房 <span class="text-danger fw-semibold">@Model.Dashboard.Kpi.TodayCheckOuts</span></small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 第二行：入住率趋势（折线图）+ 月度办理趋势（折线图） -->
    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-graph-up-arrow me-1 text-success"></i>入住率趋势（最近 12 个月）</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartOccupancyTrend" height="100"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-clipboard-data me-1 text-primary"></i>月度办理趋势</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartBookingTrend" height="100"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 第三行：部门分布 + 员工类型分布（两个饼图）+ 楼栋分布（柱状图） -->
    <div class="row g-3 mb-4">
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-pie-chart me-1 text-info"></i>部门人员分布</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartDepartment" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-pie-chart me-1 text-warning"></i>员工类型分布</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartEmployeeType" height="200"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-bar-chart me-1 text-success"></i>楼栋床位分布</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartBuilding" height="200"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 第四行：入住率 TOP 10 + 月度抄表统计 -->
    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-trophy me-1 text-warning"></i>入住率 TOP 10 宿舍</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartTopDorms" height="180"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-gauge me-1 text-secondary"></i>月度抄表统计（最近 12 个月）</h6>
                </div>
                <div class="card-body">
                    <canvas id="chartMeterCount" height="180"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- 第五行：快捷入口 -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white">
            <h6 class="mb-0 fw-semibold"><i class="bi bi-lightning-fill me-1 text-warning"></i>快捷入口</h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3 col-6">
                    <a href="/Booking" class="btn btn-outline-primary w-100 py-3 quick-btn">
                        <i class="bi bi-clipboard-check fs-5 d-block mb-1"></i><small>办理登记</small>
                    </a>
                </div>
                <div class="col-md-3 col-6">
                    <a href="/Booking/CheckIn" class="btn btn-outline-success w-100 py-3 quick-btn">
                        <i class="bi bi-box-arrow-in-right fs-5 d-block mb-1"></i><small>入住办理</small>
                    </a>
                </div>
                <div class="col-md-3 col-6">
                    <a href="/Booking/CheckOut" class="btn btn-outline-danger w-100 py-3 quick-btn">
                        <i class="bi bi-box-arrow-right fs-5 d-block mb-1"></i><small>退房办理</small>
                    </a>
                </div>
                <div class="col-md-3 col-6">
                    <a href="/Dorms" class="btn btn-outline-info w-100 py-3 quick-btn">
                        <i class="bi bi-building fs-5 d-block mb-1"></i><small>宿舍管理</small>
                    </a>
                </div>
                <div class="col-md-3 col-6">
                    <a href="/Personnel" class="btn btn-outline-warning w-100 py-3 quick-btn">
                        <i class="bi bi-people fs-5 d-block mb-1"></i><small>人员清单</small>
                    </a>
                </div>
                <div class="col-md-3 col-6">
                    <a href="/DormBilling" class="btn btn-outline-secondary w-100 py-3 quick-btn">
                        <i class="bi bi-receipt fs-5 d-block mb-1"></i><small>宿舍账单</small>
                    </a>
                </div>
                <div class="col-md-3 col-6">
                    <a href="/Meter" class="btn btn-outline-dark w-100 py-3 quick-btn">
                        <i class="bi bi-gauge fs-5 d-block mb-1"></i><small>抄表记录</small>
                    </a>
                </div>
                <div class="col-md-3 col-6">
                    <a href="/Settings" class="btn btn-outline-primary w-100 py-3 quick-btn">
                        <i class="bi bi-gear fs-5 d-block mb-1"></i><small>系统设置</small>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Chart.js CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

<script>
    const D = @Html.Raw(Model.DashboardJson);
    const palette = ['#1976d2', '#388e3c', '#f57c00', '#7b1fa2', '#0097a7', '#c2185b', '#fbc02d', '#5d4037', '#455a64', '#00796b'];

    function renderLineChart(canvasId, points, color, fillArea = false) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: points.map(p => p.label),
                datasets: [{
                    label: '数值',
                    data: points.map(p => p.value),
                    borderColor: color,
                    backgroundColor: fillArea ? color + '30' : color,
                    fill: fillArea,
                    tension: 0.3,
                    pointRadius: 3,
                    pointHoverRadius: 5
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    }

    function renderMultiLineChart(canvasId, series, labels) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: labels,
                datasets: series.map((s, i) => ({
                    label: s.name,
                    data: s.values,
                    borderColor: palette[i % palette.length],
                    backgroundColor: palette[i % palette.length] + '30',
                    fill: false,
                    tension: 0.3
                }))
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { position: 'top' } },
                scales: { y: { beginAtZero: true } }
            }
        });
    }

    function renderPieChart(canvasId, items, title) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: items.map(i => i.label),
                datasets: [{
                    data: items.map(i => i.value),
                    backgroundColor: items.map((_, i) => palette[i % palette.length])
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'right', labels: { boxWidth: 12, font: { size: 11 } } }
                }
            }
        });
    }

    function renderBarChart(canvasId, items, color) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: items.map(i => i.label),
                datasets: [{
                    label: '数量',
                    data: items.map(i => i.value),
                    backgroundColor: color + 'cc',
                    borderColor: color,
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true } }
            }
        });
    }

    function renderHorizontalBar(canvasId, items) {
        const ctx = document.getElementById(canvasId);
        if (!ctx) return;
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: items.map(i => i.dormCode + ' (' + i.building + ')'),
                datasets: [{
                    label: '入住率 %',
                    data: items.map(i => i.occupancyRate),
                    backgroundColor: items.map(i => i.occupancyRate >= 100 ? '#dc3545' : (i.occupancyRate >= 80 ? '#f57c00' : '#1976d2'))
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    x: { beginAtZero: true, max: 100, ticks: { callback: v => v + '%' } }
                }
            }
        });
    }

    // 渲染 7 个图表
    document.addEventListener('DOMContentLoaded', function () {
        if (D.occupancyTrend) renderLineChart('chartOccupancyTrend', D.occupancyTrend, '#388e3c', true);
        if (D.bookingMonthlyTrend) {
            const labels = D.bookingMonthlyTrend[0]?.labels || [];
            renderMultiLineChart('chartBookingTrend', D.bookingMonthlyTrend, labels);
        }
        if (D.departmentDistribution) renderPieChart('chartDepartment', D.departmentDistribution);
        if (D.employeeTypeDistribution) renderPieChart('chartEmployeeType', D.employeeTypeDistribution);
        if (D.buildingOccupancy) renderBarChart('chartBuilding', D.buildingOccupancy, '#1976d2');
        if (D.meterMonthlyCount) renderBarChart('chartMeterCount', D.meterMonthlyCount, '#5d4037');
        if (D.topOccupancyDorms) renderHorizontalBar('chartTopDorms', D.topOccupancyDorms);
    });
</script>

<style>
    .quick-btn { border-radius: 10px; transition: all 0.2s ease; }
    .quick-btn:hover { transform: translateY(-2px); box-shadow: 0 4px 8px rgba(0,0,0,0.1); }
    .card.shadow-sm { transition: box-shadow 0.2s ease; }
</style>