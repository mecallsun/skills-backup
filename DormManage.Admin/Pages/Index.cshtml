@page
@model IndexModel
@{
    ViewData["Title"] = "首页";
    Layout = "_Layout";
}

<div class="container-fluid">
    <!-- 页头 -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">
            <i class="bi bi-speedometer2"></i> 数据看板
        </h2>
        <small class="text-muted">
            <i class="bi bi-calendar3"></i> @DateTime.Now:yyyy年MM月dd日 dddd
        </small>
    </div>

    <!-- KPI 卡片行 -->
    <div class="row g-3 mb-4">
        <!-- 宿舍总量 -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #1976d2;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;background:#e3f2fd;">
                            <i class="bi bi-building text-primary fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <div class="text-muted mb-1">宿舍总量</div>
                        <div class="fs-3 fw-bold text-dark">@Model.TotalDorms</div>
                        <small class="text-muted">共 <span class="text-dark fw-semibold">@Model.TotalBeds</span> 个床位</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 入住率 -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #388e3c;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;background:#e8f5e9;">
                            <i class="bi bi-graph-up text-success fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <div class="text-muted mb-1">入住率</div>
                        <div class="fs-3 fw-bold text-dark">@Model.OccupancyRate%</div>
                        <small class="text-muted"><span class="text-success fw-semibold">@Model.CurrentOccupancy</span> 人已入住</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 员工总数 -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #f57c00;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;background:#fff3e0;">
                            <i class="bi bi-people text-warning fs-4"></i>
                        </div>
                    </div>
                    <div>
                        <div class="text-muted mb-1">员工总数</div>
                        <div class="fs-3 fw-bold text-dark">@Model.TotalEmployees</div>
                        <small class="text-muted">在职 <span class="text-success fw-semibold">@Model.ActiveEmployees</span> 人</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- 今日办理 -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #7b1fa2;">
                <div class="card-body d-flex align-items-center">
                    <div class="flex-shrink-0 me-3">
                        <div class="rounded-circle d-flex align-items-center justify-content-center" style="width:56px;height:56px;background:#f3e5f5;">
                            <i class="bi bi-clipboard-check text-purple fs-4" style="color:#7b1fa2;"></i>
                        </div>
                    </div>
                    <div>
                        <div class="text-muted mb-1">今日办理</div>
                        <div class="fs-3 fw-bold text-dark">@Model.TodayCheckIns + @Model.TodayCheckOuts</div>
                        <small class="text-muted">
                            入住 <span class="text-success fw-semibold">@Model.TodayCheckIns</span>
                            退房 <span class="text-danger fw-semibold">@Model.TodayCheckOuts</span>
                            预约 <span class="text-warning fw-semibold">@Model.ReservedCount</span> 个
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 第二行：人员状态分布 + 快捷入口 -->
    <div class="row g-3 mb-4">
        <!-- 人员状态分布 -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-people-fill me-1"></i>人员状态分布</h6>
                </div>
                <div class="card-body">
                    <!-- 在职 -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-muted"><i class="bi bi-check-circle text-success me-1"></i>在职</small>
                            <small class="fw-semibold">@Model.ActiveEmployees 人</small>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-success" role="progressbar"
                                 style="width: @(Model.TotalEmployees > 0 ? Model.ActiveEmployees * 100m / Model.TotalEmployees : 0)%"></div>
                        </div>
                    </div>
                    <!-- 待入职 -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-muted"><i class="bi bi-clock text-warning me-1"></i>待入职</small>
                            <small class="fw-semibold">@Model.OnboardingEmployees 人</small>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-warning" role="progressbar"
                                 style="width: @(Model.TotalEmployees > 0 ? Model.OnboardingEmployees * 100m / Model.TotalEmployees : 0)%"></div>
                        </div>
                    </div>
                    <!-- 已离职 -->
                    <div class="mb-0">
                        <div class="d-flex justify-content-between mb-1">
                            <small class="text-muted"><i class="bi bi-x-circle text-secondary me-1"></i>已离职</small>
                            <small class="fw-semibold">@Model.LeftEmployees 人</small>
                        </div>
                        <div class="progress" style="height: 8px;">
                            <div class="progress-bar bg-secondary" role="progressbar"
                                 style="width: @(Model.TotalEmployees > 0 ? Model.LeftEmployees * 100m / Model.TotalEmployees : 0)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 快捷入口 -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h6 class="mb-0 fw-semibold"><i class="bi bi-lightning-fill me-1 text-warning"></i>快捷入口</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-3 col-6">
                            <a href="/Booking" class="btn btn-outline-primary w-100 py-3 quick-btn">
                                <i class="bi bi-clipboard-check fs-5 d-block mb-1"></i>
                                <small>办理登记</small>
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="/Booking/CheckIn" class="btn btn-outline-success w-100 py-3 quick-btn">
                                <i class="bi bi-box-arrow-in-right fs-5 d-block mb-1"></i>
                                <small>入住办理</small>
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="/Booking/CheckOut" class="btn btn-outline-danger w-100 py-3 quick-btn">
                                <i class="bi bi-box-arrow-right fs-5 d-block mb-1"></i>
                                <small>退房办理</small>
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="/Dorms" class="btn btn-outline-info w-100 py-3 quick-btn">
                                <i class="bi bi-building fs-5 d-block mb-1"></i>
                                <small>宿舍管理</small>
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="/Personnel" class="btn btn-outline-warning w-100 py-3 quick-btn">
                                <i class="bi bi-people fs-5 d-block mb-1"></i>
                                <small>人员清单</small>
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="/DormBilling" class="btn btn-outline-secondary w-100 py-3 quick-btn">
                                <i class="bi bi-receipt fs-5 d-block mb-1"></i>
                                <small>宿舍账单</small>
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="/Meter" class="btn btn-outline-dark w-100 py-3 quick-btn">
                                <i class="bi bi-gauge fs-5 d-block mb-1"></i>
                                <small>抄表记录</small>
                            </a>
                        </div>
                        <div class="col-md-3 col-6">
                            <a href="/Settings" class="btn btn-outline-primary w-100 py-3 quick-btn">
                                <i class="bi bi-gear fs-5 d-block mb-1"></i>
                                <small>系统设置</small>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 最近办理记录 -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h6 class="mb-0 fw-semibold"><i class="bi bi-clock-history me-1"></i>最近办理记录</h6>
            <a href="/Booking" class="btn btn-sm btn-outline-primary">查看全部 <i class="bi bi-arrow-right"></i></a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th width="50" class="text-center">序号</th>
                            <th>姓名</th>
                            <th>工号</th>
                            <th>宿舍号</th>
                            <th class="text-center">类型</th>
                            <th class="text-center">状态</th>
                            <th class="text-center">办理日期</th>
                            <th>登记人</th>
                            <th class="text-center" width="160">操作时间</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentBookings.Count > 0)
                        {
                            var idx = 1;
                            foreach (var item in Model.RecentBookings)
                            {
                                <tr>
                                    <td class="text-center text-muted">@idx</td>
                                    <td><strong>@item.EmployeeName</strong></td>
                                    <td class="text-muted">@item.EmployeeCode</td>
                                    <td><span class="text-danger fw-bold">@item.DormCode</span></td>
                                    <td class="text-center">
                                        @if (item.Type == 1)
                                        {
                                            <span class="badge bg-success">入住</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">退房</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @switch (item.Status)
                                        {
                                            case 1: <span class="badge bg-info">预约</span>; break;
                                            case 2: <span class="badge bg-primary">在宿</span>; break;
                                            case 3: <span class="badge bg-secondary">已退房</span>; break;
                                            case 4: <span class="badge bg-dark">已取消</span>; break;
                                        }
                                    </td>
                                    <td class="text-center">@item.BookingDate.ToLongDateString()</td>
                                    <td>@item.Registrar</td>
                                    <td class="text-center text-muted small">@item.RegistrationDate.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                                idx++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">暂无办理记录，点击 <a href="/Booking">办理登记</a> 开始使用</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<style>
    .quick-btn {
        border-radius: 10px;
        transition: all 0.2s ease;
    }
    .quick-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    .card.shadow-sm {
        transition: box-shadow 0.2s ease;
    }
    .fs-4.text-purple {
        color: #7b1fa2 !important;
    }
</style>
