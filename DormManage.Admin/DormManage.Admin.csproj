<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- v2.13.162：Razor 运行时编译需要 .cshtml 包含在发布输出中。SDK Web publish 阶段默认不复制源代码 .cshtml，需在 publish itemgroup 显式声明。-->
  <ItemGroup>
    <None Include="Pages\**\*.cshtml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DormManage.Shared\DormManage.Shared.csproj" />
    <ProjectReference Include="..\DormManage.Api\DormManage.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.10" />
    <!-- v2.13.109: SQLite 已移除，仅保留 SqlServer -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- v2.13.25 修复 Publish 时 Admin.csproj 引用 Api 程序集导致的 appsettings.json 冲突 -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <!-- v2.13.11 全局抑制次要警告：CS1998（async无await）/CS8602（可能空引用）/CS8629（可空值类型）—— 由代码审计单独记录 -->
    <NoWarn>$(NoWarn);CS1998;CS8602;CS8629</NoWarn>
    <!-- v2.13.140：Release 构建启用 Obfuscar 源码级混淆（仅 Release，Debug 不影响）-->
    <ObfuscateOnRelease>true</ObfuscateOnRelease>
  </PropertyGroup>

</Project>
