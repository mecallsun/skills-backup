@page
@model DormManage.Admin.Pages.Account.ForgotPasswordModel
@{
    ViewData["Title"] = "找回密码";
    Layout = null;
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 金智住宿管理系统</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
    <style>
        body {
            font-family: "Microsoft YaHei UI", sans-serif;
            background: linear-gradient(135deg, #1976d2 0%, #0d47a1 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1rem;
        }
        .forgot-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
            max-width: 520px;
            width: 100%;
            overflow: hidden;
        }
        .forgot-header {
            background: linear-gradient(135deg, #1976d2, #1565c0);
            color: #fff;
            padding: 1.5rem 2rem;
            text-align: center;
        }
        .forgot-header i { font-size: 2.5rem; margin-bottom: .5rem; display: block; }
        .forgot-header h3 { font-weight: bold; margin-bottom: .25rem; }
        .forgot-body { padding: 2rem; }
        .step-indicator { display: flex; justify-content: space-between; margin-bottom: 2rem; }
        .step { flex: 1; text-align: center; padding: .5rem; color: #90a4ae; border-bottom: 3px solid #e0e0e0; }
        .step.active { color: #1976d2; border-bottom-color: #1976d2; font-weight: 600; }
        .step.done { color: #43a047; border-bottom-color: #43a047; }
        .step-num { display: inline-block; width: 28px; height: 28px; line-height: 28px; border-radius: 50%; background: #e0e0e0; color: #fff; }
        .step.active .step-num { background: #1976d2; }
        .step.done .step-num { background: #43a047; }
        .alert-info { background: #e3f2fd; color: #0d47a1; border-color: #90caf9; }
        .btn-primary { background: #1976d2; border-color: #1976d2; }
        .btn-primary:hover { background: #1565c0; border-color: #1565c0; }
        .error-message {
            background: #ffebee;
            color: #c62828;
            border: 1px solid #ef9a9a;
            border-radius: 8px;
            padding: .75rem 1rem;
            margin-bottom: 1rem;
            font-size: .9rem;
        }
        .success-message {
            background: #e8f5e9;
            color: #2e7d32;
            border: 1px solid #a5d6a7;
            border-radius: 8px;
            padding: .75rem 1rem;
            margin-bottom: 1rem;
            font-size: .9rem;
        }
        .step-pane { display: none; }
        .step-pane.active { display: block; }
        .version-badge {
            position: absolute;
            bottom: 1rem;
            right: 1rem;
            background: rgba(255,255,255,0.15);
            color: #fff;
            padding: .25rem .75rem;
            border-radius: 20px;
            font-size: .75rem;
        }
    </style>
</head>
<body>
    <div class="forgot-card">
        <div class="forgot-header">
            <i class="bi bi-shield-lock"></i>
            <h3>找回密码</h3>
            <small>通过安全问题验证身份</small>
        </div>
        <div class="forgot-body">
            <!-- 步骤指示 -->
            <div class="step-indicator">
                <div class="step active" id="stepInd1"><span class="step-num">1</span> 输入账号</div>
                <div class="step" id="stepInd2"><span class="step-num">2</span> 回答问题</div>
                <div class="step" id="stepInd3"><span class="step-num">3</span> 重置密码</div>
            </div>

            <div id="errorArea"></div>

            <!-- Step 1: 输入账号 -->
            <div class="step-pane active" id="step1">
                <p class="text-muted small">请输入您的用户名，系统将显示您预设的安全问题。</p>
                <div class="mb-3">
                    <label class="form-label">用户名 <span class="text-danger">*</span></label>
                    <input type="text" class="form-control form-control-lg" id="forgotUsername" placeholder="请输入用户名" autofocus>
                </div>
                <button type="button" class="btn btn-primary w-100" onclick="step1Next()">
                    下一步 <i class="bi bi-arrow-right"></i>
                </button>
                <div class="text-center mt-3">
                    <a href="/Account/Login" class="text-muted small"><i class="bi bi-arrow-left"></i> 返回登录</a>
                </div>
            </div>

            <!-- Step 2: 回答问题 -->
            <div class="step-pane" id="step2">
                <div class="alert alert-info py-2 small">
                    <i class="bi bi-info-circle"></i> 请回答以下安全问题。答案不区分大小写。
                </div>
                <div id="questionsArea"></div>
                <div class="d-flex gap-2 mt-3">
                    <button type="button" class="btn btn-outline-secondary" onclick="gotoStep(1)">
                        <i class="bi bi-arrow-left"></i> 上一步
                    </button>
                    <button type="button" class="btn btn-primary flex-grow-1" onclick="step2Next()">
                        验证 <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </div>

            <!-- Step 3: 重置密码 -->
            <div class="step-pane" id="step3">
                <div class="alert alert-success py-2 small">
                    <i class="bi bi-check-circle"></i> 身份验证通过！请设置新密码。
                </div>
                <div class="mb-3">
                    <label class="form-label">新密码 <span class="text-danger">*</span></label>
                    <input type="password" class="form-control form-control-lg" id="newPwd" minlength="8" required>
                    <small class="text-muted">≥8 位，含字母与数字</small>
                </div>
                <div class="mb-3">
                    <label class="form-label">确认新密码 <span class="text-danger">*</span></label>
                    <input type="password" class="form-control form-control-lg" id="confirmPwd" minlength="8" required>
                </div>
                <div class="mb-3">
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar" id="pwdStrengthBar" style="width: 0%; background: #f44336;"></div>
                    </div>
                    <small class="text-muted" id="pwdStrengthText"></small>
                </div>
                <button type="button" class="btn btn-primary w-100" onclick="step3Submit()">
                    <i class="bi bi-key"></i> 重置密码
                </button>
            </div>

            <!-- Step 4: 成功 -->
            <div class="step-pane" id="step4">
                <div class="success-message">
                    <i class="bi bi-check-circle-fill"></i> 密码重置成功！请使用新密码登录。
                </div>
                <a href="/Account/Login" class="btn btn-primary w-100">
                    <i class="bi bi-box-arrow-in-right"></i> 立即登录
                </a>
            </div>
        </div>
    </div>

    <div class="version-badge">v2.13.26</div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/forgot-password.js"></script>
</body>
</html>