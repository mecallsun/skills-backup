@page
@model ErrorModel
@{
    Layout = null;
    ViewData["Title"] = "Error";
    Response.ContentType = "text/html; charset=utf-8";
}

<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>错误 - 金戈宿舍管理系统</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="container-fluid h-100 d-flex align-items-center justify-content-center">
        <div class="card p-4" style="max-width: 600px; width: 90%;">
            <div class="card-body">
                <h1 class="text-danger mb-4"><i class="bi bi-exclamation-triangle"></i> 页面执行出错</h1>

                @* v2.13.201: 删除 LICENSE_READONLY 分支（注册状态提示）
                   原因：注册过期防护已统一由 license-protect.js 在操作时弹窗拦截，
                   无需在错误页面重复显示注册信息 *@

                <p class="mb-2"><strong>错误代码：</strong>@(Model?.Code ?? "未知")</p>
                @if (!string.IsNullOrEmpty(Model?.Message))
                {
                    <div class="alert alert-danger mb-4">
                        @Model.Message
                    </div>
                }
                <p>抱歉，页面执行过程中发生了意外错误。请稍后重试，或联系系统管理员。</p>
                <div class="d-flex gap-2 mt-4">
                    <a href="/" class="btn btn-primary">返回首页</a>
                    <a href="javascript:window.history.back()" class="btn btn-secondary">返回上一页</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
