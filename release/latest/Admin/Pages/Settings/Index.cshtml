        // ====================== v2.13.67 角色管理子 Tab JS ======================
        function openEditModal(id, roleCode, name, desc, sort, isActive) {
            document.getElementById('editRoleId').value = id;
            document.getElementById('editRoleCode').value = roleCode;
            document.getElementById('editRoleName').value = name;
            document.getElementById('editRoleDesc').value = desc || '';
            document.getElementById('editRoleSort').value = sort;
            document.getElementById('editRoleActive').checked = isActive === 'true';
            new bootstrap.Modal(document.getElementById('editRoleModal')).show();
        }

        function openPermMatrixModal(roleId, roleName) {
            document.getElementById('permRoleId').value = roleId;
            document.getElementById('permRoleName').textContent = roleName;
            document.querySelectorAll('.perm-cb').forEach(cb => { cb.checked = false; cb.dataset.roleId = roleId; });
            const rolePermsJson = @Html.Raw(Json.Serialize(Model.RolePermissions.ToDictionary(
                kv => kv.Key,
                kv => kv.Value.ToArray())));
            const permIds = rolePermsJson[roleId] || [];
            permIds.forEach(pid => {
                const cb = document.getElementById('perm_' + pid);
                if (cb) cb.checked = true;
            });
            // v2.13.196 修订: 根据当前角色权限集合设置「允许显示隐私字段」checkbox (deny-by-default: 勾选后才允许显示)
            const privacyPermId = @(Model.Permissions.FirstOrDefault(p => p.PermissionCode == "privacy:field:enable")?.Id ?? 0);
            const privacyFieldEnabled = privacyPermId > 0 && permIds.includes(privacyPermId);
            document.getElementById('perm_privacy_field').checked = privacyFieldEnabled;
            // v2.13.76 RBAC：挂载子→父级联（按钮任一勾选 → 上级菜单必须勾选；父菜单反选时若子全未选也可反选）
            wirePermMatrixCascade();
            new bootstrap.Modal(document.getElementById('permMatrixModal')).show();
        }

        // v2.13.76 RBAC 自动级联：父菜单（PermissionType=1 / data-parent-id=0）保持其状态；
        // 子权限（PermissionType=2 / data-parent-id > 0）任一被勾选时，其父菜单必须勾选；
        // 父菜单反选时，其下子权限应自动取消（一致性）。
        function wirePermMatrixCascade() {
            document.querySelectorAll('.perm-cb').forEach(cb => {
                if (cb.dataset.cascadeWired === '1') return;
                cb.dataset.cascadeWired = '1';
                cb.addEventListener('change', onPermCbChange);
            });
        }

        function onPermCbChange(e) {
            const cb = e.currentTarget;
            const permType = parseInt(cb.dataset.permType || '0', 10);
            const parentId = parseInt(cb.dataset.parentId || '0', 10);
            // 子权限（按钮/数据）勾选 → 上级菜单（ParentId）必须勾选
            if (cb.checked && parentId > 0) {
                const parentCb = document.querySelector('.perm-cb[data-parent-id="0"][value="' + parentId + '"]')
                    || document.getElementById('perm_' + parentId);
                if (parentCb && !parentCb.checked) parentCb.checked = true;
            }
            // 父菜单反选 → 其下所有子权限自动取消（避免父无权但子有权的不一致状态）
            if (!cb.checked && permType === 1 && parentId === 0) {
                const myValue = cb.value;
                document.querySelectorAll('.perm-cb[data-parent-id="' + myValue + '"]').forEach(child => {
                    child.checked = false;
                });
            }
            // 父菜单勾选 → 不级联子（子独立授权，避免越权默认开启）
        }

        function selectAllPerms(checked) {
            document.querySelectorAll('.perm-cb').forEach(cb => cb.checked = checked);
        }

        function confirmDelete(id, name) {
            document.getElementById('deleteRoleId').value = id;
            document.getElementById('deleteRoleNameDisplay').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteRoleConfirmModal')).show();
        }

        function wireRolePanel() {
            const createModal = document.getElementById('createRoleModal');
            if (!createModal) return;

            // Create
            createModal.addEventListener('show.bs.modal', function() {
                hideFeedback('createRoleFeedback');
                document.getElementById('createRoleForm').reset();
            });
            document.getElementById('createRoleForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                hideFeedback('createRoleFeedback');
                const data = new FormData(this);
                const btn = document.getElementById('createRoleSubmit');
                const orig = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>创建中...';
                const result = await postPanelAction('/Settings?handler=RoleCreate', data, 'createRoleFeedback');
                btn.disabled = false;
                btn.innerHTML = orig;
                if (result.ok) {
                    showFeedback('createRoleFeedback', 'success', '✓ 创建成功！即将刷新...');
                    setTimeout(() => location.reload(), 800);
                }
            });

            // Edit
            const editModal = document.getElementById('editRoleModal');
            if (!editModal) { console.error('[编辑角色 Modal 未找到]'); return; }
            editModal.addEventListener('show.bs.modal', function() { hideFeedback('editRoleFeedback'); });
            document.getElementById('editRoleForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                hideFeedback('editRoleFeedback');

                const data = new FormData(this);
                // v2.13.221 BUG 1 修复：先删除所有旧 IsActive，再根据 checkbox 状态单值提交
                // （解决之前 hidden=false 干扰 checkbox=true 的问题）
                data.delete('IsActive');
                const checkbox = document.getElementById('editRoleActive');
                data.set('IsActive', (checkbox && checkbox.checked) ? 'true' : 'false');

                const btn = document.getElementById('editRoleSubmit');
                const orig = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>保存中...';
                const result = await postPanelAction('/Settings?handler=RoleUpdate', data, 'editRoleFeedback');
                btn.disabled = false;
                btn.innerHTML = orig;
                if (result.ok) {
                    showFeedback('editRoleFeedback', 'success', '✓ 更新成功！即将刷新...');
                    setTimeout(() => location.reload(), 800);
                }
            });

            // Permission Matrix
            const permModal = document.getElementById('permMatrixModal');
            permModal.addEventListener('show.bs.modal', function() { hideFeedback('permMatrixFeedback'); });
            document.getElementById('permMatrixForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                hideFeedback('permMatrixFeedback');
                const data = new FormData(this);
                const btn = document.getElementById('permMatrixSubmit');
                const orig = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>保存中...';
                const result = await postPanelAction('/Settings?handler=RoleSavePermissions', data, 'permMatrixFeedback');
                btn.disabled = false;
                btn.innerHTML = orig;
                if (result.ok) {
                    showFeedback('permMatrixFeedback', 'success', '✓ 权限已保存！即将关闭...');
                    setTimeout(() => bootstrap.Modal.getInstance(permModal)?.hide(), 600);
                    setTimeout(() => location.reload(), 1200);
                }
            });

            // Delete
            const delModal = document.getElementById('deleteRoleConfirmModal');
            delModal.addEventListener('show.bs.modal', function() { hideFeedback('deleteRoleFeedback'); });
            document.getElementById('deleteRoleForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                hideFeedback('deleteRoleFeedback');
                const data = new FormData(this);
                const btn = document.getElementById('deleteRoleSubmit');
                const orig = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>删除中...';
                const result = await postPanelAction('/Settings?handler=RoleDelete', data, 'deleteRoleFeedback');
                btn.disabled = false;
                btn.innerHTML = orig;
                if (result.ok) {
                    showFeedback('deleteRoleFeedback', 'success', '✓ 删除成功！即将刷新...');
                    setTimeout(() => location.reload(), 800);
                }
            });
        }

        // v2.13.67：DOM Ready 时挂载两个面板的事件监听（避免在非激活 tab 时找不到元素）
        document.addEventListener('DOMContentLoaded', function() {
            wireUserPanel();
            wireRolePanel();
        });
    </script>

    @* v2.13.102 新增：DB seed 完整性 banner AJAX（重新检查 + 一键修复） *@
    <script>
        // v2.13.102：banner 重新检查（GET /Settings?handler=RoleSeedIntegrity）
        window.refreshSeedIntegrityBanner = async function () {
            const banner = document.getElementById('seedIntegrityBanner');
            if (!banner) return;
            try {
                const res = await fetch('/Settings?handler=RoleSeedIntegrity', {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' },
                    credentials: 'include'
                });
                if (res.ok) {
                    location.reload();
                } else {
                    showToast('重新检查失败：HTTP ' + res.status, 'danger');
                }
            } catch (ex) {
                console.error('refreshSeedIntegrityBanner failed', ex);
                showToast('重新检查异常：' + ex.message, 'danger');
            }
        };

        // v2.13.102：banner 一键修复（POST /Settings?handler=RoleSeedRepair）
        window.runSeedIntegrityRepair = async function () {
            if (!confirm('将立即执行 seed 完整性修复（idempotent INSERT），无需重启 Admin。\n确认执行？')) return;
            const token = document.getElementById('pageAntiforgeryToken')?.value || '';
            try {
                const res = await fetch('/Settings?handler=RoleSeedRepair', {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'RequestVerificationToken': token
                    },
                    credentials: 'include'
                });
                const json = await res.json().catch(() => ({ success: false, message: '响应解析失败' }));
                if (json.success) {
                    showToast(json.message || '修复成功', 'success');
                    setTimeout(() => location.reload(), 800);
                } else {
                    showToast(json.message || '修复失败', 'danger');
                }
            } catch (ex) {
                console.error('runSeedIntegrityRepair failed', ex);
                showToast('修复异常：' + ex.message, 'danger');
            }
        };
    </script>
