            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // v2.13.19: 数据库连接双 UI 双向同步 JS
        const DB_API = '/api/v1/system/dbconfig';

        function setActiveTab(tab) {
            const url = new URL(window.location);
            url.searchParams.set('tab', tab);
            window.history.replaceState({}, '', url);
        }

        // v2.13.19：封装对 Tray 的 IPC 通知，实际通过后端 API 转发到底层 TCP 端口 5099
        async function fetchTrayIpc(command, payload) {
            try {
                const res = await fetch('/api/v1/system/ipc/tray', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ command, payload })
                });
                return await res.json();
            } catch (e) {
                console.warn('fetchTrayIpc 失败:', e);
                return { success: false, message: e.message };
            }
        }

        // 加载当前数据库配置
        function loadDbConfig() {
            fetch(DB_API).then(r => r.json()).then(res => {
                if (!res.success) return;
                const c = res.data;
                document.getElementById('dbProvider').value = c.provider || 'SqlServer';
                document.getElementById('dbServer').value = c.dbServer || '';
                document.getElementById('dbPort').value = c.dbPort || 1433;
                document.getElementById('dbName').value = c.dbName || '';
                document.getElementById('dbUser').value = c.dbUser || '';
                document.getElementById('dbPassword').value = '';
                // v2.13.109: SQLite 字段已移除，无需 toggleProviderUI
            });
        }

        // 切换 SqlServer / Sqlite 字段可见性
        // v2.13.109: SQLite 已移除，函数体保留为空操作以兼容旧调用
        function toggleProviderUI() {
            /* no-op: 仅 SqlServer 字段 */
        }

        // 测试连接（真实 HTTP 调用）
        async function runDbTest() {
            const box = document.getElementById('dbTestResult');
            box.innerHTML = '<div class="text-muted small"><span class="spinner-border spinner-border-sm"></span> 正在测试连接...</div>';

            // v2.13.109: 强制 provider=SqlServer，移除 sqlitePath 字段
            const payload = {
                provider: 'SqlServer',
                dbServer: document.getElementById('dbServer').value,
                dbPort: parseInt(document.getElementById('dbPort').value) || 1433,
                dbName: document.getElementById('dbName').value,
                dbUser: document.getElementById('dbUser').value,
                dbPassword: document.getElementById('dbPassword').value || 'unchanged'
            };

            try {
                const res = await fetch(DB_API + '/test', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const json = await res.json();
                if (json.success) {
                    box.innerHTML = `<div class="alert alert-success mb-0"><strong><i class="bi bi-check2-all"></i> ${json.message}</strong></div>`;
                } else {
                    box.innerHTML = `<div class="alert alert-danger mb-0"><i class="bi bi-x-octagon"></i> ${json.message}</div>`;
                }
            } catch (e) {
                box.innerHTML = `<div class="alert alert-danger mb-0"><i class="bi bi-x-octagon"></i> 测试失败: ${e.message}</div>`;
            }
        }

        // 保存配置（真实 HTTP 调用 → 触发双 UI 广播）
        // v2.13.32 热加载：保存成功后自动调用 /runtime-reload，连接立即切换无需重启
        async function saveDbConfig() {
            const box = document.getElementById('dbConfigResult');
            box.innerHTML = '<div class="text-muted small"><span class="spinner-border spinner-border-sm"></span> 正在保存并热加载...</div>';

            // v2.13.109: 强制 provider=SqlServer，移除 sqlitePath 字段
            const payload = {
                provider: 'SqlServer',
                dbServer: document.getElementById('dbServer').value,
                dbPort: parseInt(document.getElementById('dbPort').value) || 1433,
                dbName: document.getElementById('dbName').value,
                dbUser: document.getElementById('dbUser').value,
                dbPassword: document.getElementById('dbPassword').value || 'unchanged'
            };

            try {
                const res = await fetch(DB_API + '/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const json = await res.json();
                if (json.success) {
                    // v2.13.32：保存成功 → 触发 runtime-reload（确保整个 Api/Admin 进程立即切换）
                    try {
                        await fetch(DB_API + '/runtime-reload', { method: 'POST' });
                    } catch (e) { /* 失败不影响主流程 */ }
                    // v2.13.32：刷新顶部连接健康徽章
                    if (typeof refreshDbIndicator === 'function') refreshDbIndicator();
                    box.innerHTML = `<div class="alert alert-success mb-0"><i class="bi bi-lightning-charge-fill"></i> <strong>${json.message}</strong><br/><small class="text-muted">所有页面下次刷新自动使用新连接，无需重启服务。</small></div>`;
                    // 触发 TrayApp IPC 同步广播（兼容托盘端 SettingsForm）
                    fetchTrayIpc('dbconfig.updated', payload);
                } else {
                    box.innerHTML = `<div class="alert alert-danger mb-0"><i class="bi bi-x-octagon"></i> ${json.message}</div>`;
                }
            } catch (e) {
                box.innerHTML = `<div class="alert alert-danger mb-0"><i class="bi bi-x-octagon"></i> 保存失败: ${e.message}</div>`;
            }
        }

        // v2.13.196: 加载关于系统页面的注册状态信息 - 优化布局界面显示
        function loadAboutLicenseInfo() {
            const badge = document.getElementById('aboutLicenseBadge');
            const status = document.getElementById('aboutLicenseStatus');
            const detail = document.getElementById('aboutLicenseDetail');
            if (!badge || !status || !detail) return;

            // 显示加载状态（spinner + 文字）
            badge.innerHTML = `
                <div class="spinner-border spinner-border-sm" role="status"><span class="visually-hidden">加载中...</span></div>
                <span>加载注册信息中...</span>
            `;
            status.innerHTML = '<span class="text-muted">加载中...</span>';
            detail.textContent = '';

            fetch('/api/v1/system/license-status')
                .then(r => r.ok ? r.json() : null)
                .then(res => {
                    if (!res || !res.success || !res.data) {
                        // 获取失败（托盘未启动/授权不可用）
                        badge.innerHTML = '<span class="badge bg-secondary"><i class="bi bi-question-circle"></i> 授权状态未知</span>';
                        status.innerHTML = '<span class="text-muted">无法连接到托盘服务</span>';
                        detail.textContent = '';
                        return;
                    }
                    const d = res.data;

                    // v2.13.196: 专业UI布局 - 徽章显示在右上角，详细内容在注册状态行
                    let badgeHtml = '';
                    let statusHtml = '';
                    let detailText = '';

                    if (d.code === '已注册' || d.status === 1) {
                        badgeHtml = '<span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> 已注册</span>';
                        const expDate = d.regDate ? new Date(d.regDate).toLocaleDateString('zh-CN') : '永久';
                        statusHtml = `<span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> 已注册</span>`;
                        if (d.ltdName) {
                            statusHtml += ` <small class="text-muted ms-2">公司：<strong>${d.ltdName}</strong></small>`;
                        }
                        statusHtml += ` <small class="text-muted ms-2">有效期至：<strong>${expDate}</strong></small>`;
                        detailText = '';
                    } else if (d.code === '试用模式' || d.status === -1) {
                        badgeHtml = '<span class="badge bg-info"><i class="bi bi-info-circle-fill"></i> 试用中</span>';
                        statusHtml = `<span class="badge bg-info"><i class="bi bi-info-circle-fill"></i> 试用模式</span>`;
                        statusHtml += ` <small class="text-muted ms-2">已用 <strong>${d.usedCount ?? '?'}</strong> / <strong>${d.limit ?? '?'}</strong> 次</small>`;
                        detailText = '';
                    } else if (d.code === '已过期' || d.status === 2) {
                        badgeHtml = '<span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle-fill"></i> 已过期</span>';
                        statusHtml = `<span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle-fill"></i> 已过期</span>`;
                        if (d.regDate) {
                            const expDate = new Date(d.regDate).toLocaleDateString('zh-CN');
                            statusHtml += ` <small class="text-danger ms-2">已于 <strong>${expDate}</strong> 过期</small>`;
                        }
                        detailText = '请联系信息科续订授权';
                    } else if (d.code === '校验失败' || d.status === 3) {
                        badgeHtml = '<span class="badge bg-danger"><i class="bi bi-shield-exclamation"></i> 校验失败</span>';
                        statusHtml = `<span class="badge bg-danger"><i class="bi bi-shield-exclamation"></i> 校验失败</span>`;
                        statusHtml += ` <small class="text-danger ms-2">机器码/公司名不匹配</small>`;
                        detailText = '请检查系统授权配置';
                    } else {
                        badgeHtml = '<span class="badge bg-secondary">授权状态</span>';
                        statusHtml = `<span class="badge bg-secondary"><i class="bi bi-question-circle"></i> ${d.code || '未知'}</span>`;
                        detailText = d.message || '';
                    }

                    badge.innerHTML = badgeHtml;
                    status.innerHTML = statusHtml;
                    detail.textContent = detailText;
                })
                .catch(err => {
                    badge.innerHTML = '<span class="badge bg-secondary">授权状态未知</span>';
                    status.innerHTML = '<span class="text-muted">查询失败</span>';
                    detail.textContent = err.message;
                });
        }

        // DOM Ready 初始化：数据库配置区域始终可用（v2.13.28 修复：不再依赖 URL ?tab=db 参数）
        document.addEventListener('DOMContentLoaded', function () {
            loadDbConfig();
            loadAboutLicenseInfo();  // v2.13.216: 加载关于系统页面注册信息
            var providerEl = document.getElementById('dbProvider');
            if (providerEl) providerEl.addEventListener('change', toggleProviderUI);
            var testEl = document.getElementById('btnDbTest');
            if (testEl) testEl.addEventListener('click', runDbTest);
            var saveEl = document.getElementById('btnDbSave');
            if (saveEl) saveEl.addEventListener('click', saveDbConfig);
        });

        // v2.13.65 修复：服务状态切换接入 IPC 接口（托盘 127.0.0.1:5099 JSON-over-lines）
        function toggleService(which) {
            const action = which === 'pda' ? 'restart-api' : 'restart-admin';
            if (!confirm(`确定重启 ${which === 'pda' ? 'API' : 'Web Admin'} 服务吗？`)) return;
            fetch('/api/v1/system/service-control', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: action })
            })
            .then(r => r.json())
            .then(j => {
                if (j.success) {
                    alert(`✓ ${which === 'pda' ? 'PDA' : 'Web'} 服务重启指令已发送`);
                    setTimeout(() => location.reload(), 2000);
                } else {
                    alert('操作失败：' + (j.message || '未知错误'));
                }
            })
            .catch(err => alert('请求失败：' + err.message));
        }

        function testConnection(id) {
            // v2.13.46 P0 修复：接通 IntegrationController API
            fetch(`/api/v1/system/integration/${id}/test`, { method: 'POST' })
                .then(r => r.json())
                .then(j => {
                    if (j.success) {
                        showToast('success', j.message || '连接测试成功');
                    } else {
                        showToast('danger', j.message || '连接测试失败');
                    }
                })
                .catch(err => showToast('danger', '连接测试请求失败：' + err.message));
        }

        // v2.13.46 P0 修复：接通 BackupController 真实 API
        function executeBackup() {
            if (!confirm('确定要立即执行数据库备份吗？')) return;
            showToast('info', '正在执行备份，请稍候...');
            fetch('/api/v1/system/backup', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ trigger: 'manual' })
            })
                .then(r => r.json())
                .then(j => {
                    if (j.success) {
                        showToast('success', j.message || '备份成功');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showToast('danger', j.message || '备份失败');
                    }
                })
                .catch(err => showToast('danger', '备份请求失败：' + err.message));
        }

        // v2.13.46 P0 修复：接通 AppVersionController 真实 API
        function publishNewAppVersion() {
            var version = prompt('请输入新版本号（如 v2.14.0）：');
            if (!version) return;
            var notes = prompt('更新说明：');
            if (notes === null) return;
            fetch('/api/v1/appversion', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ version: version, releaseNotes: notes, isCurrent: true })
            })
                .then(r => r.json())
                .then(j => {
                    if (j.success) {
                        showToast('success', j.message || '发布成功');
                        setTimeout(() => location.reload(), 1500);
                    } else {
                        showToast('danger', j.message || '发布失败');
                    }
                })
                .catch(err => showToast('danger', '发布请求失败：' + err.message));
        }

        // v2.13.46 P1 增强：Toast 提示组件（替换 alert 占位）
        function showToast(type, message) {
            var bg = { success: 'bg-success', danger: 'bg-danger', warning: 'bg-warning', info: 'bg-info' }[type] || 'bg-info';
            var html = '<div class="toast align-items-center text-white ' + bg + ' border-0 show" role="alert" style="position:fixed;top:80px;right:24px;z-index:9999;min-width:280px;">' +
                '<div class="d-flex"><div class="toast-body">' + message + '</div>' +
                '<button type="button" class="btn-close btn-close-white me-2 m-auto" onclick="this.parentElement.parentElement.remove()"></button>' +
                '</div></div>';
            var wrapper = document.createElement('div');
            wrapper.innerHTML = html;
            document.body.appendChild(wrapper.firstChild);
            setTimeout(function (el) { if (el && el.parentElement) el.remove(); }, 4000, document.querySelector('.toast:last-of-type'));
        }

        // ====================== v2.13.67 用户管理子 Tab JS ======================
        const antiforgeryToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

        function showFeedback(elId, type, message) {
            const el = document.getElementById(elId);
            if (!el) return;
            el.className = 'alert mb-3 alert-' + type;
            el.textContent = message;
            el.classList.remove('d-none');
        }
        function hideFeedback(elId) {
            const el = document.getElementById(elId);
            if (!el) return;
            el.classList.add('d-none');
        }

        // 通用 AJAX POST helper — v2.13.67：URL 改为 /Settings?handler=UserXxx
        async function postPanelAction(url, data, feedbackElId) {
            try {
                const formData = new URLSearchParams();
                for (const [key, value] of data.entries()) {
                    if (Array.isArray(value)) {
                        for (const v of value) formData.append(key, v);
                    } else if (value !== null && value !== undefined) {
                        formData.append(key, value);
                    }
                }
                const resp = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': antiforgeryToken
                    },
                    body: formData.toString()
                });
                let j = null;
                try { j = await resp.json(); } catch (e) {}
                if (resp.ok && (j === null || j.success !== false)) {
                    return { ok: true, data: j };
                } else {
                    const msg = j?.message || ('HTTP ' + resp.status);
                    if (feedbackElId) showFeedback(feedbackElId, 'danger', '操作失败：' + msg);
                    return { ok: false, message: msg };
                }
            } catch (e) {
                if (feedbackElId) showFeedback(feedbackElId, 'danger', '请求失败：' + e.message);
                return { ok: false, message: e.message };
            }
        }

        // 启停用户（直接调 API 端点）
        window.toggleUserStatus = async function(id, enable) {
            if (!confirm(enable ? '确定启用该用户？' : '确定停用该用户？')) return;
            const url = '/api/v1/auth/users/' + id + '/' + (enable ? 'enable' : 'disable');
            const resp = await fetch(url, { method: 'POST' });
            const j = await resp.json().catch(() => null);
            if (resp.ok && j?.success) {
                alert(enable ? '已启用' : '已停用');
                location.reload();
            } else {
                alert('操作失败：' + (j?.message || '未知错误'));
            }
        };

        // ============== 用户管理 Modal 事件 ==============
        function wireUserPanel() {
            const createModal = document.getElementById('createUserModal');
            const editModal = document.getElementById('editUserModal');
            const pwdModal = document.getElementById('resetPwdModal');
            const delModal = document.getElementById('deleteConfirmModal');
            if (!createModal) return; // 当前 tab 不是 users，跳过

            // Create
            createModal.addEventListener('show.bs.modal', function() {
                hideFeedback('createUserFeedback');
                document.getElementById('createUserForm').reset();
            });
            document.getElementById('createUserForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                hideFeedback('createUserFeedback');
                const data = new FormData(this);
                const btn = document.getElementById('createUserSubmit');
                const orig = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>保存中...';
                const result = await postPanelAction('/Settings?handler=UserCreate', data, 'createUserFeedback');
                btn.disabled = false;
                btn.innerHTML = orig;
                if (result.ok) {
                    showFeedback('createUserFeedback', 'success', '✓ 创建成功！即将刷新...');
                    setTimeout(() => location.reload(), 800);
                }
            });

            // Edit
            editModal.addEventListener('show.bs.modal', function(event) {
                hideFeedback('editUserFeedback');
                const btn = event.relatedTarget;
                if (!btn) return;
                const id = btn.getAttribute('data-user-id');
                const userName = btn.getAttribute('data-user-name');
                const displayName = btn.getAttribute('data-display-name') || '';
                const email = btn.getAttribute('data-email') || '';
                const phone = btn.getAttribute('data-phone') || '';
                const isActive = btn.getAttribute('data-is-active') === 'true';
                const roleIds = (btn.getAttribute('data-role-ids') || '').split(',').filter(s => s);
                // v2.13.93 新增：有效期至回显（datetime-local 接受 yyyy-MM-ddTHH:mm 格式）
                const expiresAt = btn.getAttribute('data-expires-at') || '';
                document.getElementById('editId').value = id;
                document.getElementById('editUserName').value = userName;
                document.getElementById('editDisplayName').value = displayName;
                document.getElementById('editEmail').value = email;
                document.getElementById('editPhone').value = phone;
                document.getElementById('editIsActive').checked = isActive;
                document.getElementById('editExpiresAt').value = expiresAt;
                document.querySelectorAll('#editRolesContainer input[type=checkbox]').forEach(cb => {
                    cb.checked = roleIds.includes(cb.value);
                });
            });
            document.getElementById('editUserForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                hideFeedback('editUserFeedback');
                const data = new FormData(this);

                // Use form values (hidden field ensures proper binding when checkbox unchecked)
                // Defensive sync between checkbox and form value
                const editIsActive = document.getElementById('editIsActive');
                if (editIsActive) {
                    if (!editIsActive.checked && data.get('IsActive') === 'true') {
                        data.set('IsActive', 'false');
                    } else if (editIsActive.checked && data.get('IsActive') !== 'true') {
                        data.set('IsActive', 'true');
                    }
                }

                const btn = document.getElementById('editUserSubmit');
                const orig = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>保存中...';
                const result = await postPanelAction('/Settings?handler=UserUpdate', data, 'editUserFeedback');
                btn.disabled = false;
                btn.innerHTML = orig;
                if (result.ok) {
                    showFeedback('editUserFeedback', 'success', '✓ 更新成功！即将刷新...');
                    setTimeout(() => location.reload(), 800);
                }
            });

            // Reset Password
            pwdModal.addEventListener('show.bs.modal', function(event) {
                hideFeedback('resetPwdFeedback');
                const btn = event.relatedTarget;
                if (!btn) return;
                document.getElementById('pwdId').value = btn.getAttribute('data-user-id');
                document.getElementById('pwdUserName').textContent = btn.getAttribute('data-user-name');
                document.getElementById('pwdNewPassword').value = '';
            });
            document.getElementById('resetPwdForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                hideFeedback('resetPwdFeedback');
                const data = new FormData(this);
                const btn = document.getElementById('resetPwdSubmit');
                const orig = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>重置中...';
                const result = await postPanelAction('/Settings?handler=UserResetPassword', data, 'resetPwdFeedback');
                btn.disabled = false;
                btn.innerHTML = orig;
                if (result.ok) {
                    showFeedback('resetPwdFeedback', 'success', '✓ 密码已重置！即将关闭...');
                    setTimeout(() => bootstrap.Modal.getInstance(pwdModal)?.hide(), 600);
                }
            });

            // Delete
            delModal.addEventListener('show.bs.modal', function(event) {
                hideFeedback('deleteFeedback');
                const btn = event.relatedTarget;
                if (!btn) return;
                document.getElementById('deleteId').value = btn.getAttribute('data-user-id');
                document.getElementById('deleteUserNameDisplay').textContent = btn.getAttribute('data-user-name');
            });
            document.getElementById('deleteForm').addEventListener('submit', async function(e) {
                e.preventDefault();
                hideFeedback('deleteFeedback');
                const data = new FormData(this);
                const btn = document.getElementById('deleteSubmit');
                const orig = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>删除中...';
                const result = await postPanelAction('/Settings?handler=UserDelete', data, 'deleteFeedback');
                btn.disabled = false;
                btn.innerHTML = orig;
                if (result.ok) {
                    showFeedback('deleteFeedback', 'success', '✓ 删除成功！即将刷新...');
                    setTimeout(() => location.reload(), 800);
                }
            });
