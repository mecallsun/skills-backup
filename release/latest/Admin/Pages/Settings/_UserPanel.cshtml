@* v2.13.67 用户管理子 Tab（嵌入 Settings/Index 页）
    原 /Settings/User 独立页面已合并为 Settings 的子 Tab，无需单独路由。
    使用 IndexModel 的 User* 字段（partial class UserPanelPartial.cs）+ URL 改为 /Settings?handler=UserXxx
*@
@model DormManage.Admin.Pages.Settings.IndexModel
@using DormManage.Shared.Extensions

<div class="card">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <strong><i class="bi bi-person-badge"></i> 用户管理</strong>
        <div class="d-flex align-items-center gap-2">
            <span class="text-muted small">共 <strong>@Model.UserTotalCount</strong> 人</span>
            <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createUserModal">
                <i class="bi bi-plus-lg"></i> 新增用户
            </button>
        </div>
    </div>
    <div class="card-body pb-0">
        @if (!string.IsNullOrEmpty(Model.UserSuccessMessage))
        {
            <div class="alert alert-success py-2"><i class="bi bi-check-circle"></i> @Model.UserSuccessMessage</div>
        }
        @if (!string.IsNullOrEmpty(Model.UserErrorMessage))
        {
            <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle"></i> @Model.UserErrorMessage</div>
        }

        <!-- 筛选区 -->
        <form method="get" class="card mb-3 filter-card" data-filter-form="users">
            <div class="card-body py-1">
                <input type="hidden" name="tab" value="users" />
                <div class="row g-2 align-items-end flex-nowrap filter-row">
                    <div class="col-auto filter-item">
                        <label class="form-label mb-1">搜索</label>
                        <input type="text" name="uSearch" value="@Model.UserSearch" class="form-control" placeholder="用户名 / 姓名" />
                    </div>
                    <div class="col-auto filter-item">
                        <label class="form-label mb-1">角色</label>
                        <select name="uRoleId" class="form-select">
                            <option value="">全部</option>
                            @foreach (var role in Model.UserAvailableRoles)
                            {
                                if (Model.UserRoleId == role.Id)
                                {
                                    <option value="@role.Id" selected="selected">@role.RoleName</option>
                                }
                                else
                                {
                                    <option value="@role.Id">@role.RoleName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col-auto filter-item">
                        <label class="form-label mb-1">状态</label>
                        <select name="uStatus" class="form-select">
                            @if (string.IsNullOrEmpty(Model.UserStatus))
                            {
                                <option value="" selected="selected">全部</option>
                            }
                            else
                            {
                                <option value="">全部</option>
                            }
                            @if (Model.UserStatus == "active")
                            {
                                <option value="active" selected="selected">启用</option>
                            }
                            else
                            {
                                <option value="active">启用</option>
                            }
                            @if (Model.UserStatus == "disabled")
                            {
                                <option value="disabled" selected="selected">禁用</option>
                            }
                            else
                            {
                                <option value="disabled">禁用</option>
                            }
                            @if (Model.UserStatus == "locked")
                            {
                                <option value="locked" selected="selected">已锁定</option>
                            }
                            else
                            {
                                <option value="locked">已锁定</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto filter-item filter-item-btn">
                        <div class="filter-item-btn-group">
                            <button type="submit" class="btn btn-primary filter-btn"><i class="bi bi-search"></i> 查询</button>
                            <button type="button" class="btn btn-outline-secondary filter-btn" onclick="FilterPersistence.resetFilters('users')"><i class="bi bi-arrow-counterclockwise"></i> 重置</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th width="60">序号</th>
                        <th class="text-truncate">用户名</th>
                        <th class="text-truncate">姓名</th>
                        <th class="text-truncate">角色</th>
                        @* v2.13.223：删除「联系方式」列（按用户要求） *@
                        <th class="text-truncate">最后时间</th>
                        <th class="text-truncate">登录IP</th>
                        <th style="width:140px">有效期至</th>
                        <th width="120" class="text-center">状态</th>
                        <th width="280">操作</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var startIdx = (Model.UserPageIndex - 1) * Model.UserPageSize + 1;
                        var idx = 0;
                    }
                    @foreach (var u in Model.UserUsers)
                    {
                        idx++;
                        <tr>
                            <td class="text-muted">@(startIdx + idx - 1)</td>
                            <td class="text-truncate" title="@u.UserName"><strong>@u.UserName</strong></td>
                            <td class="text-truncate" title="@u.DisplayName">@u.DisplayName</td>
                            <td class="text-truncate" title="@u.RoleNames">
                                @foreach (var roleName in u.RoleNames.Split(", ", StringSplitOptions.RemoveEmptyEntries))
                                {
                                    <span class="badge bg-info me-1">@roleName</span>
                                }
                            </td>
                            @* v2.13.223：删除「联系方式」对应的 td（与 th 同步） *@
                            <td class="small text-muted text-truncate" title="@(u.LastLoginTime.HasValue ? u.LastLoginTime.Value.ToString("yyyy-MM-dd HH:mm") : "从未登录")">
                                @if (u.LastLoginTime.HasValue)
                                {
                                    @u.LastLoginTime.Value.ToString("yyyy-MM-dd HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">从未登录</span>
                                }
                            </td>
                            <td class="small text-truncate" title="@(string.IsNullOrEmpty(u.LastLoginIp) ? "—" : u.LastLoginIp)">
                                @if (!string.IsNullOrEmpty(u.LastLoginIp))
                                {
                                    <code>@u.LastLoginIp</code>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            @* v2.13.193 修正：使用统一助手 UserExpiryHelper（与 LoginAsync 一致的 >= 语义）*@
                            <td>
                                @if (u.ExpiresAt.HasValue)
                                {
                                    var daysLeft = UserExpiryHelper.DaysUntilExpiry(u.ExpiresAt);
                                    if (daysLeft.HasValue && daysLeft.Value <= 0)
                                    {
                                        // daysLeft <= 0：已过期或今天到期（v2.13.193 修正）
                                        var overdueDays = (daysLeft ?? 0) < 0 ? -(daysLeft ?? 0) : 0;
                                        <span class="badge bg-danger" title="@(overdueDays > 0 ? $"已过期 {overdueDays} 天" : "今天已过期，请联系管理员")">@u.ExpiresAt.Value.ToString("yyyy-MM-dd")</span>
                                    }
                                    else if (daysLeft.HasValue && daysLeft.Value <= 30)
                                    {
                                        <span class="badge bg-warning text-dark" title="剩 @daysLeft 天过期">@u.ExpiresAt.Value.ToString("yyyy-MM-dd")</span>
                                    }
                                    else
                                    {
                                        <span>@u.ExpiresAt.Value.ToString("yyyy-MM-dd")</span>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">永久</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (u.IsActive && !u.IsLocked)
                                {
                                    <span class="badge bg-success">正常</span>
                                }
                                else if (u.IsLocked)
                                {
                                    <span class="badge bg-danger">已锁定</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">禁用</span>
                                }
                            </td>
                            <td class="text-center">
                                @* v2.13.223：操作列按钮风格对齐角色管理（btn-sm btn-outline-primary/success/danger + 图标 + 文字） *@
                                <button class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#editUserModal"
                                        data-user-id="@u.Id"
                                        data-user-name="@u.UserName"
                                        data-display-name="@u.DisplayName"
                                        data-email="@u.Email"
                                        data-phone="@u.Phone"
                                        data-is-active="@u.IsActive.ToString().ToLower()"
                                        data-role-ids="@u.RoleIds"
                                        data-expires-at="@(u.ExpiresAt?.ToString("yyyy-MM-dd"))">
                                    <i class="bi bi-pencil"></i> 编辑
                                </button>
                                @if (u.IsActive)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-warning" onclick="toggleUserStatus(@u.Id, false)" title="停用账号">
                                        <i class="bi bi-pause-circle"></i> 停用
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="toggleUserStatus(@u.Id, true)" title="启用账号">
                                        <i class="bi bi-play-circle"></i> 启用
                                    </button>
                                }
                                <button class="btn btn-sm btn-outline-secondary"
                                        data-bs-toggle="modal"
                                        data-bs-target="#resetPwdModal"
                                        data-user-id="@u.Id"
                                        data-user-name="@u.UserName">
                                    <i class="bi bi-key"></i> 重置密码
                                </button>
                                @if (u.UserName != "admin")
                                {
                                    <button class="btn btn-sm btn-outline-danger"
                                            data-bs-toggle="modal"
                                            data-bs-target="#deleteConfirmModal"
                                            data-user-id="@u.Id"
                                            data-user-name="@u.UserName">
                                        <i class="bi bi-trash"></i> 删除
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.UserUsers.Count == 0)
                    {
                        <tr><td colspan="8" class="text-center py-4 text-muted">暂无数据</td></tr>
                    }
                </tbody>
            </table>
        </div>
        @* v2.13.71 100% 原型对齐：统一分页组件（含每页选择 + 智能截断） *@
        @if (Model.UserTotalCount > 0)
        {
            @await Html.PartialAsync("_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel
            {
                PageIndex = Model.UserPageIndex,
                PageSize = Model.UserPageSize,
                TotalCount = Model.UserTotalCount
            })
        }
    </div>
</div>

<!-- 新增用户 Modal — v2.13.65+v2.13.67 URL 改为 /Settings?handler=UserCreate -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="createUserForm">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-person-plus"></i> 新增用户</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="createUserFeedback" class="alert d-none mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label">用户名 <span class="text-danger">*</span></label>
                        <input type="text" name="UserName" class="form-control" required maxlength="50" pattern="[A-Za-z0-9_-]+" placeholder="英文字母/数字/下划线" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">姓名 <span class="text-danger">*</span></label>
                        <input type="text" name="DisplayName" class="form-control" required maxlength="50" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">初始密码 <span class="text-danger">*</span></label>
                        <input type="password" name="Password" class="form-control" required minlength="6" />
                        <div class="form-text">至少 6 位，建议首次登录后修改</div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">邮箱</label>
                            <input type="email" name="Email" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">电话</label>
                            <input type="text" name="Phone" class="form-control" />
                        </div>
                    </div>
                    @* v2.13.93 新增：账号有效期至 *@
                    <div class="mb-3">
                        <label class="form-label">有效期至 <small class="text-muted">（日期型）</small></label>
                        <input type="date" name="ExpiresAt" class="form-control" />
                        <div class="form-text">v2.13.193 改为日期型：留空 = 永久有效；选择日期 = 那天结束后账号自动过期</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">角色</label>
                        @foreach (var role in Model.UserAvailableRoles)
                        {
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="SelectedRoleIds" value="@role.Id" id="newRole_@role.Id">
                                <label class="form-check-label" for="newRole_@role.Id">
                                    @role.RoleName <small class="text-muted">(@role.RoleCode)</small>
                                </label>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary" id="createUserSubmit"><i class="bi bi-check-lg"></i> 创建</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 编辑用户 Modal -->
<div class="modal fade" id="editUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="editUserForm">
                <input type="hidden" name="Id" id="editId">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil"></i> 编辑用户</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="editUserFeedback" class="alert d-none mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label">用户名</label>
                        <input type="text" id="editUserName" class="form-control" disabled>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">姓名 <span class="text-danger">*</span></label>
                        <input type="text" name="DisplayName" id="editDisplayName" class="form-control" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">邮箱</label>
                            <input type="email" name="Email" id="editEmail" class="form-control">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">电话</label>
                            <input type="text" name="Phone" id="editPhone" class="form-control">
                        </div>
                    </div>
                    @* v2.13.93 新增：账号有效期至 *@
                    <div class="mb-3">
                        <label class="form-label">有效期至 <small class="text-muted">（日期型，到期当天账号自动锁定）</small></label>
                        <input type="date" name="ExpiresAt" id="editExpiresAt" class="form-control" />
                        <div class="form-text">v2.13.193 改为日期型（不再需要时间）：留空 = 永久有效；选择日期 = 那天结束后账号自动过期</div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check pb-2">
                            <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editIsActive">
                            <input type="hidden" name="IsActive" value="false">
                            <label class="form-check-label" for="editIsActive">启用账号</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">角色</label>
                        <div id="editRolesContainer">
                            @foreach (var role in Model.UserAvailableRoles)
                            {
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           name="SelectedRoleIds" value="@role.Id" id="editRole_@role.Id">
                                    <label class="form-check-label" for="editRole_@role.Id">
                                        @role.RoleName <small class="text-muted">(@role.RoleCode)</small>
                                    </label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary" id="editUserSubmit"><i class="bi bi-check-lg"></i> 保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 重置密码 Modal -->
<div class="modal fade" id="resetPwdModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <form id="resetPwdForm">
                <input type="hidden" name="Id" id="pwdId">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-key"></i> 重置密码</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="resetPwdFeedback" class="alert d-none mb-3"></div>
                    <p>为用户 <strong id="pwdUserName"></strong> 设置新密码：</p>
                    <input type="password" name="NewPassword" id="pwdNewPassword" class="form-control" required minlength="6">
                    <div class="form-text">至少 6 位</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-warning" id="resetPwdSubmit"><i class="bi bi-key"></i> 重置</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 删除确认 Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <form id="deleteForm">
                <input type="hidden" name="Id" id="deleteId">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger"></i> 删除确认</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="deleteFeedback" class="alert d-none mb-3"></div>
                    <p>确定要删除用户 <strong id="deleteUserNameDisplay"></strong> 吗？</p>
                    <p class="text-muted small mb-0">此操作不可撤销。</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-danger" id="deleteSubmit"><i class="bi bi-trash"></i> 确认删除</button>
                </div>
            </form>
        </div>
    </div>
</div>