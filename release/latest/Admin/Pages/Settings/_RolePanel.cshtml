@* v2.13.67 角色管理子 Tab（嵌入 Settings/Index 页）
    原 /Settings/Role 独立页面已合并为 Settings 的子 Tab，无需单独路由。
    使用 IndexModel 的 Roles / PermissionGroups / RolePermissions 字段（partial class RolePanelPartial.cs）
    URL 改为 /Settings?handler=RoleCreate 等
*@
@model DormManage.Admin.Pages.Settings.IndexModel

<div class="card mb-3">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <strong><i class="bi bi-shield-lock"></i> 角色管理</strong>
        <button class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#createRoleModal">
            <i class="bi bi-plus-lg"></i> 新增角色
        </button>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
                <tr>
                    <th width="60">序号</th>
                    <th>角色编码</th>
                    <th>角色名称</th>
                    <th>说明</th>
                    <th width="80" class="text-center">排序</th>
                    <th width="80" class="text-center">用户数</th>
                    <th width="100" class="text-center">权限数</th>
                    <th width="100" class="text-center">状态</th>
                    <th width="280">操作</th>
                </tr>
            </thead>
            <tbody>
                @{ var idx = 0; }
                @foreach (var r in Model.Roles)
                {
                    idx++;
                    <tr>
                        <td>@idx</td>
                        <td><code>@r.RoleCode</code></td>
                        <td><strong>@r.RoleName</strong></td>
                        <td class="small text-muted">@r.Description</td>
                        <td class="text-center">@r.SortOrder</td>
                        <td class="text-center"><span class="badge bg-info">@r.UserCount</span></td>
                        <td class="text-center"><span class="badge bg-primary">@r.PermissionCount</span></td>
                        <td class="text-center">
                            @if (r.IsActive)
                            {
                                <span class="badge bg-success">启用</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">禁用</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-outline-primary"
                                    onclick="openEditModal(@r.Id, '@r.RoleCode', '@r.RoleName', '@r.Description', @r.SortOrder, @r.IsActive.ToString().ToLower())">
                                <i class="bi bi-pencil"></i> 编辑
                            </button>
                            <button class="btn btn-sm btn-outline-success"
                                    onclick="openPermMatrixModal(@r.Id, '@r.RoleName')">
                                <i class="bi bi-grid-3x3"></i> 权限矩阵
                            </button>
                            @if (r.RoleCode != "admin")
                            {
                                <button class="btn btn-sm btn-outline-danger"
                                        onclick="confirmDelete(@r.Id, '@r.RoleName')">
                                    <i class="bi bi-trash"></i> 删除
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 权限矩阵总览（只读） -->
<div class="card">
    <div class="card-header bg-light">
        <strong><i class="bi bi-grid-3x3-gap"></i> 权限矩阵总览</strong>
        <small class="text-muted ms-2">（按角色 × 顶级模块展示，✔ 表示已分配）</small>
    </div>
    <div class="table-responsive">
        <table class="table table-bordered mb-0 align-middle text-center">
            <thead class="table-light">
                <tr>
                    <th class="text-start">模块</th>
                    @foreach (var r in Model.Roles)
                    {
                        <th>@r.RoleName</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model.PermissionGroups)
                {
                    <tr>
                        <td class="text-start"><strong>@group.GroupName</strong></td>
                        @foreach (var r in Model.Roles)
                        {
                            var granted = group.Items.Any(p => Model.RolePermissions.GetValueOrDefault(r.Id)?.Contains(p.Id) ?? false);
                            <td>
                                @if (granted)
                                {
                                    <span class="text-success">✔</span>
                                }
                                else
                                {
                                    <span class="text-muted">·</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- 新增角色 Modal -->
<div class="modal fade" id="createRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createRoleForm">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-plus-lg"></i> 新增角色</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="createRoleFeedback" class="alert d-none mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label">角色编码 <span class="text-danger">*</span></label>
                        <input type="text" name="RoleCode" class="form-control" required maxlength="50" pattern="[a-z_]+">
                        <div class="form-text">仅小写字母与下划线，例如：custom_role</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">角色名称 <span class="text-danger">*</span></label>
                        <input type="text" name="RoleName" class="form-control" required maxlength="50">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">说明</label>
                        <textarea name="Description" class="form-control" rows="2" maxlength="200"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">排序</label>
                        <input type="number" name="SortOrder" class="form-control" value="99" min="0" max="999">
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary" id="createRoleSubmit"><i class="bi bi-check-lg"></i> 创建</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 编辑角色 Modal -->
<div class="modal fade" id="editRoleModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="editRoleForm">
                <input type="hidden" name="Id" id="editRoleId">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil"></i> 编辑角色</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="editRoleFeedback" class="alert d-none mb-3"></div>
                    <div class="mb-3">
                        <label class="form-label">角色编码</label>
                        <input type="text" id="editRoleCode" class="form-control" disabled>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">角色名称 <span class="text-danger">*</span></label>
                        <input type="text" name="RoleName" id="editRoleName" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">说明</label>
                        <textarea name="Description" id="editRoleDesc" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">排序</label>
                        <input type="number" name="SortOrder" id="editRoleSort" class="form-control" min="0" max="999">
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="editRoleActive">
                        @* v2.13.221 BUG 1 修复：删除 hidden input（避免 FormData 同时包含 false+true 时模型绑定取 false）。
                           改为在 JS 提交时根据 checkbox 状态用 data.set('IsActive', 'true'/'false') 单值提交。 *@
                        <label class="form-check-label" for="editRoleActive">启用角色</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary" id="editRoleSubmit"><i class="bi bi-check-lg"></i> 保存</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 权限矩阵编辑 Modal -->
<div class="modal fade" id="permMatrixModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="permMatrixForm">
                <input type="hidden" name="RoleId" id="permRoleId">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-grid-3x3"></i> 权限分配 - <span id="permRoleName"></span></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="permMatrixFeedback" class="alert d-none mb-3"></div>

                    @* v2.13.102 新增：DB seed 完整性自检 banner（仿 L213 隐私字段权限 nested card 模式） *@
                    @if (Model.SeedIntegrity is null)
                    {
                        <div class="alert alert-secondary py-2 mb-3 small" id="seedIntegrityBanner">
                            <i class="bi bi-question-circle"></i> 完整性检查未运行（数据库连接异常）
                        </div>
                    }
                    else if (!Model.SeedIntegrity.Ok)
                    {
                        <div class="card mb-3 border-warning" id="seedIntegrityBanner">
                            <div class="card-header py-2 bg-warning bg-opacity-10">
                                <strong><i class="bi bi-exclamation-triangle-fill text-warning"></i> DB seed 完整性检查未通过</strong>
                                <small class="text-muted ms-2">(@Model.SeedIntegrity.CheckedAt.ToString("HH:mm:ss"))</small>
                            </div>
                            <div class="card-body py-2">
                                <ul class="mb-2 mt-1 small">
                                    @if (Model.SeedIntegrity.MissingPermissionCodes.Count > 0)
                                    {
                                        <li><strong class="text-danger">缺失 SysPermission：</strong>@string.Join("、", Model.SeedIntegrity.MissingPermissionLabels)</li>
                                    }
                                    @if (Model.SeedIntegrity.MissingAdminPermissionCodes.Count > 0)
                                    {
                                        <li><strong class="text-danger">缺失 admin 授权：</strong>@string.Join("、", Model.SeedIntegrity.MissingRolePermissionLabels)</li>
                                    }
                                    @if (Model.SeedIntegrity.FieldPermissionCount < Model.SeedIntegrity.ExpectedFieldPermissionCount)
                                    {
                                        <li><strong class="text-danger">SysFieldPermission 仅 @Model.SeedIntegrity.FieldPermissionCount/@Model.SeedIntegrity.ExpectedFieldPermissionCount 行</strong></li>
                                    }
                                </ul>
                                <small class="text-muted d-block mb-2">
                                    <strong>修复方法：</strong>点击下方「一键修复」按钮立即补种（无需重启 Admin）；或重启 <code>DormManage.Admin.exe</code>（非托盘）触发 <code>DatabaseInitializer.InitializeAsync</code>。
                                    若仍缺失，检查「数据库连接」是否与托盘一致；启动日志应输出 <code>[v2.13.101 Verify] 完整性检查通过</code>。
                                </small>
                                <div class="d-flex gap-2">
                                    <button type="button" class="btn btn-sm btn-warning"
                                            onclick="runSeedIntegrityRepair()">
                                        <i class="bi bi-tools"></i> 一键修复
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-primary"
                                            onclick="refreshSeedIntegrityBanner()">
                                        <i class="bi bi-arrow-clockwise"></i> 重新检查
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card mb-3 border-success" id="seedIntegrityBanner">
                            <div class="card-header py-2 bg-success bg-opacity-10">
                                <strong><i class="bi bi-check-circle-fill text-success"></i> DB seed 完整性检查通过</strong>
                                <small class="text-muted ms-2">(@Model.SeedIntegrity.CheckedAt.ToString("HH:mm:ss"))</small>
                            </div>
                            <div class="card-body py-2 small">
                                <i class="bi bi-database-check"></i>
                                SysPermission @Model.SeedIntegrity.PresentPermCount/5 ·
                                SysRolePermission(admin) @Model.SeedIntegrity.PresentRpCount/5 ·
                                SysFieldPermission @Model.SeedIntegrity.FieldPermissionCount/@Model.SeedIntegrity.ExpectedFieldPermissionCount
                            </div>
                        </div>
                    }

                    @* v2.13.92 新增：隐私字段权限总开关（独立于 perm-cb 自动级联之外）
                       v2.13.193 修订：deny-by-default 语义 — 勾选后才允许显示，未勾选则全部隐藏
                       v2.13.196 修订：文案统一为「允许显示隐私字段」，与代码逻辑一致
                    *@
                    <div class="card mb-3 border-info">
                        <div class="card-header py-2 bg-info bg-opacity-10">
                            <strong><i class="bi bi-shield-check"></i> 隐私字段权限（数据权限）</strong>
                        </div>
                        <div class="card-body py-2">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox"
                                       name="PrivacyFieldEnabled" value="true" id="perm_privacy_field"
                                       @(Model.RolePrivacyFieldEnabled ? "checked" : "")>
                                @* v2.13.221 BUG 2 修复：添加 hidden input（与 IsActive 同样模式），保证未勾选时 FormData 包含 PrivacyFieldEnabled=false *@
                                <input type="hidden" name="PrivacyFieldEnabled" value="false">
                                <label class="form-check-label" for="perm_privacy_field">
                                    <strong>允许显示隐私字段</strong>
                                    <small class="text-muted d-block ms-4">
                                        勾选后，该角色可以查看「字段权限」清单中所有敏感字段（如姓名、手机号、工号等）。
                                        <strong class="text-danger">不勾选（默认）</strong> → 该角色看不到所有隐私字段（deny-by-default 安全策略）。
                                        配置清单请到 <a href="#" onclick="setActiveTab('fields'); return false;">字段权限</a> 标签。
                                    </small>
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        @foreach (var group in Model.PermissionGroups)
                        {
                            <div class="col-md-6 mb-3">
                                <div class="card">
                                    <div class="card-header py-2 bg-light">
                                        <strong>@group.GroupName</strong>
                                    </div>
                                    <div class="card-body py-2">
                                        @foreach (var perm in group.Items)
                                        {
                                            <div class="form-check @(perm.ParentId == 0 ? "perm-row-top" : "perm-row-child")">
                                                <input class="form-check-input perm-cb" type="checkbox"
                                                       name="PermissionIds" value="@perm.Id" id="perm_@perm.Id"
                                                       data-role-id=""
                                                       data-parent-id="@perm.ParentId"
                                                       data-perm-type="@perm.PermissionType"
                                                       data-perm-code="@perm.PermissionCode">
                                                <label class="form-check-label small @(perm.ParentId == 0 ? "fw-bold" : "")" for="perm_@perm.Id">
                                                    @perm.PermissionName
                                                    @if (perm.PermissionType == 1)
                                                    {
                                                        <span class="badge bg-primary ms-1">菜单</span>
                                                    }
                                                    else if (perm.PermissionType == 2)
                                                    {
                                                        <span class="badge bg-secondary ms-1">按钮</span>
                                                    }
                                                    else if (perm.PermissionType == 3)
                                                    {
                                                        <span class="badge bg-info ms-1">数据</span>
                                                    }
                                                </label>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" onclick="selectAllPerms(true)">全选</button>
                    <button type="button" class="btn btn-outline-secondary" onclick="selectAllPerms(false)">全不选</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-primary" id="permMatrixSubmit"><i class="bi bi-check-lg"></i> 保存权限</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- 删除确认 Modal — v2.13.67 改用 Bootstrap modal（v2.13.65 Role 版用 confirm()，现已统一） -->
<div class="modal fade" id="deleteRoleConfirmModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <form id="deleteRoleForm">
                <input type="hidden" name="Id" id="deleteRoleId">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle text-danger"></i> 删除角色</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div id="deleteRoleFeedback" class="alert d-none mb-3"></div>
                    <p>确定要删除角色 <strong id="deleteRoleNameDisplay"></strong> 吗？</p>
                    <p class="text-muted small mb-0">此操作不可撤销。</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                    <button type="submit" class="btn btn-danger" id="deleteRoleSubmit"><i class="bi bi-trash"></i> 确认删除</button>
                </div>
            </form>
        </div>
    </div>
</div>