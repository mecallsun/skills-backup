@page
@model DormManage.Admin.Pages.Meter.EntryModel
@{
    ViewData["Title"] = "手动补录抄表";
    Layout = "_Layout";
}

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery PageAntiforgery
@{
    var antiforgery = PageAntiforgery.GetAndStoreTokens(HttpContext);
}

@section Styles {
    <style>
        /* v2.12.36 紧凑一屏布局：去掉规范信息，减小行间距 */
        .meter-card { border-left: 3px solid #1976d2; }
        .upload-ph {
            height: 50px;
            border: 2px dashed #cfd8dc;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #90a4ae;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.8rem;
            position: relative;
        }
        .upload-ph:hover { border-color: #1976d2; color: #1976d2; }
        .upload-ph.has-file { border-color: #198754; color: #198754; border-style: solid; }
        .upload-ph img.upload-thumb { max-width: 36px; max-height: 36px; border-radius: 4px; object-fit: cover; margin-right: 6px; }
        .usage-preview { background: #f8f9fa; border-radius: 8px; padding: 8px 12px; font-size: 0.85rem; }
        .form-card-body .form-section { margin-bottom: 0.6rem; }
        .form-card-body .form-section-title { font-size: 0.85rem; font-weight: 600; color: #1976d2; border-left: 3px solid #1976d2; padding-left: 0.5rem; margin-bottom: 0.4rem; }
        .form-card-body .form-field { margin-bottom: 0.5rem; }
        .form-card-body .form-label { font-size: 0.85rem; font-weight: 500; color: #495057; margin-bottom: 0.2rem; }
        .form-card-body .form-label .required { color: #dc3545; margin-left: 2px; }
        .form-card-body .form-control, .form-card-body .form-select { border-radius: 6px; padding: 0.375rem 0.75rem; font-size: 0.9rem; }
    </style>
}

<div class="container-fluid">
    <!-- v2.12.36 紧凑页头：去掉副标题（"后台人工录入"）和规范信息提示卡片 -->
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">
            <i class="bi bi-pencil-square text-success"></i> 手动补录抄表
        </h2>
        <a href="/Meter" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i> 返回智能抄表
        </a>
    </div>

    <form id="entryForm"
      data-prev-cold="@(Model.LastRecord?.ColdMeter.ToString("F2") ?? "")"
      data-prev-hot="@(Model.LastRecord?.HotMeter.ToString("F2") ?? "")"
      data-prev-electric="@(Model.LastRecord?.ElectricMeter.ToString("F2") ?? "")"
      data-has-prev="@(Model.LastRecord != null ? "1" : "0")">
        <input type="hidden" id="antiforgeryToken" value="@antiforgery.RequestToken" />
        <div class="row">
            <!-- 左侧：表单 -->
            <div class="col-md-8">
                <!-- 基本信息 -->
                <div class="card meter-card mb-2">
                    <div class="card-body py-2">
                        <div class="form-section-title">基本信息</div>
                        <div class="row g-2">
                            <div class="col-md-4 form-field">
                                <label class="form-label">住宿<span class="required">*</span></label>
                                <select asp-for="DormId" class="form-select" onchange="onDormMonthChange()" required>
                                    <option value="">请选择住宿</option>
                                    @foreach (var dorm in Model.Dorms)
                                    {
                                        <option value="@dorm.Id" selected="@(Model.DormId == dorm.Id)">
                                            @dorm.DormCode | @dorm.AddressText
                                        </option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-4 form-field">
                                <label class="form-label">抄表月份<span class="required">*</span></label>
                                <input type="month" asp-for="ReadMonth" class="form-control" onchange="onDormMonthChange()" required>
                                <span asp-validation-for="ReadMonth" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 form-field">
                                <label class="form-label">抄表员</label>
                                <input type="text" class="form-control" value="admin（后台补录）" disabled>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(Model.ExistWarning))
                        {
                            <div class="alert alert-warning mt-2 mb-0 py-1" style="font-size:0.85rem;">
                                <i class="bi bi-exclamation-triangle"></i> @Model.ExistWarning
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(Model.LastReadingRef))
                        {
                            <div class="alert alert-secondary mt-2 mb-0 py-1" style="font-size:0.85rem;">
                                <i class="bi bi-clock-history"></i> @Model.LastReadingRef
                            </div>
                        }
                    </div>
                </div>

                <!-- 三表读数输入（紧凑三列卡片） -->
                <div class="row g-2 mb-2" id="meterInputs">
                    <div class="col-md-4">
                        <div class="card meter-card h-100 border-0 shadow-sm" style="border-left: 3px solid #1976d2 !important;">
                            <div class="card-body py-2">
                                <h6 class="text-primary mb-1"><i class="bi bi-droplet"></i> 冷水</h6>
                                <input type="number" step="0.01" min="0" name="ColdMeter" id="ColdMeter" class="form-control form-control-sm" placeholder="读数（m³）" oninput="onReadingInput()">
                                <small class="text-muted d-block" id="hint-cold">用量：—</small>
                                <input type="file" id="photo-cold" accept="image/*" capture="environment" class="d-none" onchange="onPhotoSelected('cold', this)">
                                <div class="upload-ph mt-1" id="upload-ph-cold" onclick="document.getElementById('photo-cold').click()">
                                    <i class="bi bi-camera"></i>&nbsp;<span id="label-cold">上传冷水照片</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card meter-card h-100 border-0 shadow-sm" style="border-left: 3px solid #0dcaf0 !important;">
                            <div class="card-body py-2">
                                <h6 class="text-info mb-1"><i class="bi bi-steam"></i> 热水</h6>
                                <input type="number" step="0.01" min="0" name="HotMeter" id="HotMeter" class="form-control form-control-sm" placeholder="读数（m³）" oninput="onReadingInput()">
                                <small class="text-muted d-block" id="hint-hot">用量：—</small>
                                <input type="file" id="photo-hot" accept="image/*" capture="environment" class="d-none" onchange="onPhotoSelected('hot', this)">
                                <div class="upload-ph mt-1" id="upload-ph-hot" onclick="document.getElementById('photo-hot').click()">
                                    <i class="bi bi-camera"></i>&nbsp;<span id="label-hot">上传热水照片</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="card meter-card h-100 border-0 shadow-sm" style="border-left: 3px solid #ffc107 !important;">
                            <div class="card-body py-2">
                                <h6 class="text-warning mb-1"><i class="bi bi-lightning"></i> 电</h6>
                                <input type="number" step="0.01" min="0" name="ElectricMeter" id="ElectricMeter" class="form-control form-control-sm" placeholder="读数（度）" oninput="onReadingInput()">
                                <small class="text-muted d-block" id="hint-electric">用量：—</small>
                                <input type="file" id="photo-electric" accept="image/*" capture="environment" class="d-none" onchange="onPhotoSelected('electric', this)">
                                <div class="upload-ph mt-1" id="upload-ph-electric" onclick="document.getElementById('photo-electric').click()">
                                    <i class="bi bi-camera"></i>&nbsp;<span id="label-electric">上传电表照片</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 备注（紧凑） -->
                <div class="card meter-card mb-2">
                    <div class="card-body py-2">
                        <label class="form-label">备注</label>
                        <textarea name="Remark" id="Remark" class="form-control form-control-sm" rows="2" placeholder="异常说明（如：PDA 未上传、读数修正原因等）"></textarea>
                    </div>
                </div>

                <!-- 操作按钮 -->
                <div class="d-flex gap-2">
                    <a href="/Meter" class="btn btn-outline-secondary">取消</a>
                    <button type="button" class="btn btn-primary" id="submitBtn" onclick="submitForm()">
                        <i class="bi bi-check"></i> 提交
                    </button>
                </div>
            </div>

            <!-- 右侧：用量预览（紧凑） -->
            <div class="col-md-4">
                <div class="card mb-2">
                    <div class="card-header bg-light py-2">
                        <strong style="font-size:0.9rem;"><i class="bi bi-calculator"></i> 本月用量预览</strong>
                    </div>
                    <div class="card-body py-2">
                        <div id="usagePreview" class="usage-preview">
                            <p class="text-muted small mb-0">请选择住宿与月份，并录入读数</p>
                        </div>
                    </div>
                </div>

                @if (Model.LastRecord != null)
                {
                    <div class="card">
                        <div class="card-header bg-light py-2">
                            <strong style="font-size:0.9rem;"><i class="bi bi-clock-history"></i> 上月读数参考</strong>
                        </div>
                        <div class="card-body py-2">
                            <table class="table table-sm table-borderless mb-0" style="font-size:0.85rem;">
                                <tr>
                                    <th width="60" class="text-muted">冷水</th>
                                    <td>@Model.LastRecord.ColdMeter.ToString("F2") m³</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">热水</th>
                                    <td>@Model.LastRecord.HotMeter.ToString("F2") m³</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">电</th>
                                    <td>@Model.LastRecord.ElectricMeter.ToString("F2") 度</td>
                                </tr>
                                <tr>
                                    <th class="text-muted">月份</th>
                                    <td>@Model.LastRecord.ReadMonth</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        // ========== v2.13.68 原型功能完整性 100%：照片 + AJAX + 上月读数实时加载 ==========

        var csrfToken = document.getElementById('antiforgeryToken').value;
        var selectColdDataURL = null;
        var selectHotDataURL = null;
        var selectElectricDataURL = null;
        var selectColdFile = null, selectHotFile = null, selectElectricFile = null;

        // v2.13.68 AJAX 加载上月读数（住宿/月份变更时触发）
        function onDormMonthChange() {
            var dormId = document.querySelector('select[name="DormId"]').value;
            var readMonth = document.querySelector('input[name="ReadMonth"]').value;
            if (!dormId || !readMonth) return;

            fetch('/Meter/Entry?handler=LoadReadings&dormId=' + dormId + '&readMonth=' + encodeURIComponent(readMonth))
                .then(function(r) { return r.json(); })
                .then(function(data) {
                    if (!data.success) return;
                    var form = document.getElementById('entryForm');
                    form.setAttribute('data-prev-cold', data.prevCold.toFixed(2));
                    form.setAttribute('data-prev-hot', data.prevHot.toFixed(2));
                    form.setAttribute('data-prev-electric', data.prevElectric.toFixed(2));
                    form.setAttribute('data-has-prev', data.hasPrev ? '1' : '0');

                    var warn = document.getElementById('existWarning');
                    if (warn) warn.remove();
                    if (data.currentStatus >= 0) {
                        var statusNames = ['', '未完成', '正常', '已修正', '未完成(PDA)', '已作废'];
                        var statusName = statusNames[data.currentStatus] || '未知';
                        var alertClass = data.isEffective ? 'alert-warning' : 'alert-info';
                        var icon = data.isEffective ? 'bi-exclamation-triangle' : 'bi-info-circle';
                        var html = '<div id="existWarning" class="alert ' + alertClass + ' mt-2 mb-0 py-1" style="font-size:0.85rem;">'
                            + '<i class="bi ' + icon + '"></i> '
                            + (data.isEffective
                                ? '⚠️ 该住宿 ' + readMonth + ' 已有【' + statusName + '】记录（ID: ' + data.currentRecordId + '），如需修改请走【修正】流程，不可重复补录。'
                                : 'ℹ️ 该住宿 ' + readMonth + ' 已有【' + statusName + '】占位记录（ID: ' + data.currentRecordId + '），提交后将覆盖此记录，旧数据保存到备注历史。')
                            + '</div>';
                        var basicCard = document.querySelector('.card.meter-card.mb-2 .card-body');
                        if (basicCard) basicCard.insertAdjacentHTML('beforeend', html);
                    }

                    onReadingInput();
                })
                .catch(function(err) { console.error('[v2.13.68] 加载读数失败：', err); });
        }

        // v2.13.41 用量计算 + 校验
        function onReadingInput() {
            var form = document.getElementById('entryForm');
            var hasPrev = form.getAttribute('data-has-prev') === '1';
            var prevCold = parseFloat(form.getAttribute('data-prev-cold')) || 0;
            var prevHot = parseFloat(form.getAttribute('data-prev-hot')) || 0;
            var prevElectric = parseFloat(form.getAttribute('data-prev-electric')) || 0;

            var cold = parseFloat(document.getElementById('ColdMeter').value);
            var hot = parseFloat(document.getElementById('HotMeter').value);
            var electric = parseFloat(document.getElementById('ElectricMeter').value);

            var coldUsage = (isNaN(cold) || !hasPrev) ? 0 : Math.max(0, cold - prevCold);
            var hotUsage = (isNaN(hot) || !hasPrev) ? 0 : Math.max(0, hot - prevHot);
            var electricUsage = (isNaN(electric) || !hasPrev) ? 0 : Math.max(0, electric - prevElectric);

            var hintCold = document.getElementById('hint-cold');
            var hintHot = document.getElementById('hint-hot');
            var hintElectric = document.getElementById('hint-electric');

            function renderHint(el, current, prev, usage, unit, noPrevLabel) {
                if (isNaN(current) || current === 0) {
                    el.className = 'text-muted d-block';
                    el.textContent = '用量：—';
                    return;
                }
                if (!hasPrev) {
                    el.className = 'text-info d-block';
                    el.innerHTML = '<i class="bi bi-info-circle"></i> ' + noPrevLabel + '（无上月） | 当前读数 ' + current.toFixed(2) + ' ' + unit;
                    return;
                }
                if (current < prev) {
                    el.className = 'text-danger d-block';
                    el.innerHTML = '<i class="bi bi-x-circle-fill"></i> ✗ 当前读数 ' + current.toFixed(2) + ' < 上月 ' + prev.toFixed(2) + ' ' + unit;
                    return;
                }
                el.className = 'text-success d-block';
                el.innerHTML = '<i class="bi bi-check-circle"></i> 用量：+ ' + usage.toFixed(2) + ' ' + unit + '（上月 ' + prev.toFixed(2) + ' → 本月 ' + current.toFixed(2) + '）';
            }

            renderHint(hintCold, cold, prevCold, coldUsage, 'm³', '首次抄表');
            renderHint(hintHot, hot, prevHot, hotUsage, 'm³', '首次抄表');
            renderHint(hintElectric, electric, prevElectric, electricUsage, '度', '首次抄表');

            var preview = document.getElementById('usagePreview');
            var total = coldUsage + hotUsage + electricUsage;
            if (coldUsage > 0 || hotUsage > 0 || electricUsage > 0) {
                preview.innerHTML =
                    '<div class="d-flex justify-content-between mb-1"><span>冷水用量</span><span class="fw-bold text-primary">' + coldUsage.toFixed(2) + ' m³</span></div>' +
                    '<div class="d-flex justify-content-between mb-1"><span>热水用量</span><span class="fw-bold text-info">' + hotUsage.toFixed(2) + ' m³</span></div>' +
                    '<div class="d-flex justify-content-between mb-1"><span>电用量</span><span class="fw-bold text-warning">' + electricUsage.toFixed(2) + ' 度</span></div>' +
                    '<hr class="my-1"><div class="d-flex justify-content-between"><span class="fw-bold">合计用量</span><span class="fw-bold text-success">' + total.toFixed(2) + '</span></div>';
            } else {
                preview.innerHTML = '<p class="text-muted small mb-0">请录入读数</p>';
            }

            // v2.13.41：读数 < 上月时禁用提交按钮
            var submitBtn = document.getElementById('submitBtn');
            if (submitBtn) {
                var hasError = (!isNaN(cold) && hasPrev && cold < prevCold) ||
                               (!isNaN(hot) && hasPrev && hot < prevHot) ||
                               (!isNaN(electric) && hasPrev && electric < prevElectric);
                submitBtn.disabled = hasError;
            }
        }

        // v2.13.68 照片预览
        function onPhotoSelected(meterType, input) {
            var file = input.files[0];
            if (!file) return;
            var reader = new FileReader();
            reader.onload = function(e) {
                var ph = document.getElementById('upload-ph-' + meterType);
                var label = document.getElementById('label-' + meterType);
                var dataUrl = e.target.result;
                if (meterType === 'cold') selectColdDataURL = dataUrl, selectColdFile = file;
                else if (meterType === 'hot') selectHotDataURL = dataUrl, selectHotFile = file;
                else selectElectricDataURL = dataUrl, selectElectricFile = file;

                var typeNames = { cold: '冷水', hot: '热水', electric: '电' };
                ph.classList.add('has-file');
                ph.innerHTML = '<img class="upload-thumb" src="' + dataUrl + '"><span id="label-' + meterType + '" class="small">已选 ' + file.name + '（' + (file.size / 1024).toFixed(1) + ' KB）<i class="bi bi-x-circle ms-1" onclick="clearPhoto(\'' + meterType + '\', event)"></i></span>';
            };
            reader.readAsDataURL(file);
        }

        function clearPhoto(meterType, ev) {
            if (ev) ev.stopPropagation();
            var input = document.getElementById('photo-' + meterType);
            input.value = '';
            var ph = document.getElementById('upload-ph-' + meterType);
            ph.classList.remove('has-file');
            var labels = { cold: '上传冷水照片', hot: '上传热水照片', electric: '上传电表照片' };
            ph.innerHTML = '<i class="bi bi-camera"></i>&nbsp;<span id="label-' + meterType + '">' + labels[meterType] + '</span>';
            if (meterType === 'cold') selectColdDataURL = null, selectColdFile = null;
            else if (meterType === 'hot') selectHotDataURL = null, selectHotFile = null;
            else selectElectricDataURL = null, selectElectricFile = null;
        }

        // v2.13.68 AJAX 提交：先保存读数，再依次上传照片，最后跳转
        async function submitForm() {
            var submitBtn = document.getElementById('submitBtn');
            if (submitBtn.disabled) return;
            submitBtn.disabled = true;
            submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> 保存中...';

            var dormId = document.querySelector('select[name="DormId"]').value;
            var readMonth = document.querySelector('input[name="ReadMonth"]').value;
            var cold = document.getElementById('ColdMeter').value;
            var hot = document.getElementById('HotMeter').value;
            var electric = document.getElementById('ElectricMeter').value;
            var remark = document.querySelector('textarea[name="Remark"]').value;

            if (!dormId) { alert('请选择住宿'); submitBtn.disabled = false; submitBtn.innerHTML = '<i class="bi bi-check"></i> 提交'; return; }
            if (!readMonth) { alert('请选择抄表月份'); submitBtn.disabled = false; submitBtn.innerHTML = '<i class="bi bi-check"></i> 提交'; return; }
            if (!cold || !hot || !electric) { alert('请录入三表读数'); submitBtn.disabled = false; submitBtn.innerHTML = '<i class="bi bi-check"></i> 提交'; return; }

            // Step 1: 保存读数
            var fd = new FormData();
            fd.append('DormId', dormId);
            fd.append('ReadMonth', readMonth);
            fd.append('ColdMeter', cold);
            fd.append('HotMeter', hot);
            fd.append('ElectricMeter', electric);
            fd.append('Remark', remark || '');

            try {
                var resp = await fetch('/Meter/Entry?handler=SaveReadings', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': csrfToken },
                    body: fd
                });
                var data = await resp.json();
                if (!data.success) {
                    alert('❌ ' + (data.message || '保存失败'));
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="bi bi-check"></i> 提交';
                    return;
                }

                var recordId = data.recordId;
                var photoCount = 0, photoOk = 0;
                var photos = [['cold', selectColdFile], ['hot', selectHotFile], ['electric', selectElectricFile]];

                // Step 2: 依次上传每个照片
                for (var i = 0; i < photos.length; i++) {
                    var mt = photos[i][0], file = photos[i][1];
                    if (!file) continue;
                    photoCount++;
                    var imgFd = new FormData();
                    imgFd.append('image', file);
                    try {
                        var r = await fetch('/Meter/Entry?handler=UploadImage&recordId=' + recordId + '&meterType=' + mt, {
                            method: 'POST',
                            headers: { 'RequestVerificationToken': csrfToken },
                            body: imgFd
                        });
                        var j = await r.json();
                        if (j.success) photoOk++;
                        else console.warn('[v2.13.68] ' + mt + ' 上传失败：', j.message);
                    } catch (err) {
                        console.error('[v2.13.68] ' + mt + ' 上传错误：', err);
                    }
                }

                var msg = data.message + (photoCount > 0 ? ('\n📷 上传照片：' + photoOk + '/' + photoCount + ' 成功') : '');
                alert('✅ ' + msg);
                window.location.href = '/Meter';
            } catch (err) {
                alert('❌ 网络错误：' + err.message);
                submitBtn.disabled = false;
                submitBtn.innerHTML = '<i class="bi bi-check"></i> 提交';
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            onReadingInput();
        });
    </script>
}
