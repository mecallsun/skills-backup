@page
@model DormManage.Admin.Pages.EmployeeBilling.IndexModel
@{
    ViewData["Title"] = "员工账单";
    Layout = "_Layout";

    var currentPage = Model.PageIndex;
    var pageSize = Model.PageSize;
    var totalCount = Model.Result?.TotalCount ?? 0;
    var totalPages = totalCount > 0 ? (int)Math.Ceiling(totalCount / (double)pageSize) : 0;
    var startIndex = (currentPage - 1) * pageSize + 1;
}

<div class="container-fluid">
    <!-- 页头（v2.13.15 使用 PageHeader 组件） -->
    @await Component.InvokeAsync("PageHeader", new {
        icon = "bi-wallet2",
        title = "员工账单",
        count = Model.Total,
        countLabel = "条",
        @* v2.13.88 RBAC：生成分摊/重新生成 → employeebilling:generate；全部发布 → employeebilling:publish；导出 → employeebilling:export *@
        primaryAction = new PageAction { Label = "生成分摊", OnClick = "generateBilling()", Icon = "bi-plus-circle", Style = "success", PermissionCode = "employeebilling:generate" },
        actions = new List<PageAction> {
            new() { Label = "重新生成", OnClick = "regenerateBilling()", Icon = "bi-arrow-clockwise", Style = "warning", PermissionCode = "employeebilling:generate" },
            new() { Label = "全部发布", OnClick = "publishAll()", Icon = "bi-check2-all", Style = "primary", PermissionCode = "employeebilling:publish" },
            new() { Label = "导出Excel", OnClick = "exportBilling(event)", Icon = "bi-file-earmark-excel", Style = "success", PermissionCode = "employeebilling:export" }
        }
    })

    <!-- 筛选条件区域（v2.13.20 统一结构：计费月份 → 员工 → 部门 → 员工类型 → 住宿状态 → 宿舍房号 → 分摊合计 → 查询/重置） -->
    <form method="get" class="card mb-3 filter-card" data-filter-form="employeeBilling">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end flex-nowrap filter-row">
                <div class="col-auto filter-item filter-item-month">
                    <label class="form-label mb-1">计费月份</label>
                    <input type="month" name="BillingMonth" value="@Model.BillingMonth" class="form-control">
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">员工（姓名/工号/手机）</label>
                    <input type="text" name="EmpKeyword" value="@Model.EmpKeyword" class="form-control" placeholder="模糊查询">
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">部门</label>
                    <select name="DepartmentId" class="form-select">
                        <option value="">全部</option>
                        @foreach (var item in Model.Departments)
                        {
                            <option value="@item.Id" selected="@(Model.DepartmentId == item.Id)">@item.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">员工类型</label>
                    <select name="EmployeeTypeId" class="form-select">
                        <option value="">全部</option>
                        @foreach (var item in Model.EmployeeTypes)
                        {
                            <option value="@item.Id" selected="@(Model.EmployeeTypeId == item.Id)">@item.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">住宿状态</label>
                    <select name="ResidenceStatusId" class="form-select">
                        <option value="">全部</option>
                        @foreach (var item in Model.ResidenceStatuses)
                        {
                            <option value="@item.Id" selected="@(Model.ResidenceStatusId == item.Id)">@item.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">在职状态</label>
                    <select name="EmploymentStatusId" class="form-select">
                        <option value="">全部</option>
                        @foreach (var item in Model.EmploymentStatuses)
                        {
                            <option value="@item.Id" selected="@(Model.EmploymentStatusId == item.Id)">@item.Name</option>
                        }
                    </select>
                </div>
                <div class="col-auto filter-item filter-item-dorm">
                    <label class="form-label mb-1">房号</label>
                    <input list="dormListEmployeeBilling" type="text" name="DormCode" value="@Model.DormCode" class="form-control" placeholder="选择或输入房号">
                    <datalist id="dormListEmployeeBilling">
                        @foreach (var code in Model.DormCodes)
                        {
                            <option value="@code"></option>
                        }
                    </datalist>
                </div>
                <div class="col-auto filter-item filter-item-stats">
                    <label class="form-label mb-1">费用合计</label>
                    <div class="form-control text-success fw-bold bg-light">¥@Model.Result?.Items.Sum(i => i.FinalAmount).ToString("N2")</div>
                </div>
                <div class="col-auto filter-item filter-item-btn">
                    <div class="filter-item-btn-group">
                        <button type="submit" class="btn btn-primary filter-btn">
                            <i class="bi bi-search"></i> 查询
                        </button>
                        <button type="button" class="btn btn-outline-secondary filter-btn" onclick="FilterPersistence.resetFilters('employeeBilling')">
                            <i class="bi bi-arrow-clockwise"></i> 重置
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- 列表 -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th width="60" class="text-center">序号</th>
                            <th>工号</th>
                            <th>姓名</th>
                            <th>部门</th>
                            <th>房号</th>
                            <th class="text-center">计费月份</th>
                            <th class="text-center">冷水分摊</th>
                            <th class="text-center">热水分摊</th>
                            <th class="text-center">电分摊</th>
                            <th class="text-center">在住人数</th>
                            <th class="text-center">入住天数</th>
                            <th class="text-center">补贴金额</th>
                            <th class="text-center">费用合计</th>
                            <th class="text-center">发布状态</th>
                            <th width="140" class="text-center">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Result?.Items.Count > 0)
                        {
                            var index = startIndex;
                            foreach (var item in Model.Result.Items)
                            {
                                <tr>
                                    <td class="text-center text-muted">@index</td>
                                    <td><strong>@item.EmployeeCode</strong></td>
                                    <td>
                                        @item.EmployeeName
                                        @* v2.13.86 性别 Badge *@
                                        @if (item.Gender == 1)
                                        {
                                            <span class="badge bg-primary ms-1"><i class="bi bi-gender-male"></i></span>
                                        }
                                        else if (item.Gender == 2)
                                        {
                                            <span class="badge bg-danger ms-1"><i class="bi bi-gender-female"></i></span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary ms-1">-</span>
                                        }
                                    </td>
                                    <td>@item.Department</td>
                                    <td>@item.DormCode</td>
                                    <td class="text-center">@item.BillingMonth</td>
                                    <td class="text-center">¥@item.ColdShareAmount.ToString("N2")</td>
                                    <td class="text-center">¥@item.HotShareAmount.ToString("N2")</td>
                                    <td class="text-center">¥@item.ElectricityShareAmount.ToString("N2")</td>
                                    <td class="text-center">@item.ResidentCount 人</td>
                                    <td class="text-center text-muted">
                                        @* v2.13.93 新增：入住天数列 *@
                                        @if (item.Days > 0)
                                        {
                                            <span class="badge bg-light text-dark border">@item.Days 天</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @* v2.13.93 新增：补贴金额列 *@
                                        @if (item.SubsidyAmount > 0)
                                        {
                                            <span class="text-success">-¥@item.SubsidyAmount.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td class="text-center text-success fw-bold">
                                        @* v2.13.93 新增：费用合计 = 分摊金额 - 补贴金额（≥ 0） *@
                                        ¥@item.FinalAmount.ToString("N2")
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsPublished)
                                        {
                                            <span class="badge bg-success">已发布</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">未发布</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @* v2.13.88 RBAC：查看 → employeebilling:view（路由级守卫） / 发布 → employeebilling:publish *@
                                        @if (await Html.HasPermissionAsync("employeebilling:view"))
                                        {
                                            <button class="btn btn-sm btn-outline-info" onclick="viewDetail(@item.Id, @item.EmployeeId, '@item.BillingMonth')" title="查看详情">
                                                <i class="bi bi-eye"></i> 查看
                                            </button>
                                        }
                                        @if (!item.IsPublished && await Html.HasPermissionAsync("employeebilling:publish"))
                                        {
                                            <button class="btn btn-sm btn-outline-primary" onclick="publishOne(@item.Id)">发布</button>
                                        }
                                        @if (!await Html.HasPermissionAsync("employeebilling:view") && (!item.IsPublished || !await Html.HasPermissionAsync("employeebilling:publish")))
                                        {
                                            <small class="text-muted"><i class="bi bi-lock"></i> 无操作权限</small>
                                        }
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="15" class="text-center text-muted py-4">暂无员工账单</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- 页尾分页（v2.13.71 100% 原型对齐） -->
            @await Html.PartialAsync("_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel
            {
                PageIndex = currentPage,
                PageSize = pageSize,
                TotalCount = totalCount
            })
        </div>
    </div>
</div>

<style>
    .filter-item-stats .form-control {
        background: #f8f9fa !important;
    }

    .table th {
        white-space: nowrap;
        font-weight: 500;
    }

    .table td {
        vertical-align: middle;
    }

    .pagination-footer {
        background: transparent;
        border: none;
        padding: 0.75rem 0 0 0;
    }

    .pagination .page-link {
        min-width: 32px;
        text-align: center;
    }
</style>

@section Scripts {
<script>
function generateBilling() {
    if (!confirm('确定要生成本月员工分摊账单吗？')) return;
    $.ajax({
        url: '/api/v1/billing/employee-bills/generate',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ billingMonth: '@Model.BillingMonth' }),
        success: function (res) {
            alert('生成分摊成功！');
            location.reload();
        },
        error: function (xhr) {
            alert('生成失败：' + (xhr.responseJSON?.message || xhr.statusText));
        }
    });
}

function regenerateBilling() {
    if (!confirm('确定要重新生成员工分摊账单吗？\n已存在的账单将被覆盖！')) return;
    $.ajax({
        url: '/api/v1/billing/employee-bills/generate',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ billingMonth: '@Model.BillingMonth' }),
        success: function (res) {
            alert('重新生成成功！');
            location.reload();
        },
        error: function (xhr) {
            alert('生成失败：' + (xhr.responseJSON?.message || xhr.statusText));
        }
    });
}

function publishAll() {
    if (!confirm('确定要发布全部员工账单吗？')) return;
    $.ajax({
        url: '/api/v1/billing/employee-bills/publish',
        method: 'POST',
        contentType: 'application/json',
        data: JSON.stringify({ billingMonth: '@Model.BillingMonth' }),
        success: function (res) {
            alert(res.message || '发布成功！');
            location.reload();
        },
        error: function (xhr) {
            alert('发布失败：' + (xhr.responseJSON?.message || xhr.statusText));
        }
    });
}

function publishOne(id) {
    if (!confirm('确定要发布该员工账单吗？')) return;
    alert(`✓ 原型演示：账单 ${id} 已发布`);
}

function exportBilling(event) {
    event.preventDefault();
    var month = '@Model.BillingMonth';
    var url = '/api/v1/billing/employee-bills/export?billingMonth=' + encodeURIComponent(month);
    var a = document.createElement('a');
    a.href = url;
    a.download = '员工分摊账单_' + month + '.xlsx';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
}

function viewDetail(id, empId, month) {
    // v2.13.44 新增：跳转详情页（默认跳员工当月首条，可扩展为月列表）
    // v2.13.88：携带 returnUrl 让详情页能返回原列表原状态
    var returnUrl = encodeURIComponent(window.location.pathname + window.location.search);
    window.location.href = '/EmployeeBilling/Details?id=' + id + '&returnUrl=' + returnUrl;
}
</script>
}