@page
@model DormManage.Admin.Pages.DormBilling.IndexModel
@{
    ViewData["Title"] = "宿舍账单";
    Layout = "_Layout";

    var currentPage = Model.PageIndex;
    var pageSize = Model.PageSize;
    var totalCount = Model.Result?.TotalCount ?? 0;
    var totalPages = totalCount > 0 ? (int)Math.Ceiling(totalCount / (double)pageSize) : 0;
    var startIndex = (currentPage - 1) * pageSize + 1;
}

@section Styles {
    <style>
        .filter-item-stats .form-control {
            background: #f8f9fa !important;
        }
    </style>
}

<div class="container-fluid">
    <!-- 页头（v2.13.15 使用 PageHeader 组件） -->
    @await Component.InvokeAsync("PageHeader", new {
        icon = "bi-building-add",
        title = "宿舍账单",
        count = Model.TotalCount,
        countLabel = "条",
        @* v2.13.88 RBAC：生成/重生成 → dormbilling:generate；导出 → dormbilling:export *@
        primaryAction = new PageAction { Label = "生成", OnClick = "generate(false)", Icon = "bi-bar-chart", Style = "success", PermissionCode = "dormbilling:generate" },
        actions = new List<PageAction> {
            new() { Label = "重生成", OnClick = "generate(true)", Icon = "bi-arrow-repeat", Style = "info", PermissionCode = "dormbilling:generate" },
            new() { Label = "导出Excel", OnClick = "exportBilling(event)", Icon = "bi-file-earmark-excel", Style = "success", PermissionCode = "dormbilling:export" }
        }
    })

    <!-- 筛选条件区域 -->
    <form method="get" class="card mb-3 filter-card" data-filter-form="dormBilling">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end flex-nowrap filter-row">
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">计费月份</label>
                    <input type="month" name="BillingMonth" value="@Model.BillingMonth" class="form-control">
                </div>
                <div class="col-auto filter-item filter-item-dorm">
                    <label class="form-label mb-1">房号</label>
                    <input list="dormListDormBilling" type="text" name="DormCode" value="@Model.DormCode" class="form-control" placeholder="选择或输入房号">
                    <datalist id="dormListDormBilling">
                        @foreach (var code in Model.DormCodes)
                        {
                            <option value="@code"></option>
                        }
                    </datalist>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">楼栋</label>
                    <select name="BuildingId" class="form-select">
                        <option value="">全部</option>
                        @foreach (var building in Model.Buildings)
                        {
                            <option value="@building.Id" selected="@(Model.BuildingId == building.Id)">
                                @building.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-auto filter-item">
                    <label class="form-label mb-1">楼层</label>
                    <select name="FloorId" class="form-select">
                        <option value="">全部</option>
                        @foreach (var floor in Model.Floors)
                        {
                            <option value="@floor.Id" selected="@(Model.FloorId == floor.Id)">
                                @floor.FloorNo
                            </option>
                        }
                    </select>
                </div>
                <div class="col-auto filter-item filter-item-stats">
                    <label class="form-label mb-1">账单合计</label>
                    <div class="form-control text-success fw-bold bg-light">
                        ¥@Model.Result?.Items.Sum(i => i.TotalAmount).ToString("N2")
                    </div>
                </div>
                <div class="col-auto filter-item filter-item-btn">
                    <div class="filter-item-btn-group">
                        <button type="submit" class="btn btn-primary filter-btn">
                            <i class="bi bi-search"></i> 查询
                        </button>
                        <button type="button" class="btn btn-outline-secondary filter-btn" onclick="FilterPersistence.resetFilters('dormBilling')">
                            <i class="bi bi-arrow-clockwise"></i> 重置
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </form>

    <!-- 列表 -->
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th width="60" class="text-center">序号</th>
                            <th>房号</th>
                            <th>楼栋</th>
                            <th>楼层</th>
                            <th class="text-end">冷水用量</th>
                            <th class="text-end">热水用量</th>
                            <th class="text-end">电用量</th>
                            <th class="text-end">冷水费</th>
                            <th class="text-end">热水费</th>
                            <th class="text-end">电费</th>
                            <th class="text-end">合计</th>
                            <th width="80" class="text-center">在住</th>
                            <th width="80" class="text-center">状态</th>
                            <th width="100" class="text-center">操作</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Result != null && Model.Result.Items.Any())
                        {
                            @foreach (var item in Model.Result.Items)
                            {
                                <tr>
                                    <td class="text-center text-muted">@(((Model.PageIndex - 1) * Model.PageSize) + Model.Result.Items.ToList().IndexOf(item) + 1)</td>
                                    <td><strong>@item.DormCode</strong></td>
                                    <td>@item.BuildingName</td>
                                    <td>@item.FloorName</td>
                                    <td class="text-end">@item.ColdUsage.ToString("F2") m³</td>
                                    <td class="text-end">@item.HotUsage.ToString("F2") m³</td>
                                    <td class="text-end">@item.ElectricUsage.ToString("F2") 度</td>
                                    <td class="text-end">¥@item.ColdAmount.ToString("F2")</td>
                                    <td class="text-end">¥@item.HotAmount.ToString("F2")</td>
                                    <td class="text-end">¥@item.ElectricAmount.ToString("F2")</td>
                                    <td class="text-end fw-bold text-primary">¥@item.TotalAmount.ToString("F2")</td>
                                    <td class="text-center">
                                        <span class="badge bg-info">@item.ResidentCount/@item.MaxCapacity</span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.IsPublished)
                                        {
                                            <span class="badge bg-success">已发布</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark">未发布</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @* v2.13.88 RBAC：行内详情按钮 → 默认拥有（dormbilling:view 路由级守卫已保证） *@
                                        @if (await Html.HasPermissionAsync("dormbilling:view"))
                                        {
                                            <button class="btn btn-sm btn-outline-primary" onclick="showDetail(@item.DormId, '@item.ReadMonth')">
                                                <i class="bi bi-eye"></i> 详情
                                            </button>
                                        }
                                        else
                                        {
                                            <small class="text-muted"><i class="bi bi-lock"></i> 无操作权限</small>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="14" class="text-center text-muted py-4">暂无数据，请点击"生成"按钮创建账单</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- 页尾分页（v2.13.71 100% 原型对齐） -->
            @if (Model.TotalCount > 0)
            {
                @await Html.PartialAsync("_PaginationPartial", new DormManage.Admin.Pages.Shared.PaginationModel
                {
                    PageIndex = Model.CurrentPage,
                    PageSize = Model.PageSize,
                    TotalCount = Model.TotalCount
                })
            }
        </div>
    </div>
</div>

<!-- 宿舍账单详情弹窗 -->
<div class="modal fade" id="dormDetailModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" style="max-width: 1100px;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-list-ul"></i> 宿舍账单明细 — <span id="modalDormCode" class="text-primary"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-light border mb-3">
                    <div class="row text-center">
                        <div class="col-3">
                            <div class="small text-muted">宿舍</div>
                            <div class="fw-bold" id="modalDormCode2">-</div>
                        </div>
                        <div class="col-3">
                            <div class="small text-muted">在住人数</div>
                            <div class="fw-bold" id="modalResidentCapacity">
                                <span id="modalResidentCount">-</span>/<span id="modalCapacity">-</span>
                            </div>
                        </div>
                        <div class="col-3">
                            <div class="small text-muted">计费月份</div>
                            <div class="fw-bold" id="modalMonth">-</div>
                        </div>
                        <div class="col-3">
                            <div class="small text-muted">合计金额</div>
                            <div class="fw-bold text-primary fs-5" id="modalTotal">-</div>
                        </div>
                    </div>
                </div>
                <h6 class="mb-2"><i class="bi bi-bar-chart"></i> 费用组成</h6>
                <table class="table table-sm table-bordered mb-4">
                    <thead class="table-light">
                        <tr>
                            <th class="text-center">冷水费</th>
                            <th class="text-center">热水费</th>
                            <th class="text-center">电费</th>
                            <th class="text-center">合计</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr class="text-center">
                            <td><span id="modalColdAmount">-</span></td>
                            <td><span id="modalHotAmount">-</span></td>
                            <td><span id="modalElecAmount">-</span></td>
                            <td class="fw-bold text-primary" id="modalTotalAmount">-</td>
                        </tr>
                    </tbody>
                </table>
                <h6 class="mb-2"><i class="bi bi-people"></i> 员工分摊明细</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-hover">
                        <thead class="table-light">
                            <tr>
                                <th>工号</th>
                                <th>姓名</th>
                                <th>部门</th>
                                <th>员工类型</th>
                                <th>班次</th>
                                <th>入住天数</th>
                                <th class="text-end">冷水费</th>
                                <th class="text-end">热水费</th>
                                <th class="text-end">电费</th>
                                <th class="text-end">分摊合计</th>
                            </tr>
                        </thead>
                        <tbody id="modalEmployeeBills">
                            <tr><td colspan="10" class="text-center text-muted py-3">加载中...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">关闭</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function showDetail(dormId, month) {
            // TODO: 实际项目中应通过 AJAX 加载详情数据
            document.getElementById('modalDormCode').textContent = 'D-' + dormId.toString().padStart('3', '0');
            document.getElementById('modalDormCode2').textContent = 'D-' + dormId.toString().padStart('3', '0');
            document.getElementById('modalMonth').textContent = month;
            document.getElementById('modalResidentCount').textContent = '3';
            document.getElementById('modalCapacity').textContent = '4';
            document.getElementById('modalTotal').textContent = '¥1,234.56';
            document.getElementById('modalColdAmount').textContent = '¥234.56';
            document.getElementById('modalHotAmount').textContent = '¥345.67';
            document.getElementById('modalElecAmount').textContent = '¥654.33';
            document.getElementById('modalTotalAmount').textContent = '¥1,234.56';

            var modal = new bootstrap.Modal(document.getElementById('dormDetailModal'));
            modal.show();
        }

        function generate(regenerate) {
            if (!confirm(regenerate ? '确定重新生成账单吗？将覆盖已有数据。' : '确定生成账单吗？将基于本月智能抄表生成。')) return;
            $.ajax({
                url: '/api/v1/billing/dorm-bills/generate',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ billingMonth: '@Model.BillingMonth' }),
                success: function (res) {
                    alert('生成成功！');
                    location.reload();
                },
                error: function (xhr) {
                    alert('生成失败：' + (xhr.responseJSON?.message || xhr.statusText));
                }
            });
        }

        // v2.13.43 修复：导出改为真实下载（GET 跳转触发文件下载）
        function exportBilling(e) {
            e.preventDefault();
            var month = '@Model.BillingMonth';
            var url = '/api/v1/billing/dorm-bills/export?billingMonth=' + encodeURIComponent(month);
            // 简单触发下载：创建临时 a 标签
            var a = document.createElement('a');
            a.href = url;
            a.download = '宿舍账单_' + month + '.xlsx';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }
    </script>
}
