@model DormManage.Admin.Pages.Settings.IndexModel

<div class="card">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-2">
            <strong><i class="bi bi-shield-check"></i> 字段权限管理</strong>
            <span class="badge bg-info text-dark small" title="v2.13.92 新增：数据权限 PermissionType=3 落地">RBAC 四级权限</span>
        </div>

        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-primary field-add-btn" data-bs-toggle="modal" data-bs-target="#addFieldModal">
                <i class="bi bi-plus-circle"></i> 新增字段
            </button>
        </div>
    </div>
    <div class="card-body">
        <div id="fieldPermissionFeedback" class="alert d-none mb-3"></div>

        <div class="alert alert-info py-2 mb-3">
            <i class="bi bi-info-circle"></i>
            <strong>字段权限</strong>用于管理系统中的<strong>敏感/可识别个人信息（PII）</strong>字段。
            在此「勾选」的字段，将被加入「隐私字段清单」（受隐私保护）；
            <strong class="text-danger">未勾选「允许显示隐私字段」总开关</strong>的角色 → 清单内字段在所有页面不可见（整列隐藏）。<br>
            <strong>deny-by-default 安全策略</strong>：默认所有角色都不显示隐私字段，必须通过角色总开关授权后才能查看。
            <br><br>
            <strong>使用方式：</strong>先勾选需要保护的字段 → 再进入「角色与权限」标签页 → 为角色勾选「允许显示隐私字段」总开关 → 授权完成。
            <br><br>
            <strong>新增字段：</strong>点击「新增字段」可添加新的隐私字段保护规则，模块代码需与系统已存在的模块一致（如 Personnel、Booking 等），并在 GetModuleDisplayName 中映射中文显示名。
        </div>

        <form id="fieldPermissionForm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th width="60" class="text-center">勾选</th>
                            <th>模块</th>
                            <th>字段名</th>
                            <th>字段键</th>
                            <th width="100" class="text-center">敏感等级</th>
                            <th width="80" class="text-center">排序</th>
                            <th>说明</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.FieldPermissions)
                        {
                            <tr>
                                <td class="text-center">
                                    <div class="form-check d-inline-block">
                                        <input type="checkbox" class="form-check-input fp-cb"
                                               name="FieldIds" value="@f.Id"
                                               data-id="@f.Id"
                                               @(f.IsActive ? "checked" : "")>
                                    </div>
                                </td>
                                <td><span class="badge bg-secondary">@Model.GetModuleDisplayName(f.Module)</span></td>
                                <td><strong>@f.FieldName</strong></td>
                                <td><code class="small text-muted">@f.FieldKey</code></td>
                                <td class="text-center">
                                    @if (f.SensitivityLevel == 1)
                                    {
                                        <span class="badge bg-danger">高</span>
                                    }
                                    else if (f.SensitivityLevel == 2)
                                    {
                                        <span class="badge bg-warning text-dark">中</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-info text-dark">低</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <input type="number" class="form-control form-control-sm text-center fp-sort"
                                           name="SortOrder[@f.Id]" value="@f.SortOrder" min="0" max="999"
                                           style="width: 70px;">
                                </td>
                                <td class="small text-muted">@f.Description</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllFields(true)">
                        <i class="bi bi-check-all"></i> 全选
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="selectAllFields(false)">
                        <i class="bi bi-x-lg"></i> 全不选
                    </button>
                </div>
                <div>
                    <button type="submit" class="btn btn-primary" id="fieldPermissionSubmit">
                        <i class="bi bi-check-lg"></i> 保存设置
                    </button>
                </div>
            </div>
        </form>

        <hr>
        <div class="text-muted small">
            <i class="bi bi-lightbulb"></i> <strong>使用方式：</strong>
            勾选字段后，请到「<a href="#" onclick="setActiveTab('roles'); return false;">角色与权限</a>」标签页打开对应角色的权限矩阵，
            <span class="badge bg-info text-dark">勾选「允许显示隐私字段」</span> 即可让该角色看到上述字段；不勾选则看不到（deny-by-default 默认安全）。
            <br>
            当前显示 <span id="fieldCount" class="fw-bold">0</span> 个字段配置（按模块名称排序）
        </div>
    </div>
</div>

<!-- 新增字段 Modal（v2.13.196 升级：模块+字段均为下拉选择） -->
<div class="modal fade" id="addFieldModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-plus-circle"></i> 新增隐私字段</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="关闭"></button>
            </div>
            <div class="modal-body">
                <form id="addFieldForm">
                    <div id="addFieldFeedback" class="alert d-none mb-3"></div>

                    <div class="row g-3">
                        <!-- v2.13.196：模块下拉选择（基于主菜单中有列表的模块） -->
                        <div class="col-md-6">
                            <label class="form-label">模块 <span class="text-danger">*</span></label>
                            <select class="form-select" name="Module" id="addFieldModule" required>
                                <option value="">-- 请选择模块 --</option>
                            </select>
                            <div class="form-text">基于主菜单导航中有列表页面的模块</div>
                        </div>

                        <!-- v2.13.196：字段键下拉选择（基于所选模块的数据库表） -->
                        <div class="col-md-6">
                            <label class="form-label">字段键 <span class="text-danger">*</span></label>
                            <select class="form-select" name="FieldKey" id="addFieldKey" required disabled>
                                <option value="">-- 请先选择模块 --</option>
                            </select>
                            <div class="form-text">已存在字段将标记为不可选</div>
                        </div>

                        <!-- v2.13.196：自动填充显示名 -->
                        <div class="col-md-6">
                            <label class="form-label">字段显示名 <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" name="FieldName" id="addFieldName" required readonly>
                            <div class="form-text">根据所选字段自动填充</div>
                        </div>

                        <!-- v2.13.196：自动填充字段类型 -->
                        <div class="col-md-6">
                            <label class="form-label">字段类型</label>
                            <input type="text" class="form-control" id="addFieldType" readonly>
                            <input type="hidden" name="FieldType" id="addFieldTypeHidden" value="string">
                            <div class="form-text">根据所选字段自动填充</div>
                        </div>

                        <!-- v2.13.196：建议的敏感等级（自动填充，用户可调整） -->
                        <div class="col-md-6">
                            <label class="form-label">敏感等级</label>
                            <select class="form-select" name="SensitivityLevel" id="addFieldSensitivity">
                                <option value="1">高（PII 敏感信息）</option>
                                <option value="2" selected>中（个人信息）</option>
                                <option value="3">低（一般信息）</option>
                            </select>
                            <div class="form-text">系统根据字段类型推荐，可调整</div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">排序（自动）</label>
                            <input type="number" class="form-control" name="SortOrder" value="0" min="0" max="999" disabled>
                            <div class="form-text">保存到数据库时自动按模块分配</div>
                        </div>

                        <!-- v2.13.196：自动填充描述建议（用户可编辑） -->
                        <div class="col-12">
                            <label class="form-label">描述 <span class="text-danger">*</span></label>
                            <textarea class="form-control" name="Description" id="addFieldDescription" rows="3" required></textarea>
                            <div class="form-text">系统根据字段类型推荐描述，可修改</div>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="IsActive" value="true" id="addFieldIsActive" checked>
                                <input type="hidden" name="IsActive" value="false">
                                <label class="form-check-label" for="addFieldIsActive">立即启用隐私保护（勾选后该字段默认隐藏，需角色授权才能显示）</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <button type="button" class="btn btn-primary" id="addFieldSubmit">
                    <i class="bi bi-save"></i> 保存新增
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    // v2.13.92 字段权限 JS
    function selectAllFields(checked) {
        document.querySelectorAll('.fp-cb').forEach(cb => cb.checked = checked);
    }

    // 隐藏反馈消息
    function hideFeedback(feedbackId) {
        const el = document.getElementById(feedbackId);
        if (el) {
            el.classList.add('d-none');
            el.textContent = '';
        }
    }

    // 显示反馈消息
    function showFeedback(feedbackEl, type, message) {
        if (!feedbackEl) return;
        feedbackEl.className = 'alert mb-3 alert-' + type;
        feedbackEl.innerHTML = message;
        feedbackEl.classList.remove('d-none');
    }

    function wireFieldPermissionPanel() {
        const form = document.getElementById('fieldPermissionForm');
        if (!form) return;

        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            hideFeedback('fieldPermissionFeedback');
            const updates = [];
            document.querySelectorAll('.fp-cb').forEach(cb => {
                const id = parseInt(cb.dataset.id, 10);
                const isActive = cb.checked;
                const sortInput = document.querySelector('.fp-sort[name="SortOrder[' + id + ']"]');
                const sortOrder = sortInput ? parseInt(sortInput.value, 10) || 0 : 0;
                updates.push({ id, isActive, sortOrder });
            });

            const btn = document.getElementById('fieldPermissionSubmit');
            const orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>保存中...';

            try {
                const resp = await fetch('/api/v1/system/field-permissions', {
                    method: 'PUT',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': antiforgeryToken
                    },
                    body: JSON.stringify({ updates: updates })
                });
                const j = await resp.json();
                if (resp.ok && j.success) {
                    showFeedback(document.getElementById('fieldPermissionFeedback'), 'success', '✓ 字段权限已保存！共更新 ' + updates.length + ' 个字段');
                    setTimeout(() => location.reload(), 800);
                } else {
                    showFeedback(document.getElementById('fieldPermissionFeedback'), 'danger', '✗ 保存失败：' + (j?.message || 'HTTP ' + resp.status));
                }
            } catch (err) {
                showFeedback(document.getElementById('fieldPermissionFeedback'), 'danger', '✗ 请求失败：' + err.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = orig;
            }
        });
    }

    // 新增字段逻辑（v2.13.195 新增；v2.13.196 升级：模块+字段下拉联动 + 智能填充）
    let _fieldMetaCache = null; // v2.13.196: 缓存 meta 数据，避免每次打开都请求

    async function loadFieldMetaAsync() {
        // v2.13.196: 如果已缓存则跳过请求
        if (_fieldMetaCache) return _fieldMetaCache;
        try {
            const resp = await fetch('/api/v1/system/field-permissions/meta');
            const j = await resp.json();
            if (resp.ok && j.success && j.data) {
                _fieldMetaCache = j.data;
                return _fieldMetaCache;
            }
        } catch (err) {
            console.error('[字段权限] 加载 meta 数据失败:', err);
        }
        return null;
    }

    function populateModules(modules) {
        const select = document.getElementById('addFieldModule');
        if (!select) return;
        // 清空现有选项（保留第一个提示项）
        while (select.options.length > 1) select.remove(1);

        modules.forEach(m => {
            const opt = document.createElement('option');
            opt.value = m.code;
            opt.textContent = m.displayName + ' (' + m.code + ')';
            opt.dataset.entity = m.entityName;
            select.appendChild(opt);
        });
    }

    function populateFields(fields) {
        const select = document.getElementById('addFieldKey');
        if (!select) return;

        // 清空所有选项
        while (select.options.length > 0) select.remove(0);

        if (!fields || fields.length === 0) {
            const opt = document.createElement('option');
            opt.value = '';
            opt.textContent = '-- 该模块暂无可选字段 --';
            select.appendChild(opt);
            select.disabled = true;
            return;
        }

        // 添加默认提示项
        const placeholder = document.createElement('option');
        placeholder.value = '';
        placeholder.textContent = '-- 请选择字段 --';
        select.appendChild(placeholder);

        fields.forEach(f => {
            const opt = document.createElement('option');
            opt.value = f.key;
            const existingTag = f.isExisting ? ' [已存在]' : '';
            opt.textContent = f.displayName + ' (' + f.fieldType + ')' + existingTag;
            opt.disabled = !!f.isExisting;
            opt.dataset.displayName = f.displayName;
            opt.dataset.fieldType = f.fieldType;
            opt.dataset.sensitivityHint = f.sensitivityHint;
            opt.dataset.descriptionHint = f.descriptionHint || '';
            select.appendChild(opt);
        });

        select.disabled = false;
    }

    function resetAutoFilledFields() {
        document.getElementById('addFieldName').value = '';
        document.getElementById('addFieldType').value = '';
        const hidden = document.getElementById('addFieldTypeHidden');
        if (hidden) hidden.value = 'string';
        document.getElementById('addFieldSensitivity').value = '2';
        document.getElementById('addFieldDescription').value = '';
    }

    function applyAutoFill(fieldOption) {
        // 自动填充字段显示名、字段类型、敏感等级、描述
        document.getElementById('addFieldName').value = fieldOption.dataset.displayName || '';
        document.getElementById('addFieldType').value = fieldOption.dataset.fieldType || '';
        const hidden = document.getElementById('addFieldTypeHidden');
        if (hidden) hidden.value = fieldOption.dataset.fieldType || 'string';
        document.getElementById('addFieldSensitivity').value = fieldOption.dataset.sensitivityHint || '2';
        document.getElementById('addFieldDescription').value = fieldOption.dataset.descriptionHint || '';
    }

    function resetAddFieldModal() {
        // 重置所有控件
        const moduleSel = document.getElementById('addFieldModule');
        if (moduleSel) moduleSel.value = '';
        const fieldSel = document.getElementById('addFieldKey');
        if (fieldSel) {
            fieldSel.value = '';
            fieldSel.disabled = true;
            while (fieldSel.options.length > 1) fieldSel.remove(1);
        }
        resetAutoFilledFields();
        const feedback = document.getElementById('addFieldFeedback');
        if (feedback) {
            feedback.className = 'alert d-none mb-3';
            feedback.textContent = '';
        }
    }

    function wireAddFieldModal() {
        const addFieldBtn = document.getElementById('addFieldSubmit');
        if (!addFieldBtn) {
            console.error('[字段权限] 新增字段提交按钮未找到 (id=addFieldSubmit)');
            return;
        }
        console.log('[字段权限] 新增字段 Modal 已初始化');

        // v2.13.196: 当 Modal 显示时，加载 meta 数据并填充下拉
        const modal = document.getElementById('addFieldModal');
        if (modal) {
            modal.addEventListener('show.bs.modal', async function() {
                resetAddFieldModal();
                const meta = await loadFieldMetaAsync();
                if (meta && meta.modules) {
                    populateModules(meta.modules);
                } else {
                    // 加载失败提示
                    const feedback = document.getElementById('addFieldFeedback');
                    if (feedback) {
                        feedback.className = 'alert alert-danger mb-3';
                        feedback.textContent = '✗ 模块元数据加载失败，请刷新页面重试';
                    }
                }
            });
        }

        // v2.13.196: 模块变化 → 刷新字段下拉
        const moduleSelect = document.getElementById('addFieldModule');
        if (moduleSelect) {
            moduleSelect.addEventListener('change', function() {
                const selectedCode = this.value;
                resetAutoFilledFields();
                if (!selectedCode || !_fieldMetaCache) {
                    populateFields(null);
                    return;
                }
                const module = _fieldMetaCache.modules.find(m => m.code === selectedCode);
                populateFields(module ? module.fields : null);
            });
        }

        // v2.13.196: 字段变化 → 自动填充显示名、类型、敏感等级、描述
        const fieldSelect = document.getElementById('addFieldKey');
        if (fieldSelect) {
            fieldSelect.addEventListener('change', function() {
                const selected = this.options[this.selectedIndex];
                if (selected && selected.value) {
                    applyAutoFill(selected);
                } else {
                    resetAutoFilledFields();
                }
            });
        }

        // v2.13.196: 提交按钮
        addFieldBtn.addEventListener('click', async function() {
            console.log('[字段权限] 点击新增字段提交按钮');

            const form = document.getElementById('addFieldForm');
            if (!form) {
                console.error('[字段权限] 表单未找到 (id=addFieldForm)');
                return;
            }

            // 表单基础验证
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const feedbackEl = document.getElementById('addFieldFeedback');
            if (feedbackEl) {
                feedbackEl.className = 'alert alert-info mb-3';
                feedbackEl.textContent = '正在提交...';
                feedbackEl.classList.remove('d-none');
            }

            const formData = new FormData(form);
            const data = {
                Module: formData.get('Module'),
                FieldKey: formData.get('FieldKey'),
                FieldName: formData.get('FieldName'),
                FieldType: formData.get('FieldType') || 'string', // 来自隐藏 input
                SensitivityLevel: parseInt(formData.get('SensitivityLevel'), 10) || 2,
                SortOrder: 0, // 后端自动计算
                IsActive: formData.get('IsActive') === 'true',
                Description: formData.get('Description')
            };

            console.log('[字段权限] 提交数据:', data);

            const btn = this;
            const orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>保存中...';

            try {
                const token = (typeof antiforgeryToken !== 'undefined' && antiforgeryToken)
                    || document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    || '';

                const resp = await fetch('/api/v1/system/field-permissions', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token
                    },
                    body: JSON.stringify(data)
                });

                console.log('[字段权限] HTTP 状态:', resp.status);
                const j = await resp.json();
                console.log('[字段权限] 响应:', j);

                if (resp.ok && j.success) {
                    if (feedbackEl) {
                        feedbackEl.className = 'alert alert-success mb-3';
                        feedbackEl.textContent = '✓ 字段添加成功！即将刷新列表...';
                    }
                    // v2.13.196: 清空缓存以便下次打开 Modal 时重新加载最新数据
                    _fieldMetaCache = null;
                    setTimeout(() => location.reload(), 1500);
                } else {
                    if (feedbackEl) {
                        feedbackEl.className = 'alert alert-danger mb-3';
                        feedbackEl.textContent = '✗ 添加失败：' + (j?.message || 'HTTP ' + resp.status);
                    }
                }
            } catch (err) {
                console.error('[字段权限] 请求异常:', err);
                if (feedbackEl) {
                    feedbackEl.className = 'alert alert-danger mb-3';
                    feedbackEl.textContent = '✗ 请求失败：' + err.message;
                }
            } finally {
                btn.disabled = false;
                btn.innerHTML = orig;
            }
        });
    }

    // 更新字段计数
    function updateFieldCount() {
        const count = document.getElementById('fieldCount');
        if (count) {
            count.textContent = document.querySelectorAll('.fp-cb').length;
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        wireFieldPermissionPanel();
        wireAddFieldModal();
        // 稍后更新计数，等待表格渲染
        setTimeout(updateFieldCount, 100);
    });
</script>