<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- v2.13.12 全局抑制次要警告：CS1998（async无await）/CS8602（可能空引用）/CS8629（可空值类型）/CS0618（已过时API兼容回退） -->
    <NoWarn>$(NoWarn);CS1998;CS8602;CS8629;CS0618</NoWarn>
    <!-- v2.13.140：Release 构建启用 Obfuscar 源码级混淆 -->
    <ObfuscateOnRelease>true</ObfuscateOnRelease>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="8.0.10" />
    <!-- v2.13.109: SQLite 已移除，仅保留 SqlServer -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.10" />
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <!-- v2.13.26: Shared 扩展需 ASP.NET Core 引用（HttpContext 抽象） -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
